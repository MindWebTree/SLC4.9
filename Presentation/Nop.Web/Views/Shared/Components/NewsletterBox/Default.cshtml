@model NewsLetterBoxModel
<div class="newsletter-banner bg-primary" role="form">
    <section class="newsletter-banner__container container-fluid">
        <form class="newsletter-banner__form" action="">
            <div class="newsletter-banner__row">

                <p class="newsletter-banner__heading">
                    @T("Footer.NewsLetter.Heading")
                </p>

                @* 
                  CRITICAL: 'newsletter-subscribe-block' must wrap all inputs and buttons 
                  so the script can hide the entire form on a successful submission. 
                *@
                <div id="newsletter-subscribe-block" class="newsletter-subscribe-wrapper w-100">
                    <div class="newsletter-field">
                        <div class="newsletter-field__input-wrapper">
                            <input asp-for="NewsLetterEmail"
                                   id="newsletter-email"
                                   class="newsletter-field__input form-control"
                                   placeholder="@T("Newsletter.Email.Placeholder")"
                                   aria-label="@T("Newsletter.Subscribe")" />

                            <div class="newsletter-field__validation">
                                <span id="subscribe-loading-progress" style="display: none;" class="newsletter-field__loader">
                                    @T("Common.Wait")
                                </span>
                                <span asp-validation-for="NewsLetterEmail"></span>
                            </div>
                        </div>
                    </div>

                    @* Added Captcha Support from Latest Build *@
                    @if (Model.DisplayCaptcha)
                    {
                        <div class="captcha-box mb-3 mt-2">
                            <nop-captcha />
                        </div>
                    }

                    <button type="button"
                            id="newsletter-subscribe-button"
                            class="btn btn-outline-light newsletter-banner__submit mt-2">
                        @T(Model.AllowToUnsubscribe ? "Newsletter.Options.Send" : "Newsletter.Options.Subscribe")
                    </button>

                    @if (Model.AllowToUnsubscribe)
                    {
                        <div class="newsletter-options mt-3">
                            <span class="newsletter-options__item">
                                <div class="custom-control custom-radio">
                                    <input type="radio"
                                           id="newsletter_subscribe"
                                           name="newsletter_block"
                                           class="custom-control-input newsletter-options__input"
                                           value="newsletter_subscribe"
                                           checked="checked" />
                                    <label class="custom-control-label newsletter-options__label" for="newsletter_subscribe">
                                        @T("Newsletter.Options.Subscribe")
                                    </label>
                                </div>
                            </span>
                            <span class="newsletter-options__item ml-3">
                                <div class="custom-control custom-radio">
                                    <input type="radio"
                                           id="newsletter_unsubscribe"
                                           name="newsletter_block"
                                           class="custom-control-input newsletter-options__input"
                                           value="newsletter_unsubscribe" />
                                    <label class="custom-control-label newsletter-options__label" for="newsletter_unsubscribe">
                                        @T("Newsletter.Options.Unsubscribe")
                                    </label>
                                </div>
                            </span>
                        </div>
                    }
                </div>

                @* Result Block (Shows success/error message) *@
                <div class="newsletter-field__result mt-3" id="newsletter-result-block"></div>

                <div class="newsletter-banner__bottom-text mt-3">
                    @T("footer.newsletter.bottom")
                </div>

            </div>
        </form>
    </section>

    @* Latest AJAX and ReCaptcha Script *@
    <script asp-location="Footer">

        async function getCaptchaToken(action, reCaptchaPublicKey, isReCaptchaV3) {
            var recaptchaToken = '';
            if (isReCaptchaV3) {
                grecaptcha.ready(() => {
                    grecaptcha.execute(reCaptchaPublicKey, { action: action }).then((token) => {
                        recaptchaToken = token;
                    });
                });

                while (recaptchaToken == '') {
                    await new Promise(t => setTimeout(t, 100));
                }
            } else {
                recaptchaToken = $('#newsletter-subscribe-block .captcha-box textarea[name="g-recaptcha-response"').val();
            }

            return recaptchaToken;
        }

        async function newsletter_subscribe(subscribe) {
            var subscribeProgress = $("#subscribe-loading-progress");
            subscribeProgress.show();
            var captchaTok = '';
            if (@Model.DisplayCaptcha.ToString().ToLowerInvariant() == true) {
                captchaTok = await getCaptchaToken('SubscribeNewsletter', '@Model.ReCaptchaPublicKey', @Model.IsReCaptchaV3.ToString().ToLowerInvariant());
            }
            var postData = {
                subscribe: subscribe,
                email: $("#newsletter-email").val(),
                'g-recaptcha-response': captchaTok
            };
            addAntiForgeryToken(postData);
            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.RouteUrl(NopRouteNames.Ajax.SUBSCRIBE_NEWSLETTER))",
                data: postData,
                success: function (data, textStatus, jqXHR) {
                    $("#newsletter-result-block").html(data.Result);
                    if (data.Success) {
                        $('#newsletter-subscribe-block').hide();
                        $('#newsletter-result-block').show();
                    } else {
                        $('#newsletter-result-block').fadeIn("slow").delay(2000).fadeOut("slow");
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('Failed to subscribe.');
                },
                complete: function (jqXHR, textStatus) {
                    subscribeProgress.hide();
                }
            });
        }

        $(function() {
            $('#newsletter-subscribe-button').on('click', function () {
                @if (Model.AllowToUnsubscribe)
                {
                        <text>if ($('#newsletter_subscribe').is(':checked')) {
                        newsletter_subscribe('true');
                    } else {
                        newsletter_subscribe('false');
                    }</text>
                }
                else
                {
                        <text>newsletter_subscribe('true');</text>
                }
            });
            $("#newsletter-email").on("keydown", function (event) {
                if (event.keyCode == 13) {
                    $("#newsletter-subscribe-button").trigger("click");
                    return false;
                }
            });
        });
    </script>
</div>