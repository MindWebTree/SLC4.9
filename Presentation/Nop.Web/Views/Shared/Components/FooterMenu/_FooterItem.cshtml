@model MenuItemModel *@
<li class="nav-item">
    @if (!string.IsNullOrEmpty(Model.Url))
    {
        var url = (Model.Url.Contains("{0}") || Model.Url.Contains("{1}"))
        ? string.Format(Model.Url, 0, customer?.Email ?? "")
        : Model.Url;

        <a href="@url" class="nav-link">
            @Model.Title
        </a>
    }
    else
    {
        <span class="nav-link">
            @Model.Title
        </span>
    }
</li>