@inject Nop.Services.Localization.ILocalizationService _localizationService;
@using Nop.Web.Framework.Infrastructure;
@{
    Layout = "_Root";
}
<script>

    var shadeAsShow = '@T("Product.selected.shades")';
    var defaultSortOption = '@((await _localizationService.GetResourceAsync("Common.Select")).Replace(" ", "_"))';
</script>
@{






    //current product ID
    var currentProductId = 0;
    if (Url.ActionContext.RouteData.Values["controller"].ToString().Equals("product", StringComparison.InvariantCultureIgnoreCase) &&
        Url.ActionContext.RouteData.Values["action"].ToString().Equals("productdetails", StringComparison.InvariantCultureIgnoreCase))
    {
        currentProductId = Convert.ToInt32(Url.ActionContext.RouteData.Values["productId"].ToString());
    }
    var hidefilter = false;
    var displayFilters = false;
    bool.TryParse((string)ViewBag.hidefilter, out hidefilter);
    bool.TryParse((string)ViewBag.displayFilters, out displayFilters);
    var EnableInfiniteScroll = false;
    bool.TryParse((string)ViewBag.EnableInfiniteScroll, out EnableInfiniteScroll);
}
<script>
    var EnableInfiniteScroll = '@EnableInfiniteScroll';
</script>
