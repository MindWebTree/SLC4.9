@model CategoryModel
@using Nop.Core.Domain.Customization.Custom
<div class="card-body">
    <p>
        @T("admin.catalog.entity.suggestedkeyword.hint")
    </p>
    @if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-body">

                @await Html.PartialAsync("Table", new DataTablesModel
           {
               Name = "SuggestedKeyword-grid",
               UrlRead = new DataUrl("SuggestedKeywordList", "Category",
               new RouteValueDictionary { [nameof(CategorySuggestedKeyword.CategoryId)] = Model.Id }),
               UrlDelete = new DataUrl("SuggestedKeywordDelete", "Category", null),
               UrlUpdate = new DataUrl("SuggestedKeywordAddPopup", "Category", null),

               Length = 10,
               ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(CategorySuggestedKeyword.Id))
                            {
                                Title = T("Admin.Catalog.Entity.SuggestedKeyword.Id").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = false,
                                EditType = EditType.Number
                            },
                            new ColumnProperty(nameof(CategorySuggestedKeyword.KeyWord))
                            {
                                Title = T("Admin.Catalog.Entity.SuggestedKeyword.Keyword").Text,
                                Width = "200",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                            new ColumnProperty(nameof(CategorySuggestedKeyword.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "200",
                                ClassName =  NopColumnClassDefaults.Button,
                                Render = new RenderCustom("renderSuggestedColumnEdit")
                            },
                            new ColumnProperty(nameof(CategorySuggestedKeyword.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                Width = "100",
                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                ClassName = NopColumnClassDefaults.Button
                            }
               }
            })
            </div>
            <div class="card-footer">
                <button type="submit" id="btnAddNewKeyword" class="btn btn-primary"
                        onclick="javascript:OpenWindow('@(Url.Action("SuggestedKeywordAddPopup", "Category",
        new {categoryId = Model.Id,id=0,btnId = "btnRefreshSuggestedKeyword", formId = "category-form"}))', 800, 800, true); return false;">
                    @T("Admin.Catalog.Entity.SuggestedKeyword.AddNew")
                </button>
                <button type="submit" id="btnRefreshSuggestedKeyword" style="display: none"></button>
                <script>
                    $(document).ready(function () {
                        $('#btnRefreshSuggestedKeyword').click(function () {
                            //refresh grid
                            updateTable('#SuggestedKeyword-grid');//return false to don't reload a page
                            return false;
                        });
                    });
                    function renderSuggestedColumnEdit(data, type, row, meta) {
                        return '<button onclick=\"javascript:OpenWindow(\'@Url.Action("SuggestedKeywordAddPopup", "Category")?categoryId=@Model.Id&id=' +
                            data + '&btnId=btnRefreshSuggestedKeyword&formId=category-form\', 800, 800, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
                                }
                </script>
            </div>
        </div>
    }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                @T("Admin.Catalog.Entity.SuggestedKeyword.SaveBeforeEdit")
            </div>
        </div>
    }
</div>