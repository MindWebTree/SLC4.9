@model SpecificationAttributeOptionModel

<form asp-controller="Category" asp-action="ProductFilterSpecificationAttributeDetailProduct"
      asp-route-specificationAttributeId="@Context.Request.Query["specificationAttributeId"]">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Catalog.Attributes.SpecificationAttributes.SpecificationAttribute.Options.ProductFilter")
            <small>
                <a href="javascript:void(0);" onclick="goToSpecificationAttributeOption()">
                    <i class="fas fa-arrow-circle-left"></i>
                    @T("Admin.Catalog.Attributes.SpecificationAttribute.Option.BackToList")
                </a>
            </small>
        </h1>
    </div>

    <div class="content-header clearfix">
        <div class="float-right">
            <button type="button" id="btnAddNewProduct" class="btn btn-primary">
                @T("Admin.Catalog.Categories.Products.AddNew")
            </button>
        </div>
    </div>

    <div class="card-body">
        @await Html.PartialAsync("Table", new DataTablesModel
   {
       Name = "categoryProductFilter-grid",
       UrlRead = new DataUrl("CategorySpecificationOptionUsedByProductsList", "Category",
                new RouteValueDictionary
                {
                    [nameof(Model.SpecificationAttributeOptionProductSearchModel.SpecificationAttributeOptionId)] = Model.Id,
                    [nameof(Model.SpecificationAttributeOptionProductSearchModel.SearchCategoryId)] = Model.CategoryId
                }),


       Length = Model.SpecificationAttributeOptionProductSearchModel.PageSize,
       LengthMenu = Model.SpecificationAttributeOptionProductSearchModel.AvailablePageSizes,
       UrlDelete = new DataUrl("DeleteProductOptionMapping", "Category", null),
       ColumnCollection = new List<ColumnProperty>
            {
         
                new ColumnProperty(nameof(SpecificationAttributeOptionProductModel.ProductId))
                {
                    Title = T("Admin.Catalog.Products.Fields.ProductId").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll
                },
                new ColumnProperty(nameof(SpecificationAttributeOptionProductModel.PictureThumbnailUrl))
                {
                    Title = T("Admin.Catalog.Products.Fields.PictureThumbnailUrl").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll,
                    Render = new RenderPicture()
                },
                new ColumnProperty(nameof(SpecificationAttributeOptionProductModel.ProductName))
                {
                    Title = T("Admin.Catalog.Attributes.SpecificationAttributes.SpecificationAttribute.UsedByProducts.Product").Text,
                    ClassName = NopColumnClassDefaults.CenterAll
                },
                new ColumnProperty(nameof(SpecificationAttributeOptionProductModel.DisplayOrder))
                {
                    Title = T("Admin.Catalog.Attributes.SpecificationAttributes.SpecificationAttribute.UsedByProducts.DisplayOrder").Text,
                    Editable = true,
                    EditType = EditType.Number
                },
                new ColumnProperty(nameof(SpecificationAttributeOptionProductModel.MobileDisplayOrder))
                {
                    Title = T("Admin.Catalog.Attributes.SpecificationAttributes.SpecificationAttribute.UsedByProducts.MobileDisplayOrder").Text,
                    Editable = true,
                    EditType = EditType.Number
                },    new ColumnProperty(nameof(CategoryProductModel.Id))
        {
            Title = T("Admin.Common.Delete").Text,
            Width = "100",
            Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
            ClassName = NopColumnClassDefaults.Button
        },
                new ColumnProperty(nameof(SpecificationAttributeProductModel.ProductId))
                {
                    Title = T("Admin.Common.View").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderButtonView(new DataUrl("~/Admin/Product/Edit/"))
                }
            }
   })
    </div>
</form>

<script>
    function goToSpecificationAttributeOption() {
        const params = new URLSearchParams(window.location.search);
        const categoryId = params.get("categoryId");
        const specificationAttributeId = '@Model.SpecificationAttributeId';

        if (categoryId && specificationAttributeId) {
            window.location.href = "@Url.Action("CategorySpecificationAttributeOptionSearchList", "Category")?specificationAttributeId="
                + specificationAttributeId + "&categoryId=" + categoryId;
        }
    }

    $(document).ready(function () {
        $('#btnAddNewProduct').on('click', function () {
            const params = new URLSearchParams(window.location.search);
            const categoryId = params.get("categoryId");
            const specificationAttributeOptionId = '@Model.Id';

            if (categoryId && specificationAttributeOptionId) {
                const url = "/Admin/Category/CategorySpecificationOptionMappingAddPopup"
                    + "?specificationAttributeOptionId=" + specificationAttributeOptionId
                    + "&categoryId=" + categoryId;
                OpenWindow(url, 800, 800, true);
            }
        });
    });
</script>
