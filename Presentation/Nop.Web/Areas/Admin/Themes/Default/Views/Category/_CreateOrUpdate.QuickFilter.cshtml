@model CategoryModel
<div class="card-body">
    <p>
        @T("Admin.Catalog.Category.QuickFilter.Hint")
    </p>
    @if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-body">

                @await Html.PartialAsync("Table", new DataTablesModel
           {
               Name = "QuickFilter-grid",
            UrlRead = new DataUrl("QuickFilterList", "Category",
               new RouteValueDictionary {[nameof(RelatedProductSearchModel.ProductId)]= Model.Id ,
                   [nameof(RelatedProductSearchModel.EntityType)]
               = "Category" }),
               UrlDelete = new DataUrl("QuickFilterDelete", "Category", null),
               UrlUpdate = new DataUrl("QuickFilterUpdate", "Category", null),

               Length = 10,
               ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(QuickFilterModel.TermName))
                            {
                                Title = T("Admin.Catalog.Category.QuickFilterModel.Fields.TermName").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                              new ColumnProperty(nameof(QuickFilterModel.Link))
                            {
                                Title = T("Admin.Catalog.Category.QuickFilterModel.Fields.Link").Text,
                                Width = "200",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                            new ColumnProperty(nameof(QuickFilterModel.DisplayOrder))
                            {
                                Title = T("Admin.Catalog.Category.QuickFilterModel.Fields.DisplayOrder").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.Number
                            },

                            new ColumnProperty(nameof(QuickFilterModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "200",
                                ClassName =  NopColumnClassDefaults.Button,
                              Render = new RenderCustom("quickrenderColumnEdit_filter")
                            },
                            new ColumnProperty(nameof(QuickFilterModel.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                Width = "100",
                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                ClassName = NopColumnClassDefaults.Button
                            }
                        }
           })
            </div>
            <div class="card-footer">
                <button type="submit" id="btnAddNewQuickFilterProduct" class="btn btn-primary" onclick="javascript:OpenWindow('@(Url.Action("QuickFilterAddPopup", "Category", new {entityId = Model.Id,entityType="Category", btnId = "btnRefreshQuickFilterProducts", formId = "category-form"}))', 800, 800, true); return false;">
                    @T("Admin.Catalog.QuickFilter.AddNew")
                </button>
                <button type="submit" id="btnRefreshQuickFilterProducts" style="display: none"></button>
                <script>
                    $(document).ready(function () {
                        $('#btnRefreshQuickFilterProducts').click(function () {
                            //refresh grid
                            updateTable('#QuickFilter-grid');

                            //return false to don't reload a page
                            return false;
                        });
                    });
                         function quickrenderColumnEdit_filter(data, type, row, meta) {
                        return '<button onclick=\"javascript:OpenWindow(\'@Url.Action("QuickFilterAddPopup", "Category")?entityId=@Model.Id&entityType=category&filterType=SpecificationAttribute&id=' + data
                            + '&btnId=btnRefreshQuickFilterProducts&formId=category-form\', 800, 800, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
                    }
                </script>
            </div>
        </div>
    }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                @T("Admin.Catalog.Category.RelatedSearch.SaveBeforeEdit")
            </div>
        </div>
    }
</div>