@model CategoryModel
@using Nop.Web.Areas.Admin.Models.Customization.Custom
<div class="card-body">
    <p>
        @T("Admin.Catalog.Entity.FiltersMappingByEntity.SpecificationAttribute.Hint")
    </p>
    @if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-body">

                @await Html.PartialAsync("Table", new DataTablesModel
           {
               Name = "filtermapping-SpecificationAttribute-grid",
               UrlRead = new DataUrl("FiltersMappingByEntityList", "Category",
               new RouteValueDictionary
                    {
                        [nameof(FiltersMappingByEntitySearchModel.EntityId)] = Model.Id,
                   [nameof(FiltersMappingByEntitySearchModel.EntityType)]
               = "Category",
                   [nameof(FiltersMappingByEntitySearchModel.FilterType)] = "SpecificationAttribute"
               }),
               UrlDelete = new DataUrl("FiltersMappingByEntityDelete", "Category", null),
               UrlUpdate = new DataUrl("FiltersMappingByEntityAddPopup", "Category", null),

               Length = 10,
               ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(FiltersMappingByEntityModel.filterName))
                            {
                                Title = T("Admin.Catalog.Entity.FiltersMappingByEntity.Fields.filterName").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                              new ColumnProperty(nameof(FiltersMappingByEntityModel.DisplayOrder))
                            {
                                Title = T("Admin.Catalog.Entity.FiltersMappingByEntity.Fields.DisplayOrder").Text,
                                Width = "200",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                            new ColumnProperty(nameof(FiltersMappingByEntityModel.Disabled))
                            {
                                Title = T("Admin.Catalog.Entity.FiltersMappingByEntity.Fields.Disabled").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.Number
                            },

                            new ColumnProperty(nameof(RelatedSearchModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "200",
                                ClassName =  NopColumnClassDefaults.Button,
                              Render = new RenderCustom("renderColumnEdit_attr")
                            },
                            new ColumnProperty(nameof(RelatedSearchModel.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                Width = "100",
                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                ClassName = NopColumnClassDefaults.Button
                            }
                        }
           })
            </div>
            <div class="card-footer">
                <button type="submit" id="btnAddNewSpecificationAttribute" class="btn btn-primary"
                        onclick="javascript:OpenWindow('@(Url.Action("FiltersMappingByEntityAddPopup", "Category",
        new {entityId = Model.Id,entityType="Category",
        filterType="SpecificationAttribute",id=0,btnId = "btnRefreshSpecificationAttribute", formId = "category-form"}))', 800, 800, true); return false;">
                    @T("Admin.Catalog.Entity.FiltersMappingByEntity.AddNew")
                </button>
                <button type="submit" id="btnRefreshSpecificationAttribute" style="display: none"></button>
                <script>
                    $(document).ready(function () {
                        $('#btnRefreshSpecificationAttribute').click(function () {
                            //refresh grid
                            updateTable('#filtermapping-SpecificationAttribute-grid');

                            //return false to don't reload a page
                            return false;
                        });
                    });
                    function renderColumnEdit_attr(data, type, row, meta) {
      return '<button onclick=\"javascript:OpenWindow(\'@Url.Action("FiltersMappingByEntityAddPopup", "Category")?entityId=@Model.Id&entityType=category&filterType=SpecificationAttribute&id=' + data
          + '&btnId=btnRefreshSpecificationAttribute&formId=category-form\', 800, 800, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
                                }
                                        $(document)
                                            .ready(function () {
                                                $('#btnRefresh')
                                                    .click(function () {
                                                        //refresh grid
                                                        updateTable('#shipping-banners-grid');

                                                        //return false to don't reload a page
                                                        return false;
                                                    });
                                            });
                </script>
            </div>
        </div>
    }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                @T("Admin.Catalog.Entity.FiltersMappingByEntity.SaveBeforeEdit")
            </div>
        </div>
    }
</div>