@model CategoryModel
@using Nop.Web.Areas.Admin.Models.Customization.Custom
<div class="card-body">
    <p>
        @T("Admin.Catalog.Entity.FiltersMappingByEntity.SpecificationAttributeOption.Hint")
    </p>
    @if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-body">

                @await Html.PartialAsync("Table", new DataTablesModel
           {
               Name = "filtermapping-SpecificationAttributeOption-grid",
               UrlRead = new DataUrl("FiltersMappingByEntityList", "Category",
               new RouteValueDictionary {[nameof(FiltersMappingByEntitySearchModel.EntityId)]= Model.Id ,
                   [nameof(FiltersMappingByEntitySearchModel.EntityType)]
               = "Category",
                   [nameof(FiltersMappingByEntitySearchModel.FilterType)]= "SpecificationAttributeOption"
               }),
               UrlDelete = new DataUrl("FiltersMappingByEntityDelete", "Category", null),
               UrlUpdate = new DataUrl("FiltersMappingByEntityAddPopup", "Category", null),

               Length = 10,
               ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(FiltersMappingByEntityModel.filterName))
                            {
                                Title = T("Admin.Catalog.Entity.FiltersMappingByEntity.Fields.filterName").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                              new ColumnProperty(nameof(FiltersMappingByEntityModel.DisplayOrder))
                            {
                                Title = T("Admin.Catalog.Entity.FiltersMappingByEntity.Fields.DisplayOrder").Text,
                                Width = "200",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                            new ColumnProperty(nameof(FiltersMappingByEntityModel.Disabled))
                            {
                                Title = T("Admin.Catalog.Entity.FiltersMappingByEntity.Fields.Disabled").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.Number
                            },

                            new ColumnProperty(nameof(RelatedSearchModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "200",
                                ClassName =  NopColumnClassDefaults.Button,
                              Render = new RenderCustom("renderColumnEdit")
                            },
                            new ColumnProperty(nameof(RelatedSearchModel.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                Width = "100",
                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                ClassName = NopColumnClassDefaults.Button
                            }
                        }
           })
            </div>
            <div class="card-footer">
                <button type="submit" id="btnAddNewSpecificationAttributeOption" class="btn btn-primary"
                        onclick="javascript:OpenWindow('@(Url.Action("FiltersMappingByEntityAddPopup", "Category", 
        new {entityId = Model.Id,entityType="Category",
        filterType="SpecificationAttributeOption",id=0,btnId = "btnRefreshSpecificationAttributeOption", formId = "category-form"}))', 800, 800, true); return false;">
                    @T("Admin.Catalog.Entity.FiltersMappingByEntity.AddNew")
                </button>
                <button type="submit" id="btnRefreshSpecificationAttributeOption" style="display: none"></button>
                <script>
                    $(document).ready(function () {
                        $('#btnRefreshSpecificationAttributeOption').click(function () {
                   
                            //refresh grid
                            updateTable('#filtermapping-SpecificationAttributeOption-grid');

                            //return false to don't reload a page
                            return false;
                        });
                    });
  function renderColumnEdit(data, type, row, meta) {
      return '<button onclick=\"javascript:OpenWindow(\'@Url.Action("FiltersMappingByEntityAddPopup", "Category")?entityId=@Model.Id&entityType=category&filterType=SpecificationAttributeOption&id=' + data
          + '&btnId=btnRefreshSpecificationAttributeOption&formId=category-form\', 800, 800, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
                                }

                </script>
            </div>
        </div>
    }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                @T("Admin.Catalog.Entity.FiltersMappingByEntity.SaveBeforeEdit")
            </div>
        </div>
    }
</div>