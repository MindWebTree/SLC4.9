@model CategoryModel
@using Nop.Core.Domain.Catalog;
@using Nop.Services
@using Nop.Core.Domain.Customization.Catalog
<div class="card-body">
    <div id="product-ATCRecommend-area">

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="ATCRecommendHeading" />
            </div>
            <div class="col-md-9">

                <nop-editor asp-for="ATCRecommendHeading" />
                <span asp-validation-for="ATCRecommendHeading"></span>
            </div>
        </div>
        @{ var selectList = Enum.GetValues(typeof(ATCRecommendType))
                                               .Cast<ATCRecommendType>()
                                               .Where(x => x != ATCRecommendType.Other)
                                               .Select(x => new SelectListItem
                                               {
                                                   Text = x.ToString(),
                                                   Value = ((int)x).ToString()
                                               })
                                               .ToList();

            var finalSelectList = new SelectList(selectList, "Value", "Text", Model.ATCRecommendTypeId); }
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="ATCRecommendTypeId" />
            </div>
            <div class="col-md-9">
                <nop-select asp-for="ATCRecommendTypeId" asp-items="finalSelectList" />
                <span asp-validation-for="ATCRecommendTypeId"></span>
            </div>
        </div>

    </div>
</div>
