@model Nop.Web.Areas.Admin.Models.Customization.Catalog.VariantModel

<form asp-controller="Product" asp-action="VariantEdit" method="post">

    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Catalog.VariantUpdate.Hint")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Edit" asp-route-id="@Model.ProductId">@T("admin.catalog.products.productattributes.attributes.backtoproduct")</a>
            </small>
        </h1>
        <div class="float-right">

            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div> 
    <input type="hidden" id="ProductId" name="ProductId" value="@Model.ProductId"/>
    <div class="content-header clearfix">
       
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Title" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Title" />
                <span asp-validation-for="Title"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="SeName" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="SeName" />
                <span asp-validation-for="SeName"></span>
            </div>
        </div>

  

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Msrp" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Msrp" />
                <span asp-validation-for="Msrp"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="OldPrice" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="OldPrice" />
                <span asp-validation-for="OldPrice"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Price" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Price" />
                <span asp-validation-for="Price"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="WgsRequired" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="WgsRequired" />
                <span asp-validation-for="WgsRequired"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="EnableSurcharge" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="EnableSurcharge" />
                <span asp-validation-for="EnableSurcharge"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="EstimatedDeliveryDate" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="EstimatedDeliveryDate" />
                <span asp-validation-for="EstimatedDeliveryDate"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="QueryParameter" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="QueryParameter" />
                <span asp-validation-for="QueryParameter"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Weight" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Weight" />
                <span asp-validation-for="Weight"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="ManufacturerPartNumber" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ManufacturerPartNumber" />
                <span asp-validation-for="ManufacturerPartNumber"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="EstimatedDeliveryDate" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="EstimatedDeliveryDate" />
                <span asp-validation-for="EstimatedDeliveryDate"></span>
            </div>
        </div>

        <div class="form-group row">
            <div class="col-sm-3">
                <nop-label asp-for="DimensionPictureId" />
            </div>
            <div class="col-sm-9">
                <div class="attribute-picture-selection-block clearfix">
                    <div class="form-check">
                        <label class="form-check-label">
                            <input class="form-check-input" type="radio" name="@Html.NameFor(x => x.DimensionPictureId)" value="0" id="id_image_0"
                                   @if (Model.DimensionPictureId == 0) { <text> checked="checked" </text> }>
                            @T("Admin.Catalog.Products.ProductAttributes.Attributes.Values.Fields.Picture.NoPicture")
                        </label>
                    </div>
                    @foreach (var picture in Model.ProductPictureModels)
                    {
                        <div class="form-check">
                            <label class="form-check-label">
                                <input class="form-check-input" type="radio" name="@Html.NameFor(x => x.DimensionPictureId)" value="@picture.PictureId" id="id_image_@picture.PictureId"
                                       @if (picture.PictureId == Model.DimensionPictureId) { <text> checked="checked" </text> }>
                                <img src="@picture.PictureUrl" alt="" title="" width="75" class="mb-1">
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="DimensionPictureId"></span>
            </div>
        </div>

    </div>
    <div class="card-footer">
        <button type="submit" name="save" class="btn btn-primary">
            <i class="far fa-save"></i>
            @T("Admin.Common.Save")
        </button>
    </div>

</form>