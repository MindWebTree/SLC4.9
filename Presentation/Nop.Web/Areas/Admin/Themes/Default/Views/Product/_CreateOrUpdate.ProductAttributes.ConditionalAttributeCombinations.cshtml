                // --- C. SMART MANAGER RENDER FUNCTION ---
                function renderSmartSwatches(blueprint) {
                    if (!blueprint || blueprint.length === 0) return;

                    let html = '';
                    blueprint.forEach(attr => {
                        html += `<div class="swatch-row" data-mapping-id="${attr.AttributeMappingId}">`;
                        html += `  <div class="swatch-row-label">${attr.Name}</div>`;
                        html += `  <div class="swatch-group">`;
                        attr.Values.forEach(val => {
                            html += `    <button type="button" class="smart-swatch"
                                            data-mapping-id="${attr.AttributeMappingId}"
                                            data-value-id="${val.ValueId}">
                                            ${val.Name}
                                         </button>`;
                        });
                        html += `  </div></div>`;
                    });
                    $('#smart-swatch-grid').html(html);
                }


                // ==========================================
// THE SMART JAVASCRIPT "BRAIN"
// ==========================================

// --- State Management ---
let currentSelection = {}; // Stores { mappingId: valueId }
let isGapMode = false;
let injectionTargetId = null;
let injectionPayload = {};

$(document).ready(function () {

    // 1. THE CLICK LISTENER
    // Listens for clicks on any swatch button
    // 1. THE CLICK LISTENER
    $('#smart-swatch-grid').on('click', '.smart-swatch', function () {
        const $this = $(this);

        // 1. BLOCK CLICKS: If row is frozen or sequence-locked, do nothing
        if ($this.hasClass('locked') || $this.hasClass('sequence-locked')) return;

        const mappingId = $this.data('mapping-id');
        const valueId = $this.data('value-id');
        const isActuallyDisabled = $this.hasClass('disabled');

        // GAP MODE TOGGLE: Cancel if clicking the same active swatch
        if (isGapMode && $this.hasClass('active')) {
            resetSmartManager();
            return;
        }

        // 2. SELECTION: Handle Radio Button behavior
        $this.closest('.swatch-row').find('.smart-swatch').removeClass('active');
        $this.addClass('active');
        currentSelection[mappingId] = valueId;

        // 3. CASCADING RESET: Wipe lower rows
        const $currentRow = $this.closest('.swatch-row');
        const clickedRowIndex = $('.swatch-row').index($currentRow);

        $('.swatch-row').each(function (index) {
            if (index > clickedRowIndex) {
                const lowerMappingId = $(this).data('mapping-id');
                delete currentSelection[lowerMappingId];
                $(this).find('.smart-swatch').removeClass('active locked');
            }
        });

        // 4. RE-EVALUATE: Run the dependency engine to gray out rows that don't match
        // This will now correctly disable Configuration 1 if Medium is selected.
        evaluateDependencies();

        // 5. GRID VS GAP MODE
        if (isActuallyDisabled) {
            triggerGapMode($this);
        } else {
            isGapMode = false;
            $('#smart-action-panel').slideUp();
            updateGridFilter(); // Refresh the grid
        }
    });

    // 2. THE SUBMIT ACTION (AJAX POST)
$('#btn-smart-submit').on('click', function() {
        const $btn = $(this);
        $btn.prop('disabled', true);

        if (injectionTargetId !== null) {
            // --- INJECTION MODE (Keeps using our custom endpoint) ---
            const postData = {
                TargetCombinationId: injectionTargetId,
                AttributesToInjectJson: JSON.stringify(injectionPayload)
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false, type: "POST", data: postData,
                url: "@(Url.Action("InjectAttributeValue", "Product"))",
                success: function (res) {
                    if (res.success)
                    {
                        refreshSmartInjectorData();
                        resetSmartManager();
                    }
                    else { alert(res.message); $btn.prop('disabled', false); }
                },
                error: function () { alert("Error"); $btn.prop('disabled', false); }
            });

        } else {
            // ================================================================
            // --- CREATE NEW MODE (Using EXISTING nopCommerce Endpoint!) ---
            // ================================================================

            let selectedGalleryPics = [];
            $('.gallery-checkbox:checked').each(function () {
                selectedGalleryPics.push($(this).val());
            });

            const postData = {
                productId: currentProductId,
                StockQuantity: $('#smart-stock').val(),
                AllowOutOfStockOrders: $('#smart-allow-out-of-stock').val() === 'true',
                NotifyAdminForQuantityBelow: $('#smart-notify-qty').val(),
                PictureId: $('input[name="smart-picture-id"]:checked').val(),
                GalleryPictures: selectedGalleryPics,
                Sku: $('#smart-sku').val(),
                ManufacturerPartNumber: $('#smart-mpn').val(),
                Gtin: $('#smart-gtin').val(),
                OverriddenPrice: $('#smart-price').val() || null,
                OverriddenMsrp: $('#smart-msrp').val() || null
            };

            // CRITICAL: Format the attributes exactly how the C# IFormCollection expects them
            for (const [mappingId, valueId] of Object.entries(currentSelection)) {
                postData[`product_attribute_${mappingId}`] = valueId;
            }

            addAntiForgeryToken(postData);

            $btn.text('Creating...');

            $.ajax({
                cache: false,
                type: "POST",
                data: postData,
                // Point straight to the existing C# action
                url: "@(Url.Action("ProductCustomAttributeCombinationCreatePopup", "Product"))",
                success: function (response) {
                    // Because this endpoint returns an HTML view, we look for the success script
                    if (response.includes("RefreshPage") || response.includes("window.close()")) {
                        // Success! Reload the page to update the grid and our JS memory
                        refreshSmartInjectorData();
                        resetSmartManager();
                    } else {
                        // If there is no success script, it means the C# hit a warning
                        // (e.g., combination already exists, missing values)
                        alert("Creation failed. A combination with these exact attributes might already exist, or a required value is missing.");
                        $btn.text('Create New Combination').prop('disabled', false);
                    }
                },
                error: function () {
                    alert("A server error occurred during creation.");
                    $btn.text('Create New Combination').prop('disabled', false);
                }
            });
        }
    });

    function handleSuccess(response, $btn) {
        if (response.success) {
            // Force a hard refresh of the page to rebuild the Master List!
            location.reload();
        } else {
            alert("Error: " + response.message);
            $btn.prop('disabled', false);
        }
    }
    function handleError($btn) {
        alert("A critical error occurred.");
        $btn.prop('disabled', false);
    }
});
                $(document).ajaxComplete(function (event, xhr, settings) {
