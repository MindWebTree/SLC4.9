 function refreshSmartInjectorData() {
    $.ajax({
        cache: false,
        type: "GET",
        url: "@Url.Action("GetLatestSmartInjectorData", "Product", new { productId = Model.Id })",
        success: function (data) {
            if (data) {
                let rawList = data.logicMasterListJson || data.logicMasterList || data.LogicMasterListJson;

                window.logicMasterList = typeof rawList === "string"
                    ? JSON.parse(rawList)
                    : (rawList || []); 

                let rawBlueprint = data.fullAttributeDefinitionsJson || data.fullAttributeDefinitions || data.FullAttributeDefinitionsJson;

                const newBlueprint = typeof rawBlueprint === "string"
                    ? JSON.parse(rawBlueprint)
                    : (rawBlueprint || []);

                if (newBlueprint.length > 0) {
                    renderSmartSwatches(newBlueprint);
                }
                let rawPictures = data.availablePicturesJson || data.availablePictures;
                renderPictureGalleries(rawPictures);
                evaluateDependencies();

                updateGridFilter();
            }
        },
        error: function () {
            console.error("Failed to refresh data: Server unreachable or error in Controller.");
        }
    });
}
                $(document).ajaxComplete(function (event, xhr, settings) {

                    if (settings.url.includes("/ProductAttributeCombinationList") || settings.url.includes("/ProductPictureList")) {

                        refreshSmartInjectorData();

                    }

                });
                // ==========================================
// CORE ALGORITHMS & LOGIC FUNCTIONS
// ==========================================

// --- A. The Dependency Engine ---
                function evaluateDependencies() {
                    // 1. Reset visual states
                    $('.smart-swatch').removeClass('disabled sequence-locked');
                    $('.swatch-row').removeClass('sequence-locked');

                    const $rows = $('.swatch-row');
                    const selectedMappingIds = Object.keys(currentSelection);

                    // TRACKER: The first row is always satisfied to begin with
                    let previousRowSatisfied = true;

                    $rows.each(function (index) {
                        const $currentRow = $(this);
                        const currentRowMappingId = $currentRow.data('mapping-id');

                        // --- NEW: SEQUENCE LOCK LOGIC ---
                        if (!previousRowSatisfied) {
                            $currentRow.addClass('sequence-locked');
                            $currentRow.find('.smart-swatch').addClass('sequence-locked');
                        }

                        // Check if THIS row has a selection to satisfy the NEXT row
                        const hasActiveSelection = $currentRow.find('.smart-swatch.active').length > 0;

                        // --- EXISTING: GLOBAL INTERSECTION LOGIC ---
                        const matchingRowsInDb = window.logicMasterList.filter(dbRow => {
                            for (const mId of selectedMappingIds) {
                                if (mId == currentRowMappingId) continue;
                                if (dbRow.Attributes[mId] != currentSelection[mId]) {
                                    return false;
                                }
                            }
                            return true;
                        });

                        const validValueIds = matchingRowsInDb.map(r => r.Attributes[currentRowMappingId]);

                        $currentRow.find('.smart-swatch').each(function () {
                            const btnValueId = $(this).data('value-id');

                            if (currentSelection[currentRowMappingId] == btnValueId) {
                                $(this).removeClass('disabled');
                                return;
                            }

                            const existsInDb = validValueIds.some(v => v == btnValueId);
                            if (!existsInDb) {
                                $(this).addClass('disabled');
                            }
                        });

                        // Update the tracker for the next iteration
                        previousRowSatisfied = hasActiveSelection;
                    });
                }

// --- B. Trigger Gap Mode (The Freeze) ---
                function triggerGapMode($clickedSwatch) {
                    isGapMode = true;
                    const $currentRow = $clickedSwatch.closest('.swatch-row');
                    const clickedRowIndex = $('.swatch-row').index($currentRow);

                    // 1. Lock only rows ABOVE the current selection
                    $('.swatch-row').each(function (index) {
                        if (index < clickedRowIndex) {
                            $(this).find('.smart-swatch').addClass('locked');
                        } else if (index > clickedRowIndex) {
                            // Ensure lower rows are NOT locked yet, just ready for input
                            $(this).find('.smart-swatch').removeClass('locked active');
                        }
                    });

                    // 2. Show the injection/creation panel
                    $('#smart-action-panel').slideDown();

                    // 3. Re-evaluate if the full combination is ready
                    evaluateSequenceCompletion();
                }

                function evaluateSequenceCompletion() {
                    const totalRows = $('.swatch-row').length;
                    const selectedRows = Object.keys(currentSelection).length;

                    if (selectedRows < totalRows) {
                        $('#btn-smart-submit').prop('disabled', true).text('Complete Sequence...');
                        return;
                    }

                    // --- NEW: Identify if the user is on a brand new path ---
                    // If any selected swatch has the 'disabled' class, this is NOT an injection
                    let isNewCombination = false;
                    $('.smart-swatch.active').each(function () {
                        if ($(this).hasClass('disabled')) {
                            isNewCombination = true;
                        }
                    });

                    injectionTargetId = null;
                    injectionPayload = {};

                    // Only search for a subset match if we are NOT on a brand new path
                    if (!isNewCombination) {
                        for (const dbRow of window.logicMasterList) {
                            let isSubsetMatch = true;
                            for (const [dbMapId, dbValId] of Object.entries(dbRow.Attributes)) {
                                if (currentSelection[dbMapId] != dbValId) {
                                    isSubsetMatch = false;
                                    break;
                                }
                            }

                            if (isSubsetMatch) {
                                injectionTargetId = dbRow.CombinationId;
                                injectionPayload = Object.assign({}, currentSelection);
                                for (const mapId of Object.keys(dbRow.Attributes)) {
                                    delete injectionPayload[mapId];
                                }
                                break;
                            }
                        }
                    }

                    // --- Update UI Panel ---
                    const $submitBtn = $('#btn-smart-submit');
                    $submitBtn.prop('disabled', false);

                    if (injectionTargetId !== null) {
                        // INJECTION MODE (Existing Base Found)
                        $('#action-panel-message').html(`<span style="color:green;"><i class="fas fa-check-circle"></i> Smart Match Detected!</span> Injecting into ID: ${injectionTargetId}.`);
                        $('#full-creation-inputs').slideUp();
                        $submitBtn.text('Inject Attributes').addClass('btn-inject').removeClass('btn-primary');
                    } else {
                        // CREATION MODE (Brand New Combination)
                        $('#action-panel-message').html(`<span style="color:#007bff;"><i class="fas fa-plus-circle"></i> New Combination Detected.</span> Please fill out the inventory details.`);
                        $('#full-creation-inputs').slideDown();
                        $submitBtn.text('Create New Combination').addClass('btn-primary').removeClass('btn-inject');
                    }
                }

// --- D. Reset Function ---
function resetSmartManager() {
    isGapMode = false;
    currentSelection = {};
    injectionTargetId = null;
    injectionPayload = {};

    $('.smart-swatch').removeClass('active disabled locked');
    $('#smart-action-panel').slideUp();
    $('#btn-smart-submit').text('Complete Sequence').prop('disabled', true).removeClass('btn-inject');
    $('#standard-inventory-inputs').show();
}

                // --- D. STANDARD DATATABLES RENDERERS ---
                function renderProductAttributeCheckbox(data, type, row) {
                    return `<input type="checkbox" class="select-checkbox" value="${row.Id}" />`;
                }
                function renderProductAttributesCombinationsColumnPrice(data, type, row, meta) {
                    return (data) ? Number.parseFloat(data).toFixed(2) : '';
                }
                function renderProductAttributesCombinationsColumnAttributesXml(data, type, row, meta) {
                    var warnings = (row.Warnings != null) ? '<div><span style="color: red">' + row.Warnings + '</span></div>' : '';
                    return row.AttributesXml + warnings;
                }
                function renderProductAttributesCombinationsColumnEdit(data, type, row, meta) {
                    return '<button onclick=\"javascript:OpenWindow(\'@Url.Content("~/Admin/Product/ProductCustomAttributeCombinationEditPopup/")' + data + '?btnId=btnRefreshCombinations&formId=product-form\', 800, 700, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
                }
                $(document).on("click", "#select-all", function () {
                    $(".select-checkbox").prop("checked", this.checked);
                    console.log("hello");
                });
                $(document).on("click", ".select-checkbox", function () {
                    let total = $(".select-checkbox").length;
                    let checked = $(".select-checkbox:checked").length;
                    $("#select-all").prop("checked", total === checked);
                    console.log("hello");
                });

                // --- D. Reset Function ---
                function resetSmartManager() {
                    // 1. Wipe JavaScript Memory
                    isGapMode = false;
                    currentSelection = {};
                    injectionTargetId = null;
                    injectionPayload = {};

                    // 2. Wipe UI states
                    $('.smart-swatch').removeClass('active disabled locked sequence-locked');
                    $('#smart-action-panel').slideUp();
                    $('#btn-smart-submit').text('Processing...').prop('disabled', false).removeClass('btn-inject');

                    // 3. Clear Grid Filter and Reload
                    $('#validCombinationIds').val(""); // Empty string means "Show All"
                    $("#customattributecombinations-grid").DataTable().ajax.reload();

                    // 4. Re-run dependencies to set the board back to its default starting state
                    if (typeof evaluateDependencies === "function") {
                        evaluateDependencies();
                    }
                }

                // Attach the click events to our new buttons!
                $(document).on('click', '#btn-smart-reset, #btn-smart-cancel', function () {
                    resetSmartManager();
                });

                setTimeout(function () {
                    evaluateDependencies();
                }, 200);

                function updateGridFilter() {
                    let filterValue = "";

                    // If something is selected, find the matching Combination IDs
                    if (Object.keys(currentSelection).length > 0) {
                        const survivors = window.logicMasterList.filter(row => {
                            let isMatch = true;
                            for (const [mapId, valId] of Object.entries(currentSelection)) {
                                if (row.Attributes[mapId] != valId) {
                                    isMatch = false;
                                    break;
                                }
                            }
                            return isMatch;
                        }).map(row => row.CombinationId);

                        // If no combinations match this path, send [-1] so the grid shows "No Data"
                        filterValue = survivors.length > 0 ? JSON.stringify(survivors) : "[-1]";
                    }

                    // Update the hidden input that the DataTable uses as a filter parameter
                    $('#validCombinationIds').val(filterValue);

                    // Reload the grid
                    if ($.fn.DataTable.isDataTable('#customattributecombinations-grid')) {
                        $("#customattributecombinations-grid").DataTable().ajax.reload();
                    }
                }
            </script>
        </div> 
</div>

