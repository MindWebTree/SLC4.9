@model ProductModel

@inject IStoreService storeService

 
@inject ICustomizationFormSerivce _customizationFormService
@{
    var customizationFormTemplates = await _customizationFormService.GetAllProductCustomizationFormTemplatesAsync();
    var availableCustomizationFormTemplates = new List<SelectListItem>();
    availableCustomizationFormTemplates.Add(new SelectListItem()
    {
        Value = "0",
        Text = "Please select"
    });
    foreach (var customizationFormTemplate in customizationFormTemplates)
    {
        availableCustomizationFormTemplates.Add(new SelectListItem()
        {
            Text = customizationFormTemplate.Name,
            Value = customizationFormTemplate.Id.ToString()
        });
    }
    var stores = await storeService.GetAllStoresAsync();

    //resources for product tags input
    NopHtml.AppendCssFileParts("~/lib_npm/jquery-tageditor/jquery.tag-editor.css");
    NopHtml.AppendScriptParts(ResourceLocation.Head,"~/lib_npm/jquery-tageditor/jquery.tag-editor.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head,"~/lib_npm/jquery-tageditor/jquery.caret.min.js");
}




