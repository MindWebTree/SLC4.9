<style>
    .all-gallery-picture {
        border: 1px solid #ced4da;
        max-width: 12.3% !important;
        display: inline-block;
        margin: 35px;
        margin-left: 0px;
        margin-top: 0px;
    }

    .checkmark {
        position: absolute;
        right: 4px;
        background: #fff;
        display: none;
        top: 4px;
        border: 1px solid #ced4da;
        border-radius: 100%;
        font-size: 10px;
    }

    .image-container,
    .uploaded-image {
        position: relative;
    }

    .selected .checkmark {
        display: block;
    }

    .delete-icon {
        position: absolute;
        right: -10px;
        top: -10px;
        border: 1px solid #ced4da;
        border-radius: 100%;
        width: 20px;
        padding: 0;
        height: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 20px;
        line-height: 20px;
        font-family: sans-serif;
        background: #fff;
        cursor: pointer;
    }

    #selected_image img.default-image {
        display: block;
    }

    #selected_image img.selected-image {
        display: none;
    }
</style>

