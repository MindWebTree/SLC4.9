    },
    new ColumnProperty(nameof(ProductPictureModel.DisplayOrder))
    {
    Title = T("Admin.Catalog.Products.Pictures.Fields.DisplayOrder").Text,
    Width = "150",
    ClassName = NopColumnClassDefaults.CenterAll,
    },
    new ColumnProperty(nameof(ProductPictureModel.OverrideAltAttribute))
    {
    Title = T("Admin.Catalog.Products.Pictures.Fields.OverrideAltAttribute").Text,
    Width = "200",
    },
    new ColumnProperty(nameof(ProductPictureModel.OverrideTitleAttribute))
    {
    Title = T("Admin.Catalog.Products.Pictures.Fields.OverrideTitleAttribute").Text,
    Width = "200",
    },
@*
    new ColumnProperty(nameof(ProductPictureModel.OverrideTitleAttribute))
    {
    Title = T("Admin.Catalog.Products.Pictures.Fields.OverrideTitleAttribute").Text,
    Width = "200",
    },
*@
new ColumnProperty(nameof(ProductPictureModel.DisplayOnCategoryPage))
{
Title = T("Admin.Catalog.Products.Pictures.Fields.DisplayOnCategoryPage").Text,
Width = "200",
},
new ColumnProperty(nameof(ProductPictureModel.DisplayOnListingModules))
{
Title = T("Admin.Catalog.Products.Pictures.Fields.DisplayOnListingModules").Text,
Width = "200",
},
new ColumnProperty(nameof(ProductPictureModel.HideOnProductPage))
{
Title = T("Admin.Catalog.Products.Pictures.Fields.HideOnProductPage").Text,
Width = "200",
},  new ColumnProperty(nameof(ProductPictureModel.IsDimensionImage))
    {
    Title = T("Admin.Catalog.Products.Pictures.Fields.IsDimensionImage").Text,
    Width = "200",
    },
new ColumnProperty(nameof(ProductPictureModel.Id))
{
Title = T("Admin.Common.Edit").Text,
Width = "200",
ClassName =  NopColumnClassDefaults.Button,
Render = new RenderCustom("renderColumnEdit"),
},
new ColumnProperty(nameof(ProductPictureModel.Id))
{
Title = T("Admin.Common.Delete").Text,
Width = "100",
Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
ClassName = NopColumnClassDefaults.Button
}
}
})

        <script>
            function renderPicturesColumnProductPictureUrl(data, type, row, meta) {
                return '<a href="' + row.PictureUrl + '" target="_blank"><img alt="' + row.PictureId + '" src="' + row.PictureUrl + '" width="150" /></a>';
            }
        </script>
        <div class="card card-default bulkuploadsection">
            <div class="card-header">
                @T("Admin.Catalog.Products.Bulk.Upload.Heading")
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <label class="col-form-label" for="AddPictureModel_PictureId">Upload</label>
                    </div>
                    <div class="col-md-5">
                        <input id="Images" type="file" multiple accept="image/*">
                    </div>
                    <div class="col-md-4">
                        <button type="button" id="bulk-upload-image" class="btn btn-primary">
                            @T("Admin.Catalog.Products.Bulk.Upload.Process.Button")
                        </button>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-12 response ">

                    </div>
                </div>
            </div>
            <script>

                //FormData object
                $(document).ready(function () {

                    function validateImageFile(fileName) {
                        extFile = fileName.substr(fileName.lastIndexOf(".") + 1, fileName.length).toLowerCase();
                        if (extFile == "jpg" || extFile == "jpeg" || extFile == "png" || extFile == "gif") {
                            return true;
                        }
                        return false;
                    }

                    $("#Images").on("change", function (val) {
                        var images = document.getElementById('Images');
                        for (i = 0; i < images.files.length; i++) {
                            if (!validateImageFile(images.files[i].name)) {
                                $('#Images').val('');
                                alert("Only Images file allowed!!!");
                            }
                        }
                    });

                    $("#bulk-upload-image").click(function () {
                        var formdata = new FormData();
                        var fileInput = document.getElementById('Images');
                        if (fileInput.files.length == 0) {
                            alert("Please upload images!!!");
                            return;
                        }
                        for (i = 0; i < fileInput.files.length; i++) {
                            formdata.append("Images[" + i + "]", fileInput.files[i]);
                        }

                        formdata.append('ProductId', @Model.Id);
                        formdata.append('producyType', "Product");
                        var tokenInput = $('input[name=__RequestVerificationToken]');
                        if (tokenInput.length) {
                            formdata.append("__RequestVerificationToken", tokenInput.val());
                        }
                        $.ajax({
                            url: "@(Url.Action("BulkUploadImages", "Common"))",
                            type: "POST",
                            contentType: false, // Not to set any content header
                            processData: false, // Not to process data
                            data: formdata,
                            async: false,
                            success: function (result) {
                                $('#Images').val('');
                                $(updateTable('#productpictures-grid'));
                                $(".bulkuploadsection .response").html('<div class="alert alert-success">' + result.Message+'</div>');
                            },
                            error: function (err) {
                                $(".bulkuploadsection .response").html('<div class="alert alert-danger ">' + err.statusText + '</div>');

                            }
                        });
                    });
                });
                function DeleteFile(Fileid, FileName) {
                    formdata.delete(FileName)
                    $("#" + Fileid).remove();
                    chkatchtbl();
                }
                function chkatchtbl() {
                    if ($('#FilesList tr').length > 1) {
                        $("#FilesList").css("visibility", "visible");
                    } else {
                        $("#FilesList").css("visibility", "hidden");
                    }
                }

                    function renderColumnEdit(data, type, row, meta) {
                        var editUrl = '@Url.Action("ProductPictureAddUpdatePopup", "Product", new {
                                      productId = Model.Id})';
                        var fullUrl = editUrl +'&id='+data+'\&btnId=btnRefreshProductPictures&formId=addUpdatePicture-form';
                        return '<button onclick="javascript:OpenWindow(\'' + fullUrl + '\', 800, 800, true); return false;" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
                }
            </script>
            @**@

            <script>
                $('#btnRefreshProductPictures').click(function () {
                    //refresh grid
                    $(updateTable('#productpictures-grid'));
                    //return false to don't reload a page
                    return false;
                });
            </script>

            @**@
        </div>
    }
    else
    {
        <div class="card card-default">
            <div class="card-body" id="product-pictures-area">
                @T("Admin.Catalog.Products.Pictures.SaveBeforeEdit")
            </div>
        </div>
    }
</div>
<nop-alert asp-alert-id="addProductPictureAlert" asp-alert-message="@T("Admin.Catalog.Products.Pictures.Alert.AddNew")" />
