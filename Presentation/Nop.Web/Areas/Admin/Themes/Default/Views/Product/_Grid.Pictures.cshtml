@model ProductModel

<div class="card-body">
    <div class="clearfix">
        <div class="float-left">
            <button type="submit" class="btn btn-primary" onclick="javascript:OpenWindow('@(Url.Action("ProductPictureAddUpdatePopup", "Product",new {productId=Model.Id})+
                "\\&btnId=btnRefreshProductPictures&formId=addUpdatePicture-form")', 800, 800, true); return false;">
                @T("Admin.Product.Picture.Add")
            </button>
            <button type="submit" id="btnRefreshProductPictures" style="display: none"></button>

        </div>
        <div class="float-right">
            <button type="submit" class="btn btn-primary" onclick="javascript:OpenWindow('@(Url.Action("PictureHistory", "Product", new {productId = Model.Id}))', 800, 800, true); return false;">
                @T("Admin.Product.Picture.History")
            </button>
        </div>
    </div>

    <div class="form-group row pt-2">
        <div class="col-md-2">
            <nop-label asp-for="ARImageUrl" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="ARImageUrl" />
            <span asp-validation-for="ARImageUrl"></span>
        </div>
    </div>

    <div class="form-group row pt-2">
        <div class="col-md-2">
            <nop-label asp-for="VideoUrl" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="VideoUrl" />
            <span asp-validation-for="VideoUrl"></span>
        </div>
    </div>
    <div class="form-group row pt-2">
        <div class="col-md-2">
            <nop-label asp-for="VideoThumnailDisplayOrder" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="VideoThumnailDisplayOrder" />
            <span asp-validation-for="VideoThumnailDisplayOrder"></span>
        </div>
    </div>
    @if (Model.Id > 0)
