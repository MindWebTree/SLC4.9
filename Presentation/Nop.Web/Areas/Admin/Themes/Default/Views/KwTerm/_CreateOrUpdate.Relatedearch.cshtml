@model KwTermModel
<div class="card-body">
    <p>
        @T("Admin.Catalog.Products.RelatedSearch.Hint")
    </p>
    @if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-body">

                @await Html.PartialAsync("Table", new DataTablesModel
           {
               Name = "RelatedSearch-grid",
               UrlRead = new DataUrl("RelatedSearchList", "Product",
               new RouteValueDictionary {[nameof(RelatedProductSearchModel.ProductId)]= Model.Id ,
                   [nameof(RelatedProductSearchModel.EntityType)]
               = "KwTerm" }),
               UrlDelete = new DataUrl("RelatedSearchDelete", "Product", null),
               UrlUpdate = new DataUrl("RelatedSearchUpdate", "Product", null),

               Length = 10,
               ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(RelatedSearchModel.TermName))
                            {
                                Title = T("Admin.Catalog.Products.RelatedSearchModel.Fields.TermName").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                              new ColumnProperty(nameof(RelatedSearchModel.Link))
                            {
                                Title = T("Admin.Catalog.Products.RelatedSearchModel.Fields.Link").Text,
                                Width = "200",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.String
                            },
                            new ColumnProperty(nameof(RelatedSearchModel.DisplayOrder))
                            {
                                Title = T("Admin.Catalog.Products.RelatedSearchModel.Fields.DisplayOrder").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Editable = true,
                                EditType = EditType.Number
                            },

                            new ColumnProperty(nameof(RelatedSearchModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "200",
                                ClassName =  NopColumnClassDefaults.Button,
                                Render = new RenderButtonsInlineEdit()
                            },
                            new ColumnProperty(nameof(RelatedSearchModel.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                Width = "100",
                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                ClassName = NopColumnClassDefaults.Button
                            }
                        }
           })
            </div>
            <div class="card-footer">
                <button type="submit" id="btnAddNewRelatedSearchProduct" class="btn btn-primary" onclick="javascript:OpenWindow('@(Url.Action("RelatedSearchAddPopup", "Product", new {entityId = Model.Id,entityType="KwTerm", btnId = "btnRefreshRelatedSearchProducts", formId = "KwTerm-form"}))', 800, 800, true); return false;">
                    @T("Admin.Catalog.Products.RelatedSearch.AddNew")
                </button>
                <button type="submit" id="btnRefreshRelatedSearchProducts" style="display: none"></button>
                <script>
                    $(document).ready(function () {
                        $('#btnRefreshRelatedSearchProducts').click(function () {
                            //refresh grid
                            updateTable('#RelatedSearch-grid');

                            //return false to don't reload a page
                            return false;
                        });
                    });
                </script>
            </div>
        </div>
    }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                @T("Admin.Catalog.Products.RelatedSearch.SaveBeforeEdit")
            </div>
        </div>
    }
</div>