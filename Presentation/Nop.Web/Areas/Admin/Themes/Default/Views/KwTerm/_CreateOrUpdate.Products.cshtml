@model KwTermModel

@if (Model.Id > 0)
{

    <div class="card-body">
        @await Html.PartialAsync("Table", new DataTablesModel
    {
    Name = "products-grid",
    UrlRead = new DataUrl("CustomProductList", "KwTerm", new RouteValueDictionary { [nameof(Model.KwTermProductSearchModel.KwTermId)] = Model.KwTermProductSearchModel.KwTermId }),
    UrlDelete = new DataUrl("ProductDelete", "KwTerm", null),
    UrlUpdate = new DataUrl("ProductUpdate", "KwTerm", null),
    Length = Model.KwTermProductSearchModel.PageSize,
    LengthMenu = Model.KwTermProductSearchModel.AvailablePageSizes,
    ColumnCollection = new List<ColumnProperty>
    {
        new ColumnProperty(nameof(KwTermProductModel.ProductId))
    {
    Title = T("Admin.Catalog.Categories.Products.Fields.ProductId").Text,
        Width = "100"
    },
        new ColumnProperty(nameof(KwTermProductModel.PictureThumbnailUrl))
    {
    Title = T("Admin.Catalog.Products.Fields.PictureThumbnailUrl").Text,
    Width = "100",
    Render = new RenderPicture()
    },
    new ColumnProperty(nameof(KwTermProductModel.ProductName))
    {
    Title = T("Admin.Catalog.Categories.Products.Fields.Product").Text,
     Width = "150"
    },
 
    new ColumnProperty(nameof(KwTermProductModel.DisplayOrder))
    {
    Title = T("Admin.Catalog.Categories.Products.Fields.DisplayOrder").Text,
    Width = "150",
    ClassName = NopColumnClassDefaults.CenterAll,
    Editable = true,
    EditType = EditType.Number
    },
    new ColumnProperty(nameof(KwTermProductModel.MobileDisplayOrder))
    {
    Title = T("Admin.Catalog.Categories.Products.Fields.MobileDisplayOrder").Text,
    Width = "150",
    ClassName = NopColumnClassDefaults.CenterAll,
    Editable = true,
    EditType = EditType.Number
    },
    new ColumnProperty(nameof(KwTermProductModel.ProductId))
    {
    Title = T("Admin.Common.View").Text,
    Width = "150",
    ClassName = NopColumnClassDefaults.Button,
    Render = new RenderButtonView(new DataUrl("~/Admin/Product/Edit/", nameof(KwTermProductModel.ProductId)))
    },
    new ColumnProperty(nameof(KwTermProductModel.Id))
    {
    Title = T("Admin.Common.Edit").Text,
    Width = "200",
    ClassName =  NopColumnClassDefaults.Button,
    Render = new RenderButtonsInlineEdit()
    },
    new ColumnProperty(nameof(KwTermProductModel.Id))
    {
    Title = T("Admin.Common.Delete").Text,
    Width = "100",
    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
    ClassName = NopColumnClassDefaults.Button
    }
    }
    })
    </div>
    <div class="card-footer">
        <button type="submit" id="btnAddNewProduct"
                onclick="javascript:OpenWindow('@(Url.Action("ProductAddPopup", "KwTerm", new { KwTermId = Model.Id, btnId = "btnRefreshProducts", formId = "KwTerm-form" }))', 800, 800, true); return false;"
                class="btn btn-primary">
            @T("Admin.Catalog.Categories.Products.AddNew")
        </button>
        <button type="submit" id="btnRefreshProducts" style="display: none"></button>
        <script>
            $(document).ready(function () {
                $('#btnRefreshProducts').click(function () {
                    //refresh grid
                    updateTable('#products-grid');

                    //return false to don't reload a page
                    return false;
                });
            });
        </script>
    </div>
}
else
{
    <div class="card-body">
        @T("Admin.Catalog.Categories.Products.SaveBeforeEdit")
    </div>
}

