@model KwTermModel

@if (Model.Id > 0)
{

    <div class="card-body">
        @await Html.PartialAsync("Table", new DataTablesModel
    {
    Name = "categories-grid",
    UrlRead = new DataUrl("CustomCategoryList", "KwTerm", new RouteValueDictionary { [nameof(Model.KwTermCategorySearchModel.KwTermId)] = Model.KwTermCategorySearchModel.KwTermId }),
    UrlDelete = new DataUrl("CategoryDelete", "KwTerm", null),
    UrlUpdate = new DataUrl("CategoryUpdate", "KwTerm", null),
    Length = Model.KwTermCategorySearchModel.PageSize,
    LengthMenu = Model.KwTermCategorySearchModel.AvailablePageSizes,
    ColumnCollection = new List<ColumnProperty>
    {
        new ColumnProperty(nameof(KwTermCategoryModel.CategoryId))
    {
    Title = T("Admin.Catalog.Categories.Products.Fields.CategoryId").Text,
        Width = "100"
    },
    new ColumnProperty(nameof(KwTermCategoryModel.CategoryName))
    {
    Title = T("Admin.Catalog.Categories.Products.Fields.CategoryName").Text,
     Width = "150"
    },
 
    new ColumnProperty(nameof(KwTermCategoryModel.DisplayOrder))
    {
    Title = T("Admin.Catalog.Categories.Products.Fields.DisplayOrder").Text,
    Width = "150",
    ClassName = NopColumnClassDefaults.CenterAll,
    Editable = true,
    EditType = EditType.Number
    },
    new ColumnProperty(nameof(KwTermCategoryModel.CategoryId))
    {
    Title = T("Admin.Common.View").Text,
    Width = "150",
    ClassName = NopColumnClassDefaults.Button,
    Render = new RenderButtonView(new DataUrl("~/Admin/Category/Edit/", nameof(KwTermCategoryModel.CategoryId)))
    },
    new ColumnProperty(nameof(KwTermCategoryModel.Id))
    {
    Title = T("Admin.Common.Edit").Text,
    Width = "200",
    ClassName =  NopColumnClassDefaults.Button,
    Render = new RenderButtonsInlineEdit()
    },
    new ColumnProperty(nameof(KwTermCategoryModel.Id))
    {
    Title = T("Admin.Common.Delete").Text,
    Width = "100",
    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
    ClassName = NopColumnClassDefaults.Button
    }
    }
    })
    </div>
    <div class="card-footer">
        <button type="submit" id="btnAddNewCategory"
                onclick="javascript:OpenWindow('@(Url.Action("CategoryAddPopup", "KwTerm", new { KwTermId = Model.Id, btnId = "btnRefreshCategories", formId = "KwTerm-form" }))', 800, 800, true); return false;"
                class="btn btn-primary">
            @T("Admin.Catalog.Categories.AddNew")
        </button>
        <button type="submit" id="btnRefreshCategories" style="display: none"></button>
        <script>
            $(document).ready(function () {
                $('#btnRefreshCategories').click(function () {
                    //refresh grid
                    updateTable('#categories-grid');

                    //return false to don't reload a page
                    return false;
                });
            });
        </script>
    </div>
}
else
{
    <div class="card-body">
        @T("Admin.Catalog.Categories.SaveBeforeEdit")
    </div>
}

