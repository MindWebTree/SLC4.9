@* @model ProductInfoModel
@if (Model.Products.Count > 0)
{
   
     var item=Model.Products.FirstOrDefault();   
  
    if(Model.ModuleType=="InStock"){

        <tr>
            <td style="padding: 0;text-align: center;font-size: 0;">
                <div class="column" style="width: 100%;max-width: 373px;display: inline-block; vertical-align: top;vertical-align: middle;">
                    <table width="100%" style="border-spacing: 0;font-family: sans-serif;color: #333333;">
                        <tr>
                            <td style="padding: 20px;">
                                <a style="color: black;text-decoration: none;"
                                   href="https://www.sierralivingconcepts.com@(Url.RouteUrl("Product", new {id=item.Id, SeName = item.SeName }))?utm_source=Mailer&amp;utm_medium=Email&amp;utm_campaign=backinstock">
                                    <img src="@item.DefaultPictureModel.ImageUrl" width="100%" style="border: 0;" />
                                </a>
                            </td>
                        </tr>
                    </table>
                </div>
                <div style="width: 100%;max-width: 373px;display: inline-block; vertical-align: top;vertical-align: middle;">
                    <table width="100%" style="border-spacing: 0;font-family: sans-serif;color: #333333;">
                        <tr>
                            <td align="center" style="padding: 10px 30px;">
                                <a style="color: black;text-decoration: none;" href="https://www.sierralivingconcepts.com@(Url.RouteUrl("Product", new {id=item.Id, SeName = item.SeName }))?utm_source=Mailer&amp;utm_medium=Email&amp;utm_campaign=backinstock">
                                    <h3 style="text-align: left;font-family:Arial, Helvetica, sans-serif; color:#626362;font-size:18px; font-weight:normal;">
                                        @item.Name
                                    </h3>
                                </a>

                                <div style="margin-top:5px;margin-left:10px;">
                                    @if (item.ProductPrice.IsVariantProduct)
                                    {
                                        @if (!string.IsNullOrEmpty(item.ProductPrice.MinMembershipPrice))
                                        {
                                            <h4 style="line-height:0;margin: 30px 0 25px 0;text-align: left;font-family:Arial, Helvetica, sans-serif; color:#626362;font-size:18px; font-weight:normal">
                                                @T("Label.RegularPrice")
                                                @T("Price.Range",
                                !string.IsNullOrEmpty(item.ProductPrice.MinOldPrice) ? item.ProductPrice.MinOldPrice : item.ProductPrice.MinPrice,
                                !string.IsNullOrEmpty(item.ProductPrice.MaxOldPrice) ? item.ProductPrice.MaxOldPrice : item.ProductPrice.MaxPrice)
                                            </h4>
                                            <h5 style="text-align: left;font-family:Arial, Helvetica, sans-serif; color:#444444;font-size:22px; font-weight:normal;line-height:0;">
                                                @T("Label.MembershipPrice")
                                                @T("Price.Range",item.ProductPrice.MinMembershipPrice,item.ProductPrice.MaxMembershipPrice)
                                            </h5>
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrEmpty(item.ProductPrice.MinMsrp))
                                            {
                                                <h4 style="line-height:0;margin: 30px 0 25px 0;text-align: left;font-family:Arial, Helvetica, sans-serif; color:#626362;font-size:18px; font-weight:normal">@T("Label.ListPrice") @T("Price.Range",item.ProductPrice.MinMsrp,item.ProductPrice.MaxMsrp)</h4>
                                            }
                                            <h5 style="text-align: left;font-family:Arial, Helvetica, sans-serif; color:#444444;font-size:22px; font-weight:normal;line-height:0;">
                                                @T("Label.RegularPrice")   @T("Price.Range",
                                !string.IsNullOrEmpty(item.ProductPrice.MinOldPrice) ? item.ProductPrice.MinOldPrice : item.ProductPrice.MinPrice,
                                !string.IsNullOrEmpty(item.ProductPrice.MaxOldPrice) ? item.ProductPrice.MaxOldPrice : item.ProductPrice.MaxPrice)
                                            </h5>
                                        }
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(item.ProductPrice.MembershipPrice))
                                        {
                                            <h4 style="line-height:0;margin: 30px 0 25px 0;text-align: left;font-family:Arial, Helvetica, sans-serif; color:#626362;font-size:18px; font-weight:normal">@T("Label.RegularPrice")@(!string.IsNullOrEmpty(item.ProductPrice.OldPrice) ? item.ProductPrice.OldPrice : item.ProductPrice.Price)</h4>
                                            <h5 style="text-align: left;font-family:Arial, Helvetica, sans-serif; color:#444444;font-size:22px; font-weight:normal;line-height:0;">@T("Label.MembershipPrice")@item.ProductPrice.MembershipPrice</h5>
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrEmpty(item.ProductPrice.Msrp))
                                            {
                                                <h4 style="line-height:0;margin: 30px 0 25px 0;text-align: left;font-family:Arial, Helvetica, sans-serif; color:#626362;font-size:18px; font-weight:normal">@T("Label.ListPrice")@item.ProductPrice.Msrp</h4>
                                            }
                                            <h5 style="text-align: left;font-family:Arial, Helvetica, sans-serif; color:#444444;font-size:22px; font-weight:normal;line-height:0;">@T("Label.RegularPrice")@(!string.IsNullOrEmpty(item.ProductPrice.OldPrice) ? item.ProductPrice.OldPrice : item.ProductPrice.Price)</h5>
                                        }
                                    }
                                </div>
                             
                             
                                <div style="margin-top: 50px;">
                                    <a style="color: black;text-decoration: none;" href="https://www.sierralivingconcepts.com@(Url.RouteUrl("Product", new {id=item.Id, SeName = item.SeName }))?utm_source=Mailer&amp;utm_medium=Email&amp;utm_campaign=backinstock">
                                        <span style="background-color: #444444;color: #fff;padding: 9px 70px;display: inline-block;font-size: 17px;">BUY NOW</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </td>
        </tr>

   

    }


}

 *@