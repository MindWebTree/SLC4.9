@{
    Layout = "_AdminPopupLayout";
}
@model MWT.Plugin.Shipping.FixedByWeightByTotal.Models.MWTExpectedDeliveryDateModel
@{
    NopHtml.AddCssFileParts("~/Plugins/MWT.Shipping.FixedByWeightByTotal/Content/css/style.css");
}
<form asp-controller="MWTFixedByWeightByTotal" asp-action="EditExpectedDeliveryDatePopup"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Common.Edit")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
        </div>
    </div>

    <div class="content">
        <div class="form-horizontal">
            @await Html.PartialAsync("~/Plugins/MWT.Shipping.FixedByWeightByTotal/Views/_CreateOrUpdateExpectedDeliveryDate.cshtml", Model)
        </div>
    </div>
</form>