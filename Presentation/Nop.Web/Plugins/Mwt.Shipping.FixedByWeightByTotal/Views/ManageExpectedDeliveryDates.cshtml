@model MWT.Plugin.Shipping.FixedByWeightByTotal.Models.ConfigurationModel
@using Nop.Core
@using MWT.Plugin.Shipping.FixedByWeightByTotal.Models
@using Nop.Web.Framework.Models.DataTables
@{
    NopHtml.AddCssFileParts("~/Plugins/MWT.Shipping.FixedByWeightByTotal/Content/css/style.css");
}
@{
    Layout = "_AdminLayout";
}
<form asp-controller="MWTFixedByWeightByTotal" asp-action="ExpectedDeliveryDates" method="post" id="expecteddeliverydates-form">
        <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Catalog.Customform.Lead.Details")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a href="/Admin/MWTFixedByWeightByTotal/Configure">@T("MWT.Plugins.Shipping.FixedByWeightByTotal.BackToList")</a>
            </small>
        </h1>

    </div>
    <div class="row">
        <div class="text-center col-12">
            <button type="button" id="search-expecteddeliverydates-records" class="btn btn-primary btn-search">
                <i class="fas fa-search"></i>
                @T("Admin.Common.Search")
            </button>
        </div>
    </div>
    <div class="form-horizontal">
        <div class="card card-default card-search">
            <div class="card-body">
                <p>
                    <b>@T("MWT.Plugins.Shipping.FixedByWeightByTotal.ExpectedDeliveryDates.heading")</b>
                </p>
                @await Html.PartialAsync("Table", new DataTablesModel
                {
                Name = "expecteddeliveryDates-grid",
                UrlRead = new DataUrl("ExpectedDeliveryDates", "MWTFixedByWeightByTotal", null),
                UrlDelete = new DataUrl("DeleteExpectedDeliveryDate", "MWTFixedByWeightByTotal", null),
                Length = Model.PageSize,
                LengthMenu = Model.AvailablePageSizes,
                ColumnCollection = new List<ColumnProperty>
                {
                new ColumnProperty(nameof(MWTExpectedDeliveryDateModel.ZoneName))
                {
                Title = T("MWT.Plugins.Shipping.FixedByWeightByTotal.MWTExpectedDeliveryDate.ZoneName").Text,
                Width = "200",
                },
                new ColumnProperty(nameof(MWTExpectedDeliveryDateModel.CategoryIds))
                {
                Title = T("MWT.Plugins.Shipping.FixedByWeightByTotal.MWTExpectedDeliveryDate.CategoryIds").Text,
                Width = "200"
                },
                new ColumnProperty(nameof(MWTExpectedDeliveryDateModel.ProductIDs))
                {
                Title = T("MWT.Plugins.Shipping.FixedByWeightByTotal.MWTExpectedDeliveryDate.ProductIDs").Text,
                Width = "200"
                },
                new ColumnProperty(nameof(MWTExpectedDeliveryDateModel.ExpectedMinNoOfDays))
                {
                Title = T("MWT.Plugins.Shipping.FixedByWeightByTotal.MWTExpectedDeliveryDate.ExpectedMinNoOfDays").Text,
                Width = "200"
                },
                new ColumnProperty(nameof(MWTExpectedDeliveryDateModel.ExpectedMaxNoOfDays))
                {
                Title = T("MWT.Plugins.Shipping.FixedByWeightByTotal.MWTExpectedDeliveryDate.ExpectedMaxNoOfDays").Text,
                Width = "200"
                },
                new ColumnProperty(nameof(MWTShippingByWeightByTotalModel.Id))
                {
                Title = T("Admin.Common.Edit").Text,
                ClassName = NopColumnClassDefaults.Button,
                Width = "100",
                Render = new RenderCustom("renderColumnEdit")
                },
                new ColumnProperty(nameof(MWTShippingByWeightByTotalModel.Id))
                {
                Title = T("Admin.Common.Delete").Text,
                ClassName = NopColumnClassDefaults.Button,
                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                Width = "100"
                }
                }
                })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" id="btnAddNewRecord" class="btn btn-primary"
                    onclick="javascript:OpenWindow('@(Url.Action("AddExpectedDeliveryDatePopup", "MWTFixedByWeightByTotal", new {btnId = "btnRefresh", formId = "expecteddeliverydates-form"}))', 800, 800, true);return false;">
                @T("MWT.Plugins.Shipping.FixedByWeightByTotal.MWTExpectedDeliveryDate.AddRecord")
            </button>
            <button type="submit" name="save" id="btnRefresh" class="btn btn-default" style="display: none"></button>
        </div>
    </div>
    <script>
        $(document)
            .ready(function () {
                $('#btnRefresh')
                    .click(function () {
                        //refresh grid
                        updateTable('#expecteddeliveryDates-grid');

                        //return false to don't reload a page
                        return false;
                    });
            });
        function renderColumnEdit(data, type, row, meta) {
            return '<button onclick=\"javascript:OpenWindow(\'@Url.Action("EditExpectedDeliveryDatePopup", "MWTFixedByWeightByTotal")?id=' + data + '&btnId=btnRefresh&formId=expecteddeliverydates-form\', 800, 800, true); return false;\" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
        }
    </script>
</form>
