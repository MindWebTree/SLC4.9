
@model MWT.Plugin.Shipping.FixedByWeightByTotal.Models.MWTExpectedDeliveryDateModel
@using Nop.Web.Framework.Extensions

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
        catch (e){}
        window.close();
    </script>
}



<div class="cards-group">
    <div class="card card-default card-popup">
        <div class="card-body">
            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="ZoneID" />
                </div>
                <div class="col-sm-9">
                    <nop-select asp-for="ZoneID" asp-items="Model.AvailableZones" />
                    <span asp-validation-for="ZoneID"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="SelectedCategoryIds" />
                </div>
                <div class="col-sm-9">
                    <nop-select asp-for="SelectedCategoryIds" asp-items="Model.AvailableCategories" asp-multiple="true" />
                    <span asp-validation-for="SelectedCategoryIds"></span>
                    <script>
                        $(document).ready(function () {
                            // var categoryIdsInput = $('#@Html.IdFor(model => model.SelectedCategoryIds)').data("kendoMultiSelect");
                            // categoryIdsInput.setOptions({
                            //     autoClose: false,
                            //     filter: "contains"
                            // });
                            var $categorySelect = $('#@Html.IdFor(model => model.SelectedCategoryIds)');

                        // @if (Model.AvailableCategories.Count == 0)
                        // {
                        //     <text>
                        //             categoryIdsInput.setOptions({
                        //                 enable: false,
                        //                 placeholder: '@T("Admin.Catalog.Products.Fields.Categories.NoCategoriesAvailable")'
                        //             });
                        //         categoryIdsInput._placeholder();
                        //         categoryIdsInput._enable();
                        //     </text>
                        // }
                        // Select2 replacement for the old Kendo UI logic
                            @if (Model.AvailableCategories.Count == 0)
                            {
                                    <text>
                                        // Disable the dropdown and set a helpful placeholder message
                                        $categorySelect.prop('disabled', true);
                                        $categorySelect.empty().append('<option value="">@T("Admin.Catalog.Products.Fields.Categories.NoCategoriesAvailable")</option>');

                                        // Trigger Select2 to update its UI state
                                        if (typeof $.fn.select2 !== 'undefined') {
                                            $categorySelect.trigger('change');
                                        }
                                    </text>
                            }
                                    });
                    </script>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="ProductIDs" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="ProductIDs"  />
                    <span asp-validation-for="ProductIDs"></span>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="ExpectedMinNoOfDays" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="ExpectedMinNoOfDays" />
                    <span asp-validation-for="ExpectedMinNoOfDays"></span>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="ExpectedMaxNoOfDays" />
                </div>
                <div class="col-sm-9">
                    <nop-editor asp-for="ExpectedMaxNoOfDays" />
                    <span asp-validation-for="ExpectedMaxNoOfDays"></span>
                </div>
            </div>
          </div>
    </div>
</div>
