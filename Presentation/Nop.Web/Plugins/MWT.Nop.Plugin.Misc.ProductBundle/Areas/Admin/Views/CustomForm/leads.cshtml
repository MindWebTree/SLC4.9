 
@model CustomFormSearchModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Catalog.Customform.Leads").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Custom Forms");
}



<form asp-controller="CustomForm" asp-action="index" method="post" id="CustomForms-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Catalog.Customform.Leads")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="index">@T("Admin.Catalog.Customforms.BackToList")</a>
            </small>
        </h1>
      
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">


                            @await Html.PartialAsync("Table", new DataTablesModel
                            {
                            Name = "customform-leads-grid",
                            UrlRead = new DataUrl("Leads", "CustomForm", null),
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                            new FilterParameter(nameof(Model.Id))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                            new ColumnProperty(nameof(CustomFormEntryModel.FormName))
                            {
                            Title = T("Admin.Catalog.CustomFormModel.Fields.Name").Text
                            },
                            new ColumnProperty(nameof(CustomFormEntryModel.CustomerName))
                            {
                            Title = T("Admin.Catalog.CustomFormModel.Fields.CustomerName").Text
                            },
                             new ColumnProperty(nameof(CustomFormEntryModel.Email))
                            {
                            Title = T("Admin.Catalog.CustomFormModel.Fields.Email").Text
                            },
                            new ColumnProperty(nameof(CustomFormEntryModel.CreatedOnUtc))
                            {
                            Title = T("Admin.Catalog.CustomFormEntryModel.Fields.CreatedOnUtc").Text,
                            Width = "150",
                            ClassName =  NopColumnClassDefaults.CenterAll
                            },
                            new ColumnProperty(nameof(CustomFormEntryModel.UpdatedOnUtc))
                            {
                            Title = T("Admin.Catalog.CustomFormEntryModel.Fields.UpdatedOnUtc").Text,
                            Width = "150",
                            ClassName =  NopColumnClassDefaults.CenterAll
                            } ,
                             new ColumnProperty(nameof(CustomFormModel.Id))
                            {
                            Title = T("Admin.Common.Lead.Details").Text,
                            Width = "100",
                            ClassName =  NopColumnClassDefaults.Button,
                            Render = new RenderCustom("renderColumnview")
                            }
                            }
                            })

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script>
        function renderColumnview(data, type, row, meta) {
            return '<a class="btn btn-default" href="/Admin/CustomForm/Leads/'+data+'/Details"><i class="far fa-eye"></i>View</a>';
       }
    </script>
</form>