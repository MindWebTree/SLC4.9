    @model  CustomFormModel
@inject Nop.Core.Domain.Security.CaptchaSettings _captchaSettings;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor _httpContextAccessor
@{

    bool isToTheTradeForm = string.Equals((_httpContextAccessor.HttpContext.Request.RouteValues["sename"] ?? "").ToString(), "to-the-trade", StringComparison.InvariantCultureIgnoreCase);

    var buttonId = $"btnsubmitcustomform-{Model.Id}";
    var formId = $"customform_form-{Model.Id}";
}
<div id="custom-form-section" class="@formId">
    <form id="@formId" method="post" class="customform_form">
        <input type="hidden" name="customform_id" value="@Model.Id" />
        @Html.Raw(Model.FormHtml)
        @if (Model.RenderActions)
        {
            <div class="error-section col-md-12 d-none">
                <span class="error"> </span>
            </div>
        }
        <div class="add-section captcha-button-wrapper">
            <div class="field">
                @if (_captchaSettings.Enabled && _captchaSettings.ShowOnContactUsPage)
                {
                    <div class="col-sm-6">
                        <div class="captcha">
                            <nop-captcha class="g-recaptcha" />
                        </div>
                    </div>
                }
                @if (Model.RenderActions)
                {
                    <div class="col-sm-6">
                        <button type="submit" id="@buttonId" name="submit">
                            <span>
                                @T("customform.button")
                            </span>
                            <svg width="20" height="20" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg" stroke="#4D585A" class="d-none" style=" width: 20px;">
                                <g fill="none" fill-rule="evenodd">
                                    <g transform="translate(1 1)" stroke-width="2">
                                        <circle stroke-opacity=".5" cx="18" cy="18" r="18"></circle>
                                        <path d="M36 18c0-9.94-8.06-18-18-18">
                                            <animateTransform attributeName="transform" type="rotate" from="0 18 18" to="360 18 18" dur="1s" repeatCount="indefinite"></animateTransform>
                                        </path>
                                    </g>
                                </g>
                            </svg>
                        </button>
                    </div>
                }
            </div>
        </div>
        
    </form>
</div>
<div class="modal fade" id="responseModel" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><span class="fas fa-times freeshippingbarclose">&nbsp;</span></button>
            <div class="modal-body">
            </div>

        </div>
    </div>
</div>
<script>
    if (typeof decodeHtml !== 'function') {
        function decodeHtml(html) {
            var txt = document.createElement("textarea");
            txt.innerHTML = html;
            return txt.value;
        }
    }
    var postUrl = '@Url.Action("SubmitCustomInquiry", "CustomForm")';
    window.addEventListener("load", function () {
        $("#@formId").validate();
        $('#@formId').on('submit', function (e) {
            e.preventDefault();
            $(".error-section").addClass("d-none");
            if ($("#@formId").valid()) {
                $("#@buttonId").prop('disabled', true);
                $("#@buttonId span").addClass("d-none");
                $("#@buttonId svg").removeClass("d-none");
                $.ajax({
                    url: postUrl,
                    type: "POST",
                    data: new FormData($("#@formId")[0]),
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        if (data.ErrorMessage == "") {

                            if (typeof gtag_TTT_report_conversion === "function" && '@isToTheTradeForm' == 'True') {
                                gtag_TTT_report_conversion();
                            }
                            $("#@buttonId").prop('disabled', false);
                            if (data.ThankYouPageLink != "") {
                                $("#custom-form-section").append("<div class=\"custom-form-section-response\" >@T("customform.common.thankyou.message")</div>");

                                setTimeout(function () {
                                    window.location = data.ThankYouPageLink;
                                }, 2000);
                            }
                            else {
                                if (!data.ShowInPopup)
                                    $("#@formId").html(
                                        $("<div>", { "class": "custom-form-section-response", "html": decodeHtml(data.ThankYouHtml) })
                                    );
                                else {

                                    $('#@formId')[0].reset();
                                    $("#responseModel .modal-body").html("<div class=\"custom-form-section-response\">" + data.ThankYouHtml + "</div>");
                                    $('#responseModel').modal('show');
                                }
                            }
                        }
                        else {

                            $(".error-section").removeClass("d-none");
                            $(".error-section span").html(data.ErrorMessage);
                        }
                        $("#@buttonId").prop('disabled', false);
                        $("#@buttonId span").removeClass("d-none");
                        $("#@buttonId svg").addClass("d-none");
                    }, error: function (xhr, status, error) {

                        $(".error-section").removeClass("d-none");
                        $(".error-section span").html(data.ErrorMessage);
                    }
                });
            }
        })





    });
</script>
