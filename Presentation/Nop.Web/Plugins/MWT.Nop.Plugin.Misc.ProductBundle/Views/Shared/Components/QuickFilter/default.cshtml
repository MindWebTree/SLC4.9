@model QuickFilterListModel

@if (Model.Filters.Count > 0)
{
    var currentUrl = (Context.Request?.Path ?? "").ToString() + Context.Request?.QueryString == null ? "" : Context.Request?.QueryString.ToString().ToLower();
    currentUrl = currentUrl.Replace("?", "");
    <div class="quick-filters-list">
        @foreach (var filter in Model.Filters)
        {
            var link = filter.Link.Split('?').Length > 1 ? filter.Link.Split('?')[1].ToLower() : "";
            bool isSelected = false;
            var counter = 0;
            foreach (var filterParam in link.Split('&'))
            {
                if (!isSelected && counter != 0)
                {
                    break;
                }
                counter++;

                var filterParamKeyvalue = filterParam.Split('=');
                if (filterParamKeyvalue.Length > 1)
                {
                    foreach (var queryParam in currentUrl.Split('&'))
                    {
                        if (string.Equals(filterParamKeyvalue[0].Trim(), queryParam.Split('=')[0], StringComparison.CurrentCultureIgnoreCase))
                        {
                            isSelected = true;
                            var filterParamvalues = filterParamKeyvalue[1].Replace("[", "").Replace("]", "").Split(',');

                            foreach (var filterParamValue in filterParamvalues)
                            {
                                if (queryParam.Replace("[", "").Replace("]", "").Split('=').Length > 1)
                                {
                                    if (!queryParam.Replace("[", "").Replace("]", "").Split('=')[1].Split(',').Contains(filterParamValue))
                                    {
                                        isSelected = false;
                                    }
                                }

                            }
                            break;
                        }
                        else
                        {
                            isSelected = false;
                        }
                    }
                }


            }
            <div class="category-breakouts__category @(isSelected ? "active" : "")">
                <a href="@filter.Link">
                    <p class="cmsBlack crate-bold renew__eyebrow tC">
                        @filter.TermName
                    </p><svg width="16" height="16" alt="@filter.TermName" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">

                        <path d="M12 4L4 12" stroke="white" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" />

                        <path d="M4 4L12 12" stroke="white" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" />

                    </svg>
                </a>
            </div>


        }
    </div>

}
