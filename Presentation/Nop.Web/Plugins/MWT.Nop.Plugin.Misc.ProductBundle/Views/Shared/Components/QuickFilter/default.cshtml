    function selectFilters(queryParams, isRemove) {

        queryParams.forEach(queryParam => {

            if (queryParam.key != "sortby") {
                if ($('[data-filter-name="' + queryParam.key + '"]').length > 0) {
                    var parentFilterId = $('[data-filter-name="' + queryParam.key + '"]').attr("id").replace("filter-btn-horizonatal-", "").replace('filter-btn-', '');
           
                    const filterOption = $('input[data-parent-filterid="' + parentFilterId + '"]').filter(function () {
                        return $(this).data('filter-name') === queryParam.value;
                    });

                    if (filterOption.length > 0) {
                        filterOption.prop('checked', isRemove);
                    }
                }
            }
            else {
                $('#products-orderby').val(queryParam.value);
            }
        });

       
        var elements = $('.popupfilter').length > 0 ? $('.popupfilter') : $(".filtercheckbox");
        console.log(elements);
        var isFilterSelected = false;
        $(elements).each(function () {
            var optionId = $(this).attr("popup-data-option-id");
         
            if (!optionId || typeof (optionId) == "undefined") {
                optionId = $(this).attr("data-option-id");
                
            }
           

            if ($("[data-option-id=" + optionId + "]")) {
                if ($(this).prop('checked') == true) {
                    if ($(".selectedFilters").find("button[data-option-id=\"" + optionId + "\"]").length == 0)
                        $(".inline-clear-all").after('<span class="selections"><button data-style="button" aria-label="" type="button" data-option-id="' + optionId + '" class="cta"><span class="selections-close">\u00D7</span> <span>' + $('label[for="attribute-option-' + optionId + '"]').contents().filter(function () {
                            return this.nodeType === Node.TEXT_NODE;
                        }).text() + '</span></button></span>');
                    isFilterSelected = true;
                    if (!$("[data-option-id=" + optionId + "]").hasClass("popupfilter")) {
                        if ($("[data-option-id=" + optionId + "]").prop('checked') != true) {
                            $("[data-option-id=" + optionId + "]").prop("checked", true);
                        }

                    }
                }
                else {
                    if ($(".selectedFilters").find("button[data-option-id=\"" + optionId + "\"]").length > 0)
                        $(".selectedFilters").find("button[data-option-id=\"" + optionId + "\"]").parent().remove();
                    if (  !$("[data-option-id=" + optionId + "]").hasClass("popupfilter")) {
                        if ($("[data-option-id=" + optionId + "]").prop('checked') == true) {
                            $("[data-option-id=" + optionId + "]").prop("checked", false);
                        }
                    }
                }
            }
        });

        if (isFilterSelected) {
            $(".inline-clear-all a").parent().parent().show();
            $(".filterDesktopIcon span").text($(".filterDesktopIcon span").attr("data-hidefilter-text"));
            $(".filterDesktopIcon").addClass("show");
        }
        else {
            $(".inline-clear-all a").parent().parent().hide();
           
        }

        $(".popupfilterheading button").click();
        // Load Filters
        CatalogProducts.getProducts();
    }
