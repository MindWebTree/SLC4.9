@model IList<CategoryModel.SubCategoryModel>
@if (Model.Count > 0)
{

    <div id="category-slider" class="slick-slider position-relative">
        @foreach (var item in Model)
        {
            <div class="category-card">
                <a href="@Url.RouteUrl("Category", new { SeName = item.SeName, id = item.Id })" title="@item.PictureModel.Title">
                    <div class="card">
                        <img alt="@item.PictureModel.AlternateText" class="card-img-top lazy" src="/images/pixel.png" data-src="@item.PictureModel.ImageUrl" title="@item.PictureModel.Title" />

                        <div class="card-body">
                            <h2 class="title">
                                <span class="card-title" title="@item.PictureModel.Title">
                                    @item.Name
                                </span>
                            </h2>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>


    <script asp-location="Footer">

        $(document).ready(function () {
            $('#category-slider').slick({
                slidesToShow: 6,
                slidesToScroll: 1,
                infinite: false,
                arrows: true,
                dots: false,
                autoplay: false,
                autoplaySpeed: 3000,
                speed: 800,
                cssEase: 'ease-in-out',

                responsive: [

                    {

                        breakpoint: 992,
                        settings: {
                            slidesToShow: 3,
                            arrows: true
                        }
                    },
                    {

                        breakpoint: 768,
                        settings: {
                            slidesToShow: 3,
                            arrows: true
                        }
                    },
                    {

                        breakpoint: 576,
                        settings: {
                            slidesToShow: 3,
                            slidesToScroll: 1,
                            arrows: true,
                            dots: true
                        }
                    }
                ]
            });
        });
    </script>
}

<style>
    .version1.categorypage-heading-section h1.page-heading {
        float: none;
    }

    .kwterm-categories-list #category-slider {
        margin-top: 30px;
        padding: 0 12px;
    }

        .kwterm-categories-list #category-slider .slick-list {
            padding: 0 !important;
        }

        .kwterm-categories-list #category-slider .slick-track {
            left: 0 !important;
        }

    .kwterm-categories-list .slick-prev:before {
        background: url(/images/uploaded/review-left-svg-image.svg);
        content: '';
        background-size: 32px;
        display: block;
        width: 32px;
        height: 32px;
        background-color: #fff !important;
        border-radius: 50px;
    }

    #category-slider a:focus:not(:focus-visible),
    #category-slider button:focus:not(:focus-visible) {
        outline: none;
        box-shadow: none;
    }

    .kwterm-categories-list .slick-next:before {
        background: url(/images/uploaded/review-sec-right-arrow.svg);
        content: '';
        background-size: 32px;
        display: block;
        width: 32px;
        height: 32px;
        position: relative;
        right: 13px;
        background-color: #fff !important;
        border-radius: 50px;
    }

    .kwterm-categories-list .card-body h2 {
        color: rgba(34, 34, 34, 1) !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        text-transform: uppercase;
        text-align: left;
        padding: 0 10px 0 0;
    }

    .kwterm-categories-list .card-body {
        padding: 10px 0 0 0;
    }

    #category-slider a:focus,
    #category-slider button:focus {
        outline: none !important;
        box-shadow: none !important;
    }

    .kwterm-categories-list .slick-slide img {
        border-radius: 0 !important;
    }

    .kwterm-categories-list .slick-slide {
        margin: 0 5px;
    }

    @@media all and (max-width:767px) {
        .kwterm-categories-list .slick-prev, .slick-next {
            z-index: 1;
        }

        .kwterm-categories-list .slick-next {
            right: 0;
        }

        .kwterm-categories-list .slick-prev {
            left: 0;
        }

        .kwterm-categories-list .card-body h2 {
            padding: 0;
        }
    }

</style>