@model Nop.Web.Models.Customer.PasswordRecoveryModel
@inject Nop.Core.Domain.Security.CaptchaSettings _captchaSettings;
<div class="modal fade cart-login-process" id="forgot-password-default" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Forgot Your Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 0L21 20" stroke="#010101" stroke-width="1.76757" stroke-miterlimit="10" />
                        <path d="M1 20L21 0" stroke="#010101" stroke-width="1.76757" stroke-miterlimit="10" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <p>Please enter your email address below. You will receive a link to reset your password.</p>
                <form id="forgotPasswordForm" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <input asp-for="Email" placeholder="Email" class="form-control" type="email" id="EmailReset" />
                        <div class="checkout-label">
                            <label asp-for="Email"></label>
                            <span class="required">*</span>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    @if (_captchaSettings.Enabled && _captchaSettings.ShowOnForgotPasswordPage)
                    {
                        <div class="form-group">
                            <div class="row">
                                <div class="col-12 col-sm-8 offset-md-4 offset-lg-4 offset-xl-4">
                                    <nop-captcha class="g-recaptcha" />
                                </div>
                            </div>
                        </div>
                    }
                    <!-- Reset Password Button -->
                    <button type="submit" class="btn btn-signin">@T("Account.PasswordRecovery.RecoverButton")</button>

                    <p class="response"></p>
                </form>
                <!-- Error message container -->
                <div class="errorMessage" class="text-danger"></div>
            </div>
        </div>
    </div>
</div>


<script asp-location="Footer">
    $(document).ready(function () {
        $('#forgotPasswordForm').on('submit', function (e) {
            e.preventDefault();
            $.validator.unobtrusive.parse($("#forgotPasswordForm"));
            $("#forgotPasswordForm").validate();
            if (!$("#forgotPasswordForm").valid())
                return;
            var token = $('input[name="__RequestVerificationToken"]').val();

               $.ajax({
                url: '@Url.Action("CustomPasswordRecoverySend", "CustomerExtended")',
                method: 'POST',
                data: $("#forgotPasswordForm").serialize(),
                headers: {
                    'RequestVerificationToken': token
                },
                   success: function (data) {
                   if (data.StatusCode == 200) {
                        $('.response').text(data.Result);
                        $(".errorMessage").html("");
                    }
                    else {
                        $('.errorMessage').text(data.Result);
                        $(".response").html("");
                    }

                },
                   error: function (xhr, status, error) {
                     
                    $('.errorMessage').text("@T("Common.Error")")
                   }
                   , complete: function () {
                       
                   }
            });
        });
    });
</script>
