@model MWT.Nop.Plugin.Misc.ProductBundle.Models.BundleConfigurationModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Nop.Web.Framework

@* Hidden fields for the 1:1 mapping *@
<input asp-for="BundleId" type="hidden" id="bundle-id-hidden" />
<input asp-for="ProductId" type="hidden" />
<input asp-for="VariantId" type="hidden" />

<div class="card card-default">
    <div class="card-header">
        <div class="card-title">
            <i class="fas fa-info-circle"></i>
            Bundle Information
        </div>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="callout callout-info">
            You are configuring a bundle for <strong>Product: @Model.ProductName</strong>
            @if (!string.IsNullOrEmpty(Model.VariantName))
            {
                <br />
                <span>Selected Variant: <strong>@Model.VariantName</strong></span>
            }
        </div>

        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Name" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        @* No Of Pieces Field *@
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="NoOfPieces" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="NoOfPieces" />
                <span asp-validation-for="NoOfPieces" class="text-danger"></span>

                @* This logic triggers when Model.Id > 0 *@
                <div class="mt-2">
                    <span id="save-name-status" class="text-success" style="display:none;">
                        <i class="fas fa-check"></i> Saved successfully!
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="DisplayOnProductPage" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="DisplayOnProductPage" />
                <span asp-validation-for="DisplayOnProductPage" class="text-danger"></span>
            </div>
        </div>
        
        <div class="card card-default mt-4">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-image"></i>
                    <nop-label asp-for="PictureId" />
                </div>
            </div>
            <div class="card-body">
                <div class="row">

                    <nop-editor asp-for="PictureId" />

                </div>
            </div>
        </div>
        @if (Model.Id > 0)
        {
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="CreatedOnUtc" />
                </div>
                <div class="col-md-9">
                    <div class="form-text-row">@Model.CreatedOnUtc</div>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="UpdatedOnUtc" />
                </div>
                <div class="col-md-9">
                    <div class="form-text-row">@Model.UpdatedOnUtc</div>
                </div>
            </div>
        }
    </div>
</div>
