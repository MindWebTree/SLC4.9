@model CustomCatalogProductsModel
@inject ICustomWorkContext _workContext
@inject ISettingService _settingService;
@inject ICustomCategoryService _categoryService
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Http
@inject Nop.Core.IWebHelper webHelper
@inject Nop.Core.IStoreContext _storeContext
@inject IHttpContextAccessor _httpContextAccessor
@{
    var currentUrl = $"{Url.RouteUrl("Category", new { id = Model.CategoryID, SeName = Model.Sename }, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant()}";
    var queryString = _httpContextAccessor.HttpContext.Request.Query;
    var validQueryString = string.Empty;
    foreach (var query in queryString)
    {
        if (!string.IsNullOrEmpty(query.Key) && !string.Equals(query.Key, "categoryid", StringComparison.InvariantCultureIgnoreCase)
          && !string.Equals(query.Key, "openTabs", StringComparison.InvariantCultureIgnoreCase)
          && !string.Equals(query.Key, "popupOpenTabs", StringComparison.InvariantCultureIgnoreCase) && !string.Equals(query.Key, "_", StringComparison.InvariantCultureIgnoreCase)
          && !string.IsNullOrEmpty(query.Value))
        {
            validQueryString += (validQueryString == "" ? "?" : "&") + query.Key + "=" + query.Value;
        }

    }
    currentUrl += validQueryString;
    var EnableInfiniteScroll = false;
    bool.TryParse((string)ViewBag.EnableInfiniteScroll, out EnableInfiniteScroll);
}
@if (!string.IsNullOrEmpty(Model.WarningMessage))
{

    <div class="warning">
        @Model.WarningMessage
    </div>
}
@{
    int entityId = 0;
    int.TryParse(ViewData["entityId"] == null ? "" : ViewData["entityId"].ToString(), out entityId);
    var catModel = new CategoryModel();
    if (entityId != 0)
        catModel.Id = entityId;
    else
        catModel.Id = Model.CategoryID;
    bool hasThirdBanner = Model.ShowBanner && await _categoryService.IsMwtWidgetApplied(CustomPublicWidgetZones.CategoryDetailsProductListThirdPosition, catModel.Id, "Category", _workContext.IsMobileDevice());
    bool hasSixthBanner = Model.ShowBanner && await _categoryService.IsMwtWidgetApplied(CustomPublicWidgetZones.CategoryDetailsProductListSixthPosition, catModel.Id, "Category", _workContext.IsMobileDevice());
    bool hasNinthBanner = Model.ShowBanner && await _categoryService.IsMwtWidgetApplied(CustomPublicWidgetZones.CategoryDetailsProductListNinthPosition, catModel.Id, "Category", _workContext.IsMobileDevice());

}
@if (Model.Products.Count > 0)
{
    int rowPosition = (Model.Products.Count / 3) / 2;
    if (rowPosition > 1)
    {
        if ((rowPosition * 3) % 2 == 1)
        {
            rowPosition = (rowPosition - 1) * 3;
        }
        else
        {
            rowPosition = rowPosition * 3;
        }
        if (_workContext.IsMobileDevice())
            rowPosition = rowPosition - 1;
    }
    else
        rowPosition = 0;

    <div class="row">
        @{
            int counter = 1;
        }
        @foreach (var product in Model.Products)
        {
            <div class="col-sm-6 col-lg-4 cat-box">
                @await Html.PartialAsync(product.Inventory <= 0 ? "_Catgory_ProductBox_OutOfStock" : "_Catgory_ProductBox", product)
            </div>
            if (counter == 2)
            {
                if (hasThirdBanner)
                {
                    counter++;
                }
                if (hasThirdBanner)
                {
                    <div class="col-sm-6 col-lg-4 cat-box">
                        @await Component.InvokeAsync("Widget", new { widgetZone = CustomPublicWidgetZones.CategoryDetailsProductListThirdPosition, additionalData = catModel })
                    </div>
                }
            }
            else if (counter == 8)
            {
                if (hasSixthBanner)
                {
                    counter++;
                }
                if (hasSixthBanner)
                {
                    <div class="col-sm-6 col-lg-4 cat-box">
                        @await Component.InvokeAsync("Widget", new { widgetZone = CustomPublicWidgetZones.CategoryDetailsProductListSixthPosition, additionalData = catModel })
                    </div>
                }
            }
            else if (counter == 14)
            {
                if (hasNinthBanner)
                {
                    counter++;
                }
                if (hasNinthBanner)
                {
                    <div class="col-sm-6 col-lg-4 cat-box">
                        @await Component.InvokeAsync("Widget", new { widgetZone = CustomPublicWidgetZones.CategoryDetailsProductListNinthPosition, additionalData = catModel })
                    </div>
                }
            }
            if (counter == rowPosition)
            {
                @await Component.InvokeAsync("Widget", new { widgetZone = CustomPublicWidgetZones.CategoryDetailsProductListMiddle, additionalData = catModel })
            }
            counter++;
        }
    </div>

    var pager = Html.CustomPager(Model, Model.defaultPageSize)
        .QueryParam(T("Pagenumber.Query.Param").Value)
        // for search page
        .BooleanParameterName("advs")
        .BooleanParameterName("isc")
        .BooleanParameterName("sid")
        .RenderEmptyParameters(true);

    @if (!await pager.IsEmpty())
    {
        <div class="pager">
            <div class="showing">
                @Html.Raw(string.Format(T("Label.Showing").Text, (Model.PageIndex + 1) * Model.PageSize > Model.TotalItems ? Model.TotalItems : (Model.PageIndex + 1) * Model.PageSize, Model.TotalItems))
                @pager
            </div>
        </div>
    }


    @if (EnableInfiniteScroll && Model.HasNextPage)
    {
        <a href="#" class="btn-load-more">@T("Common.Load.More")</a>
    }
}
else if (!string.IsNullOrEmpty(Model.NoResultMessage))
{
    <div class="no-result">
        @Model.NoResultMessage
    </div>
}
<div class="infinite-scroll-loader">Loading  ...</div>
<script>
    if (document.getElementById("noofprdDisplay") != null)
        document.getElementById("noofprdDisplay").innerHTML = "@(Html.Raw(string.Format(T("Label.Showing").Text, (Model.PageIndex + 1) * Model.PageSize > Model.TotalItems ? Model.TotalItems : (Model.PageIndex + 1) * Model.PageSize, Model.TotalItems)))";
</script>
