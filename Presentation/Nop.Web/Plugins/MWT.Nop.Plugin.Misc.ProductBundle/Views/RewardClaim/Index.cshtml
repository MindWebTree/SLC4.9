            flex: 1 1 100px;
            min-width: 100px;
            position: relative;
        }

        .main-container-claim-page .step-description {
            font-size: 12px;
            color: #000000;
        }

        .main-container-claim-page .step:not(:last-child)::after {
            left: 70%;
            right: -70%;
        }

        .main-container-claim-page .claim-gift-btn {
            font-size: 12px;
            width: 75px;
            height: 26px;
        }
    }
</style>

<form asp-controller="Reward" asp-action="Index" method="post" asp-route-orderId="@Context.Request.Query["orderId"]"
      asp-route-email="@Context.Request.Query["email"]" novalidate>
    <div class="main-container-claim-page">
        <!-- ErrorMessage Show -->
        <!-- Banner -->
        <section class="banner">
            <h2>OUR WAY OF SAYING THANK YOU</h2>
            <p>Share your experience on Google and receive a complimentary gift.</p>
        </section>
        <div class="container text-center m-0 p-0"><img class="img-fluid" src="/images/uploaded/hero-image-claim.png" alt="Promo Banner" /></div>
        <!-- Banner -->
        <section class="pt-5 text-center valued-section">
            <h2>Dear Valued Customer!</h2>
            <p class="mt-3 mx-auto" style="max-width: 600px;"><strong>Thank you for choosing Sierra Living Concepts!</strong> Your feedback helps us improve and inspires our artisans. Share your thoughts, and we’ll send you a <strong>special gift</strong> as thanks.</p>
        </section>
        <section class="gift-section">
            <div class="mx-auto p-4" style="max-width: 700px;">


                <!-- Alert Box -->
                <div class="claim-alert-box mb-4" role="alert">Please verify your order details below to proceed.</div>
                <!-- Form Fields -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="OrderId"></label>
                        <input id="orderIdInput" class="form-control" type="number"
                               min="1" asp-for="OrderId" placeholder="Enter your order ID" />
                        <span asp-validation-for="OrderId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="EmailAddress"></label>
                        <input id="emailAddressInput" class="form-control" asp-for="EmailAddress" placeholder="Enter your email address" />
                        <span asp-validation-for="EmailAddress" class="text-danger"></span>
                    </div>
                </div>
                <!-- Submit Button Styled Like Link 
                <div class="text-center"><a class="btn btn-link text-primary text-decoration-underline fw-semibold" href="#bottom"> Continue to Gifts </a></div> -->
            </div>
        </section>
        <section class="how-it-works">
            <h3>How It Works</h3>
            <div class="step-flow">
                <!-- Step 1 -->
                <div class="step">
                    <div class="step-circle">1</div>
                    <div class="step-description">Leave a quick <strong>Google</strong>  <strong>review</strong> </div>
                </div>
                <!-- Step 2 -->
                <div class="step">
                    <div class="step-circle">2</div>
                    <div class="step-description"><strong>Select</strong> your gift</div>
                </div>
                <!-- Step 3 -->
                <div class="step">
                    <div class="step-circle">3</div>
                    <div class="step-description"><strong>We'll verify</strong> &amp; send it to you</div>
                </div>
            </div>
        </section>
        <section id="bottom" class="full-sec-form">

            <div class="py-5 gifts-main">
                <!-- Review Button -->
                @if (!string.IsNullOrWhiteSpace(Model.ReviewComment))
                {
                    <div class="quote-box">We’ve pre-filled the text box with your feedback. Just copy and post it as it is, or edit it before sharing.</div>
                    <div class="review-title">Post your review to unlock your gift <img src="/images/uploaded/giftbox.png" alt="giftbox" /></div>
                    <!-- Card -->

                    <div id="writeReviewPost" class="card card-custom">
                        <div class="card-body">
                            <div id="userReviewCopy">                              
                                <div id="userReview" name="ReviewComment" class="form-control">@Model.ReviewComment</div>
								<span id="copyReviewBtn" style="cursor:pointer;" class="reward-copy-content" data-bs-placement="bottom" data-placement="top" aria-label="Copied!" data-bs-original-title="Copied!"> Copy
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <g clip-path="url(#clip0_16225_16023)">
                                            <path d="M13.3333 6H7.33333C6.59695 6 6 6.59695 6 7.33333V13.3333C6 14.0697 6.59695 14.6667 7.33333 14.6667H13.3333C14.0697 14.6667 14.6667 14.0697 14.6667 13.3333V7.33333C14.6667 6.59695 14.0697 6 13.3333 6Z" stroke="#444444" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M3.33203 10.0007H2.66536C2.31174 10.0007 1.9726 9.86017 1.72256 9.61013C1.47251 9.36008 1.33203 9.02094 1.33203 8.66732V2.66732C1.33203 2.3137 1.47251 1.97456 1.72256 1.72451C1.9726 1.47446 2.31174 1.33398 2.66536 1.33398H8.66536C9.01899 1.33398 9.35812 1.47446 9.60817 1.72451C9.85822 1.97456 9.9987 2.3137 9.9987 2.66732V3.33398" stroke="#444444" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" />
                                        </g>
                                        <defs>
                                            <clipPath id="clip0_16225_16023">
                                                <rect width="16" height="16" fill="white" />
                                            </clipPath>
                                        </defs>
                                    </svg>
                                </span>
                            </div>
                        </div>
                    </div>
                }


                <div class="review-section-outer">
                    <!-- Google Reviews -->
                    <div class="col-md-12 review-box"><img src="/images/uploaded/google-review.svg" alt="Google" /> <button type="button" id="googlebtncustom2" class="btn btn-custom2 mobile-show" disabled>Post On Google</button></div>
                   
                  
              
                </div>
                <div class="note-section visibility-off py-4">
                    <div>
                        <!-- Note -->
                        <div class="note-text"><strong>Note:-</strong> Share your review to claim your gift!</div>
                        <!-- Google Review -->
                        <div class="form-check">
                            <input asp-for="IsGoogleReview" class="form-check-input review-input" checked/>
                            <label class="form-check-label" asp-for="IsGoogleReview"> <strong> Google Review Shared</strong> </label>
                        </div>
                      
                    
                        <!-- Video Review -->
                        <div class="form-check">
                            <input asp-for="IsPreferVideo" class="form-check-input review-input" disabled />
                            <label class="form-check-label" asp-for="IsPreferVideo"> <strong> Prefer video?</strong> </label>
                        </div>
                       
                       <div class="extra-text">Submit a 30–180 seconds testimonial video and get a <strong>$25 Amazon Gift Card</strong>.<br />Visit – <a href="https://www.sierralivingconcepts.com/video-review" target="_blank" rel="noopener"> www.sierralivingconcepts.com/video-review </a></div> 
					    
                    </div>
                    <div asp-validation-summary="ModelOnly" class="message-error"></div>
                </div>
                <h2>Pick One of These Exclusive Gifts</h2>
				 
                <!-- Gift Options -->
                <input type="hidden" id="SelectedGift" name="SelectedGift" value="" />
                <div class="row g-4">
                    

                    <div class="col-md-6">
                        <label class="form-check-label d-block">
                            <img src="/images/uploaded/starbucks_image.png" class="starbucks-image" alt="Starbucks" />
                        </label>
                        <div class="gift-card">$15 STARBUCKS E-GIFT CARD</div>
                        <button class="claim-gift-btn" type="submit" data-gift="@(RewardClaimGift.StarbucksGiftCard)" disabled>
                            Claim Gift
                        </button>
                    </div>

                    <div class="col-md-6">
                        <label class="form-check-label d-block">
                            <img src="/images/uploaded/amazons.png" alt="Amazon" />
                        </label>
                        <div class="gift-card">$20 AMAZON E-GIFT CARD</div>
                        <button class="claim-gift-btn" type="submit" data-gift="@(RewardClaimGift.AmazonGiftCard)" disabled>
                            Claim Gift
                        </button>
                    </div>
					<div class="col-md-6">
                        <label class="form-check-label d-block">
                            <img src="/images/uploaded/wooden-coasters.png" alt="Coaster" />
                        </label>
                        <div class="gift-card">COASTER SET (6 PIECES)</div>
                        <button class="claim-gift-btn" type="submit" data-gift="@(RewardClaimGift.CoasterSet)" disabled>
                            Claim Gift
                        </button>
                    </div>

                    <div class="col-md-6">
                        <label class="form-check-label d-block">
                            <img src="/images/uploaded/chopping.png" alt="Cutting Board" />
                        </label>
                        <div class="gift-card">CHOPPING / CUTTING BOARD</div>
                        <button class="claim-gift-btn" type="submit" data-gift="@(RewardClaimGift.ChoppingBoard)" disabled>
                            Claim Gift
                        </button>
                    </div>
                </div>


                <div class="text-center mt-4">
                    <p class="mt-2 text-ps">We'll send your <strong>e-gift card or gift details</strong> to your registered email address.</p>
                </div>

                <div id="exampleModal" class="modal fade" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">

                                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                                {
                                    <button asp-route="Index" class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close">
                                        <img src="/images/uploaded/cross-modal.png" />
                                    </button>
                                }
                                else
                                {
                                    <button asp-route="Index" class="btn-close" type="button" onclick="location.href='@Url.Action("Index", "Reward")'">
                                        <img src="/images/uploaded/cross-modal.png" />
                                    </button>
                                }
                            </div>

                            <div class="modal-body">
                                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                                {
                                    <div class="review-errormessage">@Model.ErrorMessage</div>
                                }
                                else
                                {
                                    <div class="review-feedback">
                                        <strong>Big thanks from Sierra Living Concepts!</strong> We’ll do a quick review check and disburse your gift to <strong>@Model.EmailAddress</strong> within 72 hours.Thanks for making our day!
                                    </div>
                                }
                            </div>
                            @if (Model.ShowModal)
                            {
                                <script>
                                    document.addEventListener("DOMContentLoaded", function () {
                                        var myModal = new bootstrap.Modal(document.getElementById('exampleModal'));
                                        myModal.show();
                                    });
                                </script>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </section>

    </div>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // orderid and email get by query string
        const orderIdInput = document.getElementById("orderIdInput");
        const emailInput = document.getElementById("emailAddressInput");

        // Get query string values
        const urlParams = new URLSearchParams(window.location.search);




        const googlebtncustom2 = document.getElementById("googlebtncustom2"); 
        const reviewInputs = document.querySelectorAll(".review-input");
        const claimGiftBtn = document.querySelectorAll(".claim-gift-btn");
        const reviewNotice = document.getElementById("reviewNotice");
        const userReview = document.getElementById("userReview");
        const copyReviewBtn = document.getElementById("copyReviewBtn");
        const userReviewCopy = document.getElementById("userReviewCopy");
        const selectedGiftInput = document.getElementById("SelectedGift");

        function isValidEmail(email) {
            if (typeof email !== 'string') return false;
            // basic sanity check: local@domain.tld
            const re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            return re.test(email.trim());
        }
        // Function to toggle gifts and claim button
        function toggleGiftSection() {
		
            const orderIdVal = parseInt(orderIdInput.value, 10);
            const hasOrderId = !isNaN(orderIdVal) && orderIdVal > 0;
            const hasEmail = isValidEmail(emailInput.value);
            const isGiftSelected = !isNaN(selectedGiftInput.value) && selectedGiftInput.value > 0;
            var isFormValid = hasOrderId && hasEmail;
            reviewInputs.forEach(el => el.disabled = !isFormValid);
             isFormValid = hasOrderId && hasEmail && (document.getElementById('IsGoogleReview').checked || 
                document.getElementById('IsPreferVideo').checked);

            claimGiftBtn.forEach(el => el.disabled = !isFormValid);

            googlebtncustom2.disabled = !hasOrderId; 
            // Toggle the enabled class for styling
            if (hasOrderId) {
                googlebtncustom2.classList.add('enabled'); 
            } else {
                googlebtncustom2.classList.remove('enabled'); 
            }
        }

        // Function to show/hide review textarea

        // When any Claim Gift button is clicked
        claimGiftBtn.forEach(btn => {
            btn.addEventListener("click", function (e) {
                selectedGiftInput.value = btn.dataset.gift;
            });
        });

        // Review text copied to clipboard
        if (copyReviewBtn) {
            copyReviewBtn.addEventListener("click", function () {
				const reviewText = userReview.textContent.trim(); // FIXED
                copyToClipboard(reviewText);
            });
        }
		
		let copyTooltip = null;

		if (copyReviewBtn) {
			copyTooltip = new bootstrap.Tooltip(copyReviewBtn, {
				trigger: 'manual'
			});
		}
        reviewInputs.forEach(cb => cb.addEventListener('change', toggleGiftSection));

        function copyToClipboard(text) {		
            navigator.clipboard.writeText(text)
                .then(() => {
                    console.log("Review text copied to clipboard!");
					
					if (copyTooltip) {
						copyTooltip.hide();
						setTimeout(() => {
							copyTooltip.show();
							setTimeout(() => copyTooltip.hide(), 1000);
						}, 100);
					}
                })
                .catch((error) => {
                    console.error("Failed to copy review text to clipboard:", error);
                });
        }


        // Initial toggle
        toggleGiftSection();


        // Event listeners for input changes
        orderIdInput.addEventListener("input", function () {
            toggleGiftSection();

        });
		       googlebtncustom2.addEventListener("click", function () {
           window.open("https://www.google.com/search?q=Sierra Living Concepts Inc. 46560 Fremont Blvd, 414 Fremont, CA 94538&oq=Sierra Living Concepts Inc. 46560 Fremont Blvd, 414 Fremont, CA 94538&aqs=chrome..69i57&sourceid=chrome&ie=UTF-8#lrd=0x808fc6fd648aa0f9:0xe3cda53b61df6d47,1,,,", '_blank');
       });
     
        emailInput.addEventListener("input", toggleGiftSection);
    });
</script>













