            <script>
                $(document).ready(function () {

                              function manageEntityId() {
                    if ($("#EntityType").val() == "Category" || $("#EntityType").val() == "" || $("#EntityType").val() == null) {
                        $(".categorysection select").attr("name", "EntityIds");
                    }
                    else {
                        $(".categorysection select").attr("name", "category_EntityId");
                    }
                }
                    manageEntityId();
                    $("#EntityType").change(function () {
                        if ($(this).val() == "Category") {
                            $(".categorysection").show();
                         //   $(".kwtermsection").hide();
                        }
                        else {
                            $(".categorysection").hide();
                    //        $(".kwtermsection").show();
                        }
                        manageEntityId();
                    })
                    // Initially hide all div groups
                    var selectedValue = $('#WidgetZone').val();
                    if (selectedValue === 'categorydetails_middle_product_list' || selectedValue === 'categorydetails_third_product_list') {
                        $('#DesktopVideoRadio').hide();
                        $('#MobileVideoRadio').hide();
                        $('#DesktopVideo').hide();
                        $('#MobileVideo').hide();
                    }

                    // Show the selected div group based on the radio button selection
                    $('input[type=radio][name=BannerType]').change(function () {
                        $('.desktop').hide();
                        $('#' + $(this).val()).show();
                    });
                    $('input[type=radio][name=MobileBannerType]').change(function () {
                        $('.mobile').hide();
                        $('#' + $(this).val()).show();
                    });

                    $('#WidgetZone').change(function () {

                        var selectedValue = $(this).val();
                        if (selectedValue === 'categorydetails_middle_product_list' || selectedValue === 'categorydetails_third_product_list') {
                            $('#DesktopVideoRadio').hide();
                            $('#MobileVideoRadio').hide();
                            $('#DesktopVideo').hide();
                            $('#MobileVideo').hide();

                            if ($('#desktopRadio input:checked').val() == 'DesktopVideo') {
                                $('#desktopRadio input[value="DesktopBanner"]').prop('checked', true).trigger('change');
                            }
                            if ($('#mobileRadio input:checked').val() == 'MobileVideo') {
                                $('#mobileRadio input[value="MobileBanner"]').prop('checked', true).trigger('change');
                            }



                        } else {
                            $('#DesktopVideoRadio').show();
                            $('#MobileVideoRadio').show();

                        }
                    });




                });
            </script>

        </div>
    </div>
