@model MWT.Nop.Plugin.Widgets.Catalog.Models.MWTEntityBannerModel
<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />
@if (ViewBag.RefreshPage == true)
{
    <script>
        try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
        catch (e){}
        window.close();
    </script>
}

<div class="cards-group">
    <div class="card card-default card-popup">
        <div class="card-body">

            <div class="col-12 notes">
                @T("MWT.Plugins.Widgets.Catalog.Note")
            </div>
            <input name="EntityId" type="hidden" value="1" />

            <div class="form-group row">
                <div class="col-sm-3">
                    <nop-label asp-for="EntityType" />
                </div>
                <div class="col-sm-9">
                    @if (Model.Id > 0)
                    {
                        <nop-select asp-for="EntityType" asp-items="Model.EntityTypes" />
                    }
                    else
                    {
                        <nop-select asp-for="EntityType" asp-items="Model.EntityTypes" />
                    }

                </div>
            </div>
            <div class="form-group row categorysection" style="display:@(Model.EntityType == "Category" || string.IsNullOrEmpty(Model.EntityType) ? "" : "none")">
                <div class="col-sm-3">
                    <nop-label asp-for="EntityIds" />
                </div>
                <div class="col-sm-9">
                    <select name="@(Model.EntityType == "Category" || string.IsNullOrEmpty(Model.EntityType) ? "EntityIds" : "category_EntityId")" class="form-control select2" multiple="true">
                        @foreach (var category in Model.AvailableCategories)
                        {
                            if (!string.IsNullOrEmpty(category.Value) && Model.EntityIds.Contains(Convert.ToInt32(category.Value)))
                            {
                                <option value="@category.Value" selected>@category.Text</option>
                            }
                            else
                            {
                                <option value="@category.Value">@category.Text</option>
                            }
                        }
                    </select>

                    <span asp-validation-for="EntityIds" class="text-danger"></span>
