@model MWT.Nop.Plugin.Payments.Affirm.Models.ConfigurationModel
@{ Layout = "_ConfigurePlugin"; }
@using MWT.Nop.Plugin.Payments.Affirm.Domain
@await Component.InvokeAsync("StoreScopeConfiguration")

<form asp-controller="AffirmSetting" asp-action="Configure" method="post">
    <script>
        $(document).ready(function () {
            $("#showDebugInfo").click(toggleshowDebugInfo);
            $("#@Html.IdFor(model => model.CreateOrderModeId)").change(toggleCreateOrderMode);
            $("#@Html.IdFor(model => model.EnableOnShoppingCart)").change(toggleEnableOnShoppingCart);
            $("#@Html.IdFor(model => model.EnableOnProductDetailsPage)").change(toggleEnableOnProductDetailsPage);
            $("#@Html.IdFor(model => model.EnableOnProductBox)").change(toggleEnableOnProductBox);

            toggleshowDebugInfo();
            toggleCreateOrderMode();
            toggleEnableOnShoppingCart();
            toggleEnableOnProductDetailsPage();
            toggleEnableOnProductBox();
        });

        function toggleshowDebugInfo() {
            if ($('#showDebugInfo').is(':checked')) {
                $('#pnlclearlogfile, #pnlgetlogfile').showElement();
            }
            else {
                $('#pnlclearlogfile, #pnlgetlogfile').hideElement();
            }
        }
        function toggleEnableOnShoppingCart() {
            if ($("#@Html.IdFor(model => model.EnableOnShoppingCart)").is(':checked')) {
                $('#pncWidgetZoneShoppingCart').showElement();
            }
            else {
                $('#pncWidgetZoneShoppingCart').hideElement();
            }
        }
        function toggleEnableOnProductDetailsPage() {
            if ($("#@Html.IdFor(model => model.EnableOnProductDetailsPage)").is(':checked')) {
                $('#pncWidgetProductDetailsPage').showElement();
            }
            else {
                $('#pncWidgetProductDetailsPage').hideElement();
            }
        }
        function toggleEnableOnProductBox() {
            if ($("#@Html.IdFor(model => model.EnableOnProductBox)").is(':checked')) {
                $('#pncWidgetProductBox').showElement();
            }
            else {
                $('#pncWidgetProductBox').hideElement();
            }
        }
        function toggleCreateOrderMode() {
            var selectedCreateOrderModeId = $("#@Html.IdFor(model => model.CreateOrderModeId)").val();

            $('#pnlSkipPaymentInfo').hideElement();

            switch (selectedCreateOrderModeId) {
               case '@(((int)CreateOrderMode.AfterPayment).ToString())':
                   break;
               case '@(((int)CreateOrderMode.BeforePayment).ToString())':
                    $('#pnlSkipPaymentInfo').showElement();
                   break;
                }
            }
    </script>
