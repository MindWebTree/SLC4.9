@model CustomerInfoModel

<form id="co-customerinfo-form">
    <div class="errors-container"></div>
    <div class="form-group">
                <input asp-for="FirstName" class="form-control" placeholder="@Html.DisplayNameFor(m=>m.FirstName)" />
   
    </div>
    <div class="form-group">
        <input asp-for="LastName" class="form-control" placeholder="@Html.DisplayNameFor(m=>m.LastName)" />
                <span asp-validation-for="FirstName"></span>
    </div>
    <div class="form-group emaiteddit">
        <input asp-for="Email" class="form-control" placeholder="@Html.DisplayNameFor(m=>m.Email)" />
                <span asp-validation-for="FirstName"></span>
    </div>
    <div class="form-group">
        <input asp-for="Phone" class="form-control" placeholder="@Html.DisplayNameFor(m=>m.Phone)" />
        <span asp-validation-for="FirstName"></span>
    </div>
    <div class="form-group">
        <input asp-for="Phone" class="form-control" placeholder="@Html.DisplayNameFor(m=>m.ZipPostalCode)" />
        <span asp-validation-for="FirstName"></span>
    </div>
    <button name="save" type="button" class="checkoutdesktopbtn customerinfobtn button-1 button-2 btn btn-primary new-address-next-step-button" onclick="customOrderProcess.save()">@T("Common.Continue")</button>

</form>

