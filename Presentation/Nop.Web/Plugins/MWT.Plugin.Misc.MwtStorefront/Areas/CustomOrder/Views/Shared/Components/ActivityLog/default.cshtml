@model List<CustomerActivityModel>
<div class="row my-3 mx-5 bg-white" style="border-radius: 10px;">
    <div clas="col-md-12">
        <div class="pt-3">
            <h4 style="margin-left: 26px;">@T("CustomOrder.Label.CustomerActivity")</h4>
        </div>
        @if (Model.Count > 0)
        {
            <ul class="customer-activity mt-5 ml-5">
                @for (var i = 0; i < Model.Count; i++)
                {
                    <li>@Model[i].Details</li>
                }
            </ul>
        }
        else
        {
            <ul class="customer-activity mt-5 ml-5">
                <li>@T("CustomOrder.Acivity.NotFound")</li>
            </ul>
           
        }
    </div>
</div>