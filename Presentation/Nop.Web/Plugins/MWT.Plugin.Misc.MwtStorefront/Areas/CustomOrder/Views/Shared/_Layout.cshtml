    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/jquery-ui-dist/jquery-ui.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/jquery/jquery.min.js");

    //page title
    string customOrderPageTitle = !string.IsNullOrWhiteSpace(ViewBag.PageTitle) ? ViewBag.PageTitle + " / " : "";
    customOrderPageTitle += T("CustomOrder.PageTitle").Text;

    //has "Manage Maintenance" permission?
    var canManageMaintenance = await permissionService.AuthorizeAsync(StandardPermission.System.MANAGE_MAINTENANCE);

    //avatar
    var currentCustomer = await workContext.GetCurrentCustomerAsync();

    //event
    await eventPublisher.PublishAsync(new PageRenderingEvent(this.NopHtml));

    //info: we specify "Admin" area for actions and widgets here for cases when we use this layout in a plugin that is running in a different area than "admin"
}
<!DOCTYPE html>
<html lang="@languageService.GetTwoLetterIsoLanguageName(await workContext.GetWorkingLanguageAsync())" @(supportRtl? Html.Raw(" dir=\"rtl\"") : null)>
<head>
    <title>@customOrderPageTitle</title>
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8" />
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    @*Google Font*@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic" />
    <script>
        var rootAppPath = '@(Url.Content("~/"))';
    </script>
    @NopHtml.GenerateHeadCustom()
    @NopHtml.GenerateCssFiles()
    @NopHtml.GenerateScripts(ResourceLocation.Head)
    @*Insert favicon and app icons head code*@
    @await Component.InvokeAsync("Favicon")
    @NopHtml.GenerateInlineScripts(ResourceLocation.Head)
</head>
<body class="customorder_container">
    <script type="text/javascript">
        var culture = "@GetDefaultLocale()";

        //load cldr for current culture
        $.when(
            $.get("/lib_npm/cldr-data/supplemental/likelySubtags.json"),
            $.get("/lib_npm/cldr-data/main/" + culture + "/numbers.json"),
            $.get("/lib_npm/cldr-data/main/" + culture + "/currencies.json"),
            $.get("/lib_npm/cldr-data/supplemental/numberingSystems.json"),
            $.get("/lib_npm/cldr-data/main/" + culture + "/ca-gregorian.json"),
            $.get("/lib_npm/cldr-data/main/" + culture + "/timeZoneNames.json"),
            $.get("/lib_npm/cldr-data/supplemental/timeData.json"),
            $.get("/lib_npm/cldr-data/supplemental/weekData.json"),
        ).then(function () {
            // Normalize $.get results, we only need the JSON, not the request statuses.
            return [].slice.apply(arguments, [0]).map(function (result) {
                return result[0];
            });
        }).then(Globalize.load).then(function () {
            Globalize.locale(culture);
        });
    </script>
    <script>
        // kendo.culture("@(currentKendoCulture)");
    </script>
    <div class="throbber">
        <div class="curtain">
        </div>
        <div class="curtain-content">
            <div>
                <h1 class="throbber-header">@T("Common.Wait")</h1>
                <p>
                    <img src="@Url.Content("~/css/admin/images/throbber-synchronizing.gif")" alt="" />
                </p>
            </div>
        </div>
    </div>
    <div id="ajaxBusy" style="display:none;">
        <div>&nbsp;</div>
    </div>

    <section>
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-1 pl-0 pr-0 h-100 d-inline-block fixed-left">
                    @*Navigation*@
                    @await Html.PartialAsync("Menu")
                </div>
                <div class="col-md-12 main-sec-right mb-5">
                    @*header*@
                    @if (IsSectionDefined("header"))
                    {
                        @RenderSection("header")
                    }
                    else
                    {
                        <div class="heading bg-light mt-3 py-1">
                            <h4 class="mb-0 py-3 text-primary"><a href="/" class="text-primary">@storeName</a></h4>
                            @if (ViewBag.headingextraData != null)
                            {
                                <h5 class="text-primary float-right mt-n5 pt-2 pr-2">@ViewBag.headingextraData</h5>
                            }
                        </div>
                    }
                    @*body*@
                    <div class="customorder-container">
                        @await Html.PartialAsync("Notifications")
                        <nop-antiforgery-token />
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </section>

    @NopHtml.GenerateInlineScripts(ResourceLocation.Footer)

</body>
</html>