@{
    string storeName = _storeContext.GetCurrentStore()?.Name;
    var returnUrl = webHelper.GetRawUrl(Context.Request);

    //Kendo UI
    // var kendoVersion = "2020.1.406";

    var currentKendoCulture = (await EngineContext.Current.Resolve<IWorkContext>().GetWorkingLanguageAsync()).LanguageCulture;

    var currentCulture = CultureInfo.CurrentCulture;

    //Code to get check if current cultures scripts are exists. If not, select parent cultures scripts
    string GetDefaultLocale()
    {
        var localePattern = NopCommonDefaults.LocalePatternPath;

        var cultureToUse = NopCommonDefaults.DefaultLocalePattern; //Default regionalisation to use

        if (fileProvider.DirectoryExists(fileProvider.Combine(WebHostEnvironment.WebRootPath, string.Format(localePattern, currentCulture.Name))))
            cultureToUse = currentCulture.Name;
        else if (fileProvider.DirectoryExists(fileProvider.Combine(WebHostEnvironment.WebRootPath, string.Format(localePattern, currentCulture.TwoLetterISOLanguageName))))
            cultureToUse = currentCulture.TwoLetterISOLanguageName;

        return cultureToUse;
    }

    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl && !localizationSettings.IgnoreRtlPropertyForAdminArea;

    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    NopHtml.AppendCssFileParts("~/css/Customizations/Areas/CustomOrder/style.css?msg=version3");
    NopHtml.AppendCssFileParts("~/css/Customizations/Areas/CustomOrder/bootstrap.min.css");


    NopHtml.AppendCssFileParts($"~/lib_npm/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css");
    NopHtml.AppendCssFileParts($"~/lib_npm/datatables.net-bs4/css/dataTables.bootstrap4.min.css");
    // NopHtml.AppendCssFileParts($"~/lib/kendo/{kendoVersion}/styles/web/kendo.rtl.min.css");
    // NopHtml.AppendCssFileParts($"~/lib/kendo/{kendoVersion}/styles/web/kendo.default.min.css");
    // NopHtml.AppendCssFileParts($"~/lib/kendo/{kendoVersion}/styles/web/kendo.common.min.css");
    NopHtml.AppendCssFileParts("~/lib_npm/@fortawesome/fontawesome-free/css/all.min.css");
    NopHtml.AppendCssFileParts("~/lib_npm/bootstrap-touchspin/jquery.bootstrap-touchspin.min.css");
    NopHtml.AppendCssFileParts("~/lib_npm/jquery-ui-dist/jquery-ui.min.css");
    <link rel="stylesheet" href="~/lib_npm/admin-lte/plugins/select2/css/select2.min.css">

    //scripts
    NopHtml.AppendScriptParts(ResourceLocation.Head, $"~/lib_npm/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, $"~/lib_npm/datatables.net-buttons/js/dataTables.buttons.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, $"~/lib_npm/moment/min/moment-with-locales.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, $"~/lib_npm/datatables.net-bs4/js/dataTables.bootstrap4.min.js");

    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/js/admin.table.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, $"~/lib_npm/datatables.net/js/dataTables.min.js");
    //  NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/lib/kendo/{kendoVersion}/js/cultures/kendo.culture.{currentKendoCulture}.min.js");

    // var fileInfo = fileProvider.GetFileInfo($"{WebHostEnvironment.WebRootPath}/lib/kendo/{kendoVersion}/js/messages/kendo.messages.{currentKendoCulture}.min.js");
    // @if (fileInfo.Exists)
    // {
    //     NopHtml.AppendScriptParts(ResourceLocation.None, $"~/lib/kendo/{kendoVersion}/js/messages/kendo.messages.{currentKendoCulture}.min.js");
    // }
    // else
    // {
    //     NopHtml.AppendScriptParts(ResourceLocation.None, "~/lib/kendo/{kendoVersion}/js/messages/kendo.messages.{NopCommonDefaults.DefaultLanguageCulture}.min.js");
    // }
    // NopHtml.AppendScriptParts(ResourceLocation.None, $"~/lib/kendo/{kendoVersion}/js/kendo.ui.core.min.js");

    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/typeahead.js/typeahead.bundle.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/jquery-migrate/jquery-migrate.min.js");

    // this file can be downloaded from :
    // https://github.com/johnnyreilly/jquery-validation-globalize
