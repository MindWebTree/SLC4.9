    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/js/Customizations/customorder.common.js?msg=version3");
    // globalize scripts
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/globalize/globalize/currency.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/globalize/globalize/date.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/globalize/globalize/number.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/globalize/globalize.js");

    // cldr scripts (needed for globalize)
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/cldrjs/cldr/supplemental.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/cldrjs/cldr/event.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/cldrjs/cldr.js");

    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/admin-lte/plugins/select2/js/select2.full.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/jquery-validation/jquery.validate.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Head, "~/lib_npm/bootstrap/js/bootstrap.bundle.min.js");
