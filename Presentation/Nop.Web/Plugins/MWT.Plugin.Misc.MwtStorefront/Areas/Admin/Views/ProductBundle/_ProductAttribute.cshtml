    @*@await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ProductConfigurationBundle, additionalData = Model })*@
    if (Model.AllowAddingOnlyExistingAttributeCombinations && catalogSettings.AttributeValueOutOfStockDisplayType == AttributeValueOutOfStockDisplayType.Disable)
    {
        NopHtml.AddScriptParts(ResourceLocation.Footer, "~/js/public.combinationsbehavior.js");

        <script asp-location="Footer">
            var combinationsBehavior_@(Model.Id);
            $(document).ready(function () {
                                                                                                    combinationsBehavior_@(Model.Id) = createCombinationsBehavior({
                contentEl: '[data-productid="@Model.Id"]',
                fetchUrl: '@Html.Raw(Url.RouteUrl("GetProductCombinations", new { productId = Model.Id }))'
            });
                                                                                                    combinationsBehavior_@(Model.Id).init();
            });
        </script>
    }

    //dynamic update support
    var attributesHaveConditions = Model.ProductAttributes.Any(x => x.HasCondition);
    var attributesHaveAssociatedPictures = Model.ProductAttributes.Any(x => x.ProductId > 0);
    var attributeChangeScriptsBuilder = new StringBuilder();
    var safeBundleIdForJs = bundleId.Replace("-", "_");
    var attributeChangeHandlerFuncName = $"{refFormId}attribute_change_handler_{Model.Id}_{safeBundleIdForJs}";
    if (catalogSettings.AjaxProcessAttributeChange)
    {
        if (Model.AllowAddingOnlyExistingAttributeCombinations && catalogSettings.AttributeValueOutOfStockDisplayType == AttributeValueOutOfStockDisplayType.Disable)
        {
            <script asp-location="Footer">
                $(document).ready(function () {
                    $(combinationsBehavior_@(Model.Id)).on('processed', function () {
                @(attributeChangeHandlerFuncName)();
                    });
                });
            </script>
        }
        else
        {
            //generate change event script
            foreach (var attribute in Model.ProductAttributes)
            {
                var controlId = $"{refFormId}{NopCatalogDefaults.ProductAttributePrefix}{attribute.Id}";
                switch (attribute.AttributeControlType)
                {
                    case AttributeControlType.DropdownList:
                        {
                            attributeChangeScriptsBuilder.AppendFormat("$('#{0}').on('change', function(e){{{1}('#{0}',e);}});\n", controlId, attributeChangeHandlerFuncName);
                        }
                        break;
                    case AttributeControlType.RadioList:
                    case AttributeControlType.ColorSquares:
                    case AttributeControlType.ImageSquares:
                        {
                            foreach (var attributeValue in attribute.Values)
                            {
                                attributeChangeScriptsBuilder.AppendFormat("$('#{0}_{1}_{3}').on('click', function(e){{{2}('#{0}',e);}});\n", controlId, attributeValue.Id, attributeChangeHandlerFuncName, bundleId);
                            }
                        }
                        break;
                    case AttributeControlType.Checkboxes:
                    case AttributeControlType.ReadonlyCheckboxes:
                        {
                            foreach (var attributeValue in attribute.Values)
                            {
                                attributeChangeScriptsBuilder.AppendFormat("$('#{0}_{1}_{3}').on('click', function(e){{{2}('#{0}',e);}});\n", controlId, attributeValue.Id, attributeChangeHandlerFuncName, bundleId);
                            }
                        }
                        break;
                    default:
                        break;
                }
            }
        }

        foreach (var attribute in Model.ProductAttributes)
        {

            foreach (var attributeValue in attribute.Values.Where(value => value.CustomerEntersQty))
            {

                var controlId = $"{refFormId}{NopCatalogDefaults.ProductAttributePrefix}{attribute.Id}";

                attributeChangeScriptsBuilder.AppendFormat("$('#{0}_{1}_qty').on('input propertychange paste', function(e){{{2}(e);}});\n", controlId, attributeValue.Id, attributeChangeHandlerFuncName);
            }
        }


        <script asp-location="Footer">
    var productid = @Model.Id;
    var svgNS = "http://www.w3.org/2000/svg";
    var default_img = [];
    var show_default_img = true;
    var previous_shade = $.trim($('@addtoCartFormId .shade-section .Stain').text());
    var previous_config = $("@addtoCartFormId .Configuration-section input:checked").val();
    var previous_size = "";
    var selectedAttrId = 0;

    if ($("@addtoCartFormId .size-section select").length > 0) {
        previous_size = $("@addtoCartFormId .size-section select").val();
    }
    else {
        previous_size = $("@addtoCartFormId .size-section  input:checked").val();
    }

    function @(attributeChangeHandlerFuncName)(refId, e) {

        if ($.trim($('@addtoCartFormId .shade-section .Stain').text()) == $.trim("@T("Product.Attr.shade.Custom.Shade").Text")) {
            $("@addtoCartFormId .custom_shade_message").removeClass("d-none");
        }
        else {
            $("@addtoCartFormId .custom_shade_message").addClass("d-none");
        }

        var attrId = 0;
        if (e != null) {
            attrId = e.target.value;
        }

        var prdName = 'Picture of ' + $("h1[itemprop=\"name\"]").text().trim();
        var show_image_length = $('.product-sub-images').jcarousel('visible').length;

        function change_gallery_img(imageObjects, FullSizeImageUrl, DefaultSize, dimensionPictureFullSizeUrl, dimensionPictureDefaultSizeUrl, dimensionPictureThumbImageUrl, defaultGallery) {
            $("#product-magiczoom .overlay-text").removeClass("show");
            $('.product-sub-images').find('ul').empty();

            if (dimensionPictureFullSizeUrl !== null && dimensionPictureFullSizeUrl !== undefined && dimensionPictureFullSizeUrl !== '') {
                var galleryItem = {
                    ThumbImageUrl: dimensionPictureThumbImageUrl,
                    ImageUrl: dimensionPictureDefaultSizeUrl,
                    AlternateText: '',
                    FullSizeImageUrl: dimensionPictureFullSizeUrl,
                    IsVideo: false,
                    VideoUrl: "",
                    IsDimensionImage: true
                };
                if (!defaultGallery) {
                    if (imageObjects.length < dimensionIndex) {
                        imageObjects.push(galleryItem);
                    }
                    else {
                        imageObjects.splice(3, 0, galleryItem);
                    }
                }
                else {
                    var item = imageObjects.find(x => x.IsDimensionImage === true);
                    if (item) {
                        item.ThumbImageUrl = dimensionPictureThumbImageUrl;
                        item.ImageUrl = dimensionPictureDefaultSizeUrl;
                        item.FullSizeImageUrl = dimensionPictureFullSizeUrl;
                        item.AlternateText = '';
                    }
                    else {
                        if (imageObjects.length < dimensionIndex) {
                            imageObjects.push(galleryItem);
                        }
                        else {
                            imageObjects.splice(3, 0, galleryItem);
                        }
                    }
                }
            }

            imageObjects.forEach(function (imageObj, index) {
                var newLi;

                if (imageObj.IsVideo && imageObj.VideoUrl) {
                    newLi = $('<li>').append(
                        $('<a>', {
                            'class': 'thumb-Video',
                            'data-zoom-id': 'product-video-magiczoom',
                            'href': imageObj.FullSizeImageUrl,
                            'data-image': imageObj.ImageUrl,
                            'title': prdName
                        }).append(
                            $('<img>', {
                                'src': imageObj.ThumbImageUrl,
                                'class': 'lazy',
                                'width': "100",
                                'height': "100",
                                'title': prdName,
                                'data-src': imageObj.ThumbImageUrl,
                                'data-defaultsize': imageObj.ImageUrl,
                                'data-fullsize': imageObj.FullSizeImageUrl,
                                'data-index': index,
                                'alt': imageObj.AlternateText,
                                'data-video': imageObj.VideoUrl
                            }),
                            $('<div>', { 'class': 'video-play-overlay' }).append(
                                $(document.createElementNS(svgNS, "svg"))
                                    .attr({
                                        width: 24,
                                        height: 24,
                                        viewBox: "0 0 24 24",
                                        fill: "white"
                                    })
                                    .append(
                                        $(document.createElementNS(svgNS, "path"))
                                            .attr("d", "M8 5v14l11-7z")
                                    )
                            )
                        )
                    );
                }
                else {
                    newLi = $('<li>').append(
                        $('<a>', {
                            'data-zoom-id': 'product-magiczoom',
                            'href': imageObj.FullSizeImageUrl,
                            'class': `thumb-item mz-thumb ${imageObj.IsDimensionImage ? "dimension-image" : ""}`,
                            'data-image': imageObj.ImageUrl,
                            'AlternateText': imageObj.AlternateText,
                            'title': prdName
                        }).append(
                            $('<img>', {
                                'src': imageObj.ThumbImageUrl,
                                'class': 'lazy',
                                'width': "100",
                                'height': '100',
                                'title': prdName,
                                'data-src': imageObj.ThumbImageUrl,
                                'data-defaultsize': imageObj.ImageUrl,
                                'data-fullsize': imageObj.FullSizeImageUrl,
                                'AlternateText': imageObj.AlternateText,
                                'data-index': index
                            })
                        )
                    );
                }
                $('.product-sub-images').find('ul').append(newLi); // Append the new <li> to the carousel
            });

            var $mainLink = $("#product-magiczoom");
            $mainLink.find('iframe, .auto-video-container').remove();
            if ($mainLink.find('img').length === 0) {
                $mainLink.empty().append(
                    $('<img>', {
                        id: 'main-product-img-@Model.Id',
                        alt: prdName,
                        src: ''
                    }).attr({
                        width: 840,
                        height: 840
                    })
                );
            }

            MagicZoom.stop("product-magiczoom");

            // Update the main image elements
            $mainLink.attr("href", FullSizeImageUrl || imageObjects[0].FullSizeImageUrl); // Set to the largeUrl of the first new image
            $mainLink.find("img").attr("src", DefaultSize || imageObjects[0].ImageUrl); // Set to the thumbUrl of the first new image
            $mainLink.find("img").attr("alt", imageObjects[0].AlternateText); // Set the alt text

            // Restart MagicZoom
            MagicZoom.start("product-magiczoom");

            // Reinitialize the jCarousel
            $(".jcarousel").jcarousel("destroy"); // Destroy previous instance
            $(".jcarousel").jcarousel();

            // Reinitialize jCarousel control functionality
            $(".jcarousel-control-prev").jcarouselControl({
                target: '-=1'
            });

            $(".jcarousel-control-next").jcarouselControl({
                target: '+=1'
            });

            console.log(show_image_length);

            if (imageObjects.length >= show_image_length) {
                $(".product-gallery .jcarousel-control-prev,.product-gallery .jcarousel-control-next").show();
            } else {
                $(".product-gallery .jcarousel-control-prev,.product-gallery .jcarousel-control-next").hide();
            }
        }

     $('.attribute_value_wrapper[id$="_@(Model.Id)_@(bundleId)"]').each(function() {
            var $wrapper = $(this);
            var $row = $wrapper.closest('tr');

            // 2. Only process it if it's a Stain/Shade row
            if ($row.hasClass('shade-section')) {
                var selectedStainName = "";

                // A. Check if it's a Dropdown
                var $dropdown = $wrapper.find('select');
                if ($dropdown.length > 0 && $dropdown.val() != "0") {
                    selectedStainName = $dropdown.find('option:selected').text().split('[')[0].trim();
                }
                // B. Check if it's a Color Square or Image Square (Radio)
                else {
                    var $checkedRadio = $wrapper.find('input[type="radio"]:checked');
                    if ($checkedRadio.length > 0) {
                        var $label = $checkedRadio.closest('label');

                        selectedStainName = $label.attr('data-attr-name') ||
                                            $checkedRadio.siblings('span').text() ||
                                            $checkedRadio.closest('li').find('.attrvalue-name').text();

                        selectedStainName = $.trim(selectedStainName).split('[')[0].trim();
                    }
                }

                // C. Find the span safely inside THIS EXACT ROW and update it
                if (selectedStainName) {
                    $row.find('.current-selected-shade-name').text(selectedStainName);
                }
            }
        });

        $(document).trigger({
            type: "attribute_changed",
            changedData: { attrId: attrId }
        });

    }


    $(document).ready(function () {
        @(attributeChangeHandlerFuncName)("onload");
        @Html.Raw(attributeChangeScriptsBuilder.ToString())
    });

        </script>

    }
