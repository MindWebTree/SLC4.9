@model LandingPageModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Published" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Published" />
            <span asp-validation-for="Published"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DisplayOrder" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DisplayOrder" />
            <span asp-validation-for="DisplayOrder"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Deleted" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Deleted" />
            <span asp-validation-for="Deleted"></span>
        </div>
    </div>
    
 

 
  

   
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="PageContent" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="PageContent" asp-template="RichEditor" />
            <span asp-validation-for="PageContent"></span>
        </div>
    </div>

</div>

