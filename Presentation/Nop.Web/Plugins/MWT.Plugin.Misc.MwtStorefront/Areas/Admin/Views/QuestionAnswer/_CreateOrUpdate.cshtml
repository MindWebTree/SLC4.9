@model QuestionAnswerModel

@{
    const string hideInfoBlockAttributeName = "QuestionAnswerPage.HideInfoBlock";
    var hideInfoBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideInfoBlockAttributeName);

    const string hideDisplayBlockAttributeName = "QuestionAnswerPage.HideDisplayBlock";
    var hideDisplayBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideDisplayBlockAttributeName, defaultValue: true);

    const string hideMappingsBlockAttributeName = "QuestionAnswerPage.HideMappingsBlock";
    var hideMappingsBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideMappingsBlockAttributeName, defaultValue: true);

    const string hideSeoBlockAttributeName = "QuestionAnswerPage.HideSEOBlock";
    var hideSeoBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSeoBlockAttributeName, defaultValue: true);

    const string hideProductsBlockAttributeName = "QuestionAnswerPage.HideProductsBlock";
    var hideProductsBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideProductsBlockAttributeName, defaultValue: true);

    const string hideRelatedQuestionAnswerBlockAttributeName = "QuestionAnswerPage.HideRelatedQuestionAnswerBlock";
    var hideRelatedQuestionAnswerBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideRelatedQuestionAnswerBlockAttributeName, defaultValue: true);





	   

}

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="row">
                <div class="col-md-12 clearfix">
                    <div class="float-left">
                        @await Component.InvokeAsync("SettingMode", new { modeName = "QuestionAnswer-advanced-mode" })
                    </div>
                </div>
            </div>

            <nop-cards id="QuestionAnswer-cards">
                <nop-card asp-name="QuestionAnswer-info" asp-icon="fas fa-info" asp-title="@T("Admin.Catalog.QuestionAnswer.Info")" asp-hide-block-attribute-name="@hideInfoBlockAttributeName" asp-hide="@hideInfoBlock" asp-advanced="false">@await Html.PartialAsync("_CreateOrUpdate.Info", Model)</nop-card>
                <nop-card asp-name="QuestionAnswer-display" asp-icon="fas fa-tv" asp-title="@T("Admin.Catalog.QuestionAnswer.Display")" asp-hide-block-attribute-name="@hideDisplayBlockAttributeName" asp-hide="@hideDisplayBlock" asp-advanced="false">@await Html.PartialAsync("_CreateOrUpdate.Display", Model)</nop-card>
                <nop-card asp-name="QuestionAnswer-seo" asp-icon="fas fa-search-plus" asp-title="@T("Admin.Common.SEO")" asp-hide-block-attribute-name="@hideSeoBlockAttributeName" asp-hide="@hideSeoBlock" asp-advanced="true">@await Html.PartialAsync("_CreateOrUpdate.Seo", Model)</nop-card>
                <nop-card asp-name="QuestionAnswer-products" asp-icon="fas fa-th-list" asp-title="@T("Admin.Catalog.QuestionAnswer.Products")" asp-hide-block-attribute-name="@hideProductsBlockAttributeName" asp-hide="@hideProductsBlock" asp-advanced="true">@await Html.PartialAsync("_CreateOrUpdate.Products", Model)</nop-card>

                <nop-card asp-name="Related-questionAnswer" asp-icon="fas fa-th-list" asp-title="@T("Admin.Catalog.RelatedQuestionAnswer")" asp-hide-block-attribute-name="@hideRelatedQuestionAnswerBlockAttributeName" asp-hide="@hideRelatedQuestionAnswerBlock" asp-advanced="true">@await Html.PartialAsync("_CreateOrUpdate.RelatedQuestionAnswers", Model)</nop-card>

                @await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.CategoryDetailsBlock, additionalData = Model })




            </nop-cards>
        </div>
    </div>
</section>