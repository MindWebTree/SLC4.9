 
@model CustomFormModel

@{
    //page title
    ViewBag.PageTitle = T(Model.Id > 0 ? "Admin.Catalog.Customforms.EditCustomformsDetails" : "Admin.Catalog.Customforms.CustomformsDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Custom Forms");
}

<form asp-controller="CustomForm" asp-action="Edit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T(Model.Id > 0 ? "Admin.Catalog.Customforms.EditCustomformsDetails" : "Admin.Catalog.Customforms.CustomformsDetails")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="index">@T("Admin.Catalog.Customforms.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>@if(Model.Id>0){
                <span id="customform-delete" class="btn bg-red">
                <i class="far fa-trash-alt"></i>
                @T("Admin.Common.Delete")
            </span>
            }

        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdateCustomForm", Model)
</form>
@if(Model.Id>0){
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="customform-delete" asp-action="CustomFormDelete" /> 
}