 
@model CustomFormSearchModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Catalog.Customform.Lead.Details").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Custom Forms");
    string referer =Context.Request.Headers["Referer"].ToString();
}



<form asp-controller="CustomForm" asp-action="Details" method="post" id="CustomForms-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Catalog.Customform.Lead.Details")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a href="@(string.IsNullOrEmpty(referer)?
                   Url.Action("Leads","CustomForm",new {id=Model.Id}):referer)">@T("Admin.Catalog.Customform.Leads.BackToList")</a>
            </small>
        </h1>
      
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">


                            @await Html.PartialAsync("Table", new DataTablesModel
                            {
                            Name = "customform-lead-details-grid",
                            UrlRead = new DataUrl("Details", "CustomForm", new RouteValueDictionary{[nameof(Model.Id)]=Model.Id}),
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                            new FilterParameter(nameof(Model.Id))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                            new ColumnProperty(nameof(CustomFormEntryMetaModel.MetaKey))
                            {
                            Title = T("Admin.Catalog.CustomFormEntryMetaModel.Fields.MetaKey").Text
                            },
                            new ColumnProperty(nameof(CustomFormEntryMetaModel.MetaValue))
                            {
                            Title = T("Admin.Catalog.CustomFormEntryMetaModel.Fields.MetaValue").Text,
                            Width = "150"
                            }
                          
                           
                            }
                            })

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
   
</form>