@model SegmentSlugMappingSearchModel
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Segment URL Slugs (Second Segment)";
}

<div class="content-header clearfix">
    <h1>Segment URL Slugs</h1>
    <div class="pull-right">
        <a href="@Url.Action("CreateSegmentSlug")" class="btn btn-primary">
            <i class="fa fa-plus-square"></i> Add New Segment Slug
        </a>
        <a href="@Url.Action("TagSlugs")" class="btn btn-default">
            <i class="fa fa-tag"></i> Manage Tag Slugs
        </a>
    </div>
</div>

<div class="content">
    <div class="form-horizontal">
        <div class="panel-group">
            <div class="panel panel-default">
                <div class="panel-body">
                    <p class="text-muted">
                        These are the <strong>second URL segments</strong>:
                        <code>/new/<strong>furniture</strong></code>, <code>/new/<strong>wood</strong></code>, <code>/new/<strong>all-in-stock</strong></code> —
                        each maps to a Category, Specification Attribute Option, or nothing (all products).
                    </p>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Segment Slug List</h3>
                </div>
                <div class="panel-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
               {
                   Name            = "segmentslug-grid",
                   UrlRead         = new DataUrl("SegmentSlugList", "TagAdmin", null),
                   UrlDelete = new DataUrl("DeleteSegmentSlug", "TagAdmin", null),
                   SearchButtonId  = "search-segmentslug",
                   Length          = Model.PageSize,
                   LengthMenu      = Model.AvailablePageSizes,
                   Filters         = new List<FilterParameter>(),
                   ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(SegmentSlugMappingModel.Slug))
                            {
                                Title  = "Slug",
                                Render = new RenderCustom("renderSegSlug")
                            },
                            new ColumnProperty(nameof(SegmentSlugMappingModel.Label))
                            {
                                Title = "Label"
                            },
                            new ColumnProperty(nameof(SegmentSlugMappingModel.SlugType))
                            {
                                Title  = "Type",
                                Render = new RenderCustom("renderSlugType")
                            },
                            new ColumnProperty(nameof(SegmentSlugMappingModel.SortOrder))
                            {
                                Title = "Sort Order"
                            },
                            new ColumnProperty(nameof(SegmentSlugMappingModel.IsActive))
                            {
                                Title  = "Active",
                                Render = new RenderBoolean()
                            },
                           new ColumnProperty(nameof(SegmentSlugMappingModel.Id))
                             {
                               Title = T("Admin.Common.Edit").Text,
                               Width = "100",
                               ClassName =  NopColumnClassDefaults.Button,
                               Render = new RenderButtonEdit(new DataUrl("EditSegmentSlug", "TagAdmin"))
                              },
                           new ColumnProperty(nameof(SegmentSlugMappingModel.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                ClassName = NopColumnClassDefaults.Button,
                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                Width = "100"
                            }
                        }
               })
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function renderSegSlug(data) {
    return '<code>/[tag]/' + data + '</code>';
}
function renderSlugType(data) {
    var types = { 0: '<span class="label label-default">All</span>',
                  1: '<span class="label label-info">Category</span>',
                  2: '<span class="label label-warning">Specification</span>' };
    return types[data] || data;
}
</script>
