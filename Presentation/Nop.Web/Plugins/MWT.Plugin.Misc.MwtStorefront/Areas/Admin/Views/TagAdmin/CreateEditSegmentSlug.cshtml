@model  SegmentSlugMappingModel
@{
    Layout = "_AdminLayout";
    var isEdit = Model.Id > 0;
    ViewBag.Title = isEdit ? "Edit Segment Slug" : "Add Segment Slug";
}

<div class="content-header clearfix">
    <h1>@ViewBag.Title</h1>
</div>

<div class="content">
    <form asp-action="@(isEdit ? "EditSegmentSlug" : "CreateSegmentSlug")" method="post" id="segment-form">
        <input type="hidden" asp-for="Id" />

        <div class="panel-group">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Segment Slug Details</h3>
                </div>
                <div class="panel-body">

                    <!-- Slug -->
                    <!-- Label -->
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Label" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Label" />
                        </div>
                    </div>


                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="@Model.MetaTitle" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.MetaTitle" />
                            <span asp-validation-for="@Model.MetaTitle"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="@Model.MetaKeywords" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.MetaKeywords"  />
                            <span asp-validation-for="@Model.MetaKeywords"></span>
                        </div>
                    </div>
                    
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="@Model.AdditionalDescription" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.AdditionalDescription" asp-template="RichEditor" />
                            <span asp-validation-for="@Model.AdditionalDescription"></span>
                        </div>
                    </div>

                 
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="@Model.Description" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.Description" asp-template="RichEditor" />
                            <span asp-validation-for="@Model.Description"></span>
                        </div>
                    </div>


                    <div id="tags-section">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="TagId" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="TagId"
                                            asp-items="Model.AvailableTagSlugs" />
                            </div>
                        </div>
                    </div>


                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Slug" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Slug" />
                            <span asp-validation-for="Slug" class="text-danger"></span>
                            <small class="text-muted">
                                Lowercase, no spaces. E.g: <code>furniture</code>, <code>wood</code>, <code>all-in-stock</code>
                            </small>
                        </div>
                    </div>
                    <!-- Slug Type -->
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="SlugType" />
                        </div>
                        <div class="col-md-9">
                            <select asp-for="SlugType"
                                    asp-items="Model.AvailableSlugTypes"
                                    class="form-control"
                                    id="SlugType"
                                    onchange="toggleFilterFields()">
                            </select>
                        </div>
                    </div>

                    <!-- ── Category fields ────────────────────────── -->
                    <div id="category-section" style="display:none">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CategoryId" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="CategoryId"
                                            asp-items="Model.AvailableCategories" />
                            </div>
                        </div>
                    </div>

                    <!-- ── Specification fields ───────────────────── -->
                    <div id="spec-section" style="display:none">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="SpecificationAttributeId" />
                            </div>
                            <div class="col-md-9">
                                <select asp-for="SpecificationAttributeId"
                                        asp-items="Model.AvailableSpecAttributes"
                                        class="form-control"
                                        id="SpecificationAttributeId"
                                        onchange="loadSpecOptions(this.value)">
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="SpecificationAttributeOptionId" />
                            </div>
                            <div class="col-md-9">
                                <select asp-for="SpecificationAttributeOptionId"
                                        asp-items="Model.AvailableSpecOptions"
                                        class="form-control"
                                        id="SpecificationAttributeOptionId">
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Sort Order & Active -->
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="SortOrder" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="SortOrder" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="@Model.EnableInfiniteScroll" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.EnableInfiniteScroll" />
                            <span asp-validation-for="@Model.EnableInfiniteScroll"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="IsActive" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="IsActive" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-body">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="@Url.Action("SegmentSlugs")" class="btn btn-default">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    // Show/hide fields based on selected slug type
    function toggleFilterFields() {
        var type = document.getElementById('SlugType').value;
        document.getElementById('category-section').style.display = (type == '1') ? '' : 'none';
        document.getElementById('spec-section').style.display = (type == '2') ? '' : 'none';
    }

    // AJAX-load spec options when attribute changes
    function loadSpecOptions(attrId) {
        if (!attrId) return;

        fetch('@Url.Action("GetSpecOptions", "TagAdmin")?specAttributeId=' + attrId)
            .then(r => r.json())
            .then(data => {
                var sel = document.getElementById('SpecificationAttributeOptionId');
                sel.innerHTML = '<option value="">— Select Option —</option>';
                data.forEach(function (o) {
                    var opt = document.createElement('option');
                    opt.value = o.value;
                    opt.text = o.text;
                    sel.appendChild(opt);
                });
            });
    }

    // Init on page load
    document.addEventListener('DOMContentLoaded', function () {
        toggleFilterFields();
    });
</script>
