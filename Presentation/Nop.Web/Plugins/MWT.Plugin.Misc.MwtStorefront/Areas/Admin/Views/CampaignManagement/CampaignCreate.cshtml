@model CampaignCreateModel

<form asp-controller="CampaignManagement" asp-action="CampaignCreate" method="post" id="product-form" enctype="multipart/form-data">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("CampaignManagement.Campaign.Create.heading")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("CampaignManagement.Campaign.BackToList")</a>
            </small>
        </h1>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <nop-cards id="product-cards">
                    <nop-card asp-name="design-info" asp-hide-block-attribute-name="false" asp-hide="false" asp-icon="fas fa-info" asp-title="@T("CampaignManagement.Campaign.Create.Design")" asp-advanced="false">@await Html.PartialAsync("_CreateOrUpdate.Design", Model)</nop-card>
                    <nop-card asp-name="setting-info" asp-hide-block-attribute-name="false" asp-hide="false" asp-icon="fas fa-info" asp-title="@T("CampaignManagement.Campaign.Create.Settings")" asp-advanced="false">@await Html.PartialAsync("_CreateOrUpdate.Settings", Model)</nop-card>
                </nop-cards>
            </div>
        </div>
    </section>
    <div class="card-footer">
        <button type="submit" id="btnAddNewAssociatedProduct" class="btn btn-primary">
            @T("admin.common.save")
        </button>
    </div>
</form>
