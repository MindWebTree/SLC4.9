@model List<CampaignModel>
@{
    List<SelectListItem> campaignsStatus = new List<SelectListItem>();
    campaignsStatus.Add(new SelectListItem()
    {
        Value = "0",
        Text = "All",
        Selected = Context.Request.Query["status"] == "0"

                ? true : false
    });
    campaignsStatus.Add(new SelectListItem()
    {
        Value = "1",
        Text = "Active",
        Selected = Context.Request.Query["status"] == "1" ? true : false
    });
    campaignsStatus.Add(new SelectListItem()
    {
        Value = "2",
        Text = "InActive",
        Selected = Context.Request.Query["status"] == "2" ? true : false
    });

    List<SelectListItem> sortOptions = new List<SelectListItem>();
    sortOptions.Add(new SelectListItem()
    {
        Value = "",
        Text = "Default",
        Selected = Context.Request.Query["sortBy"] == ""

                        ? true : false
    });
    sortOptions.Add(new SelectListItem()
    {
        Value = "name",
        Text = "Name",
        Selected = Context.Request.Query["sortBy"] == "name" ? true : false
    });
    sortOptions.Add(new SelectListItem()
    {
        Value = "creation_date",
        Text = "Created On",
        Selected = Context.Request.Query["sortBy"] == "creation_date" ? true : false
    });
}
@await Html.PartialAsync("_header")
<div class="content-header clearfix">
    <h1 class="float-left">
        @T("CampaignManagement.Campaign.List.heading")
    </h1>
    <div class="float-right">
        <a class="btn btn-primary" href="@Url.Action("CampaignCreate")">
            <i class="fas fa-plus-square"></i>
            @T("admin.common.addnew")
        </a>

    </div>
</div>
<div class="form-horizontal">

    <div class="cards-group">
        <div class="card card-default card-search">
            <div class="card-body">
                <div class="search-body">
                    <form asp-controller="CampaignManagement" asp-action="List" method="get" id="campaign-form">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group row">
                                    <div class="col-md-12">
                                        <select asp-items="campaignsStatus" name="status" class="form-control"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <div class="label-wrapper">
                                            <label class="col-form-label">@T("common.orderby")</label>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <select asp-items="sortOptions" name="sortBy" class="form-control"></select>
                                            </div>
                                            <div class="col-md-2">
                                                <input type="radio" id="sortDirection" @(Context.Request.Query["sortDirection"] == "desc" || Context.Request.Query["sortDirection"] != "asc" ? "checked" : "") name="sortDirection" class="fa fa-sort-amount-down customradiowithimage" value="desc">
                                                <input @(Context.Request.Query["sortDirection"] == "asc" ? "checked" : "") type="radio" id="sortDirection" name="sortDirection" class="fa fa-sort-amount-up customradiowithimage" value="asc">


                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
        <section class="content">
            <div class="container-fluid">
                <div class="form-horizontal">
                    <div class="cards-group">
                        <div class="card card-default card-search card-popup">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                        <table class="table table-bordered table-hover table-striped dataTable no-footer" width="100%" id="associatedproducts-grid" role="grid" aria-describedby="associatedproducts-grid_info" style="width: 100%;">

                                            <tbody>
                                                @foreach (var campaign in Model)
                                                {
                                                    <tr class="odd">

                                                        <td>
                                                            <a data-id="@campaign.Id" data-type="StatusChange" class="ajaxaction" data-status="@(campaign.IsActive==true?false:true)">
                                                                <img src="@(campaign.IsActive?"/images/icons/paused.png":"/images/icons/running.png")">
                                                            </a> @campaign.Title
                                                        </td>

                                                        <td>
                                                            @Html.Raw(campaign.TimeSpan)
                                                        </td>
                                                        <td>
                                                            @campaign.Impressions<br />
                                                            @T("CampaignManagement.Impressions.Heading")
                                                        </td>
                                                        <td>
                                                            @campaign.Conversions<br />
                                                            @T("CampaignManagement.Conversions.Heading")
                                                        </td>

                                                        <td>
                                                            <a href="@Url.Action("Settings","CampaignManagement",new{campaignId=campaign.Id})">
                                                                <img src="/images/icons/Targetting.png">

                                                                @T("CampaignManagement.Targeting.Heading")
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <a data-id="@campaign.Id" data-type="Clone" class="ajaxaction">
                                                                <img src="/images/icons/clone.png">

                                                                @T("CampaignManagement.Clone.Heading")
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <a href="@Url.Action("DesignSetting","CampaignManagement",new{campaignId=campaign.Id})">
                                                                <img src="/images/icons/Design.png">

                                                                @T("CampaignManagement.Design.Heading")
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <a data-id="@campaign.Id" data-type="Delete" class="ajaxaction">
                                                                <img src="/images/icons/delete.png">

                                                                @T("CampaignManagement.Delete.Heading")
                                                            </a>
                                                        </td>

                                                     @*   <td>
                                                            <a href="">
                                                                <img src="/images/icons/Targetting.png">

                                                                @T("CampaignManagement.Preview.Heading")
                                                            </a>
                                                        </td>*@




                                                    </tr>
                                                }

                                            </tbody>
                                        </table>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('input,select').on('change', function () {
            $("#campaign-form").submit();
        });
    });
    $(document).ready(function () {
        $(".ajaxaction").click(function (e) {
            e.preventDefault();
            var formdata = new URLSearchParams();
            formdata.append(`Id`, parseInt($(this).attr("data-id")));
            formdata.append(`Actiontype`, $(this).attr("data-type"));
            if ($(this).attr("data-status")) {
                formdata.append(`Status`, $(this).attr("data-status"));
            }
            var tokenInput = $('input[name=__RequestVerificationToken]');
            if (tokenInput.length) {
                formdata += "&__RequestVerificationToken=" + tokenInput.val();
            }
            $.ajax({
                url: '@Url.Action("UpdateCampaign", "CampaignManagement")',
                type: 'POST',
                data: formdata,
                success: function (response) {
                    window.location = window.location.href;
                },
                error: function () {

                }
            });

        })
    })
</script>