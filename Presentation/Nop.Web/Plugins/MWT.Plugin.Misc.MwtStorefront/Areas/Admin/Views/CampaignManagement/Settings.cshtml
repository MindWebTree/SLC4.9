
@model CampaignTargetModel
<div class="card card-secondary card-outline">
    <div class="card-header with-border clearfix">
        <div class="card-title">
            <i class="fas fa-info"></i>@T("CampaignManagement.Campaign.Setting.heading")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("CampaignManagement.Campaign.BackToList")</a>
            </small>
        </div>
        <div class="card-tools float-right">
            <button class="btn btn-tool" data-card-widget="collapse" type="button">
                <i class="fa-minus toggle-icon fa"></i>
            </button>
        </div>
    </div>
    <style>
        .targetrow:nth-child(1) .removebtsection {
            display:none;
        }
    </style>
    <form asp-controller="CampaignManagement" asp-action="Settings" method="post" enctype="multipart/form-data">
        <input asp-for="@Model.CampaignId" type="hidden" />
        <input asp-for="@Model.IconImageSrc" type="hidden" />
        <div class="card-body">
            <div id="product-details-area">
                <div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.IsScheduled" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.IsScheduled" />
                            <div class="timeSection" style="display:@(Model.IsScheduled?"block":"none")">
                                <div class="form-group row">
                                    <div class="col-md-3">
                                        <div class="label-wrapper">
                                            <nop-label asp-for="@Model.StartDate" />
                                        </div>
                                        <div class="col-md-9">
                                            <nop-editor asp-for="@Model.StartDate" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="label-wrapper">
                                            <nop-label asp-for="@Model.EndDate" />
                                        </div>
                                        <div class="col-md-9">
                                            <nop-editor asp-for="@Model.EndDate" />
                                        </div>
                                    </div>
                                    <div class="col-md-12">

                                        Schedule will work as per the Server Time<br />
                                        Current Server Time: @DateTime.Now
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.IsExitPopup" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.IsExitPopup" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.IsGlobal" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.IsGlobal" />
                            <div class="urlconfigurations" style="display:@(Model.IsGlobal && Model.Targets.Count>0?"block":"none")">
                                @{
                                    var i = 0;
                                    foreach (var target in Model.Targets)
                                    {
                                        <div class="form-group row targetrow @(i==0?"target-firstrow":"")">
                                            <div class="col-md-12">
                                                URL:
                                            </div>
                                            <div class="col-md-5">


                                                <select class="form-control" asp-items="@Model.UrlConditions" asp-for="@Model.Targets[i].ConditionId"></select>

                                            </div>
                                            <div class="col-md-5">
                                                <input class="form-control" asp-for="@Model.Targets[i].Url" />

                                            </div>
                                            <div class="col-md-2 removebtsection" >
                                                <button type="button" class=" btn btn-primary remove">@T("ADMIN.COMMON.Remove")</button>
                                            </div>
                                        </div>
                                        i++;
                                    }
                                    if (Model.Targets.Count == 0)
                                    {
                                        <div class="form-group row targetrow target-firstrow">
                                            <div class="col-md-12">
                                                URL:
                                            </div>
                                            <div class="col-md-5">
                                              


                                                <select class="form-control valid" data-val="true" data-val-required="The ConditionId field is required." id="Targets_0__ConditionId" name="Targets[0].ConditionId" aria-describedby="Targets_0__ConditionId-error" aria-invalid="false">

                                                    @foreach (var urlCondition in Model.UrlConditions)
                                                    {
                                                        <option  value="@urlCondition.Value">@urlCondition.Text</option>

                                                    }
                                                </select>

                                            </div>
                                            <div class="col-md-5">
                                                <input class="form-control" type="text" id="Targets_0__Url" name="Targets[0].Url" value="">

                                            </div>

                                            <div class="col-md-2 removebtsection" >
                                                <button type="button" class=" btn btn-primary remove">@T("ADMIN.COMMON.Remove")</button>
                                            </div>
                                        </div>

                                    }
                                    <div class="col-md-12 add-btn">
                                        <button type="button" class="add btn btn-primary">@T("ADMIN.COMMON.ADD")</button>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.TriggerOn" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            Popup to Appear after   <nop-editor asp-for="@Model.TriggerOn" /> Second
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.FrequencyId" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="FrequencyId" asp-items="Model.CampaignFreQuency" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.DeviceType" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="DeviceType" asp-items="Model.DeviceTypes" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.Position" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="Position" asp-items="Model.PopupPositions" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.IconImage" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.HaveIconImage" />
                            <div class="iconimagesection" style="display:@(Model.HaveIconImage?"block":"none")">
                                <div>
                                    <label>
                                        @Html.RadioButtonFor(x => x.IconType, IconType.Image) &nbsp;Image
                                    </label>
                                    <label>
                                        @Html.RadioButtonFor(x => x.IconType, IconType.Html)  &nbsp;Html
                                    </label>
                                </div>
                                <div class="iconimage" style="display:@(Model.IconType==IconType.Image?"block":"none")">
                                    <div class="col-md-12">
                                        <nop-editor asp-for="@Model.IconImage" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.IconImageSrc))
                                    {
                                        <div class="col-md-12">
                                            <img src="@Model.IconImageSrc" width="100px" height="100px" />
                                        </div>
                                    }
                                </div>
                                <div class="iconhtml" style="display:@(Model.IconType==IconType.Html?"block":"none")">
                                    <div class="col-md-12">
                                        <nop-editor asp-for="@Model.IconHtml" asp-template="RichEditor" />
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.IconPosition" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-select asp-for="IconPosition" asp-items="Model.IconPositions" />
                        </div>
                    </div>
                </div>


            </div>


        </div>
        <div class="card-footer">
            <button type="submit" id="btnAddNewAssociatedProduct" class="btn btn-primary">
                @T("admin.common.save")
            </button>
        </div>
    </form>
</div>

<script>
    $("#IsScheduled").change(function () {
        if ($(this).is(":checked")) {
            $(".timeSection").show();
        }
        else {
            $(".timeSection").hide();
        }
    })
    $("input[name=\"IconType\"]").change(function () {

        if ($(this).val() == "Image") {
            $(".iconimage").show();
            $(".iconhtml").hide();

        }
        else {
            $(".iconimage").hide();
            $(".iconhtml").show();
        }
    })
    $("#HaveIconImage").change(function () {
        if ($(this).is(":checked")) {
            $(".iconimagesection").show();
        }
        else {
            $(".iconimagesection").hide();
        }
    })
    $("#IsGlobal").change(function () {
        if ($(this).is(":checked")) {
            $(".urlconfigurations").show();
        }
        else {
            $(".urlconfigurations").hide();
        }
    })


    $(document).ready(function () {
        // Function to update the visibility of the Remove button
        function updateRemoveButtonVisibility() {
            var numRows = $(".targetrow").length;
            if (numRows === 1) {
                $(".remove").hide(); // Hide the Remove button
            } else {
                $(".remove").show(); // Show the Remove button
            }
        }

        // Add button click event
        $(document).on("click", ".add", function () {
            var newRow = $(".target-firstrow:first").clone(); // Clone the current row

            // Find the number of existing rows
            var rowNumber = $(".targetrow").length + 1;

            newRow.find("select, input").each(function () {
                var name = $(this).attr("name");
                var id = $(this).attr("id");
                if (name) {
                    name = name.replace(/\[\d\]/, "[" + (rowNumber - 1) + "]");
                    $(this).attr("name", name);
                }
                if (id) {
                    id = id.replace(/\_\d\_\_/, "_" + (rowNumber - 1) + "_");
                    $(this).attr("id", id);
                }
                $(this).val(""); // Clear input field value
            });


            //$(this).closest(".form-group.row").after(newRow); // Append the new row after the current row
            // $(".urlconfigurations").append(newRow);
            newRow.insertBefore(".add-btn");
            updateRemoveButtonVisibility(); // Update the visibility of the Remove button
        });

        // Remove button click event
        $(document).on("click", ".remove", function () {
            var rowToRemove = $(this).closest(".form-group.row");
            var rowNumber = $(".form-group.row").length;

            if (rowNumber > 1) {
                rowToRemove.remove(); // Remove the current row

                // Update the input IDs and names for the remaining rows
                $(".targetrow").each(function (index) {
                    $(this).find("select, input").each(function () {
                        var name = $(this).attr("name");
                        var id = $(this).attr("id");
                        if (name) {
                            name = name.replace(/\[\d\]/, "[" + index + "]");
                            $(this).attr("name", name);
                        }
                        if (id) {
                            id = id.replace(/\_\d\_\_/, "_" + index + "_");
                            $(this).attr("id", id);
                        }
                    });
                });

                updateRemoveButtonVisibility(); // Update the visibility of the Remove button
            }
        });

        // Initially, hide the Remove button if there's only one row
        updateRemoveButtonVisibility();
    });

</script>