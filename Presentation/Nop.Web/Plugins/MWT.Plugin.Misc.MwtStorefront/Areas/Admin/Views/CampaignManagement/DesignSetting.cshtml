
@model DesignSettingmodel
<div class="card card-secondary card-outline">
    <div class="card-header with-border clearfix">
        <div class="card-title">
            <i class="fas fa-info"></i>@T("CampaignManagement.Campaign.DesignSetting.heading")
        </div>
        <div class="card-tools float-right">
            <button class="btn btn-tool" data-card-widget="collapse" type="button">
                <i class="fa-minus toggle-icon fa"></i>
            </button>
        </div>
    </div>
    <form asp-controller="CampaignManagement" asp-action="DesignSetting" method="post" enctype="multipart/form-data">
        <input asp-for="@Model.Id" type="hidden" />

        <div class="card-body">
            <div id="product-details-area">
                <div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.Name" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.Name" />

                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.TemplateId" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <select class="form-control" asp-items="@Model.Templates" asp-for="@Model.TemplateId"></select>

                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.ResponseTemplateId" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <select class="form-control" asp-items="@Model.Templates" asp-for="@Model.ResponseTemplateId"></select>

                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <nop-label asp-for="@Model.SubscribedUserResponseTemplateId" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <select class="form-control" asp-items="@Model.Templates" asp-for="@Model.SubscribedUserResponseTemplateId"></select>

                        </div>
                    </div>
                </div>


            </div>


        </div>
        <div class="card-footer">
            <button type="submit" id="btnAddNewAssociatedProduct" class="btn btn-primary">
                @T("admin.common.save")
            </button>
        </div>
    </form>
</div>

<script>
    $("#IsScheduled").change(function () {
        if ($(this).is(":checked")) {
            $(".timeSection").show();
        }
        else {
            $(".timeSection").hide();
        }
    })

    $("#HaveIconImage").change(function () {
        if ($(this).is(":checked")) {
            $(".iconimagesection").show();
        }
        else {
            $(".iconimagesection").hide();
        }
    })
    $("#IsGlobal").change(function () {
        if ($(this).is(":checked")) {
            $(".urlconfigurations").hide();
        }
        else {
            $(".urlconfigurations").show();
        }
    })
</script>