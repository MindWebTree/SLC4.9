
@model DesignModel

<form asp-controller="CampaignManagement" asp-action="TemplateUpdate" method="post" enctype="multipart/form-data">
    <input asp-for="@Model.Id" type="hidden" />

    <div class="card-body">
        <div id="product-details-area">
            <div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <div class="label-wrapper">
                            <nop-label asp-for="@Model.Name" />
                        </div>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="@Model.Name" />
                        <span asp-validation-for="Name"></span>

                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <div class="label-wrapper">
                            <nop-label asp-for="@Model.HtmlContent" />
                        </div>
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="@Model.HtmlContent" asp-template="RichEditor"  />
                        <span asp-validation-for="HtmlContent"></span>
                  
                    </div>
                </div>


            </div>
            
        

        </div>
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-9">
                @T("Template.Notes")
            </div>
        </div>

    </div>
    <div class="card-footer">
        <button type="submit" id="btnTemplate" class="btn btn-primary">
            @T("admin.common.save")
        </button>
    </div>
</form>
<script>


</script>