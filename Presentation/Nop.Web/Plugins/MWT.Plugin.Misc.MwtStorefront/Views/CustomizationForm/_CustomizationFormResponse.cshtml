@model CustomizationFormDataModel
@inject ILocalizationService _localizedService;

@{
    var interested_item_label = await _localizedService.GetResourceAsync("customizationform.intereseditems");
}
<style>
    .customform_version2 .modal-header, .customform_version1 .modal-header {
        display: none;
    }
</style>
<div class="customization-form-thankyou">
    <div class="container">
        <div id="customization-response-content">
            <p class="common">
                @T("Customizationform.Thankyou.heading")
            </p>
            <br>


            <div class="outer-thanks-message">

                <div class="col-sm-5 thanksleft">
                    <h4><u> @T("Customizationform.Thankyou.PersonalDetails.heading")</u></h4>
                    <table>
                        <tbody>
                            <tr>
                                <td valign="top"><span><b>@T("customizationform.fields.fullname"):</b></span></td>
                                <td valign="top"><span>@Model.FullName</span></td>
                            </tr>
                            <tr>
                                <td valign="top"><span><b>@T("customizationform.fields.email"):</b></span></td>
                                <td valign="top"><span>@Model.Email</span></td>
                            </tr>
                            <tr>
                                <td valign="top" s><span><b>@T("customizationform.fields.phone"):</b></span></td>
                                <td valign="top"><span>@Model.Phone</span></td>
                            </tr>
                            @if (!string.IsNullOrEmpty(Model.ZipCode))
                            {
                                <tr>
                                    <td valign="top"><span><b>@T("customizationform.fields.zipcode"):</b></span></td>
                                    <td valign="top"><span>@Model.ZipCode</span></td>
                                </tr>
                            }
                            @foreach (var prop in Model.customProps)
                            {
                                if (prop.Key == interested_item_label)
                                {
                                    <tr>
                                        <td valign="top" style="width:140px; white-space: nowrap;"><span><b>@prop.Key:</b></span></td>
                                        <td valign="top"><span>@prop.Value</span></td>
                                    </tr>
                                }
                            }
                            <tr>
                                <td valign="top" style="width:140px; white-space: nowrap;"><span><b>@T("customizationform.fields.additionalnotes"):</b></span></td>
                                <td valign="top"><span>@Model.Message</span></td>
                            </tr>
                        </tbody>
                    </table>
                    <br>
                </div>

                <div class="col-sm-7 thanks2right">
                    <h4><u> @T("Customizationform.Thankyou.ProductDetails.heading") </u></h4>
                    <div class="col-md-12 manual12">
                        <div class="col-md-8 manual12">
                            <table>
                                <tbody>

                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(Model.Picture))
                                            {
                                                <div class="col-md-4 prodimg"><img src="@Model.Picture" alt="ProductImg" height="100px" width="100px"></div>
                                            }
                                        </td>
                                        <td style="vertical-align:top;">
                                            <table>
                                                <tbody>
                                                    <tr>
                                                        <td valign="top" style="width:120px; white-space: nowrap;"><span><b>@T("customizationform.fields.productname"):</b></span></td>
                                                        <td valign="top"><span class="thankyou-p-name">@Model.ProductName</span></td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="top" style="width:120px; white-space: nowrap;"><span><b>@T("customizationform.fields.sku"):</b></span></td>
                                                        <td valign="top"><span>@Model.SKU</span></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                    @foreach (var prop in Model.customProps)
                                    {
                                        if (prop.Key != interested_item_label)
                                        {
                                            <tr>
                                                <td valign="top" style="width:140px; white-space: nowrap;"><span><b>@prop.Key:</b></span></td>
                                                <td valign="top"><span>@Html.Raw(prop.Value)</span></td>
                                            </tr>
                                        }
                                    }

                                    @if (Model.Attachments.Count > 0)
                                    {
                                        <tr>
                                            <td valign="top" style="width:140px; white-space: nowrap;" colspan="2"><span><b>@T("Customizationform.Fields.Attachment")</b></span></td>
                                        </tr>
                                        <tr>
                                            <td valign="top" class="attachments">

                                                @foreach (var attachment in Model.Attachments)
                                                {
                                                    @if (attachment.Value)
                                                    {
                                                        <span><img src="@attachment.Key" height="100px" width="100px" /></span>

                                                    }
                                                    else
                                                    {
                                                        <a target="_blank" href="@attachment.Key"> @T("Customizationform.Fields.Attachment.Link")</a>
                                                    }

                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <br>

                    <br>
                </div>
            </div>
        </div>
        <div class="print-continue-btns">
            <a href="#" onclick="printCustomizationFormResponse();" class="">
                <input type="button" class="btn" value="">
                <svg viewBox="0 0 25 25" class="icon-print" data-test-id="pip-print-icon-ds">
                    <title>Print</title>
                    <path fill="currentColor" fill-rule="nonzero" d="M20.12 5.109h-1.011V1H6.304v4.065h-1.01A4.772 4.772 0 0 0 .532 9.826v5.641a4.76 4.76 0 0 0 4.532 4.74v.13a2.74 2.74 0 0 0 2.728 2.728h9.783a2.74 2.74 0 0 0 2.728-2.728v-.087a4.76 4.76 0 0 0 4.533-4.74V9.87a4.772 4.772 0 0 0-4.717-4.761ZM7.826 2.565h9.783V5.11H7.826V2.565Zm9.783 19.022H7.826c-.666 0-1.206-.54-1.206-1.207v-5.826c0-.666.54-1.206 1.206-1.206h9.783c.666 0 1.206.54 1.206 1.206v5.826a1.207 1.207 0 0 1-1.195 1.218l-.011-.011Zm5.75-6.076a3.26 3.26 0 0 1-3.011 3.26v-4.217a2.74 2.74 0 0 0-2.728-2.684H7.837a2.74 2.74 0 0 0-2.728 2.728v4.174a3.26 3.26 0 0 1-3.011-3.261V9.87c0-1.801 1.46-3.261 3.26-3.261H20.12c1.8 0 3.26 1.46 3.26 3.26v5.642h-.021Z">
                    </path>
                </svg>
            </a>
            <h5><a href="/" data-bs-dismiss="modal" aria-label="Close">@T("shoppingcart.continueshopping")</a></h5>
        </div>

        <br><br>
        <!-- Contents end -->
    </div>
</div>
<style>
    @@media print {

        #product-details-pairwith, #product-details-collection, .complete-collection, .people-viewed-section, .customize-banner, .shop-by-category, .product-review-block, footer, .footer-menu, .header-menu, .header-lower, .navbar, .admin-header-links, .tariff-banner, header, .col-sm-8.product-image, #productdetail-accordion, .you-may-also-need-section, .stock-subscription-section, .price-without-offer.price-shade-section, .price-shade-section, .producttags, header, .modal-header, #productdetail-accordion, .header-message {
            display: none !important;
        }

        .modal-dialog-centered {
            align-items: self-start;
        }

        body {
            visibility: hidden;
            min-height: 100%;
            float: left;
            width: 100%;
            height: 1000px;
            position: fixed
        }

        #customization-response-content {
            visibility: visible;
        }

        #customization-response-content {
            max-height: 500px !important;
            page-break-inside: avoid;
        }
    }
</style>
<script>
    function printCustomizationFormResponse() {


        window.print();


    }

</script>