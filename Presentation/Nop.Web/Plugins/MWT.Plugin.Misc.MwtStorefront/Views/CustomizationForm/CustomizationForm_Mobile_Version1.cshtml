@model CustomizationFormModel
@inject Nop.Core.IStoreContext _storeContext
@inject IWorkContext _workContext
@inject Nop.Services.Configuration.ISettingService _settingService;
@inject Nop.Services.Localization.ILocalizationService _localizationService;
@using Nop.Core.Domain.Common;
@inject Nop.Services.Directory.ICountryService _countryService
@inject Nop.Services.Common.IAddressService _addressService
@inject Nop.Core.IStoreContext _storeContext
@{
    var storeEmail = await _settingService.GetSettingByKeyAsync<string>("store.email");
    string uploadTypes_Expression = await _settingService.GetSettingByKeyAsync<string>("Customizationform.Supported.UploadTypes.Expression");
    var store = _storeContext.GetCurrentStore();
    var mail = await _settingService.GetSettingByKeyAsync<string>("store.email");
    var sizeASttr = await _localizationService.GetResourceAsync("Product.Attr.Size");
    Address shippingAddress = new Address();
    Address billingAddress = new Address();
    var customer = await _workContext.GetCurrentCustomerAsync();
    string shippingCountry = "";
    string billingCountry = "";
    if (customer != null)
    {
        if (customer.ShippingAddressId.HasValue && customer.ShippingAddressId.Value > 0)
        {
            shippingAddress = await _addressService.GetAddressByIdAsync(customer.ShippingAddressId.Value);
            if (shippingAddress.CountryId.HasValue && shippingAddress.CountryId.Value > 0)
            {
                shippingCountry = (await _countryService.GetCountryByIdAsync(shippingAddress.CountryId.Value))?.Name ?? "";
            }
        }

        if (customer.BillingAddressId.HasValue && customer.BillingAddressId.Value > 0)
        {
            billingAddress = await _addressService.GetAddressByIdAsync(customer.BillingAddressId.Value);
            if (billingAddress.CountryId.HasValue && billingAddress.CountryId.Value > 0)
            {
                billingCountry = (await _countryService.GetCountryByIdAsync(billingAddress.CountryId.Value))?.Name ?? "";
            }
        }
    }
}
