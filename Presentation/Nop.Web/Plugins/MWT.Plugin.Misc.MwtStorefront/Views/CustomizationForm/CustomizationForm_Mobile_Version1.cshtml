<script type="text/javascript">

    $(document).ready(function () {
        $(".customization-product-sub-images a").click(function (e) {
            $(".main-customization-image").attr("src", $(this).attr("data-image"));
            e.preventDefault();
        })
        $('.jcarousel').jcarousel({
            wrap: 'circular' // Allow infinite scrolling
        });
        $('.customization-product-sub-images.jcarousel').jcarousel({
            wrap: 'circular' // Allow infinite scrolling
        });
        $('.customization-product-sub-images.jcarousel').on('jcarousel:visiblein', 'li', function (event, carousel) {
            $(this).addClass('visible');
        });

        $('.customization-product-sub-images.jcarousel').on('jcarousel:visibleout', 'li', function (event, carousel) {
            $(this).removeClass('visible');
        });

        $('.customization-product-sub-images .jcarousel-control-prev').click(function () {
            $('.jcarousel').jcarousel('scroll', '-=1');
            return false;
        });
        $('.customization-product-sub-images .jcarousel-control-next').click(function () {
            $('.jcarousel').jcarousel('scroll', '+=1');
            return false;
        });
            $.validator.unobtrusive.parse("#CustomizationForm");
            $('.attributes input,.attributes select').each(function () {
                console.log($(this).prop("nodeName"));
                if ($(this).val() != 0 && $(this).prop("nodeName") == "SELECT") {
                    console.log($('#custom_' + $(this).attr("id")));
                    $('#custom_' + $(this).attr("id")).val($(this).val()).change();
                }
                else {
                    if ($(this).prop('checked')) {
                        $('#custom_' + $(this).attr("id")).click();
                    }
                }
            })


            x = $(".customform-attributes .custom-select");
            l = x.length;
            for (i = 0; i < l; i++) {
                customDropDown(x[i]);
            }
        });


    $(function () {
        var btnId = '#btnsubmitcustomizationform';
        $('#CustomizationForm').on('submit', function (e) {
            e.preventDefault();
            var _form = $("#CustomizationForm");
            $.validator.unobtrusive.parse(_form);
            $(_form).validate();
            if (!$(_form).valid())
                return;
            if ($("#consent1").length > 0) {
                if (!$("#consent1").prop("checked")) {
                    $(".customize-form-consent-section").addClass("invalid");
                    $("#consent1").focus();
                    return;
                }
                else {

                    $(".customize-form-consent-section").removeClass("invalid");
                }
            }
            $("#CustomizationForm #Phone span[data-valmsg-for='Phone']").removeClass("field-validation-error");
            $("#CustomizationForm span[data-valmsg-for='Phone']").html('<span id="field-validation-error" class=""></span>');
            if ($("#CustomizationForm #Phone").val().trim().length > 0) {
                if (!validatePhoneNumber($("#CustomizationForm #Phone").val())) {
                    $("#CustomizationForm #Phone").addClass("input-validation-error");
                    $("#CustomizationForm span[data-valmsg-for='Phone']").removeClass("field-validation-valid");
                    $("#CustomizationForm span[data-valmsg-for='Phone']").addClass("field-validation-error");
                    $("#CustomizationForm span[data-valmsg-for='Phone']").html('<span id="field-validation-error" class="">'
                        + '@T("Account.Fields.Phone.NotValid")' + '</span>');
                    return;
                }
            }
            if ($("#CustomizationForm #ZipCode").length > 0) {
                if (!ValidateZipCode($("#CustomizationForm #ZipCode").val())) {
                    $("#CustomizationForm #ZipCode").addClass("input    -validation-error");
                    $("#CustomizationForm span[data-valmsg-for='ZipCode']").removeClass("field-validation-valid");
                    $("#CustomizationForm span[data-valmsg-for='ZipCode']").addClass("field-validation-error");
                    $("#CustomizationForm span[data-valmsg-for='ZipCode']").html('<span id="field-validation-error" class="">'
                        + '@T("Account.Fields.Zipcode.NotValid")' + '</span>');
                    return;
                }
            }
            $(btnId).prop("disabled", true);
            $(btnId + " span").addClass("d-none");
            $(btnId + " svg").removeClass("d-none");
            $(".customization-form-body .alert-danger").html("");
            $(".customization-form-body .alert-danger").addClass("d-none");

            var formData = new FormData($("#CustomizationForm")[0]);
            $('.custom.custom-size-tr input').prop('disabled', true);
            $.ajax({
                url: _form.attr("action"),
                type: 'POST',
                data: formData,
                async: true,
                cache: false,
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.Success) {
                        // advamce google ads data

                        var email = $(".customizationformBody #Email").val();
                        var phoneNumber = $(".customizationformBody #Phone").val();
                        var zipCode = $(".customizationformBody #ZipCode").val();
                        var name = $(".customizationformBody #FullName").val();
                        phoneNumber = phoneNumber.replace(/ /g, "").replace(/-/g, "");
                        phoneNumber = "+1" + phoneNumber;
                        var firstName = name.split(' ')[0];

                        var lastName = name.split(' ').length > 1 ? name.split(' ').slice(1).join(' '):"";

                        var addresses = [];


                            addresses.push({
                                "first_name": firstName, "last_name": lastName, "street": '@shippingAddress?.Address1'
                                , "city": '@shippingAddress?.City', "region": '@shippingAddress?.County',
                                "postal_code": zipCode, "country": '@shippingCountry'});

                           if (@(billingAddress?.Id??0) > 0) {

                            addresses.push({
                                "first_name": '@billingAddress?.FirstName', "last_name": '@billingAddress?.LastName',
                                "street": '@billingAddress?.Address1'
                                , "city": '@billingAddress?.City', "region": '@billingAddress?.County',
                                "postal_code": '@billingAddress?.ZipPostalCode', "country": '@billingCountry'});
                        }

                        //if (gtag) {
                        //    gtag('set', 'user_data', {
                        //        "email": email,
                        //        "phone_number": phoneNumber,
                        //        "address": addresses
                        //    });
                        //}
                        // end
                        if (typeof gtag_TTT_CustomProduct_report_conversion === "function") {
                            gtag_TTT_CustomProduct_report_conversion({
                                "email": email,
                                "phone_number": phoneNumber,
                                "address": addresses
                            });
                        }
                        if (window.uetq) {
                            window.uetq = window.uetq || [];
                            window.uetq.push('event', 'submit_lead_form', {});
                        }
                        $(".customization-form-body").html(data.content);
                    }
                    else {
                           $('.custom.custom-size-tr input').prop('disabled', false);
                        $(".customization-form-body .alert-danger").removeClass("d-none");
                        $(".customization-form-body .alert-danger").html(data.content);
                    }
                    $(btnId).prop("disabled", false);
                    $(btnId + " span").removeClass("d-none");
                    $(btnId + " svg").addClass("d-none");
                },
                error: function (xhr) {
                    $(".customization-form-body .alert-danger").removeClass("d-none");
                    $(".customization-form-body .alert-danger").html(xhr);
                    $(btnId).prop("disabled", false);
                    $(btnId + " span").removeClass("d-none");
                    $(btnId + " svg").addClass("d-none");
                }
            });


        });

    });

    function validatePhoneNumber(phoneNumber) {
        var regex = new RegExp("^[0-9]{3}-[0-9]{3}-[0-9]{4}$");
        return regex.test(phoneNumber);
    }
    $(document).ready(function () {
        setTimeout(function () {

            if ($("#zsiq_maintitle").text().toLowerCase().indexOf("online") > 0) {
                try {
                    if ($("#zsiq_maintitle").text().toLowerCase().indexOf("online") > 0)
                        $(".chatdiv").addClass("online-user");
                }
                catch (ex) { }
            }
        }, 4000);
        $("body").on("keyup paste", "#CustomizationForm #Phone", function (e)   {
            $("#CustomizationForm #Phone span[data-valmsg-for='Phone']").removeClass("field-validation-error");
            $("#CustomizationForm #Phone").removeClass("input-validation-error");
            // Remove invalid chars from the input
            var input = this.value.replace(/[^0-9\(\)\s\-]/g, "");
            var inputlen = input.length;
            // Get just the numbers in the input
            var numbers = this.value.replace(/\D/g, '');
            var numberslen = numbers.length;
            // Value to store the masked input
            var newval = "";

            // Loop through the existing numbers and apply the mask
            for (var i = 0; i < numberslen; i++) {
                if (i == 0) newval = numbers[i];
                else if (i == 3) newval += "-" + numbers[i];
                else if (i == 6) newval += "-" + numbers[i];
                else newval += numbers[i];
            }

            // Re-add the non-digit characters to the end of the input that the user entered and that match the mask.
            if (inputlen >= 1 && numberslen == 0 && input[0] == "-") newval = "";
            else if (inputlen >= 6 && numberslen == 3 && input[4] == ")" && input[5] == " ") newval += "";
            else if (inputlen >= 5 && numberslen == 3 && input[4] == ")") newval += "-";
            else if (inputlen >= 6 && numberslen == 3 && input[5] == " ") newval += " ";
            else if (inputlen >= 10 && numberslen == 6 && input[9] == "-") newval += "-";

            $(this).val(newval.substring(0, 12));
        });
    });

    function ValidateZipCode(zipcode) {
  return zipcode.length > 7 || zipcode.length < 5 ? false : true;
    }

