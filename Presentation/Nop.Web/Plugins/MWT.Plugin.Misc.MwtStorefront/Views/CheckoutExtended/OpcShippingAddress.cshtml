
@model CheckoutAddressModel

<div class="section address-item col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
    <div class="step-title"><h2>@T("opc.heading.ShippingAddress")</h2></div>
    <ul class="info">
        <li class="name">
            @Model.FullName
        </li>
        @if (Model.StreetAddressEnabled)
        {
            <li class="address1">
                @Model.Address1
            </li>
        }
        @if (Model.StreetAddress2Enabled && !string.IsNullOrEmpty(Model.Address2))
        {
            <li class="address2">
                @Model.Address2
            </li>
        }


        <li class="address2">

            @Model.StateProvinceName , @Model.CountryTwoLetterSeoCode @Model.ZipPostalCode
        </li>


        <li class="phone">
            @Model.PhoneNumber
        </li>
        <li>
            <button class="shipping-address-edit" type="button" onclick="customerInfo.editaddress()" aria-label="Edit shipping address">@T("Common.Edit")</button>
        </li>
    </ul>

</div>

<script asp-location="Footer">
    $(document).ready(function () {
        $("body").on("click", ".shipping-address-edit", function () {
            $("#co-customerinfo-form .section.address-item").addClass("inactive");
            $(".checkout-shipping-address-form").removeClass("d-none");
            $("#checkout-step-customerinfo .checkoutdesktopbtn").addClass("d-none");
            $("#checkout-step-customerinfo .shipping-address-button").removeClass("d-none");
        })
    });

</script>