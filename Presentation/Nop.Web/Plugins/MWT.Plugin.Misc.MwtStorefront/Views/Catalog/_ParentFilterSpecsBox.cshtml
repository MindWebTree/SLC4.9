@model CustomSpecificationFilterModel
@inject Nop.Core.IWorkContext _workContext
<script>
    var filterAttr = '@string.Join( ",",Model.Attributes.Select(m=>m.Name.ToLower().Trim()).ToArray())';

</script>
<h4 class="filter-by-title d-sm-none">@T("Filtering.SpecificationFilter")</h4>

<div class="@(_workContext.IsMobileDevice()?"mobile":"sideFilters") filter-content">
    @foreach (var attr in Model.Attributes)
    {
        <div class="card-header collapsed @(attr.Values.Any(x => !string.IsNullOrEmpty(x.ColorSquaresRgb)) ? "product-spec-color" : null )"
             data-bs-toggle="collapse" href="#collapse_@attr.Id" id="filter-btn-@attr.Id" data-filter-name="@(attr.Id == -1 ? attr.Sename : attr.Name)">
            <span class="card-title">
                <strong>@attr.Name</strong>
            </span>
        </div>
        <div id="collapse_@attr.Id" class="card-body collapse">
            @foreach (var value in attr.Values)
            {
                @if (attr.Id == -1)
                {
                    <input id="attribute-option-@value.Id" type="radio" data-parent-filterId="@attr.Id" data-filter-name="@value.Id" data-option-id="@value.Id" checked="@value.Selected" name="category" class="filtercheckbox popupfilter catpopfilter" />

                }
                else
                {
                    <input id="attribute-option-@value.Id" type="checkbox" data-parent-filterId="@attr.Id" data-filter-name="@value.Sename" data-option-id="@value.Id" checked="@value.Selected" class="filtercheckbox popupfilter" />
                }
                @if (string.IsNullOrEmpty(value.ColorSquaresRgb))
                {
                    <label for="attribute-option-@value.Id">
                        @value.Name
                        <span class="count">(@value.Count)</span>
                    </label>
                }
                else
                {
                    <label for="attribute-option-@value.Id" class="attribute-squares color-squares">
                        <span class="attribute-square" style="background-color: @(value.ColorSquaresRgb);"></span>
                        @value.Name
                    </label>
                }
                <br />
            }
        </div>
    }

</div>
@if (_workContext.IsMobileDevice())
{

    <script asp-location="Footer">
        $(document).ready(function () {
            $(CatalogProducts).on('before', function (e) {
                var options = [];
                var selected_options = $.map($('[data-option-id]'), function (el) {
                    var $optionEl = $(el);
                    if ($optionEl.is(':checked')) {

                        var parentName = "";
                        var parent = $("#filter-btn-horizonatal-" + $optionEl.data("parent-filterid"));
                        if (parent.length) {
                            parentName = $(parent).data("filter-name");
                        }
                        else {
                            parent = $("#filter-btn-" + $optionEl.data("parent-filterid"));
                            parentName = $(parent).data("filter-name");
                        }
                        var attrName = $optionEl.data("filter-name")
                        if (options.length == 0) {
                            options.push({ name: parentName, values: [attrName], isProcessed: false, isExternal: false });
                        }
                        else {
                            var obj = options.find(x => x.name === parentName);
                            if (obj === undefined || obj === null)
                                options.push({ name: parentName, values: [attrName], isProcessed: false, isExternal: false });
                            else {
                                obj.values.push(attrName);
                            }
                        }
                        $optionEl.data('option-id');
                    }
                    return null;
                });
                options = orderingOfFilters(options);
                if (options && options.length > 0) {

                    $(options).each(function (index, option) {
                        if (option.isExternal == false) {
                            if (option.name.toLowerCase().trim() == "categoryid") {
                                e.payload.urlBuilder
                                    .addParameter(option.name, option.values.join(","));
                            }
                            else {
                                e.payload.urlBuilder
                                    .addParameter(option.name, '[' + option.values.join(",") + ']');
                            }
                        }
                        else {
                            e.payload.urlBuilder
                                .addParameter(option.name, option.values.join(","));
                        }
                    });
                }
            });
            $("body").on("click", ".filters  .btncancel", function (e) {
                e.preventDefault();
                $(".filtercheckbox").each(function () {
                    if ($(this).attr("data-parent-filterId") != -1) {
                        $(this).prop("checked", false);
                    }
                });

                // Delete filters
                $(".selectedFilters .selections").remove();
                // end

                // Hide Clear All
                $(".inline-clear-all a").parent().parent().hide();

                // Load Filters
                CatalogProducts.getProducts();
                $(".filters .navbar-toggler-icon").click();
            });

            $("body").on("click", ".filters  .btnapply", function (e) {
                e.preventDefault();
                var elements = $('.popupfilter');


                // Hide Clear All

                var isFilterSelected = false;
                $(elements).each(function () {
                    var optionId = $(this).attr("data-option-id");
                    if ($("[data-option-id=" + optionId + "]")) {
                        if ($(this).prop('checked') == true) {
                            if ($(this).attr("data-parent-filterId") != -1) {
                                if ($(".selectedFilters").find("button[data-option-id=\"" + optionId + "\"]").length == 0)
                                    $(".inline-clear-all").after('<span class="selections"><button data-style="button" aria-label="" type="button" data-option-id="' + optionId + '" class="cta"><span class="selections-close">×</span> <span>' + $('label[for="attribute-option-' + optionId + '"]').contents().filter(function () {
                                        return this.nodeType === Node.TEXT_NODE;
                                    }).text() + '</span></button></span>');

                                isFilterSelected = true;

                                if ($("[data-option-id=" + optionId + "]").prop('checked') != true) {
                                    $("[data-option-id=" + optionId + "]").prop("checked", true);
                                }
                            }
                            if ($("[top-data-option-id=" + optionId + "]").length > 0) {
                                $("[top-data-option-id=" + optionId + "]").prop("checked", true);
                            }
                        }
                        else {
                            if ($("[top-data-option-id=" + optionId + "]").length > 0) {
                                $("[top-data-option-id=" + optionId + "]").prop("checked", false);
                            }
                            $(".selectedFilters").find("button[data-option-id=" + optionId + "]").parent().remove();
                        }
                    }
                });
                if (isFilterSelected)
                    $(".inline-clear-all a").parent().parent().show();
                else
                    $(".inline-clear-all a").parent().parent().hide();


                // Load Filters
                CatalogProducts.getProducts();
                $(".filters .navbar-toggler-icon").click();
            });

        });

        function orderingOfFilters(options) {
            var _options = [];
            const params = new URLSearchParams(window.location.search);

            for (var key of params.keys()) {
                var obj = options.find(x => x.name === key);
                if (obj !== undefined && obj !== null) {
                    _options.push(obj);
                    obj.isProcessed = true;
                }
                else {
                    if (key != "@T("SortOption.Query.Param")" && key != "@T("Pagenumber.Query.Param")" && key != "@T("viewall.Query.Param")") {

                        if (!filterAttr.split(",").includes(key.toLowerCase().trim(), 0))
                            _options.push({ name: key, values: [params.get(key)], isExternal: true });
                    }
                }
            }

            $(options).each(function (index, option) {
                if (option.isProcessed == false) {
                    _options.push(option);
                }
            });
            return _options;
        }



        $(document).ready(function () {

            $("body").on('change', '[data-option-id]', function (e) {
                var isCategoryFilterSelected = false;
                if ($(this).hasClass("catpopfilter")) {
                    var optionId = $(this).attr("data-option-id");
                    if ($(this).attr("data-parent-filterId") == -1) {
                        isCategoryFilterSelected = true;

                        $(".filtercheckbox").each(function () {
                            if ($(this).attr("data-option-id") != optionId)
                                $(this).prop("checked", false);
                        });
                        $(".selectedFilters .selections").remove();
                        $(".inline-clear-all").hide();
                    }
                    // end
                    CatalogProducts.getProducts();
                }
            });
        });
    </script>
}
