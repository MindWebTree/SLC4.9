@model SpecificationFilterModel
@using System.Linq;

@{
    int index = 0; int noOfFiltersToShow = 5;
    List<int> openTabs = new List<int>();

    if (ViewData["openTabs"] != null)
    {
       
        openTabs = (List<int>)ViewData["openTabs"];
    }
}

@foreach (var attr in Model.Attributes)
{
    index++;
    if (index > noOfFiltersToShow)
    {
        continue;
    }
    <div class="custom-select col-2 hrfiltersection">
        <div class=" subfiltersdrp">
            <button class="btn btn-info btn-sm dropdown-toggle btndropdown" type="button">
                <p class="mt-0 mp-0 pr-0 mb-0" id="filter-btn-horizonatal-@attr.Id" data-filter-name="@(attr.Id==-1?attr.Sename:attr.Name)">@attr.Name</p>
                <i class="@(openTabs.Contains(attr.Id)?"up-arrow":"down-arrow")"></i>
            </button>
            @*<div class="card-header collapsed @(attr.Values.Any(x => !string.IsNullOrEmpty(x.ColorSquaresRgb)) ? "product-spec-color" : null )"
        data-bs-toggle="collapse" href="#collapse_@attr.Id">
        <span class="card-title">
        <strong>@attr.Name</strong>
        </span>
        </div>*@

            <ul class="dropdown-menu @(openTabs.Contains(attr.Id)?"show":"")" style="display:@(openTabs.Contains(attr.Id)?"block;":"")">
                @foreach (var value in attr.Values)
                {
                    <li>
                        <div class="radio-btn">
                            @if (attr.Id == -1 )
                            {
                               <input id="attribute-option-@value.Id" type="radio"
                                       data-parent-filterId="@attr.Id" data-option-id="@value.Id"  data-filter-name="@value.Id" checked="@value.Selected" class="filtercheckbox" />
                            }
                            else
                            {
                                <input id="attribute-option-@value.Id" type="checkbox" data-parent-filterId="@attr.Id" data-option-id="@value.Id" data-filter-name="@value.Sename" checked="@value.Selected" class="filtercheckbox" />
                            }
                            @if (string.IsNullOrEmpty(value.ColorSquaresRgb))
                            {
                                <label for="attribute-option-@value.Id">
                                    @value.Name
                                    <span class="count">@value.Count</span>
                                </label>
                            }
                            else
                            {
                                <label for="attribute-option-@value.Id" class="attribute-squares color-squares">
                                    <span class="attribute-square" style="background-color: @(value.ColorSquaresRgb);"></span>
                                    @value.Name
                                </label>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
}
@if (index > noOfFiltersToShow)
{
    <div class="show-all-filters col-2">
        <button id="ShowAllFilters" type="button" class="btn btn-info btn-lg">@T("Txt.Category.AllFilters")</button>
    </div>
}





