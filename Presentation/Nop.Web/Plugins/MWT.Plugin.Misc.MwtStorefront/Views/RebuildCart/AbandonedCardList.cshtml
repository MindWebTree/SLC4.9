@using MWT.Plugin.Misc.MwtStorefront.Models.AbandonedCarts
@model List<AbandonedCartModel>
@inject Nop.Core.IWorkContext _workcontext
@inject Nop.Services.Catalog.IPriceFormatter _priceFormatter

<br />
<br />

@{
    if (Model.Count > 0)
    {
    <table class="table">
        <tr>
            <th>Email</th>
            <th>InvoiceId</th>
            <th>NoOfItems</th>
            <th>CreatedOn</th>
            <th>Link</th>
        </tr>
        @foreach (var cart in Model)
        {
            <tr>
                <th>@cart.Customer?.Email</th>
                <th>@cart.InvoiceId</th>
                <th>@cart.NoOfCartItem</th>
                <th>@cart.CreatedOn</th>
                <th>@Url.RouteUrl("RebuildCart",new { invoiceId= cart.InvoiceId })</th>
            </tr>

        }
    </table>

    }
    else
    {
        @T("admin.dt.infoempty")
    }

}