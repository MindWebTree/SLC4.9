@model PasswordRecoveryModel
@using Nop.Core
@using Nop.Core.Domain.Seo
@inject IWebHelper webHelper
@inject SeoSettings seoSettings
@inject Nop.Services.Configuration.ISettingService _settingService;
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.PasswordRecovery").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-password-recovery-page");
    if (seoSettings.CanonicalUrlsEnabled)
    {
        NopHtml.AddCanonicalUrlParts(Url.RouteUrl("PasswordRecovery", null, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant(), false);
    }
    NopHtml.AddMetaDescriptionParts(await _settingService.GetSettingByKeyAsync<string>("seosettings.PasswordRecovermetadescription"));
}
<div class="page password-recovery-page">
    <div class="page-title">
        <h1>@T("Account.PasswordRecovery")</h1>
    </div>
    <div class="page-body">
      
        <form asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY" method="post">
            <div asp-validation-summary="ModelOnly" class="message-error"></div>
            <p >@T("Account.PasswordRecovery.Tooltip")</p>
            <div class="fieldset">
                <div class="form-fields">
                    <div class="form-group">
                        <div class="row">
                           
                            <div class="col-12">
                                <input asp-for="Email" class="email form-control" placeholder="Enter your email" />
                            </div>
                        
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                <span asp-validation-for="Email"></span>
                            </div>
                        </div>
                    </div>
                    @if (Model.DisplayCaptcha)
                    {
                        <div class="form-group">
                            <div class="row">
                                <div class="col-12 col-sm-8 offset-md-4 offset-lg-4 offset-xl-4">
                                    <nop-captcha class="g-recaptcha" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="buttons">
                <button type="submit" name="send-email" class="button-1 btn btn-primary password-recovery-button">@T("Account.PasswordRecovery.RecoverButton")</button>
            </div>
        </form>
    </div>
</div>