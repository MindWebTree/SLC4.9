@using Nop.Core.Domain.Seo
@using Nop.Services.Localization
@using Nop.Core
@inject ILocalizationService localizationService
@inject IStoreContext storeContext
@inject Nop.Services.Configuration.ISettingService _settingService;
@inject SeoSettings seoSettings
@inject Nop.Core.IWebHelper webHelper
@{
    Layout = "_ColumnsOne";
    var controllerName = this.ViewContext.RouteData.Values["controller"].ToString();
    var action = this.ViewContext.RouteData.Values["action"].ToString();
    bool isHome = String.Compare(controllerName, "home",
        StringComparison.OrdinalIgnoreCase) == 0 && String.Compare(action, "index",
        StringComparison.OrdinalIgnoreCase) == 0 ? true : false;
    var homepageTitle = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), s => s.HomepageTitle);

    //title
    if (!string.IsNullOrEmpty(homepageTitle))
    {
        NopHtml.AddTitleParts(homepageTitle);
    }

    var homepageDescription = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), s => s.HomepageDescription);

    //meta
    if (!string.IsNullOrEmpty(homepageDescription))
    {
        NopHtml.AddMetaDescriptionParts(homepageDescription);
    }
    if (seoSettings.CanonicalUrlsEnabled)
    {
        NopHtml.AddCanonicalUrlParts(Url.RouteUrl("Homepage", null, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant(), false);
    }
    //page class
    NopHtml.AppendPageCssClassParts("html-home-page");
    string productIds = await _settingService.GetSettingByKeyAsync<string>("CatalogSettings.HomePage.FeaturedProducts.productids");

    string collectionProductIds = await _settingService.GetSettingByKeyAsync<string>("CatalogSettings.HomePage.CollectionProducts.productids");
    int collectionNoOfProductsToDisplay = await _settingService.GetSettingByKeyAsync<int>("CatalogSettings.HomePage.CollectionProducts.NoOfProductsToDisplay");

    string topSellerproductIds = await _settingService.GetSettingByKeyAsync<string>("CatalogSettings.HomePage.TopSeller.productids");
    int topsellerNoOfProductsToDisplay = await _settingService.GetSettingByKeyAsync<int>("CatalogSettings.HomePage.TopSeller.NoOfProductsToDisplay");
}
<div class="page home-page">
    <div class="page-body">
        @if (await _settingService.GetSettingByKeyAsync<bool>("Enable.Nivo.Slider"))
        {
            <div class="banner-section homepagebannersection">
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageTop })
            </div>
        }
        else
        {
            <div class="banner-section homepagebannersection-version2">
                @if (!_useragentContext.IsMobileDevice())
                {
                    @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Desktop.Home.Page.Slider" })
                }
                else
                {
                    @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Mobile.Home.Page.Slider" })
                }

            </div>
        }
        <div class="@(isHome ? "container-fluid p-0" : "")">

 
            @await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "HomepageText" })
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeCategories })
            @await Component.InvokeAsync("CustomHomepageCategories")
            @*             @await Component.InvokeAsync(typeof(FilterLevelValueSearchViewComponent)) *@
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeProducts })

            @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Homepage.HandcCrafted.Section" })

            @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Homepage.HandcCrafted.Categories.Section" })

            @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "HomePage.DesignMonth" })

            @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Homepage.Collection.Section" })

            @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Homepage.Collection.Categories" })

            @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Homepage.NewArrival.Section" })

            @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Homepage.Design.Heighlights.Section" })

            @await Component.InvokeAsync("Custom_Product_Listing_by_Setting", new
            {
                productIds = topSellerproductIds,
                        heading = await localizationService.GetResourceAsync("Heading.TopSeller"),
                        sectionId = "section_topseller",
                        noOfProductsToDisplay = topsellerNoOfProductsToDisplay,
                        type = ProductType.SimpleProduct
                        })

            @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "HomePage.Customization.Section" })

            @await Component.InvokeAsync("Custom_RecentlyViewedProductsBlock")
            @*             @await Component.InvokeAsync(typeof(HomepageProductsViewComponent))
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeBestSellers }) *@ 
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBottom })
        </div>
    </div>
</div>
