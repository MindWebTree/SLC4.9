@model ShoppingCartModel.DiscountBoxModel
@inject Nop.Services.Orders.IShoppingCartService _shoppingCartService
@inject Nop.Services.Customers.ICustomerService _customerService
@inject Nop.Core.IWorkContext _workcontext
@{
    var customer = await _workcontext.GetCurrentCustomerAsync();
}
@if (Model.Display)
{
    <div class="coupon-box">

        <div class="form-group">
            <div class="row">

                <div class="coupon-code col-12 col-sm-12 col-md-6 col-lg-12 col-xl-12">
                    <input name="discountcouponcode" id="discountcouponcode" type="text" class="discount-coupon-code form-control" aria-label="@T("ShoppingCart.DiscountCouponCode.Label")" />
                    <button type="submit" name="customapplydiscountcouponcode" id="applydiscountcouponcode"
                            class="button-2 btn btn-default apply-discount-coupon-code-button">
                        @T("ShoppingCart.DiscountCouponCode.Button")
                    </button>
                </div>
                @if (!await _customerService.IsRegisteredAsync(customer))
                {
                    <div class="coupon-code col-12 col-sm-12 col-md-6 col-lg-12 col-xl-12 signup">
                        @T("ShoppingCart.DiscountCouponCode.Guest.Checkout.Message")
                    </div>
                }
                @foreach (var message in Model.Messages)

                {
                    <div class="@(Model.IsApplied ? "message-success alert alert-success" : "message-failure alert alert-danger")">
                        @message
                    </div>
                }
                @foreach (var discount in Model.AppliedDiscountsWithCodes)
                {
                    <div class="current-code">
                        <span class="applied-discount-code">@Html.Raw(string.Format(T("ShoppingCart.DiscountCouponCode.CurrentCode").Text, discount.CouponCode))</span>
                        @*empty value (little hack for FormValueExistsAttribute)*@
                        <button type="submit" name="removediscount-@discount.Id" class="remove-discount-button"></button>
                    </div>
                }
            </div>
        </div>
    </div>
    <script asp-location="Footer">
        $(document).ready(function () {
            $('#discountcouponcode').on('keydown', function (event) {
                if (event.keyCode == 13) {
                    $('#applydiscountcouponcode').trigger("click");
                    return false;
                }
            });
        });
    </script>
}