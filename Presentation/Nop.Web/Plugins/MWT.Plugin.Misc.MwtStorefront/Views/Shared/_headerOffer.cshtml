@inject Nop.Services.Configuration.ISettingService _settingService
@inject IThemeContext themeContext

@{
    bool displayOfferTimer = await _settingService.GetSettingByKeyAsync<bool>("marketingsettings.Display.OfferTimer");
    var date = DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss");
    var endDate = await _settingService.GetSettingByKeyAsync<DateTime>("marketingsettings.offer.enddate");
    var headerstripFix = await _settingService.GetSettingByKeyAsync<bool>("marketingsettings.offer.headerstrip.fixed");
    var themeName = await themeContext.GetWorkingThemeNameAsync();
}
@if (DateTime.Now < endDate  && displayOfferTimer)
{
  
 @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "header-offer-strip" })
  
        <script>
          var  headerofferintervalId = 0;
        function checkSaleCookieExists(name) {
            const nameEQ = name + "=";
            const ca = document.cookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) == ' ') c = c.substring(1, c.length);  // trim leading spaces
                if (c.indexOf(nameEQ) == 0) return true;  // Cookie exists
            }
            return false;  // Cookie does not exist
        }


        const close_sale = document.querySelector('.close-sale-icon');
        close_sale.addEventListener('click', close_sale_function);
        // Define the function to run when the button is clicked
        function close_sale_function() {
            var sale_element = document.querySelector('.black-friday-sale-main');
            sale_element.classList.add('hidden-hurry-sale');
            setSaleCookie("Black-friday-sale", true, 3650);

        }
        function setSaleCookie(name, value, days) {
            let expires = "";
            if (days) {
                const date = new Date();
                // Set the expiration date to a far future time (for example, 10 years from now)
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            // Set the cookie with the calculated expiration date
            document.cookie = name + "=" + (value || "")  + "; path=/";
        }


        var date = "@date";
        var endDate = "@endDate";
        if (typeof formatTime !== 'function') {
            function formatTime(time) {
                return time < 10 ? "0" + time : time;
            }
        }



        // Initialize the interval counter

            if (typeof updateCountdown !== 'function' && headerofferintervalId == 0) {

            let timeInterval = 0;
            const countdownDate = new Date(endDate).getTime();
            const now = new Date(date).getTime();
            // Function to update the countdown
            var distance = 0;
            const updateCountdown = () => {

                // Decrement time by interval (one second for each interval)
                const newTime = now - timeInterval * 1000;

                // Calculate the remaining time (distance) to the countdown date
                distance = countdownDate - newTime;
                if (distance > 0) {
                    var elements = document.getElementsByClassName('hurry-sale');

                    for (var i = 0; i < elements.length; i++) {
                        elements[i].classList.remove('hidden-hurry-sale');
                    }
                }
                timeInterval--;

                // Calculate days, hours, minutes, and seconds
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor(
                    (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
                );
                const minutes = Math.floor(
                    (distance % (1000 * 60 * 60)) / (1000 * 60)
                );
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                // Update the countdown display
                // if (distance < 1000 * 60 * 60 * 24) {
                //     // Less than 24 hours

                //     var elements = document.getElementById('days');
                //     elements.classList.add('hidden-hurry-sale');


                // } else {
                //     var elements = document.getElementById('days');
                //     elements.classList.remove('hidden-hurry-sale');
                //     elements.textContent = formatTime(days) ;

                // }
                var elements = document.getElementById('days');

                elements.textContent = formatTime(days);
                // Display hours, minutes, and seconds with leading zeros if needed

                var elements = document.getElementById('hours');

                elements.textContent = formatTime(hours);


                var elements = document.getElementById('minutes');
                elements.textContent = formatTime(minutes);


                var elements = document.getElementById('seconds');
                elements.textContent = formatTime(seconds) + "";



                // Stop the countdown when it reaches zero
                if (distance <= 0) {
                    var sale_element = document.querySelector('.black-friday-sale-main');
                    sale_element.classList.add('hidden-hurry-sale');
                    clearInterval(headerofferintervalId);
                    var elements = document.getElementsByClassName('hurry-sale');

                    for (var i = 0; i < elements.length; i++) {
                        elements[i].classList.add('hidden-hurry-sale');
                    }

                }
            };
                headerofferintervalId = setInterval(updateCountdown, 1000);
            updateCountdown();
            if (distance > 0) {
			  if (document.body.offsetWidth > 767) {
			  if (!checkSaleCookieExists("Black-friday-sale")) {
                    var sale_element = document.querySelector('.black-friday-sale-main');
                    sale_element.classList.remove('hidden-hurry-sale');
                   

                }
			  }else{
			  var sale_element = document.querySelector('.black-friday-sale-main');
                    sale_element.classList.remove('hidden-hurry-sale');
			  }
                
            }
        }

        if (document.body.offsetWidth > 767) {
            originalOffsetY = 40;
            window.addEventListener('scroll', function () {

                if (window.scrollY > originalOffsetY  && '@headerstripFix'=="True") {

                    if (document.body.offsetWidth > 767) {
                        document.querySelector('.black-friday-sale-inner').classList.add('fixed');
                        document.querySelector('body').style.marginTop = originalOffsetY;
                    }

                } else {
                    document.querySelector('.black-friday-sale-inner').classList.remove('fixed');
                    document.querySelector('body').style.marginTop = 0;
                }
            });
        }

		

        </script>
    
}