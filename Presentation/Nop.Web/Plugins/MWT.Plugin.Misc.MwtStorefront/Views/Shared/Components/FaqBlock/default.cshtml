@model List<FaqModel>

@if (Model.Count > 0)
{

    <div class="entitytype-faq">
        <h2 class="mb-3">@T("Heading.Faq")</h2>

        <div class="accordion" id="faqAccordion">
            @{
                int i = 0;
            }

            @foreach (var faq in Model)
            {
                var headingId = $"heading{i}";
                var collapseId = $"collapse{i}";
                <div class="accordion-item faq-box">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId"
                                aria-expanded="false"
                                aria-controls="@collapseId">
                            @faq.Question
                        </button>
                    </h2>

                    <div id="@collapseId"
                         class="accordion-collapse collapse"
                         aria-labelledby="@headingId"
                         data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            @faq.Answer
                        </div>
                    </div>
                </div>

                i++;
            }
        </div>
    </div>
}

<style>
    .entitytype-faq .accordion-button::after {
        content: "+";
        font-size: 1.2em;
        transform: rotate(0deg);
    }

    .entitytype-faq .accordion-button:not(.collapsed)::after {
        content: "−";
    }

    .entitytype-faq .faq-box {
        margin-bottom: 10px;
        border: 1px solid #999999;
        border-radius: 5px;
        overflow: hidden;
    }

        .entitytype-faq .faq-box:not(:first-child) {
            border-top: 1px solid #999999;
        }

    .entitytype-faq .accordion-button:not(.collapsed) {
        color: #444;
        background-color: #fff;
        box-shadow: unset;
    }

    .entitytype-faq .accordion-button:focus {
        box-shadow: unset;
    }
</style>

@if (Model != null && Model.Count > 0)
{
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        @for (int i = 0; i < Model.Count; i++)
        {
            var faq = Model[i];
            <text>
            {
              "@@type": "Question",
              "name": "@Html.Raw((faq.Question??string.Empty) .Replace("\"", "\\\""))",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "@Html.Raw((faq.Answer??string.Empty).Replace("\"", "\\\""))"
              }
            }@(i < Model.Count - 1 ? "," : "")
            </text>
        }
      ]
    }
</script>
}