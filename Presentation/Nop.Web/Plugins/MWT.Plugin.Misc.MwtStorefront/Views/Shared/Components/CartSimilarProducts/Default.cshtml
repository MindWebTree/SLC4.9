@model IList<CustomProductOverviewModel>
@if (Model.Count > 0)
{
    <div class="complete-style">
        <h4>@Model[0].ProductRelation</h4>
        <div class="complete-images">
            @foreach (var item in Model)
            {
                
       @await Html.PartialAsync("_Cart_Similar_ProductBox", item)
            }

        </div>
    </div>

}

