@model List<RelatedSearchModel>

@if (Model.Count > 0)
{
    <div aria-labelledby="relatedSearchPage" role="region" class="shop-by-category related-search">
    <h2 id="relatedSearchPage" >@T("Heading.RelatedSearch.SearchPage")</h2>
    <ul>
        @foreach (var term in Model)
        {
           <li><a href="@term.Link">@term.TermName</a></li>
           }
    </ul>
</div>
}