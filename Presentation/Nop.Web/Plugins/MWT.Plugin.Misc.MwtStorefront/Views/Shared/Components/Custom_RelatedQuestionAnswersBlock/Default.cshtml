

@model IList<QuestionAnswerModel>
@if (Model.Count > 0)
{

    <div class="" bis_skin_checked="1">
        <h5 class="content-related-questions">Related Questions</h5>
        <ul class="list-unstyled mb-4 mt-4">
            @foreach (var item in Model)
            {
                <li class="mb-3"><a href="@Url.RouteUrl("QuestionAnswer", new { SeName = item.SeName })"> <h2 class="related-span-question">@item.Name</h2></a></li>
            }
        </ul>
        <a class="question-button-view" href="/answers">VIEW ALL QUESTIONS</a>
    </div>

}

