@model HeadLinkModel

<div class="ossa-11049-tabbed-nav-container">
    <div class="tabbed-nav-buttons">
        @foreach (var item in Model.Links)
        {
            <div class="tab-button @(item.IsActive?"active":"")">
                @if (string.IsNullOrEmpty(item.Link))
                {
                    <div class="tab-button ">@item.Title</div>
                }
                else
                {
                    <a href="@item.Link" alt="@item.Title"  >
                        <div class="tab-button ">@item.Title</div>
                    </a>
                }
            </div>
        }
   
    </div>
</div>
