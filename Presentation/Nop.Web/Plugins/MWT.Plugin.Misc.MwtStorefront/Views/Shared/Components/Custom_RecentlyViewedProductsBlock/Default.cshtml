@model IList<CustomProductOverviewModel>
@if (Model.Count > 0)
{
    <div aria-labelledby="recentlyviewed-products-heading" role="region" class="shop-by-category recently-viewed-products">
        <h2 id="recentlyviewed-products-heading" >@Html.Raw(T("Products.RecentlyViewedProducts"))</h2>
        <div class="recentlyviewed-products">
            @foreach (var item in Model)
            {
                @await Html.PartialAsync("_home_ProductBox", item)
            }
        </div>
    </div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
	  var $slider = $('.recentlyviewed-products');
        $('.recentlyviewed-products').slick({
            dots: true,
            infinite: false,
            speed: 800,
			cssEase: 'ease-out', 
			useTransform: true, 
			useCSS: true, 
            slidesToShow: 4,
            slidesToScroll: 1,
            variableWidth: false,
            centerMode: false,
            centerPadding: '0',
  dots: false,
            responsive: [
			  {
                    breakpoint: 1200,
                    settings: {
                        centerMode: false,
                        centerPadding: '40px',
                        slidesToShow: 3
                    }
                },
                {
                    breakpoint: 991,
                    settings: {
                        centerMode: false,
                        centerPadding: '40px',
                        slidesToShow: 2
                    }
                },
                {
                    breakpoint: 767,
                    settings: {
                        centerMode: false,
                        centerPadding: '40px',
                        dots: false,
                        slidesToShow: 2
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        centerMode: false,
                        centerPadding: '40px',
                        dots: false,
                        slidesToShow: 1
                    }
                }
            ]
        });
        $('.recentlyviewed-products').on('init reInit setPosition breakpoint', function () {
            $(this).find('.slick-prev').attr('aria-label', 'Previous');
            $(this).find('.slick-next').attr('aria-label', 'Next');
        });
		let isScrolling = false;

$slider.on('wheel', function(e) {
    let deltaX = e.originalEvent.deltaX;
    let deltaY = e.originalEvent.deltaY;

    // 👉 Ignore if vertical scroll is dominant
    if (Math.abs(deltaY) > Math.abs(deltaX)) {
        return;
    }

    e.preventDefault();

    if (isScrolling) return;
    isScrolling = true;

    if (deltaX > 10) {
        $slider.slick('slickNext');
    } else if (deltaX < -10) {
        $slider.slick('slickPrev');
    }

    setTimeout(function() {
        isScrolling = false;
    }, 50);
});
    });
</script>
}
