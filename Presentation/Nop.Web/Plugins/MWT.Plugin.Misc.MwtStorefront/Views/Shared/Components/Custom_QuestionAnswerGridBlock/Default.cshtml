@model QuestionAnswerListModel
@if (Model?.QuestionAnswers != null && Model.QuestionAnswers.Count > 0)
{
    <ul class="list-group list-group-flush border-0">

        @foreach (var questionAnswer in Model.QuestionAnswers)
        {

            <li class="list-group-item border-0 border-bottom"><a href="@Url.RouteUrl("QuestionAnswer", new {  SeName = questionAnswer.SeName })">@questionAnswer.Name</a></li>
        }
    </ul>
}

else
{
    <div class="no-result">
        No questions were found.
    </div>
}

@{
    var pager = Html.CustomPager(Model, 15)
        .QueryParam(T("Pagenumber.Query.Param").Value)
        // for search page
        .BooleanParameterName("advs")
        .BooleanParameterName("isc")
        .BooleanParameterName("sid")
        .RenderEmptyParameters(true);
}
@if (!await pager.IsEmpty())
{
    <div class="pager">
        @pager
    </div>
}