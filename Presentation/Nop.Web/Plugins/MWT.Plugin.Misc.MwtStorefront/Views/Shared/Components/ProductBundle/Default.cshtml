        function recalculateVisibleBundleMath(bundlePriceFromAjax, config) {
            let totalIndividualCurrent = 0;
            let totalIndividualOld = 0;
            let totalItemsCount = 0;

            // 1. SELECT ONLY VISIBLE CARDS

            $('.master-item:not(.d-none)').each(function () {
                const $card = $(this);
                const qty = parseInt($card.find('.qty-value').text()) || 0;

                // Pull raw numbers from data-attributes
                const currentPrice = parseFloat($card.attr('data-price')) || 0;
                const oldPrice = parseFloat($card.attr('data-old-price')) || currentPrice;

                totalIndividualCurrent += (currentPrice * qty);
                totalIndividualOld += (oldPrice * qty);
                totalItemsCount += qty;
            });


            // 2. The Set Price (The "Shared" Bundle Price from the Main Variant)
            const setPrice = parseFloat(bundlePriceFromAjax) || 0;

            // 3. The Math Logic
            const formatter = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                maximumFractionDigits: 2
            });


            var offer = totalIndividualOld - totalIndividualCurrent; // "Save" (Retail vs Individual)
            var bundleOffer = totalIndividualCurrent - setPrice;       // "Offer" (Individual vs Set)
            var bmsmDiscountAmount = (getBMSMDiscountAmount(config, setPrice));
            let bundleofferwithoutbmsm = bundleOffer - bmsmDiscountAmount
            var totalSaving = offer + bundleOffer;
            console.log(totalSaving, setPrice, bmsmDiscountAmount, bundleOffer);
            if (bundleofferwithoutbmsm < 0) {
                bmsmDiscountAmount = 0;
                bundleofferwithoutbmsm = bundleOffer;
            }



            // 5. Update the Footer Elements
            $('.bundle-total-amount').text(formatter.format(setPrice));
            $('.save-total').text(formatter.format(totalSaving));
            $('.offer').text(formatter.format(offer));

            $('.save-bmsm-offer').text(formatter.format(bmsmDiscountAmount));
            $('.save-extra').text(formatter.format(bundleofferwithoutbmsm));
            $('.qty-value-main').text(totalItemsCount + " items Included");

            $(".promo--bmsm").toggleClass("d-none", bmsmDiscountAmount <= 0);
            $(".promo--offer").toggleClass("d-none", offer <= 0);
            $(".promo--bundle").toggleClass("d-none", bundleofferwithoutbmsm <= 0);

            // --- NEW: UPDATE ADD TO CART BUTTON ---
            const $cartBtn = $('#product-details-form .add-to-cart-button');
            if (totalItemsCount > 0) {  
                $cartBtn.html('Add collection to cart ');
            } else {
                $cartBtn.html('Add to cart');
            }
        }

        function getBMSMDiscountAmount(config, subTotal) {
            if (!config || !config.metadata || config.metadata.length === 0) {
                return 0; // Return 0 if no bundle data exists
            }
       let isPercent = discountType == "Percent" ? true : false;


            // If there is no discount configured or subtotal didn't match a tier, return 0 early
            if (buyMoreSaveMoreDiscount <= 0) return 0;

            let costlyItemPrice = 0;
            let excludedProductId = null;
            let totalDiscount = 0;

            config.metadata.forEach(function (item) {
                let price = parseFloat(item.priceraw) || 0;
                let qty = parseInt(item.qnty) || 1;
                let itemTotalValue = price * qty;

                if ((itemTotalValue > costlyItemPrice && config.metadata.length > 1) ||
                    (config.metadata.length === 1 && (qty === 1 || price < singleItemThreshold))) {

                    costlyItemPrice = itemTotalValue;
                    excludedProductId = item.productId;
                }
            });

            // 4. Calculate the discount for the eligible items
            config.metadata.forEach(function (item) {
                if (item.productId !== excludedProductId) {
                    let price = parseFloat(item.priceraw) || 0;
                    let qty = parseInt(item.qnty) || 1;
                    let deduction = 0;

                    if (config.metadata.length > 1) {
                        // Multi-item bundle logic
                        if (isPercent) {
                            deduction = ((price * qty) * buyMoreSaveMoreDiscount) / 100;
                        } else {
                            deduction = (buyMoreSaveMoreDiscount > price) ? (price * qty) : (buyMoreSaveMoreDiscount * qty);
                        }
                    } else {
                        // Single item bundle (qty > 1) logic
                        if (isPercent) {
                            deduction = ((price * (qty - 1)) * buyMoreSaveMoreDiscount) / 100;
                        } else {
                            deduction = (buyMoreSaveMoreDiscount > price) ? (price * (qty - 1)) : (buyMoreSaveMoreDiscount * (qty - 1));
                        }
                    }

                    totalDiscount += deduction;
                }
            });

            return totalDiscount;
        }

