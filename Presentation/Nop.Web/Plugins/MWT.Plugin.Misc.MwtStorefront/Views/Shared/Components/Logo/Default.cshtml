@model LogoModel
@using Microsoft.AspNetCore.Http;
@using Nop.Services.Helpers
@inject Nop.Services.Configuration.ISettingService _settingService;
@inject IHttpContextAccessor httpContextAccessor
@inject Nop.Core.IStoreContext _storeContext;
@inject Nop.Services.Configuration.ISettingService settingService;
@inject Nop.Core.IWorkContext _workContext;
@inject IUserAgentHelper _userAgentHelper;

@{
    var store = await _storeContext.GetCurrentStoreAsync();
    var logoImg = await _settingService.GetSettingByKeyAsync<string>(key: "Store.logo");
    var url = httpContextAccessor.HttpContext.Request.Scheme + "://" + httpContextAccessor.HttpContext.Request.Host.ToString() + httpContextAccessor.HttpContext.Request.Path.ToString();
    var storeSupportEmail = await settingService.GetSettingByKeyAsync<string>("store.support.email");
}

<a href="@Url.RouteUrl(Nop.Core.Http.NopRouteNames.General.HOMEPAGE)">
    @if (!_userAgentHelper.IsMobileDevice())
    {
        <img alt="@(Model.StoreName + " logo")" src="@(string.IsNullOrEmpty(logoImg) ? Model.LogoPath : logoImg)?v=1" width="513" height="80">
    }
    else
    {
        <img alt="@Model.StoreName" src="/images/mobile-logo.svg" width="513" height="80">
    }

</a>


<script type="application/ld+json">
    [
      {
        "@@context": "https://schema.org/",
        "@@type": "Organization",
        "name": "@store.Name",
        "url": "@store.Url",
        "image": "@(string.IsNullOrEmpty(logoImg) ? Model.LogoPath : logoImg)",
        "logo": "@(string.IsNullOrEmpty(logoImg) ? Model.LogoPath : logoImg)",
        "telephone": "@store.CompanyPhoneNumber",
        "sameAs": [
          "https://www.pinterest.com/slcfurniture/",
          "https://www.facebook.com/sierralivingconcepts/",
          "https://www.instagram.com/sierralivingconcepts/"
        ],
        "address": {
          "@@type": "PostalAddress",
             "streetAddress": "46560 Fremont Blvd, Suite 414",
                "addressLocality": "Fremont",
            "addressCountry": "US",
                "addressRegion": "CA",
            "postalCode": "94538"
        },
        "contactPoint": {
          "@@type": "ContactPoint",
          "email": "@storeSupportEmail",
          "contactType": "Customer Service"
        }
      }
    ]</script>