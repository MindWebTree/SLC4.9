@model Nop.Web.Models.Customer.RegisterModel
<div class="modal fade cart-login-process" id="new-create-account" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">@T("Checkout.Register.Heading")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 0L21 20" stroke="#010101" stroke-width="1.76757" stroke-miterlimit="10" />
                        <path d="M1 20L21 0" stroke="#010101" stroke-width="1.76757" stroke-miterlimit="10" />
                    </svg>
                </button>

            </div>
            <div class="modal-body">
                <p>@T("Checkout.Register.Info")</p>
                <div class="external-authentication">
                    @await Component.InvokeAsync("ExternalMethods", "ExternalAuthentication")
                </div>


                <div class="col-lg-2 col-xl-2 line-login-center"></div>
                <div class="modal-body" id="RegisterModalBody">
                    <!-- Error message will be injected here -->

                    <form id="registerForm">
                        <div class="errormessage"></div>
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />


                        @Html.AntiForgeryToken()

                        @if (Model.GenderEnabled)
                        {
                            <div class="form-group">
                                <div class="row">
                                    <label for="gender" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label">@T("Account.Fields.Gender"):</label>
                                    <div id="gender" class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                        <div class="gender">
                                            <span class="male">
                                                <div class="custom-control custom-radio" for="gender-male">
                                                    <input type="radio" asp-for="Gender" class="custom-control-input" value="M" checked="@(Model.Gender == "M")" id="gender-male" />
                                                    <label class="custom-control-label" for="gender-male">@T("Account.Fields.Gender.Male")</label>
                                                </div>
                                            </span>
                                            <span class="female">
                                                <div class="custom-control custom-radio" for="gender-female">
                                                    <input type="radio" asp-for="Gender" class="custom-control-input" value="F" checked="@(Model.Gender == "F")" id="gender-female" />
                                                    <label class="custom-control-label" for="gender-female">@T("Account.Fields.Gender.Female")</label>
                                                </div>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (Model.FirstNameEnabled)
                        {
                            <div class="form-group" bis_skin_checked="1">
                                <div class="row">
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                                        <input asp-for="FirstName" placeholder="First Name" class="form-control" id="Register-FirstName" />
                                        <div class="checkout-label" bis_skin_checked="1">
                                            <label for="Register-FirstName">First Name</label>
                                            <span class="required">*</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                                        <span asp-validation-for="FirstName"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (Model.LastNameEnabled)
                        {
                            <div class="form-group" bis_skin_checked="1">
                                <div class="row">
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                                        <input asp-for="LastName" placeholder="Last Name" class="form-control" id="Register-LastName" />
                                        <div class="checkout-label" bis_skin_checked="1">
                                            <label for="Register-LastName">Last Name</label>
                                            <span class="required">*</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                                        <span asp-validation-for="LastName"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (Model.DateOfBirthEnabled)
                        {
                            <div class="form-group date-of-birth">
                                <div class="row">
                                    <label class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label">@T("Account.Fields.DateOfBirth"):</label>
                                    <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                        <nop-date-picker asp-day-name="@Html.NameFor(x => x.DateOfBirthDay)"
                                                         asp-month-name="@Html.NameFor(x => x.DateOfBirthMonth)"
                                                         asp-year-name="@Html.NameFor(x => x.DateOfBirthYear)"
                                                         asp-begin-year="@(DateTime.Now.Year - 110)"
                                                         asp-end-year="@(DateTime.Now.Year)"
                                                         asp-selected-day="@Model.DateOfBirthDay"
                                                         asp-selected-month="@Model.DateOfBirthMonth"
                                                         asp-selected-year="@Model.DateOfBirthYear" />
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-2 col-lg-2 col-xl-2">
                                        @if (Model.DateOfBirthRequired)
                                        {
                                            <nop-required />
                                        }
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                        <span asp-validation-for="DateOfBirthDay"></span>
                                        <span asp-validation-for="DateOfBirthMonth"></span>
                                        <span asp-validation-for="DateOfBirthYear"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="form-group" bis_skin_checked="1">
                            <div class="row">
                                <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                                    <input asp-for="Email" placeholder="Email Address" class="form-control" id="Register-Email" />
                                    <div class="checkout-label" bis_skin_checked="1">
                                        <label for="Register-Email">Email Address</label>
                                        <span class="required">*</span>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                                    <span asp-validation-for="Email"></span>
                                </div>
                            </div>
                        </div>
                        @if (Model.EnteringEmailTwice)
                        {
                            <div class="form-group">
                                <div class="row">
                                    <label asp-for="ConfirmEmail" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                    <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                        <input asp-for="ConfirmEmail" class="form-control" id="Register-ConfirmEmail" />
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                        <nop-required />
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                        <span asp-validation-for="ConfirmEmail"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (Model.UsernamesEnabled)
                        {
                            <div class="form-group">
                                <div class="row">
                                    <label asp-for="Username" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                    <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                        <input asp-for="Username" class="form-control" id="Register-Username" />
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                        <nop-required />
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                        <span asp-validation-for="Username"></span>
                                        @if (Model.CheckUsernameAvailabilityEnabled)
                                        {
                                            @await Html.PartialAsync("_CheckUsernameAvailability")
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (Model.ZipPostalCodeEnabled)
                        {
                            <div class="form-group">
                                <div class="row">
                                    <label asp-for="ZipPostalCode" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                    <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                        <input asp-for="ZipPostalCode" class="form-control" id="Register-ZipPostalCode" />
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                        @if (Model.ZipPostalCodeRequired)
                                        {
                                            <nop-required />
                                        }
                                    </div>
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                        <span asp-validation-for="ZipPostalCode"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (Model.PhoneEnabled)
                        {
                            <input name="Phone" value="-" aria-describedby="Register-Phone-error" type="hidden">

                        }

                        <div class="form-group" bis_skin_checked="1">
                            <div class="row">
                                <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                                    <input asp-for="Password" placeholder="Password" class="form-control" id="Register-Password" />
                                    <div class="checkout-label" bis_skin_checked="1">
                                        <label for="Password">Password</label>
                                        <span class="required">*</span>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                                    <span asp-validation-for="Password"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" bis_skin_checked="1">
                            <div class="row">
                                <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                                    <input asp-for="ConfirmPassword" placeholder="Confirm Password" class="form-control" id="Register-ConfirmPassword" />
                                    <div class="checkout-label" bis_skin_checked="1">
                                        <label for="Register-ConfirmPassword">Confirm Password</label>
                                        <span class="required">*</span>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                                    <span asp-validation-for="ConfirmPassword"></span>
                                </div>
                            </div>
                        </div>
                        @if (Model.CompanyEnabled || Model.DisplayVatNumber)
                        {
                            <div class="title">
                                <strong>@T("Account.CompanyDetails")</strong>
                            </div>
                            <div class="form-fields">
                                @if (Model.CompanyEnabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="Company" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <input asp-for="Company" class="form-control" id="Register-Company" />
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                @if (Model.CompanyRequired)
                                                {
                                                    <nop-required />
                                                }
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span asp-validation-for="Company"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.DisplayVatNumber)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="VatNumber" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <input asp-for="VatNumber" class="form-control" id="Register-VatNumber" />
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span class="vat-note"><em>@T("Account.Fields.VatNumber.Note")</em></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        @if (Model.StreetAddressEnabled ||
               Model.StreetAddress2Enabled ||
               Model.CityEnabled ||
               Model.CountyEnabled ||
               Model.CountryEnabled)
                        {
                            <div class="title">
                                <strong>@T("Account.YourAddress")</strong>
                            </div>
                            <div class="form-fields">
                                @if (Model.StreetAddressEnabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="StreetAddress" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <input asp-for="StreetAddress" class="form-control" id="Register-StreetAddress" />
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                @if (Model.StreetAddressRequired)
                                                {
                                                    <nop-required />
                                                }
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span asp-validation-for="StreetAddress"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.StreetAddress2Enabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="StreetAddress2" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <input asp-for="StreetAddress2" class="form-control" id="Register-StreetAddress2" />
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                @if (Model.StreetAddress2Required)
                                                {
                                                    <nop-required />
                                                }
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span asp-validation-for="StreetAddress2"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.CountyEnabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="County" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <input asp-for="County" class="form-control" id="Register-County" />
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                @if (Model.CountyRequired)
                                                {
                                                    <nop-required />
                                                }
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span asp-validation-for="County"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.CityEnabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="City" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <input asp-for="City" class="form-control" id="Register-City" />
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                @if (Model.CityRequired)
                                                {
                                                    <nop-required />
                                                }
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span asp-validation-for="City"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.CountryEnabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="CountryId" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <select asp-for="CountryId" asp-items="Model.AvailableCountries" class="form-control"
                                                        data-trigger="country-select"
                                                        data-url="@(Url.RouteUrl("GetStatesByCountryId"))"
                                                        data-stateprovince="#@Html.IdFor(model => model.StateProvinceId)"
                                                        data-loading="#states-loading-progress"></select>
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                @if (Model.CountryRequired)
                                                {
                                                    <nop-required />
                                                }
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span asp-validation-for="CountryId"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.CountryEnabled && Model.StateProvinceEnabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="StateProvinceId" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <select asp-for="StateProvinceId" asp-items="Model.AvailableStates" class="form-control"></select>
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                @if (Model.StateProvinceRequired)
                                                {
                                                    <nop-required />
                                                }
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span id="states-loading-progress" style="display: none;" class="please-wait">@T("Common.Wait")</span>
                                                <span asp-validation-for="StateProvinceId"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        @if (Model.FaxEnabled)
                        {
                            <div class="title">
                                <strong>@T("Account.YourContactInformation")</strong>
                            </div>
                            <div class="form-fields">

                                @if (Model.FaxEnabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="Fax" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <input asp-for="Fax" class="form-control" />
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                @if (Model.FaxRequired)
                                                {
                                                    <nop-required />
                                                }
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                                                <span asp-validation-for="Fax"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        @if (Model.NewsletterEnabled || Model.CustomerAttributes.Count > 0)
                        {
                            <div class="title">
                                <strong>@T("Account.Options")</strong>
                            </div>
                            <div class="form-fields">
                                @if (Model.NewsletterEnabled)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-12 col-sm-12 col-md-4 offset-md-4 offset-lg-4 offset-xl-4">
                                                <div class="custom-control custom-checkbox newsletter">
                                                    <input asp-for="Newsletter" type="checkbox" class="custom-control-input" id="Newsletter" />
                                                    <label asp-for="Newsletter" for="Newsletter" class="custom-control-label"></label>
                                                </div>
                                                <span asp-validation-for="Newsletter"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.CustomerAttributes.Count > 0)
                                {
                                    @await Html.PartialAsync("_CustomerAttributes", Model.CustomerAttributes)
                                }
                            </div>
                        }
                        @if (Model.AllowCustomersToSetTimeZone)
                        {
                            <div class="title">
                                <strong>@T("Account.Preferences")</strong>
                            </div>
                            <div class="form-fields">
                                @if (Model.AllowCustomersToSetTimeZone)
                                {
                                    <div class="form-group">
                                        <div class="row">
                                            <label asp-for="TimeZoneId" asp-postfix=":" class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 col-form-label"></label>
                                            <div class="col-12 col-sm-12 col-md-5 col-lg-5 col-xl-5">
                                                <select asp-for="TimeZoneId" asp-items="Model.AvailableTimeZones" class="form-control"></select>
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-3 col-lg-3 col-xl-3">
                                                <span asp-validation-for="TimeZoneId"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }


                        <div class="form-group">
                            <div class="row">
                                <div class="col-12 col-sm-12">


                                    <label class="custom-control-label">@T("consent.message.register")</label>

                                </div>
                            </div>
                        </div>
                        @if (Model.DisplayCaptcha)
                        {
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-12 col-sm-8 offset-md-4 offset-lg-4 offset-xl-4">
                                        <nop-captcha class="g-recaptcha" />
                                    </div>
                                </div>
                            </div>
                        }
                        @if (Model.HoneypotEnabled)
                        {
                            @Html.Raw(Html.GenerateHoneypotInput())
                        }


                        <button type="submit" class="btn btn-signin">@T("common.createaccount") </button>
                    </form>
                    <div class="footer-modal-content">
                        @T("Checkout.AlreadyHaveAccount")
                        <a href="#" class="btn-link" data-bs-toggle="modal" data-bs-target="#accountsignin">@T("Checkout.Switch.SignIn")</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script asp-location="Footer">
    $(document).ready(function () {
        $('#registerForm').on('submit', function (e) {
                                e.preventDefault();
                                if (!$(this).valid()) {
                                    return; // Don't proceed if the form is invalid
                                }

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("CustomRegister", "Customer")',
                method: 'POST',
                data: $(this).serialize(),

                headers: {
                 'RequestVerificationToken': token
                },
                success: function (data) {
                                    if (data.statusCode === 200) {
                                        window.location.href = data.redirectUrl || '/cart';

                    } else {
                                        $('#registerForm .errormessage').html('<div class="alert alert-danger">' + data.message + '</div>').removeAttr('hidden');

                    }
                },
                error: function () {
                    $('#registerForm .errormessage').html('@T("Common.Error")');
                }, complete: function () {
                   
                }
            });
        });
    });
</script>