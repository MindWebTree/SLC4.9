@using MWT.Nop.Core.Services
@using MWT.Nop.Core.Services.Customers
@inject Nop.Services.Configuration.ISettingService _settingServce;
@inject ICustomCustomerService _customerService;
@inject Nop.Core.IWorkContext _workContext;
@inject Nop.Core.IWebHelper webHelper;
@{
    var settingValue = await _settingServce.GetSettingByKeyAsync<string>("MarketingSettings.ShowBuymoreSavemoreBanner");
    bool showBuymoreSavemoreBanner = false;
    bool.TryParse(settingValue, out showBuymoreSavemoreBanner);
    var IsAuthenticated = await _customerService.IsRegisteredAsync(await _workContext.GetCurrentCustomerAsync());
}

@model MiniShoppingCartModel

<div class="container">
    <div class="mini-shopping-cart row">
        <div class="count">
            @if (Model.TotalProducts == 0)
            {
                if (IsAuthenticated)
                {
                    @T("ShoppingCart.Mini.NoItems")
                }
                else
                {
                    var returnUrl = Context.Request.Query.TryGetValue("returnUrl", out var url) && !StringValues.IsNullOrEmpty(url.ToString().Trim())
                    ? url.ToString()
                    : webHelper.GetRawUrl(Context.Request);
                    @T("ShoppingCart.Mini.NoItems.anonymous", Url.RouteUrl("Login", new { returnUrl }), Url.RouteUrl("ShoppingCart"))
                }
            }
            else
            {
                @Html.Raw(string.Format(T("ShoppingCart.Mini.ItemsText").Text, $"{string.Format(T("ShoppingCart.Mini.Items").Text, Model.TotalProducts)}"))
            }
        </div>
        @if (Model.TotalProducts > 0)
        {
            <div class="items">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    <div class="item @(i == 0 ? "first" : null)">
                        @if (Model.ShowProductImages)
                        {
                            <div class="picture">
                              
                                    <img alt="@item.Picture.AlternateText" src="@item.Picture.ImageUrl" title="@item.Picture.Title" />
                               
                            </div>
                        }
                        <div class="product">
                            <div class="name">
                                <a href="@Url.RouteUrl("Product", new {id=item.ProductId, SeName = item.ProductSeName })">@item.ProductName</a>
                            </div>
                            @if (!string.IsNullOrEmpty(item.AttributeInfo))
                            {
                                <div class="attributes">
                                    @Html.Raw(System.Net.WebUtility.HtmlDecode(item.AttributeInfo))
                                </div>
                            }
                            <div class="price">@T("ShoppingCart.Mini.UnitPrice"): <span>@item.UnitPrice</span></div>
                            <div class="quantity">@T("ShoppingCart.Mini.Quantity"): <span>@item.Quantity</span></div>
                        </div>
                    </div>
                }
            </div>
            <div class="totals">@T("ShoppingCart.Totals.SubTotal"): <strong>@Model.SubTotal</strong></div>
            <div class="buttons">
                @if (Model.DisplayShoppingCartButton)
                {
                    <button type="button" class="button-2 btn btn-primary cart-button" onclick="setLocation('@(Url.RouteUrl("ShoppingCart"))')">@T("ShoppingCart.Mini.ViewCart")</button>

                }
                @if (Model.DisplayCheckoutButton)
                {
                    var checkoutUrl = "";
                    if (Model.AnonymousCheckoutAllowed && Model.CurrentCustomerIsGuest)
                    {
                        checkoutUrl = Url.RouteUrl("LoginCheckoutAsGuest", new { returnUrl = Url.RouteUrl("ShoppingCart") });
                    }
                    else
                    {
                        checkoutUrl = Url.RouteUrl("Checkout");
                    }
                    <button type="button" class="button-2 btn btn-primary checkout-button" onclick="setLocation('@checkoutUrl')">@T("Checkout.Button")</button>
                }
            </div>
        }
    </div>
</div>



