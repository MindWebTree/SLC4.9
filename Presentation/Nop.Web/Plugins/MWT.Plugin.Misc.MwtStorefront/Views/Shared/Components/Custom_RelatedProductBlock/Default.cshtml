    line-height: 32px;
    text-decoration: none !important;
    border: 1px solid #444444;
    text-align: center;
    font-size: 14px;
    text-transform: uppercase;
    background:#ffffff;
   color: #444444;
font-weight:400;
}
.you-may-also-need-section .view-details:hover{
background: #444;
color:#fff;
}
.you-may-also-need-section .inner-sec-need .product-details h3 a{
margin:0;
}
.you-may-also-need-section .inner-sec-need .product-details h3 a {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}
@@media screen and (max-width: 767px) {
.you-may-also-need-section h4.price.actual-price, .you-may-also-need-section h4.price.actual-price span {
    flex-direction: column;
    gap: 0;
    font-size: 14px !important;
}
.you-may-also-need-section p.sale-price.m-0.offertext-p {
    font-size: 13px !important;
    gap: 4px;
    margin: 3px 0 2px 0 !important;
}
.you-may-also-need-section .inner-sec-need .product-image img {
    width: 112px;
}

.you-may-also-need-section .inner-sec-need {
    padding: 15px;
}
    .you-may-also-need-section h2{
        display:block;
		        padding-top: 30px;
    }
    .you-may-also-need-section h4.price.actual-price.sale-price span:first-child {
        font-weight: 400 !important;
        font-size: 14px !important;
    }
}
</style>
