    font-weight: 600;
    color: #444;
    text-align: left !important;
    line-height: 16px;
}

.you-may-also-need-section .price-sec {
      align-items: start;
    gap: 0;
    margin-bottom: 15px;
    display: flex;
    flex-direction: column;
}

    .you-may-also-need-section h4.price.actual-price.sale-price span.saleprice,
.you-may-also-need-section h4.price.actual-price .sale-price	{
        font-weight: 400 !important;
        font-size: 16px !important;
		padding:0 !important;
		display: flex;
    align-items: center;
    gap: 6px;
	    margin-bottom: 0;
    }
	.you-may-also-need-section p.sale-price.m-0.offertext-p {
    display: flex;
    gap: 10px;
    color: #B80000 !important;
    font-size: 14px !important;
    margin: 5px 0 3px 0 !important;
    padding: 0;
}
.you-may-also-need-section h4.price.actual-price {
       color: #B80000 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex;
    font-weight: 400 !important;
    font-size: 16px !important;
    align-items: center;
    gap: 6px;
}
.you-may-also-need-section h4.price.actual-price .suggested-price {
  margin: 0 !important;
    padding: 0 !important;
    font-size: 16px;
    color: #303030 !important;
    text-decoration: line-through;
}
    .you-may-also-need-section .current-price {
        color: #B80000;
        font-size: 16px;
    }
.you-may-also-need-section .old-price {
    font-size: 16px;
    color: #303030;
    text-decoration: line-through;
}
.you-may-also-need-section .product-details {
    display: flex;
    flex-direction: column;
}
.you-may-also-need-section .view-details {
