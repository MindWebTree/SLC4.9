<div class="my-account d-none d-sm-block dropdown account-dropdown-target">
    @if (Model.IsAuthenticated)
    {
        <button class="btn btn-dropdown bg-transparent dropdown-toggle" type="button" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="my account">
           <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="#444444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="#444444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
<br><span class="caret">My Account</span>
        </button>
        <div class="dropdown-menu account-menu" aria-labelledby="dropdownMenuLink" role="menu">
            <a role="menuitem" href="@Url.RouteUrl("CustomerInfo")" class="ico-account d-inline-block dropdown-item">@T("Account.MyAccount")@*@Model.CustomerName*@</a>
            <a role="menuitem" href="@trackUrl" target="_blank" class="ico-logout d-inline-block dropdown-item">@T("Account.TrackOrders")</a>
            <a role="menuitem" href="/to-the-trade" class="ico-logout d-inline-block dropdown-item">@T("Account.ToTheTrade")</a>
            <a role="menuitem" href="@Url.RouteUrl("Logout")" class="ico-logout d-inline-block dropdown-item">@T("Account.Logout")</a>
        </div>
    }
    else
    {

        var returnUrl = Context.Request.Query.TryGetValue("returnUrl", out var url) && !StringValues.IsNullOrEmpty(url.ToString().Trim())
