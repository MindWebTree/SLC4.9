@if (Model.ShoppingCartEnabled)
{
    <script asp-location="Footer">
        $(document).ready(function () {
            $('.header-right-links').on('mouseenter', '.my-cart', function () {
                console.log("in");
                $('#flyout-cart-popup').addClass('active');
            });
            $('.header-right-links').on('mouseleave', '.my-cart', function () {
                $('#flyout-cart-popup').removeClass('active');
            });
            $('.header-right-links').on('mouseenter', '.my-cart', function () {
                console.log("in");
                $('#flyout-cart-popup').addClass('active');
            });
            $('.header-right-links').on('mouseleave', '.my-cart', function () {
                console.log("in");
                $('#flyout-cart-popup').removeClass('active');
            });

            $('.header-right-links').on('mouseenter', '.header-wishlist', function () {
                console.log("in");
                $('#flyout-wishlist-popup').addClass('active');
            });
            $('.header-right-links').on('mouseleave', '.header-wishlist', function () {
                $('#flyout-wishlist-popup').removeClass('active');
            });
            $('.header-right-links').on('mouseenter', '.header-wishlist', function () {
                $('#flyout-wishlist-popup').addClass('active');
            });
            $('.header-right-links').on('mouseleave', '.header-wishlist', function () {
                $('#flyout-wishlist-popup').removeClass('active');
            });

            $('.header-right-links').on('mouseenter focusin', '.my-cart', function () {
                $('#flyout-cart-popup').addClass('active');
            });
            $('body').on('mouseleave focusout', '.my-cart, #flyout-cart-popup', function (e) {
                if (!$('#flyout-cart-popup').has(e.relatedTarget).length && !$('.my-cart').has(e.relatedTarget).length && !$('.my-cart').is(e.relatedTarget)) {
                    $('#flyout-cart-popup').removeClass('active');
                }
            });

            // Wishlist
            $('.header-right-links').on('mouseenter focusin', '.header-wishlist', function () {
                $('#flyout-wishlist-popup').addClass('active');
            });
            $('body').on('mouseleave focusout', '.header-wishlist, #flyout-wishlist-popup', function (e) {
                if (!$('#flyout-wishlist-popup').has(e.relatedTarget).length && !$('.header-wishlist').has(e.relatedTarget).length && !$('.header-wishlist').is(e.relatedTarget)) {
                    $('#flyout-wishlist-popup').removeClass('active');
                }
            });

            $('body').on('mouseenter focusin', '#dropdownMenuLink', function () { 
                $('.account-menu').addClass('show');
            });
            $('body').on('mouseleave focusout', '#dropdownMenuLink, .account-menu', function (e) {
                // Check if the new focus target is OUTSIDE the menu and the button
                var isInsideMenu = $('.account-menu').has(e.relatedTarget).length > 0;
                var isOnButton = $('#dropdownMenuLink').is(e.relatedTarget) || $('#dropdownMenuLink').has(e.relatedTarget).length > 0;

                if (!isInsideMenu && !isOnButton) {
                    $('.account-menu').removeClass('show');
                }
            });
        });

    </script>
}

