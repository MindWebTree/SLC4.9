@model  CategoryGroupProductModel


@if (Model.GroupProducts.Count > 0)
{
    foreach (var groupproduct in Model.GroupProducts)
    {
        <div class="container">
            <div class="row">
                <div class="col-12 collection-rectangle-image">
                    <img src="/images/pixel.png" data-src="@groupproduct.Product.DefaultPictureModel.FullSizeImageUrl" alt="" class="w-100 lazy">
                    <div class="col-6 col-sm-3 bg-white pl-sm-3 pt-sm-3 pb-sm-0 pl-4 pt-3 pb-0 text-left" id="height">
                        <h5 class="mt-2 ml-0 font-weight-bold">@groupproduct.Product.Name</h5>
                        <p class="mt-1 ml-0">@((groupproduct.Product.SizeShadeMessage??"").Replace("|", ", ").Trim().TrimEnd(','))</p>
                        <a href="@Url.RouteUrl("Product", new {id=groupproduct.Product.Id,SeName = groupproduct.Product.SeName})" class="btn btn-secondary mt-1 mb-4 ml-0 bg-primary" id="btn1">explore collection</a>

                    </div>
                </div>
                <br />
                @foreach (var associatedProduct in groupproduct.AssociatedProducts)
                {
            <div class="col-6 col-sm-3 my-4 collection-p">
              
                <a href="@Url.RouteUrl("Product", new {id=associatedProduct.Id,SeName = associatedProduct.SeName})">
                            <img src="/images/pixel.png" data-src="@associatedProduct.DefaultPictureModel.ImageUrl" alt="" class="w-100 lazy">
                    </a>

                <a href="@Url.RouteUrl("Product", new {id=associatedProduct.Id,SeName = associatedProduct.SeName})">
                    <h3 class="mt-2 text-left">
                        @associatedProduct.Name
                    </h3></a>
                    <h5 class="mt-2">
                        @if (!string.IsNullOrEmpty(associatedProduct.ProductPrice.MembershipPrice))
                        {
                            <h5 class="price old-price">@T("Product.Label.StartingAt") <strong>@(!string.IsNullOrEmpty(associatedProduct.ProductPrice.OldPrice) ? associatedProduct.ProductPrice.OldPrice : associatedProduct.ProductPrice.Price) </strong></h5>

                        }
                        else
                        {
                            if (!string.IsNullOrEmpty(associatedProduct.ProductPrice.Msrp))
                            {
                                    <h5 class="price old-price">
                                        @T("Label.RegularPrice") @(!string.IsNullOrEmpty(associatedProduct.ProductPrice.OldPrice) ? associatedProduct.ProductPrice.OldPrice : associatedProduct.ProductPrice.Price)

                                    </h5>
                            }
                            else
                            {
                                if (!string.IsNullOrEmpty(associatedProduct.ProductPrice.OldPrice) || !string.IsNullOrEmpty(associatedProduct.ProductPrice.Price))
                                {
                                        <h5 class="price actual-price">@T("Label.RegularPrice") @(!string.IsNullOrEmpty(associatedProduct.ProductPrice.OldPrice) ? associatedProduct.ProductPrice.OldPrice : associatedProduct.ProductPrice.Price)</h5>
                                }
                            }
                        }
                    </h5>



</div>
                    <br />
                }
                <hr class="line" aria-hidden="true" color="#000000;">
            </div>
        </div>
    }
}