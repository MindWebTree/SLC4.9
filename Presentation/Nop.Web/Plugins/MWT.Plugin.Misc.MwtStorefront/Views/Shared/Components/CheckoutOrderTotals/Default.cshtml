                                    @if (discountSummary != null && !String.IsNullOrEmpty(discountSummary.Summary))
                                    {
                                        @Html.Raw(discountSummary.Summary)
                                    }
                                    @if (productDiscountSummary != null && !String.IsNullOrEmpty(productDiscountSummary.Summary))
                                    {
                                        @Html.Raw(productDiscountSummary.Summary)
                                    }
                            </div>
                        </span>
                    }
                }

            </label>
        </td>
        <td class="cart-total-right a-right">
            <span class="value-summary discount">@Model.SubTotalDiscount</span>

        </td>
    </tr>
        }
    @if (Model.SelectedShippingMethod == @T("freeshipping.method.name").Value ||
        Model.SelectedShippingMethod == @T("WhiteGloveService.method.name").Value)
