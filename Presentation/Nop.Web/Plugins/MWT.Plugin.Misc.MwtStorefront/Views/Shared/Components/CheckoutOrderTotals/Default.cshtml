    @if (Model.DisplayTax)
    {
        if (!Model.Taxes.Where(t => t.TaxType != Nop.Services.Tax.TaxType.Tax && t.TaxRate > 0).Any())
        {
            <tr class="tax-value">
                <td class="cart-total-left a-left" colspan="2">
                    @T("ShoppingCart.Totals.DisplayTax", zipCode, Model.TaxRates.Count > 0 ? "(" + Model.TaxRates.FirstOrDefault().Rate + "% )" : "")

                </td>
                <td class="cart-total-right a-right">
                    <span class="value-summary">@Model.Tax</span>
                </td>
            </tr>
        }
        else
        {
            <tr class="tax-value">
                <td colspan="2" class="cart-total-left a-left">
                    <label>@T("ShoppingCart.Totals.DisplayTax.Info")</label>
                </td>
            </tr>
            @foreach (var tax in Model.Taxes.Where(t => t.TaxRate > 0))
            {
                <tr class="tax-value">
                    <td style="padding: 0 0 0 10px;" colspan="2">
                        <label style="text-transform: uppercase;">@T("Canada.Tax.Label", tax.TaxType.ToString(), tax.TaxRate.ToString("F2"))</label>
                    </td>
                    <td class="cart-total-right a-right">
                        <span class="">@await _priceFormatter.FormatPriceAsync(tax.Amount, true, false)</span>
                    </td>
                </tr>
            }

        }
