@using MWT.Nop.Core.Domain.Orders


@model OrderTotalsModel
@inject Nop.Services.Catalog.IPriceFormatter _priceFormatter;
@inject Nop.Core.IWorkContext _workContext;
@inject Nop.Services.Common.IAddressService _addressService;
@inject Nop.Core.IWorkContext _workContext
@inject Nop.Services.Orders.IShoppingCartService _shoppingCartService
@{
    string zipCode = "";
    var customer = await _workContext.GetCurrentCustomerAsync();
    if (customer.ShippingAddressId != null && customer.ShippingAddressId > 0)
    {
        var address = await _addressService.GetAddressByIdAsync(Convert.ToInt32(customer.ShippingAddressId));
        zipCode = address?.ZipPostalCode ?? "";

    }
    int noOfItems = (await _shoppingCartService.GetShoppingCartAsync(await _workContext.GetCurrentCustomerAsync())).Count;
    decimal orderTotal = 0, subTotal = 0;
    if (!string.IsNullOrEmpty(Model.OrderTotal))
    {
        decimal.TryParse(Model.OrderTotal.Replace("$", "").Replace(",", ""), out orderTotal);
    }
    else if (!string.IsNullOrEmpty(Model.SubTotal))
    {
        decimal.TryParse(Model.OrderTotal.Replace("$", "").Replace(",", ""), out subTotal);
    }
}
<tfoot>
