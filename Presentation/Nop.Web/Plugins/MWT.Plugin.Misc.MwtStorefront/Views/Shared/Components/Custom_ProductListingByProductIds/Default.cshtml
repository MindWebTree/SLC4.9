@model IList<CustomProductOverviewModel>
@if (Model.Count > 0)
{


    @if (ViewBag.Type == "_product_listing"  || ViewBag.Type == "_product_listing_version1" ||
	ViewBag.Type == "_product_listing_version2" ||
	ViewBag.Type == "_product_listing_version3" ||
	ViewBag.Type == "_product_listing_version4" ||
	ViewBag.Type == "_product_listing_version5"  ||
	ViewBag.Type == "_product_listing_version6" ||	ViewBag.Type == "_product_listing_version7"  )
    {
        <div class="landing-page-slider mt-3">

            @foreach (var item in Model)
            {
                var partialViewData = new ViewDataDictionary(ViewData)
{
        { 
		
		"Utm",ViewBag.Type=="_product_listing" ||ViewBag.Type== "_product_listing_version1" ? "vida_niko":ViewBag.Type=="_product_listing_version2"?"mollie_frager":
		ViewBag.Type=="_product_listing_version3"?"jessica_gahan":ViewBag.Type=="_product_listing_version4"?"studio_hanego":ViewBag.Type=="_product_listing_version5"?"brittney_gutierrez":"lauren_andresky"
		},
		{
        "target",
        ViewBag.Type == "_product_listing_version7" ? "_blank" : "_self"
    }
    };
@await Html.PartialAsync("_Topic_ProductBox", item, partialViewData)
}
        </div>
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                $('.landing-page-slider').slick({
                    infinite: false,
                    slidesToShow: @(ViewBag.Type == "_product_listing_version1" ||ViewBag.Type == "_product_listing_version7" ? 4 : 3),
                    slidesToScroll: 1,
                    arrows: true,
                    dots: true,
                    prevArrow: '<button type="button" class="slick-prev"><img src="/images/uploaded/left-arrow-landing.png" alt="Previous"></button>',
                    nextArrow: '<button type="button" class="slick-next"><img src="/images/uploaded/right-arrow-landing.png" alt="Next"></button>',
                    responsive:
                        [
                            {
                                breakpoint: 1199, // When window width is <= 1199px
                                settings:
                                {
                                    slidesToShow: 2,
                                    slidesToScroll: 1
                                }
                            },
                            {
                                breakpoint: 767, // When window width is <= 767px
                                settings:
                                {
                                    slidesToShow: 1,
                                    slidesToScroll: 1
                                }
                            }
                        ]
                });
            });
        </script>
    }
    else
    {
        <div class="@ViewBag.sectionId slick-without-customization">
            @foreach (var item in Model)
            {
                @await Html.PartialAsync(ViewBag.Type == "product_with_price_info" ? "_Product_Listing_Product_Box_With_Price_Info" : "_Product_Listing_Product_Box", item)
            }
        </div>

        <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('.@(ViewBag.sectionId)').slick({
                dots: true,

				slidesToShow: 1,
                slidesToScroll: 1,
                arrows: '@ViewBag.Type' == "product_without_price_info" ? false: true,
            });
if($('body').width()>767){
            $(".single-item .slick-next").appendTo(".slick-dots");
            $(".single-item .slick-prev").appendTo(".slick-dots");
			}
        });
        </script>
    }
}
