@model CustomProductOverviewModel
@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax
@inject CatalogSettings catalogSettings
@inject IWorkContext workContext
@inject ICustomSpecificationAttributeService _specificationAttributeService


<div data-productid="@Model.Id" data-main-catid="@await _specificationAttributeService.GetMainCategoryOfProduct(Model.Id)">

    @*Tags*@
    <div class="Tags">

        @if (Model.Tags != null)
        {
            foreach (var tag in Model.Tags)
            {
                <div class="@tag.Name">@tag.Name</div>
                break;
            }
        }
    </div>
    <a href="@Url.RouteUrl("Product", new { id = Model.Id, SeName = Model.SeName })" aria-label="@Model.DefaultPictureModel.Title">
        <img alt="" style="width:100%; height:auto;" width="415" height="415" src="/images/pixel.png" data-src="@Model.DefaultPictureModel.ImageUrl" class="lazy" />
    </a>
    @*@if (ViewBag.Type == null)
        {*@
    <h3 class="product-title">
        <a href="@Url.RouteUrl("Product", new { id = Model.Id, SeName = Model.SeName })">@Model.Name</a>
    </h3>

    @Html.Partial("_ListingPrice", Model)


    @*}
        else
        {
            <h3 class="product-title">
                <a href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">@Model.Name</a>
            </h3>
            <h4>
                <a href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">@T("home.heading.Collection")</a>
            </h4>

        }*@




</div>



