@model AddressModel

<input class="address-id" asp-for="Id" type="hidden" />
<div class="edit-address">
    <div class="fieldset">
        <div class="form-fields">
            <div class="form-group">
                <div class="row">

                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                        <input asp-for="FirstName" placeholder="First Name" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                        <span asp-validation-for="FirstName"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="row">

                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                        <input asp-for="LastName" placeholder="Last Name" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                        <span asp-validation-for="LastName"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="row">

                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                        <input asp-for="Email" placeholder="Email" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                        <span asp-validation-for="Email"></span>
                    </div>
                </div>
            </div>
            @if (Model.CompanyEnabled)
            {
                <div class="form-group">
                    <div class="row">

                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <input asp-for="Company" placeholder="Company" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="Company"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.CountryEnabled)
            {
                <div class="form-group">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <select asp-for="CountryId" asp-items="Model.AvailableCountries" class="form-control"
                                    data-trigger="country-select"
                                    data-url="@(Url.RouteUrl("GetStatesByCountryId"))"
                                    data-stateprovince="#@Html.IdFor(model => model.StateProvinceId)"
                                    data-loading="#states-loading-progress"></select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="CountryId"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.CountryEnabled && Model.StateProvinceEnabled)
            {
                <div class="form-group">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <select asp-for="StateProvinceId" asp-items="Model.AvailableStates" data-trigger="state-select" class="form-control"></select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span id="states-loading-progress" style="display: none;" class="please-wait">@T("Common.Wait")</span>
                            <span asp-validation-for="StateProvinceId"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.CountyEnabled)
            {
                <div class="form-group">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <input asp-for="County" class="form-control" />
                        </div>

                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="County"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.CityEnabled)
            {
                <div class="form-group">
                    <div class="row">

                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <input asp-for="City" placeholder="City" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="City"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.StreetAddressEnabled)
            {
                <div class="form-group">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <input asp-for="Address1" placeholder="Address1" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="Address1"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.StreetAddress2Enabled)
            {
                <div class="form-group">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <input asp-for="Address2" placeholder="Address2" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="Address2"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.ZipPostalCodeEnabled)
            {
                <div class="form-group">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <input asp-for="ZipPostalCode" placeholder="Zip / postal code" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="ZipPostalCode"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.PhoneEnabled)
            {
                <div class="form-group">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <input asp-for="PhoneNumber" placeholder="Phone Number" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="PhoneNumber"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.FaxEnabled)
            {
                <div class="form-group">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 px-0">
                            <input asp-for="FaxNumber" placeholder="Fax Number" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-start px-0">
                            <span asp-validation-for="FaxNumber"></span>
                        </div>
                    </div>
                </div>
            }
            @if (Model.CustomAddressAttributes.Count > 0)
            {
                @await Html.PartialAsync("_AddressAttributes", Model.CustomAddressAttributes)
            }
        </div>
    </div>
</div>
