<script type="text/javascript" asp-location="Footer">
    $(document).ready(function () {
        bindWishlist();
    });

    function bindWishlist() {
        if (wishlistIds != "") {
            wishlistIdsArr = wishlistIds.split(",");
            for (var i = 0; i < wishlistIdsArr.length; i++) {
                var data = wishlistIdsArr[i].split("-");
                if ($("[data-wishlistid='" + data[0] + "']")) {
                    $("[data-wishlistid='" + data[0] + "']").addClass("active");
                    $("[data-wishlistid='" + data[0] + "']").attr("data-wishlist", data[1]);
                }
            }
        }
    }
</script>
