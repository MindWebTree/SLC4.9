@if (_customWorkContext.IsMobileDevice())
{
    <script type="text/javascript" asp-location="Footer">
        var lastScrollTop = 0;
        $(window).scroll(function (event) {
            var st = $(this).scrollTop();
            if (st > lastScrollTop) {
                // downscroll code
                $('header .container').removeClass('display_header');
                $('header .container').addClass('header-ease-out');
                $('body').addClass('sticky_header_enable');
                $('#sidebar-menu').removeClass('scroll_sidebar');
                // add his code to handle minus scrolling
                if (st < 1) {
                    $('header .container').removeClass('display_header');
                    $('body').removeClass('sticky_header_enable');
                    $('header .container').removeClass('header-ease-out');
                }
            } else {
                // upscroll code
                $('header .container').addClass('display_header');
                // add his code to handle minus scrolling
                $('header .container').removeClass('header-ease-out');

                $('#sidebar-menu').addClass('scroll_sidebar');

                if (st < 1) {

                    $('body').removeClass('sticky_header_enable');
                    $('header .container').removeClass('header-ease-out');
                    $('.header-message').removeClass('sticky_header_enabled');
                    $('header .container').removeClass('display_header');

                    $('#sidebar-menu').removeClass('scroll_sidebar');
                }
            }
            lastScrollTop = st;
        });</script>
}