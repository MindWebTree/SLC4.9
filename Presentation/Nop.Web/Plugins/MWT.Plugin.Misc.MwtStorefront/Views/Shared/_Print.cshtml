@using Nop.Core
@inject Nop.Services.Localization.ILanguageService languageService
@inject Nop.Core.Domain.Common.CommonSettings commonSettings
@inject IThemeContext themeContext
@inject IWorkContext workContext;
@{
    var themeName = await themeContext.GetWorkingThemeNameAsync();
}
<!DOCTYPE html>
<html lang="@languageService.GetTwoLetterIsoLanguageName(await workContext.GetWorkingLanguageAsync())" class="@NopHtml.GeneratePageCssClasses()">
<head>
    <title>@await NopHtml.GenerateTitleAsync()</title>
    <meta http-equiv="Content-type" content="text/html;charset=UTF-8" />
    <link href="~/Plugins/MWT.Plugin.Misc.MwtStorefront/Content/css/print.css" rel="stylesheet" type="text/css" />
    @NopHtml.GenerateCssFiles()
    <script src="@Url.Content("~/lib_npm/jquery/jquery.min.js")"></script>
    @*/when jQuery migrate script logging is active you will see the log in the browser console*@
    @if (commonSettings.JqueryMigrateScriptLoggingActive)
    {
        <script src="@Url.Content("~/lib_npm/jquery-migrate/jquery-migrate.js")"></script>
    }
    else
    {
        <script src="@Url.Content("~/lib_npm/jquery-migrate/jquery-migrate.min.js")"></script>
    }
    @NopHtml.GenerateScripts(ResourceLocation.Head)
    @NopHtml.GenerateInlineScripts(ResourceLocation.Head)
</head>
<body>
    @RenderBody()
    @NopHtml.GenerateInlineScripts(ResourceLocation.Footer)
</body>
</html>
