@{
    Layout = "_Root.Head";
}

@inject Nop.Services.Orders.IShoppingCartService _shoppingCartService;
@inject ICustomWorkContext _customWorkContext;
@inject Nop.Core.IStoreContext _storeContext;
@using Nop.Core.Domain.Orders;
@await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.BodyStartHtmlTagAfter })
@await Html.PartialAsync("_Notifications")
@await Html.PartialAsync("_JavaScriptDisabledWarning")
@await Html.PartialAsync("_OldInternetExplorerWarning")
@inject Nop.Core.IWorkContext _workContext;
@inject IThemeContext themeContext
@inject Nop.Services.Localization.ILocalizationService _localizationService;
@{
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    var controllerName = this.ViewContext.RouteData.Values["controller"].ToString();
    var action = this.ViewContext.RouteData.Values["action"].ToString();
    bool isHome = String.Compare(controllerName, "home",
                  StringComparison.OrdinalIgnoreCase) == 0 && String.Compare(action, "index",
                  StringComparison.OrdinalIgnoreCase) == 0 ? true : false;
    var customer = await _workContext.GetCurrentCustomerAsync();
    IList<ShoppingCartItem> cart = new List<ShoppingCartItem>();
    if (customer != null)
    {
        cart = await _shoppingCartService.GetShoppingCartAsync(customer, ShoppingCartType.Wishlist, (await _storeContext.GetCurrentStoreAsync()).Id);

    }
    var wishlist_deleteitem = await _localizationService.GetResourceAsync("wishlist.mini.deleteitem");
    var wishlist_deleteitem_empty = await _localizationService.GetResourceAsync("wishlist.mini.deleteitem.empty");

}
<script type="text/javascript">
    var offerintervalId = 0;
    var wishlistIds = "@string.Join(",", cart.Select(m => m.ProductId + "-" + m.Id).ToArray())";
    var copyContentHelp='@T("Common.CopyContent.Help")';
    var contentCopyClipLoard = '@T("Common.ContentCopyClipLoard")';
</script>
<div class="master-wrapper-page">
    <div class="skip-main-link">
        <a href="#main" id="skip-to-main" onclick="addTabIndex('main')">Skip to Main Content</a>
        <a href="#footer" id="skip-to-footer" onclick="addTabIndex('footer')">Skip to Footer</a>
    </div>
    @await Html.PartialAsync("_DataLayer")
    @await Component.InvokeAsync("AdminHeaderLinks")
    @await Html.PartialAsync("_headerOffer")
    @await Html.PartialAsync("_headerPromotion")
    @if (_customWorkContext.IsMobileDevice())
    {
        @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Marketing.Bar.Header.Mobile" })
    }

    <header>
        @await Html.PartialAsync("_Header")
        <script type="text/javascript" asp-location="Footer">
            var localized_data = {
                AjaxCartFailure: "@T("AjaxCart.Failure")"
            };
            AjaxCart.init(false, '.ico-cart .cart-qty', '.header-wishlist .wishlist-qty', '#flyout-cart .modal-content', '#flyout-Wishlist-cart .modal-content', '#wishlistpopupmodel', '#cartpopupmodel', '#flyout-cart-popup', '#flyout-wishlist-popup', '@wishlist_deleteitem','@wishlist_deleteitem_empty',  localized_data);
        </script>
        <div class="header-menu">
            @await Component.InvokeAsync("Widget", new { widgetZone = CustomPublicWidgetZones.ThemeHeaderMenu })
            @await Component.InvokeAsync("Widget", new { widgetZone = CustomPublicWidgetZones.ThemeMobileHeaderMenu })
        </div>
        <!--- seema Mobile Search bar -->

        <div class="col-12 d-lg-none d-block m-search">
            @await Component.InvokeAsync(typeof(MWT.Plugin.Misc.MwtStorefront.Components.SearchBoxViewComponent))
        </div>


    </header>
    @if (!_customWorkContext.IsMobileDevice())
    {
        @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Marketing.Bar.After.MainNavigation" })
    }

    <section id="main">
        <div class="master-wrapper-content @(isHome ? "" : "container")">
            @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ContentBefore })

            @if (IsSectionDefined("Breadcrumb"))
            {
                @RenderSection("Breadcrumb")
            }
            <div class="master-column-wrapper">

                @RenderBody()
            </div>
            @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ContentAfter })
        </div>

    </section>
    @await Component.InvokeAsync(typeof(FooterViewComponent))
</div>
@await Component.InvokeAsync("EuCookieLaw")
@await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.BodyEndHtmlTagBefore })

