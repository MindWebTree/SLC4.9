@if (_customWorkContext.IsMobileDevice())
{
    <script type="text/javascript" asp-location="Footer">
        var lastScrollTop = 0;
        var isUserScrolling = false;
        $(window).on("touchstart", function () {
            isUserScrolling = false;
        });

        $(window).on("touchmove", function () {
            isUserScrolling = true;
        });
        $(window).scroll(function (event) {
            var st = $(this).scrollTop();
            if (st > lastScrollTop) {

                // downscroll code
                $('body').removeClass('sticky_header_enable');
                $('header .container').removeClass('display_header');
                // $('header .container').removeClass('header-ease-in');



                $('.header-message').removeClass('sticky_header_enabled');
                if (st > ($('.master-wrapper-page header') + $('.master-wrapper-page .section-2'))) {
                    $('header .container').addClass('header-ease-out');
                    $('body').addClass('sticky_header_enable');
                }
                /* ram || remove fixed search fro mobile*/
                if (jQuery('body').width() < 992 && isUserScrolling) {
                    $('.m-search').removeClass('display');
                    $('.m-search').removeClass('fixed');
                }
                else {
                    $('.m-search').css('top', $('.logo-section .row ').height() + $('.logo-section .row ').offset().top);
                }
                /* ram || end remove fixed search fro mobile*/
                $('#sidebar-menu').removeClass('scroll_sidebar');
                // add his code to handle minus scrolling
                if (st < st > ($('.master-wrapper-page header') + $('.master-wrapper-page .section-2'))) {
                    $('header .container').removeClass('display_header');
                    $('body').removeClass('sticky_header_enable');
                    //$('header .container').removeClass('header-ease-in');
                    $('header .container').removeClass('header-ease-out');
                }
            } else {


                // upscroll code
                $('header .container').addClass('display_header');
                $('body').addClass('sticky_header_enable');
                //$('header .container').addClass('header-ease-in');
                $('header .container').removeClass('header-ease-out');
                $('.header-message').addClass('sticky_header_enabled');
                $('#sidebar-menu').addClass('scroll_sidebar');

                if (st < $('header .container').height()) {

                    $('header .container').removeClass('display_header');
                    $('body').removeClass('sticky_header_enable');
                    //$('header .container').removeClass('header-ease-in');
                    $('header .container').removeClass('header-ease-out');
                    $('.header-message').removeClass('sticky_header_enabled');
                    $('#sidebar-menu').removeClass('scroll_sidebar');

                }
                /* ram || remove fixed search fro mobile*/
                if (jQuery('body').width() < 992 && isUserScrolling) {
                    $('.m-search').removeClass('display');
                    $('.m-search').removeClass('fixed');
                }
                else {
                    $('.m-search').css('top', $('.logo-section .row ').height() + $('.logo-section .row ').offset().top);
                }
                /* ram || end remove fixed search fro mobile*/

            }
            lastScrollTop = st;
        });</script>
}