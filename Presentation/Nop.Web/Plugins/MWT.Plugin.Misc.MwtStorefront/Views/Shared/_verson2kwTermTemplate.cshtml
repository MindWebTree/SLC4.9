<div class="row mx-0 kwterm">
    @if (IsSectionDefined("CategoryTopWidget"))
    {
        @await RenderSectionAsync("CategoryTopWidget", false)
    }
    @if (IsSectionDefined("Heading"))
    {
        @await RenderSectionAsync("Heading")

    }      @if (IsSectionDefined("Categories"))
    {
        @await RenderSectionAsync("Categories")

    }  <div class="category-listing-sort-filter-conatiner">

        @*@await RenderSectionAsync("QuickFilter")*@
        @if (IsSectionDefined("CatalogSelector"))
        {
            @await RenderSectionAsync("CatalogSelector")
        }
        @if (_workContext.IsMobileDevice())
        {
            @if (IsSectionDefined("SelectedtFilters"))
            {
                @await RenderSectionAsync("SelectedtFilters", false)
            }
        }
        @if (IsSectionDefined("CatalogFilters") && !_workContext.IsMobileDevice())
        {
            @await RenderSectionAsync("CatalogFilters", false)
        }
    </div>
</div>
<div class="row kwterm">
    @if (IsSectionDefined("CatalogFilters"))
    {
        <div class="filters  col-0">
            @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.LeftSideColumnBefore })
            @if (_workContext.IsMobileDevice())
            {
                @await RenderSectionAsync("CatalogFilters", false)
            }
        
        </div>
    }
    <div class="listinggrid  col-sm-12">
        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.MainColumnBefore })
        @RenderBody()
        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.MainColumnAfter })
    </div>
    <div class="col-sm-12">
        @await RenderSectionAsync("categoryBottom")
    </div>
</div>
