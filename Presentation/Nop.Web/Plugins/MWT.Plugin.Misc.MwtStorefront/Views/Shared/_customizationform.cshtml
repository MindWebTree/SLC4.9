@model CustomProductDetailsModel
@inject ICustomWorkContext _workContext
@inject Nop.Services.Configuration.ISettingService _settingService;
@inject ICustomProductService _productService
@inject ICustomizationFormSerivce _customFormService
@inject ICustomSpecificationAttributeService _specificationAttributeService
@inject ICustomCategoryService _categoryService
@{ int customizationFormTemplateId = Model.CustomizationFormTemplateId;
                if (customizationFormTemplateId == 0)
                {
                    var categoryId = await _specificationAttributeService.GetMainCategoryOfProduct(Model.Id);
                    if (categoryId != 0)
                    {
                        customizationFormTemplateId = (await _categoryService.GetCategoryByIdAsync(categoryId))?.CustomizationFormTemplateId ?? 0;
                    }
                }

                if (customizationFormTemplateId == 0)
                {
        var templates = await _customFormService.GetAllProductCustomizationFormTemplatesAsync();
                    customizationFormTemplateId = templates.Where(t => t.IsDefault).FirstOrDefault()?.Id ?? 0;
                    if (customizationFormTemplateId == 0)
                    {
                        customizationFormTemplateId = templates.FirstOrDefault()?.Id ?? 0;
                    }
                }

    var formName = customizationFormTemplateId == 0 ? "Default" : (await _customFormService.GetProductCustomizationFormTemplateByIdAsync(customizationFormTemplateId))?.Name ?? "";
                formName = formName == "Rugs" ? "Version1 rugs" : formName;
                var sizeAttr = await _settingService.GetSettingByKeyAsync<string>("catalog.product.attribute.size.name");
                bool showCustomizationBanner = !Model.ProductAttributes.Where(s => s.Name == sizeAttr).Any();
                string uploadTypes_Expression = await _settingService.GetSettingByKeyAsync<string>("Customizationform.Supported.UploadTypes.Expression"); }
