<div class="modal fade" id="customizationFormModel" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered customizationform-popup customform_@formName.ToLower()" role="document">




    </div>
</div>

<script type="text/javascript" asp-location="Footer">
 let totalImages = 0;
    var customizationurl = '@Url.RouteUrl("CustomizationForm", new { productId = Model.Id })'
    $(".StartCustomization").click(function (event) {
        cutomizationProduct("");
        event.preventDefault();

    });
    function cutomizationProduct(target) {

        $.ajax({
            cache: false,
            url: customizationurl + "?width=" + $(window).width(),
            type: "GET",
            success: function (response) {
                totalImages = 0;
                $(".customizationform-popup").attr("data-trigger", "");
                $(".customizationform-popup").attr("data-trigger", target);
                $(".customizationform-popup").html(response.content);
                $('#customizationFormModel').modal('show')
            },
            error: function (response) {
            }
        });
    }
    $(".Product-customize-size,.product-customize-shade").click(function (e) {
        e.preventDefault();
        cutomizationProduct($(this).attr("class"));
    });

// new script
    $('body').on('click', '.custom-size-request-input.disabled ul,.custom-size-request-input.disabled select', function() {

     const checkbox = $('.custom-size-tr .custom-size-request input');
    checkbox.prop('checked', !checkbox.prop('checked')).change();
})

    $('body').on('click', '.custom-shade-tr .custom-shade', function (e) {

    var shadecheckbox = $('.custom-shade-tr #custom-stain-checkbox');
    shadecheckbox.prop('checked', !shadecheckbox.prop('checked')).change(); // Manually trigger the change event

    e.stopPropagation();
});
var custom_shade_default_name='Fill stain details below ';

  $('body').on('change', '.custom.custom-size-tr input[name="customsize"]', function () {
                if ($(this).is(':checked')) {
                    $('#customizationFormModel .custom-size-control input[type="radio"]').prop('checked', false).closest('tr').addClass('disabled');
                    $('#customizationFormModel .custom.custom-size-tr input').prop('readonly', false).closest('td').removeClass('disabled');
                    $('#customizationFormModel .custom.custom-size-tr select').prop('disabled', false).closest('td').removeClass('disabled');
                    // $('.new-size-box input input:not([name="customsize"])').prop('disabled', true).prop('checked', false);
                    $('#customizationFormModel .custom-shade-tr.size input:not([name="customsize"])').prop('disabled', true).prop('checked', false);
                    $('#customizationFormModel .custom-shade-tr.size select').prop('disabled', true).closest('tr').addClass('disabled');

                } else {
                    $('.new-size-box input').prop('disabled', false).closest('tr').removeClass('disabled');
                     $('.custom-shade-tr.size select').prop('disabled', false).closest('tr').removeClass('disabled');
                    $('.custom.custom-size-tr input:not([name="customsize"])').prop('readonly', true).closest('td').addClass('disabled');
                    $('.custom.custom-size-tr select').prop('disabled', true).closest('td').addClass('disabled');

                }
            });

            $('body').on('change', '#custom-stain-checkbox', function () {


                if ($(this).is(':checked')) {
                    $('.form-group.message').addClass('enable');
                    $('.custom-shade-tr .selected-shade-front .Stain').text(custom_shade_default_name);
                    $('.custom.custom-shade-tr').removeClass('desable');

                   $('.custom-shade-tr:not(.size) input:not(#custom-color-picker):not(#custom-stain-checkbox)').not('.custom').prop('disabled', true).closest('tr').addClass('disabled');
                   $('.custom-shade-tr:not(.size)').addClass('disabled');
                   $('#custom-color-picker').prop('disabled', false).closest('td').removeClass('disabled');
                    $('.custom.custom-shade-tr .custom-size-request-input').addClass('disabled');
                    $(".custom-shade-message").removeClass("d-none")
                } else {
                    $(".custom-shade-message").addClass("d-none")
                   $('.custom-shade-tr:not(.size) input:not(#custom-color-picker):not(#custom-stain-checkbox)').not('.custom').prop('disabled', false).closest('tr').removeClass('disabled');
                    $('#custom-color-picker').prop('disabled', true).closest('td').addClass('disabled');

                     $('.custom-shade-tr .selected-shade-front .Stain').text($('.custom-shade-tr:not(.size) .selected-value label').data('attr-name'));
                       $('.custom-shade-tr:not(.size)').removeClass('disabled');
                         $('.custom.custom-shade-tr').addClass('desable');
                         $('.custom.custom-shade-tr .custom-size-request-input').removeClass('disabled');
                         if(!$('.check-customize-new #InteresedInCustomDesign').prop('checked'))    {

                        $('.form-group.message').removeClass('enable');
                    }
                }
            });


              $('body').on('change', '.check-customize-new #InteresedInCustomDesign', function () {


                if ($(this).is(':checked')) {
                              $('.customize-form-section-messgae-attachemnt .form-group.message').addClass('enable');
                } else {
                    if(!$('#custom-stain-checkbox').prop('checked'))    {
                        $('.customize-form-section-messgae-attachemnt .form-group.message').removeClass('enable');
                    }

                }
            });



      const MAX_IMAGES = 3;
        // let totalImages = 0;
          $('body').on('click','.add-image',function(e){
       $('.image-attachment-error').hide();

           if($('.multiple_attachment_image .preview-item').length<1){
                inputField= $('<div class="preview-item new"><input name="attachment[]" class="form-control-file" accept="@uploadTypes_Expression" multiple type="file" style="display: none;" /></div>');
             $('.multiple_attachment_image').append(inputField);
           }
           $('.form-control-file').click();
        })


   $('body').on('click','.add-image-icon.enable',function(e){


 $('.image-attachment-error').hide();
    // Create a new input field
    var inputField='';
    if($('.multiple_attachment_image .new').length<1){


     inputField= $('<div class="preview-item new"><input name="attachment[]" class="form-control-file" accept="@uploadTypes_Expression" multiple type="file" style="display: none;" /></div>');
    }

    // Append the input field to the .add-image-icon div
    $('.multiple_attachment_image').append(inputField);
        $('.multiple_attachment_image');
    // Trigger the click event on the newly created input field
    $('.multiple_attachment_image .new input').trigger('click');

    e.stopPropagation();

    // Handle file selection
  });




   $('body').on('change', '.form-control-file', function() {
    const input = this;
    const previewContainer = $('.multiple_attachment_image'); // Update this to select the correct container
    const files = input.files;


    // Create a new FileList-like object to store the files
    const dataTransfer = new DataTransfer();

    // Check if adding these files would exceed the limit
    console.log(totalImages,files.length);
    if (totalImages + files.length > MAX_IMAGES) {
       $('.image-attachment-error').show();
        input.value = '';
        return;
    }

    for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const reader = new FileReader();

        reader.onload = function(e) {
            var previewItem='';
            if($('.multiple_attachment_image .new').length<1){
                 previewItem = document.createElement('div');
                  previewItem.className = 'preview-item new';
            }else{
              previewItem = previewContainer.find('.new').first();
            }



            const img = document.createElement('img');
            img.src = e.target.result;
            img.classList.add('image-preview');

            const removeButton = document.createElement('button');
            removeButton.innerHTML = '×';
            removeButton.classList.add('remove-preview');
            removeButton.onclick = function() {
                // Remove this specific image
                previewItem.remove();
                totalImages--;

                // Remove the file from the input
                const currentFiles = Array.from(input.files);
                const updatedFiles = currentFiles.filter((_, index) => index !== i);

                // If there are remaining files, add them back to the input
                if (updatedFiles.length > 0) {
                    const newDataTransfer = new DataTransfer();
                    updatedFiles.forEach(file => newDataTransfer.items.add(file));
                    input.files = newDataTransfer.files;
                }
                  if($('.preview-item img').length<1){
                        $('.add-image').show();
                        $('.add-image-icon').removeClass('enable');
                  }
                        $('.add-image-icon').show();
            };
            $(previewItem).removeClass('new');
            $(previewItem).append(img);
            $(previewItem).append(removeButton);
            previewContainer.append(previewItem); // Append to the ".multiple_attachment_image" container
            $('.add-image').hide();

            $('.add-image-icon').removeClass('desable').addClass('enable');
             if($('.preview-item img').length>=3){
            $('.add-image-icon').hide();
          }
            // Add the file to our FileList-like object
            dataTransfer.items.add(file);
            totalImages++;
        };

        reader.readAsDataURL(file);
    }

    // Update the input's files with our managed FileList
    // input.files = dataTransfer.files;

});



</script>


