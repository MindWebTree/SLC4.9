@model CustomProductOverviewModel.ProductPriceModel
@using Nop.Core
@using Nop.Core.Domain.Tax
@using Nop.Web.Models.Catalog
@inject ICustomWorkContext workContext
@{ string offerText = CustomCommonHelper.GetProductOfferText(Model.ProductId, Model.OfferText, Model.OfferPlaceHolder, Model.DiscountAmount, Model.DiscountPercentage, Model.SaleEndDate, true);

    List<ProductDetailsModel.ProductAttributeModel> attributes = new List<ProductDetailsModel.ProductAttributeModel>();

    if (ViewData["productAttributes"] != null && ViewData["productAttributes"] != "")
    {
        attributes = (List<ProductDetailsModel.ProductAttributeModel>)ViewData["productAttributes"];
    } }
<div class="price-shade-section">
    @if (!Model.CustomerEntersPrice)
    {
<div class="prices">
    @if (Model.CallForPrice)
    {@*call for price*@
                        <div class="product-price call-for-price">
                            <span>@T("Products.CallForPrice")</span>
                        </div> }
                                        else
                                        {
                                            if (Model.IsRental)
                                            {
                        <div class="rental-price">
                            <label>@T("Products.Price.RentalPrice"):</label>
                            <span>@Model.RentalPrice</span>
                        </div> }


                        @if (Model.IsVariantProduct)
                        {
    @if (!string.IsNullOrEmpty(Model.MinMembershipPrice))
    {
<h3 class="product-price">
    <span>   @T("Product.Label.RegularPrice")</span><span>:</span>
    <span id="price-value-@(Model.ProductId)" class="price-value-@(Model.ProductId)">
        @T("Price.Range",
!string.IsNullOrEmpty(Model.MinOldPrice) ? Model.MinOldPrice : Model.MinPrice,
!string.IsNullOrEmpty(Model.MaxOldPrice) ? Model.MaxOldPrice : Model.MaxPrice)
    </span>
</h3>
                            <h3 class="membershipPrice-section-@(Model.ProductId)">
                                <span>
                                    @T("Products.Label.MembershipPrice")
                                </span><span>:</span>
                                <span id="membershipPrice-value-@(Model.ProductId)" class="membershipPrice-value-@(Model.ProductId)">
                                    @T("Price.Range", Model.MinMembershipPrice, Model.MaxMembershipPrice)
                                </span>
                            </h3> }
                                                    else
                                                    {

                            @if (Model.MinOldPriceValue > 0 && Model.MinPriceValue > 0 && (Model.MinOldPriceValue != Model.MinPriceValue || Model.MaxPriceValue != Model.MaxOldPriceValue))
                            {
                                if (!string.IsNullOrEmpty(Model.OfferText))
                                {
<p class="sale-price  m-0 limited-offer-@(Model.ProductId)">@Html.Raw(offerText)</p> }

<h3 class="product-price">
    <span id="price-value-@(Model.ProductId)" class="price-value-@(Model.ProductId)">
        @T("Price.Range.With.Saleprice",
!string.IsNullOrEmpty(Model.MinPrice) ? Model.MinPrice : Model.MinOldPrice,
!string.IsNullOrEmpty(Model.MaxPrice) ? Model.MaxPrice : Model.MaxOldPrice,
!string.IsNullOrEmpty(Model.MinOldPrice) ? Model.MinOldPrice : Model.MinPrice,
!string.IsNullOrEmpty(Model.MaxOldPrice) ? Model.MaxOldPrice : Model.MaxPrice
)
    </span>
</h3> }
                            else
                            {
                                if (!string.IsNullOrEmpty(Model.OfferText))
                                {
<p class="sale-price  m-0 limited-offer-@(Model.ProductId)">@Html.Raw(offerText)</p> }
<h3 class="product-price">

    <span id="price-value-@(Model.ProductId)" class="price-value-@(Model.ProductId)">
        @T("Price.Range",
!string.IsNullOrEmpty(Model.MinOldPrice) ? Model.MinOldPrice : Model.MinPrice,
!string.IsNullOrEmpty(Model.MaxOldPrice) ? Model.MaxOldPrice : Model.MaxPrice)
    </span>
</h3>}} }
                        else
                        {
                            if (!string.IsNullOrEmpty(Model.MembershipPrice))
                            {
    <h3 class="product-price">

        <span>   @T("Product.Label.RegularPrice")</span><span>:</span>
        @*render price*@
        <span id="price-value-@(Model.ProductId)" class="price-value-@(Model.ProductId)">
            @Html.Raw(!string.IsNullOrEmpty(Model.OldPrice) ? Model.OldPrice : Model.Price)
        </span>
    </h3>

                                <h3 class="membershipPrice-section-@(Model.ProductId)">
                                    <span>
                                        @T("Products.Label.MembershipPrice")
                                    </span><span>:</span>
                                    <span id="membershipPrice-value-@(Model.ProductId)" class="membershipPrice-value-@(Model.ProductId)">
                                        @Model.MembershipPrice
                                    </span>
                                </h3> }
                                                        else
                                                        {
                                                            if (Model.OldPriceValue > 0 && Model.PriceValue > 0 && Model.OldPrice != Model.Price)
                                                            {
                                                                if (!string.IsNullOrEmpty(Model.OfferText))
                                                                {
                                <p class="sale-price  m-0 limited-offer-@(Model.ProductId)">@Html.Raw(offerText)</p> }
                                <h3 class="product-price">
                                    <span id="price-value-@(Model.ProductId)" class="price-value-@(Model.ProductId)">
                                        <span class="sale-price">@Model.Price</span><span class="suggested-price">@Model.OldPrice</span>
                                    </span>
                                </h3> }
                                                            else
                                                            {
                                                                if (!string.IsNullOrEmpty(Model.OfferText))
                                                                {
                                <p class="sale-price  m-0 limited-offer-@(Model.ProductId)">@Html.Raw(offerText)</p> }
                                <h3 class="product-price">
                                    @*render price*@
                                    <span id="price-value-@(Model.ProductId)" class="price-value-@(Model.ProductId)">
                                        @(!string.IsNullOrEmpty(Model.OldPrice) ? Model.OldPrice : Model.Price)
                                    </span>
                                </h3>}
                                                        }
                                                    }}

</div>}
    @if (attributes.Count > 0)
    {
<div class="selected-attributes-show">
    @foreach (var attribute in attributes)
    {
        var textPrompt =  attribute.Name;
        var selectedAttrs = "";
@foreach (var attributeValue in attribute.Values)
{
    if (attributeValue.IsPreSelected)
    {
        selectedAttrs = selectedAttrs + attributeValue.Name + ",";
    }
}
                    <div class="parent-@(attribute.Id)" style="@(selectedAttrs.Length==0?"display:none;":"")">
                        @if (T("Product.Attr.shades").Text == textPrompt)
                        {
    <span class="@textPrompt">
        @Html.Raw(T("Product.selected.shades", selectedAttrs.Length > 0 ? selectedAttrs.Substring(0, selectedAttrs.Length - 1) : selectedAttrs))
    </span> }
                        else
                        {
    <span class="@textPrompt">
        @Html.Raw(selectedAttrs.Length > 0 ? selectedAttrs.Substring(0, selectedAttrs.Length - 1) : selectedAttrs)
    </span>                    }
                    </div>}
</div>}
</div>