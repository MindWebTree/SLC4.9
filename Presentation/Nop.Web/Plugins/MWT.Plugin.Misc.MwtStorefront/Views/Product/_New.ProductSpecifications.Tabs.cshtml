@model CustomProductSpecificationModel
@using Nop.Core.Domain.Catalog;
@inject Nop.Services.Configuration.ISettingService _settingService
@if (Model.Groups.SelectMany(g => g.Attributes).ToList().Count > 0)
{
    var displayDimension = ViewData["DisplaySpecificationAttributeDimension"] as bool? ?? true;
    int counter = 0;
    @foreach (var group in Model.Groups)
    {
        @if (group.Attributes.Count > 0)
        {
            @for (int i = 0; i < group.Attributes.Count; i++)
            {
                var attr = group.Attributes[i];
                @if (attr.Name.Equals(T("product.specification.attr.dimension").Text, StringComparison.InvariantCultureIgnoreCase) || attr.Name.Equals(T("product.specification.attr.Mobiledimension").Text, StringComparison.InvariantCultureIgnoreCase))
                {
                    continue;
                }
                <span data-target="#collapse-@attr.Id" class="cta-tab">
                    <span class="span">
                        @attr.Name
                    </span>
                </span>
            }

        }
    }
}
