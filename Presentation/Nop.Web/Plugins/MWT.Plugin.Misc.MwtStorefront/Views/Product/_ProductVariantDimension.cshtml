@model CustomProductDetailsModel
@using Nop.Core.Domain.Catalog;
@inject Nop.Core.IStoreContext _storeContext;
@inject Nop.Services.Configuration.ISettingService _settingService
@inject ICustomWorkContext _workcontext
@{ var dimensionAttributeName = await _settingService.GetSettingByKeyAsync<string>("product.specification.attr.dimension");
    var attr = Model.ProductAttributes.Where(a => a.Name.Equals(T("product.attr.size").Text, StringComparison.InvariantCultureIgnoreCase)).FirstOrDefault();
    var activeDimensionTab = ViewData["ActiveDimensionTab"] as bool? ?? false; }
@if (attr != null)
{

    int selectedId = attr.Values.Where(v => !string.IsNullOrEmpty(v.VariantDimension)).Where(a => a.IsPreSelected).FirstOrDefault()?.Id ?? attr.Values.Where(v => !string.IsNullOrEmpty(v.VariantDimension)).FirstOrDefault()?.Id ?? 0;
    if (_workcontext.IsMobileDevice())
    {

<div class="product-dimension-block">
    @*//added to scroll to this section*@
    <div class="card-header @(!activeDimensionTab ? "collapsed" : "")" data-bs-toggle="collapse" href="#collapse-dimension">
        <span class="card-title">
            @dimensionAttributeName
        </span>
    </div>
    <div id="collapse-dimension" class="card-body @(!activeDimensionTab ? "collapse" : "show")" style="">
        <div class="custom-select">



            <select id="attributeDropdown" name="AttributeValues" class="form-control">
                <option value="0">@T("Products.ProductAttributes.DropdownList.DefaultItem")</option>
                @foreach (var value in attr.Values.Where(v => !string.IsNullOrEmpty(v.VariantDimension)))
                {
                    // Determine if the current value is the first one to set selected
<option value="@value.Id" selected="@(value.Id == selectedId)">@value.Name</option>}
            </select>
        </div>
        <div id="variant-dimensions-section">
            @{ var counter = 0;
                foreach (var value in attr.Values.Where(v => !string.IsNullOrEmpty(v.VariantDimension)))
                {
<div class="dimension-block" data-id="@value.Id" style="display:@(value.Id == selectedId ? "block" : "none");">
    @Html.Raw(value.VariantDimension)
</div> counter++;
} }
        </div>
    </div>
</div> }
                else
                { <div class="custom-select">



                        <select id="attributeDropdown" name="AttributeValues" class="form-control">
                            <option value="0">@T("Products.ProductAttributes.DropdownList.DefaultItem")</option>
                            @foreach (var value in attr.Values.Where(v => !string.IsNullOrEmpty(v.VariantDimension)))
                            {
                                // Determine if the current value is the first one to set selected
        <option value="@value.Id" selected="@(value.Id == selectedId)">@value.Name</option>}
                        </select>
                    </div>
                                        <div id="variant-dimensions-section">
                                            @{ var counter = 0;
                                                foreach (var value in attr.Values.Where(v => !string.IsNullOrEmpty(v.VariantDimension)))
                                                {
                            <div class="dimension-block" data-id="@value.Id" style="display:@(value.Id == selectedId ? "block" : "none");">
                                @Html.Raw(value.VariantDimension)
                            </div> counter++;
                        } }
                                        </div>

                                    }
                    <script asp-location="Footer">
        if ('@(activeDimensionTab)' == "True") {
            initDimensionZoom(@(selectedId));
        }

        $('#attributeDropdown').on('change', function (e) {

            $('.dimension-block').hide();
            $(".dimension-block[data-id='" + $(this).val() + "']").show();
            initDimensionZoom($(this).val());
        });

        $(document).on("attribute_changed", function (event) {
            if ($(`select[id="attributeDropdown"] option[value="${event.changedData.attrId}"]`).length > 0 && event.changedData.attrId > 0) {

                $('select[id="attributeDropdown"]').val(event.changedData.attrId).trigger("change");

                let selectedText = $('#attributeDropdown option:selected').text();
                let $customOptions = $('#collapse-dimension .select-items > div');

                $customOptions.removeClass('same-as-selected');
                $customOptions.each(function () {
                    if ($(this).text().trim() === selectedText.trim()) {
                        $(this).addClass('same-as-selected');
                    }
                });

                $('#collapse-dimension .select-selected').text(selectedText);
            }
        });
        document.body.addEventListener(
            "click",
            function (e) {
                // Find the closest zoom link clicked
                const target = e.target.closest("a.dimension-zoom, a.default-dimension-zoom");
                if (target) {
                    e.stopPropagation(); // Stop opening in new tab
                    e.preventDefault();
                    console.log(e.target);

                    // Trigger MagicZoom manually

                }
            },
            true // Use capture phase
        );

        function initDimensionZoom(id) {

            // Find the currently visible dimension-block
            const visibleBlock = document.querySelector(`.dimension-block[data-id='${id}']`);

            if (!visibleBlock) return;

            var link = visibleBlock.querySelector('a.dimension-zoom'); // select the <a> tag
            if (link) {

                if (!link.classList.contains('mz-initialized')) {
                    if (window.MagicZoom) {
                        MagicZoom.start(link); // pass the <a> element, not the <img>
                        link.classList.add('mz-initialized');
                    }
                }
            }



            link = visibleBlock.querySelector('a.default-dimension-zoom'); // select the <a> tag
            if (link) {

                if (!link.classList.contains('mz-initialized')) {
                    if (window.MagicZoom) {
                        MagicZoom.start(link); // pass the <a> element, not the <img>
                        link.classList.add('mz-initialized');
                    }
                }
            }

        }
        var collapseElement = document.getElementById("collapse-dimension");

        // Attach event listener for after it opens
        collapseElement.addEventListener("shown.bs.collapse", function () {
            var visibleBlock = $(".dimension-block:visible");
            if (visibleBlock.length) {
                initDimensionZoom(visibleBlock.attr("data-id"));
            }
        });
                    </script>}