@model CustomProductDetailsModel.ProductPriceModel
@using Nop.Core
@using Nop.Core.Domain.Tax
@inject IWorkContext workContext

@{ bool isAttributePreselected = true;
    if (ViewData["isAttributePreselected"] != null && ViewData["isAttributePreselected"] != "")
    {
        bool.TryParse(ViewData["isAttributePreselected"].ToString(), out isAttributePreselected);

    }
    List<CustomProductDetailsModel.ProductAttributeModel> attributes = new List<CustomProductDetailsModel.ProductAttributeModel>();

    if (ViewData["productAttributes"] != null && ViewData["productAttributes"] != "")
    {
        attributes = (List<CustomProductDetailsModel.ProductAttributeModel>)ViewData["productAttributes"];
    } }
<div class="price-without-offer price-shade-section">
    @if (!Model.CustomerEntersPrice)
    {
        <div class="prices">
            @if (Model.CallForPrice)
            {@*call for price*@
            <div class="product-price call-for-price">
                <span>@T("Products.CallForPrice")</span>
            </div> }
        else
        {
            if (Model.IsRental)
            {
                <div class="rental-price">
                    <label>@T("Products.Price.RentalPrice"):</label>
                    <span>@Model.RentalPrice</span>
                </div> }
            @if (Model.IsVariantProduct && !isAttributePreselected)
            {
                @if (!string.IsNullOrEmpty(Model.MinMembershipPrice))
                {
                    <h3 class="product-price">
                        <span>   @T("Product.Label.RegularPrice")</span><span>:</span>
                        <span id="price-value-withoutoffer-@(Model.ProductId)" class="price-value-withoutoffer-@(Model.ProductId)">
                            @T("Price.Range",
                    !string.IsNullOrEmpty(Model.MinOldPrice) ? Model.MinOldPrice : Model.MinPrice,
                    !string.IsNullOrEmpty(Model.MaxOldPrice) ? Model.MaxOldPrice : Model.MaxPrice)
                        </span>
                    </h3>
                    <h3 class="membershipPrice-section-@(Model.ProductId)">
                        <span>
                            @T("Products.Label.MembershipPrice")
                        </span><span>:</span>
                        <span id="membershipPrice-withoutoffer-value-@(Model.ProductId)" class="membershipPrice-value-withoutoffer-@(Model.ProductId)">
                            @T("Price.Range", Model.MinMembershipPrice, Model.MaxMembershipPrice)
                        </span>
                    </h3> }
                else
                {

                    @if (Model.MinOldPriceValue > 0 && Model.MinPriceValue > 0 && (Model.MinOldPriceValue != Model.MinPriceValue || Model.MaxPriceValue != Model.MaxOldPriceValue))
                    {
                       

                        <h3 class="product-price">
                            <span id="price-value-withoutoffer-@(Model.ProductId)" class="price-value-withoutoffer-@(Model.ProductId)">
                                @T("Price.Range.With.Saleprice",
                        !string.IsNullOrEmpty(Model.MinPrice) ? Model.MinPrice : Model.MinOldPrice,
                        !string.IsNullOrEmpty(Model.MaxPrice) ? Model.MaxPrice : Model.MaxOldPrice,
                        !string.IsNullOrEmpty(Model.MinOldPrice) ? Model.MinOldPrice : Model.MinPrice,
                        !string.IsNullOrEmpty(Model.MaxOldPrice) ? Model.MaxOldPrice : Model.MaxPrice
                        )
                            </span>
                        </h3> }
                    else
                    {

                        <h3 class="product-price">

                            <span id="price-value-withoutoffer-@(Model.ProductId)" class="price-value-withoutoffer-@(Model.ProductId)">
                                @T("Price.Range",
                        !string.IsNullOrEmpty(Model.MinOldPrice) ? Model.MinOldPrice : Model.MinPrice,
                        !string.IsNullOrEmpty(Model.MaxOldPrice) ? Model.MaxOldPrice : Model.MaxPrice)
                            </span>
                        </h3>}} }
            else
            {
                if (!string.IsNullOrEmpty(Model.MembershipPrice))
                {
                    <h3 class="product-price">

                        <span>   @T("Product.Label.RegularPrice")</span><span>:</span>
                        @*render price*@
                        <span id="price-value-withoutoffer-@(Model.ProductId)" class="price-value-withoutoffer-@(Model.ProductId)">
                            @Html.Raw(!string.IsNullOrEmpty(Model.OldPrice) ? Model.OldPrice : Model.Price)
                        </span>
                    </h3>

                    <h3 class="membershipPrice-section-@(Model.ProductId)">
                        <span>
                            @T("Products.Label.MembershipPrice")
                        </span><span>:</span>
                        <span id="membershipPrice-value-withoutoffer-@(Model.ProductId)" class="membershipPrice-value-withoutoffer-@(Model.ProductId)">
                            @Model.MembershipPrice
                        </span>
                    </h3> }
                else
                {
                    if (Model.OldPriceValue > 0 && Model.PriceValue > 0 && Model.OldPrice != Model.Price)
                    {
                       
                        <h3 class="product-price">
                            <span id="price-value-withoutoffer-@(Model.ProductId)" class="price-value-withoutoffer-@(Model.ProductId)">
                                <span class="sale-price">@Model.Price</span>
                            </span>
                        </h3> 
                        
                      }
                    else
                    {
               
                        <h3 class="product-price">
                            @*render price*@
                            <span id="price-value-withoutoffer-@(Model.ProductId)" class="price-value-withoutoffer-@(Model.ProductId)">
                                @(!string.IsNullOrEmpty(Model.OldPrice) ? Model.OldPrice : Model.Price)
                            </span>
                        </h3>}
                }
            }}
        </div>}


</div>