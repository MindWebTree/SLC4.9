        <script asp-location="Footer">
            function hidNextPreviousCraouselButtons(carouselRef) {
                var $carousel = $(`${carouselRef} .jcarousel`);

                if ($carousel.length && $carousel.data('jcarousel')) {
                    var $items = $carousel.find('li'); // All items
                    var $visible = $carousel.jcarousel().jcarousel('visible');

                    var $firstVisible = $visible.first();
                    var $lastVisible = $visible.last();
                    var $firstItem = $items.first();
                    var $lastItem = $items.last();

                    var $prev = $(`${carouselRef} .jcarousel-control-prev`);
                    var $next = $(`${carouselRef} .jcarousel-control-next`);

                    // Hide prev if first visible is first item
                    if ($firstVisible.get(0) === $firstItem.get(0)) {
                        $prev.hide();
                    } else {
                        $prev.show();
                    }

                    // Hide next if last visible is last item
                    if ($lastVisible.get(0) === $lastItem.get(0)) {
                        $next.hide();
                    } else {
                        $next.show();
                    }
                } else {

                }
            }
            $(document).ready(function () {
                $('.attributevalue-section').hover(function () {
                    const $label = $(this);
                    const offset = $label.offset();

                    // Generate the shade preview
                    const $shade = $(`
                                                                                                                      <div class="shade-overview">
                                                                                                                        <img class="img_fadeIn"
                                                                                                                             src="${$label.attr('data-attr-img')}"
                                                                                                                             alt="${$label.attr('data-attr-name')}">
                                                                                                                        <p>${$label.attr('data-attr-name')}</p>
                                                                                                                      </div>
                                                                                                                    `);

                    const previewWidth = 200;
                    const margin = 10;
                    const windowWidth = $(window).width();

                    let left = offset.left - 50;
                    if (left + previewWidth + margin > windowWidth) {
                        left = windowWidth - previewWidth - margin;
                    }
                    if (left < margin) {
                        left = margin;
                    }
                    $shade.appendTo('body').css({
                        position: 'absolute',
                        top: (offset.top + $(this).outerHeight()) + 'px',
                        left: left + 'px',
                        display: 'block',
                        zIndex: 9999,
                        background: 'white',
                        padding: '10px',
                        boxShadow: '0 0 10px rgba(0,0,0,0.5)',
                        width: previewWidth + 'px'
                    }).addClass('shade-floating');
                }, function () {
                    $('.shade-floating').remove();
                });
                $('.attributes .attribute_value_wrapper').each(function () {
                    hidNextPreviousCraouselButtons('#' + $(this).attr('id'));
                    var $carousel2 = $(this).find('.jcarousel');


                    $carousel2.on('jcarousel:reload jcarousel:scrollend', function () {

                        totalItems = $carousel2.find('li').length;
                        var currentIndex = $carousel2.jcarousel('items').index($carousel2.jcarousel('visible').first());
                        visibleItems = $carousel2.jcarousel('visible').length;
                        var $prevBtn = $carousel2.closest('.attribute_value_wrapper').find('.jcarousel-control-prev');
                        var $nextBtn = $carousel2.closest('.attribute_value_wrapper').find('.jcarousel-control-next');
                        function updateButtonVisibility() {
                            var totalItem = $carousel2.jcarousel('items').length;
                            var currentIndex = $carousel2.jcarousel('items').index($carousel2.jcarousel('visible').first());
                            var visibleItem = $carousel2.jcarousel('visible').length;

                            $prevBtn.toggle(currentIndex > 0);
                            $nextBtn.toggle(currentIndex + visibleItem < totalItem);
                        }
                        updateButtonVisibility(totalItems, currentIndex, visibleItems);
                    });
                });
            });
            $('.accordion-header').on('click', function () {

                $(this).toggleClass('active');
                console.log($(this));
                $(this).next().toggleClass('active');

            });





        </script>
        <script asp-location="Footer">
            function showHideDropdownQuantity(id) {
                $('select[name=' + id + '] > option').each(function () {
                    var attr = $(this).attr("data-attr-custom");
                    if (typeof attr === 'undefined' || attr === false) {
                        $('#' + id + '_' + this.value + '_qty_box').hide();

                    }
                });
                $('#' + id + '_' + $('select[name=' + id + '] > option:selected').val() + '_qty_box').css('display', 'inline-block');
            };

            function showHideRadioQuantity(id) {
                $('input[name=' + id + ']:radio').each(function () {
                    $('#' + $(this).attr('id') + '_qty_box').hide();
                });
                $('#' + id + '_' + $('input[name=' + id + ']:radio:checked').val() + '_qty_box').css('display', 'inline-block');
            };

            function showHideCheckboxQuantity(id) {
                if ($('#' + id).is(':checked'))
                    $('#' + id + '_qty_box').css('display', 'inline-block');
                else
                    $('#' + id + '_qty_box').hide();
            };
