        <script asp-location="Footer">
             function hidNextPreviousCraouselButtons(carouselRef) {
                var $carousel = $(`${carouselRef} .jcarousel`);

                if ($carousel.length && $carousel.data('jcarousel')) {
                    var $carousel = $(`${carouselRef} .jcarousel`);
                    if (!$carousel.length || !$carousel.data('jcarousel')) {
                        return;
                    }

                    var $prev = $(`${carouselRef} .jcarousel-control-prev`);
                    var $next = $(`${carouselRef} .jcarousel-control-next`);

                    var $allItems = $carousel.jcarousel('items');
                    var totalItems = $allItems.length;

                    if (!totalItems) {
                        $prev.hide();
                        $next.hide();
                        return;
                    }
                    var $fullyVisible = $carousel.jcarousel('fullyvisible');
                    if ($fullyVisible.length >= totalItems) {
                        $prev.hide();
                        $next.hide();
                        return;
                    }
                    else {
                        $prev.show();
                        $next.show();
                    }
                } else {

                }
            }
