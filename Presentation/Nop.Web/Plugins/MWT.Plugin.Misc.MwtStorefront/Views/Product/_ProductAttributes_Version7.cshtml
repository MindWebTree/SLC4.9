                                        function scrollSizeList(buttonElement, direction) {
                                            var wrapper = buttonElement.closest('.custom-scroll-wrapper');
                                            var container = wrapper.querySelector('.size-image-squares');

                                            if (container) {
                                                var item = container.querySelector('li');
                                                if (!item) return;

                                                // Get actual width INCLUDING gap
                                                var style = window.getComputedStyle(container);
                                                var gap = parseFloat(style.columnGap || style.gap || 0);

                                                var scrollAmount = item.offsetWidth + gap;

                                                container.scrollBy({
                                                    left: scrollAmount * direction,
                                                    behavior: 'smooth'
                                                });
                                            }
                                        }

                                        document.addEventListener("DOMContentLoaded", function () {
                                            var wrappers = document.querySelectorAll('.custom-scroll-wrapper');

                                            wrappers.forEach(function (wrapper) {
                                                var container = wrapper.querySelector('.size-image-squares');
                                                var prevBtn = wrapper.querySelector('.custom-scroll-prev');
                                                var nextBtn = wrapper.querySelector('.custom-scroll-next');

                                                if (!container || !prevBtn || !nextBtn) return;

                                                // Count exactly how many items there are
                                                var itemCount = container.querySelectorAll('li').length;

                                                function updateArrowVisibility() {
                                                    // If there are 1 or 2 items, ALWAYS hide the arrows (Mobile & Desktop)
                                                    if (itemCount <= 2) {
                                                        prevBtn.classList.add('hidden-arrow');
                                                        nextBtn.classList.add('hidden-arrow');
                                                        return;
                                                    }

                                                    // If it's the vertical grid or static on desktop, we don't need arrows
                                                    if (window.innerWidth >= 768 && (wrapper.closest('.layout-desktop-vertical-grid') || wrapper.closest('.layout-desktop-static'))) {
                                                        return;
                                                    }

                                                    // Check if the container is actually scrollable horizontally
                                                    var isScrollable = container.scrollWidth > (container.clientWidth + 2);

                                                    if (!isScrollable) {
                                                        prevBtn.classList.add('hidden-arrow');
                                                        nextBtn.classList.add('hidden-arrow');
                                                        return;
                                                    }

                                                    // Hide Left arrow if at the start
                                                    if (container.scrollLeft <= 5) {
                                                        prevBtn.classList.add('hidden-arrow');
                                                    } else {
                                                        prevBtn.classList.remove('hidden-arrow');
                                                    }

                                                    // Hide Right arrow if at the end
                                                    if (Math.ceil(container.scrollLeft + container.clientWidth) >= container.scrollWidth - 5) {
                                                        nextBtn.classList.add('hidden-arrow');
                                                    } else {
                                                        nextBtn.classList.remove('hidden-arrow');
                                                    }
                                                }

                                                // Run on load
                                                setTimeout(updateArrowVisibility, 150);

                                                // Run on scroll (swiping on mobile or smooth scrolling)
                                                container.addEventListener('scroll', updateArrowVisibility);

                                                // Run on window resize
                                                window.addEventListener('resize', updateArrowVisibility);
                                            });
                                        });

                                    </script>
                                }



                                break;



