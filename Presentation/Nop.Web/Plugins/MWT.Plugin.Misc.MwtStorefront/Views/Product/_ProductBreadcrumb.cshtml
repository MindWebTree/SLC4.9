@model CustomProductDetailsModel.ProductBreadcrumbModel
@using Nop.Core.Domain.Common
@inject CommonSettings commonSettings
@{
    var breadcrumbDelimiter = commonSettings.BreadcrumbDelimiter;
}
@if (Model.Enabled)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb" itemscope itemtype="http://schema.org/BreadcrumbList">
            @{ int position = 1; }
            @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ProductBreadcrumbBefore, additionalData = Model })
            <li class="breadcrumb-item">
                <span itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <a href="@Url.RouteUrl("Homepage")" itemprop="item">
                        <span>@T("Products.Breadcrumb.Top")</span>
                        <span style="display:none;" itemprop="name">Home</span>
                    </a>
                    <meta itemprop="position" content="@position" />
                </span>
            </li>
            @{ position++; }
            

            @{

                foreach (var category in Model.CategoryBreadcrumb)
                {
                    <li class="breadcrumb-item" style="@(position-1==Model.CategoryBreadcrumb.Count?"":"display:none")">
                        <span itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                            <a href="@Url.RouteUrl("Category", new { id = category.Id, SeName = category.SeName })" itemprop="item">
                                <span itemprop="name">@category.Name</span>
                            </a>
                            <meta itemprop="position" content="@position" />
                        </span>

                    </li>
                    position++;
                }
            }

            <li class="breadcrumb-item active" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                <strong class="current-item" itemprop="name">@Model.ProductName</strong>
                <span itemprop="item" itemscope itemtype="http://schema.org/Thing"
                      id="@Url.RouteUrl("Product", new {id=Model.ProductId, SeName = Model.ProductSeName })">
                </span>
                <meta itemprop="position" content="@position" />
                @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ProductBreadcrumbAfter, additionalData = Model })
            </li>

        </ol>
    </nav>

}