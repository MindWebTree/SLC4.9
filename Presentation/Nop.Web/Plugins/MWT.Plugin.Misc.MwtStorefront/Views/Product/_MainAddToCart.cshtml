@model ProductDetailsModel.AddToCartModel
@using Nop.Core.Domain.Orders
@{ int variantId = 0;
    if (ViewData["variantId"] != null && ViewData["variantId"] != "")
    {
        int.TryParse(ViewData["variantId"].ToString(), out variantId);
    }

    ProductDetailsModel.ProductPriceModel priceModel = new ProductDetailsModel.ProductPriceModel();

    if (ViewData["priceModel"] != null)
    {
        priceModel = (ProductDetailsModel.ProductPriceModel)ViewData["priceModel"];
    }
    else
    {
        priceModel = null;
    }
    bool isAttributePreselected = false;
    if (ViewData["isAttributePreselected"] != null)
    {
        isAttributePreselected = (bool)ViewData["isAttributePreselected"];
    }
    string addtoCartFormId = "#product-details-form";
    if (ViewData["addtocartform"] != null && ViewData["addtocartform"] != "")
    {
        addtoCartFormId = ViewData["addtocartform"].ToString();
    }
    string refFormId = addtoCartFormId.Replace("#", "").Replace("-", "_").Split('?')[0];
    int quantity = 1;
    if (ViewBag.Quantity != null)
        int.TryParse(ViewBag.Quantity.ToString(), out quantity);
    Model.EnteredQuantity = quantity == 0 ? Model.EnteredQuantity == 0 ? 1 : Model.EnteredQuantity : quantity;
    if (Model.UpdatedShoppingCartItemId > 0)
    {
        <input asp-for="UpdatedShoppingCartItemId" type="hidden" />
    } }
@if (!Model.DisableBuyButton || Model.CustomerEntersPrice)
{

    @if (Model.CustomerEntersPrice)
    {
        <table>
            <tbody>
                <tr>
                    <td>
                        <label asp-for="CustomerEnteredPrice" asp-postfix=":" class="enter-price-label control-label"></label>
                    </td>
                    <td>
                        @*round price*@
                        <input asp-for="CustomerEnteredPrice" value="@Convert.ToInt32(Math.Ceiling(Model.CustomerEnteredPrice))" class="enter-price-input form-control" />
                    </td>
                    <td class="price-range">
                        @Model.CustomerEnteredPriceRange
                    </td>
                </tr>
            </tbody>
        </table> } @*@if (!string.IsNullOrEmpty(Model.MinimumQuantityNotification))
        {
            <div class="min-qty-notification">@Model.MinimumQuantityNotification</div>
        }*@

    @if (!Model.DisableBuyButton)
    {
        <div class="qty-price-section">
            <div class="qty-section">
                <table class="qtyBox">
                    <tbody>
                        <tr>
                            
                            <td>
                                <div class="input-group">
                                    <span class="input-group-btn">
                                        <button type="button" class="quantity-left-minus btn  btn-number" data-type="minus" data-field="">
                                            <svg width="9" height="8" viewBox="0 0 9 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <g clip-path="url(#clip0_10687_17062)">
                                                    <g clip-path="url(#clip1_10687_17062)">
                                                        <g clip-path="url(#clip2_10687_17062)">
                                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.617188 4.64375H7.97719V3.84375H0.617188V4.64375Z" fill="#444444" />
                                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.617188 4.64375H7.97719V3.84375H0.617188V4.64375Z" fill="#444444" />
                                                        </g>
                                                    </g>
                                                </g>
                                                <defs>
                                                    <clipPath id="clip0_10687_17062">
                                                        <rect width="8" height="8" fill="white" transform="translate(0.296875)" />
                                                    </clipPath>
                                                    <clipPath id="clip1_10687_17062">
                                                        <rect width="8" height="8" fill="white" transform="translate(0.296875)" />
                                                    </clipPath>
                                                    <clipPath id="clip2_10687_17062">
                                                        <rect width="8" height="8" fill="white" transform="translate(0.296875)" />
                                                    </clipPath>
                                                </defs>
                                            </svg>

                                        </button>
                                    </span>
                                    <input asp-for="EnteredQuantity" data-max-qty="@Model.AllowedQuantities.Count" id="product_enteredQuantity_@Model.ProductId" class="qty-input" type="text" aria-label="@T("Products.Qty.AriaLabel")" value="@Model.EnteredQuantity" />

                                    <span class="input-group-btn">
                                        <button type="button" class="quantity-right-plus btn  btn-number" data-type="plus" data-field="">
                                            <svg width="9" height="8" viewBox="0 0 9 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <g clip-path="url(#clip0_10687_17072)">
                                                    <g clip-path="url(#clip1_10687_17072)">
                                                        <g clip-path="url(#clip2_10687_17072)">
                                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.617188 4.33318H7.97719V3.66406H0.617188V4.33318Z" fill="#444444" />
                                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.617188 4.33286H7.97719V3.66406H0.617188V4.33286Z" fill="#444444" />
                                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M3.96875 7.68031H4.63787V0.320312H3.96875V7.68031Z" fill="#444444" />
                                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M3.96875 7.68031H4.63787V0.320312H3.96875V7.68031Z" fill="#444444" />
                                                        </g>
                                                    </g>
                                                </g>
                                                <defs>
                                                    <clipPath id="clip0_10687_17072">
                                                        <rect width="8" height="8" fill="white" transform="translate(0.296875)" />
                                                    </clipPath>
                                                    <clipPath id="clip1_10687_17072">
                                                        <rect width="8" height="8" fill="white" transform="translate(0.296875)" />
                                                    </clipPath>
                                                    <clipPath id="clip2_10687_17072">
                                                        <rect width="8" height="8" fill="white" transform="translate(0.296875)" />
                                                    </clipPath>
                                                </defs>
                                            </svg>

                                        </button>
                                    </span>
                                </div>
                                <script asp-location="Footer">
                                //when a customer clicks 'Enter' button we submit the "add to cart" button (if visible)
                                $(document).ready(function () {
                                    $("#@Html.IdFor(model => model.EnteredQuantity)").on("keydown", function (event) {
                                        if (event.keyCode == 13) {
                                            $("#add-to-cart-button-@Model.ProductId").trigger("click");
                                            return false;
                                        }
                                    });

                                    $("#product_enteredQuantity_@Model.ProductId").on("input propertychange paste", function () {
                                        var data = {
                                            productId: @Model.ProductId,
                                            quantity: $('#product_enteredQuantity_@Model.ProductId').val()
                                        };
                                        $(document).trigger({ type: "product_quantity_changed", changedData: data });
                                    });
                                });
                                </script>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </div>
            @if (priceModel != null) { 
            <div class="price-section">
                @{ var dataDictPrice = new ViewDataDictionary(ViewData);
                    dataDictPrice.TemplateInfo.HtmlFieldPrefix = $"price_{Model.ProductId}";
                    ViewData["isAttributePreselected"] = isAttributePreselected;
                    @await Html.PartialAsync("_ProductPrice", priceModel, dataDictPrice)
                }
            </div>
            }
        </div>
        <div class="main add-to-cart">
            @{ var addToCartText = "";
                if (Model.UpdatedShoppingCartItemId > 0 && Model.UpdateShoppingCartItemType.HasValue && Model.UpdateShoppingCartItemType.Value == ShoppingCartType.ShoppingCart)
                {
                    addToCartText = T("ShoppingCart.AddToCart.Update").Text;
                }
                else
                {
                    addToCartText = T("ShoppingCart.AddToCart").Text;
                    if (Model.IsRental)
                    {
                        addToCartText = T("ShoppingCart.Rent").Text;
                    }
                    if (Model.AvailableForPreOrder)
                    {
                        addToCartText = T("ShoppingCart.PreOrder").Text;
                    }
                }
                <button type="button" id="add-to-cart-button-@Model.ProductId" class="button-2 btn btn-primary add-to-cart-button btn btn-secondary"
                        data-productid="@Model.ProductId" data-variantId="@variantId" onclick="AjaxCart.addproducttocart_details('@Url.RouteUrl("CustomAddProductToCart-Details",
                new {formId=refFormId,productId = Model.ProductId, shoppingCartTypeId = (int) ShoppingCartType.ShoppingCart})', '@addtoCartFormId');return false;">
                    @addToCartText
                </button> var dataDictAddToWishlist = new ViewDataDictionary(ViewData);
                dataDictAddToWishlist.TemplateInfo.HtmlFieldPrefix = $"addtocart_{Model.ProductId}";
                @await Html.PartialAsync("_AddToWishlist", Model, dataDictAddToWishlist) }
        </div>}
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ProductDetailsAddInfo, additionalData = Model })}

