@model List<CustomProductDetailsModel>
@using Nop.Core.Domain.Orders
@inject Nop.Services.Directory.ICurrencyService _currencyService;
@inject ICustomWorkContext _workContext;
@inject Nop.Services.Configuration.ISettingService _settingService;
@{
    var addtoCartFormId = ViewData["addtocartform"].ToString();
    string refFormId = addtoCartFormId.Replace("#", "").Replace("-", "_").Split('?')[0];
    var isMembershipEnabled = await _settingService.GetSettingByKeyAsync<bool>("ismembershipenabled");
    string productIds = "";
    foreach (var product in Model)
    {
        productIds += "-" + product.Id;
    }
}
<div class="add-to-cart">
    <button type="button" id="add-to-cart-button-fbt-@Model.FirstOrDefault().Id" class="button-2 btn btn-primary add-to-cart-button btn btn-secondary fbt-addtocart" data-productid="@Model.FirstOrDefault().Id">@T("ShoppingCart.AddToCart")</button>
</div>


<script asp-location="Footer">
    var fbtUrl = '@Url.RouteUrl("CustomAddProductToCart-Collections", new {formId=refFormId, isFbt = true, productIds = productIds, shoppingCartTypeId = (int) ShoppingCartType.ShoppingCart})';
    $(".fbtchkboxt").change(function () {
        updateFbtPrice();
    });
    function updateFbtPrice() {
   
        var fbtPrice = 0;
        var fbtOldPrice = 0;
        var membershipPrice = 0;
        var hasMembership = false;
        var onSale = false;
        $(".cls-frqbought .product-price").each(function (index, element) {
         
            if (!$(this).parent().parent().parent().parent().hasClass("disabled")) {

                if ('@isMembershipEnabled' == 'True' && $("#fbt-membershipprice-product").length > 0) {
                    hasMembership = true;
                    fbtPrice += Number($(element).find("span:last-child").text().replace(/[^0-9.-]+/g, ""), "");

                    var spanId = $(element).find("span:last-child").attr("id");

                    spanid = "#" + spanId.replace("price-value-", "membershipPrice-value-");


                    if ($(element).parent().find(spanid).length > 0)
                        membershipPrice += Number($(element).parent().find(spanid).text().replace(/[^0-9.-]+/g, ""), "");
                    else
                        membershipPrice += Number($(element).find("span").text().replace(/[^0-9.-]+/g, ""), "");


                }
                else {
                    var container = $(this).find("span:last-child");
                  
                    if ($(container).find(".saleprice").length>0) {
                        onSale = true;

                        fbtPrice += Number($(container).find(".saleprice").text().replace(/[^0-9.-]+/g, ""), "");
                        fbtOldPrice += Number($(container).find(".suggested-price").text().replace(/[^0-9.-]+/g, ""), "");
                      }
                    else {
                   
                        fbtOldPrice += Number($(container).text().replace(/[^0-9.-]+/g, ""), "");
                        fbtPrice += Number($(container).text().replace(/[^0-9.-]+/g, ""), "");
                    }
                }
            }

        });
  
   
        if (!isNaN(fbtPrice) && hasMembership) {
            $("#fbt-price-product").html("$" + fbtPrice.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, "$&,"));
            $("#fbt-membershipprice-product").html("$" + membershipPrice.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, "$&,"));
        }
        else {
        
            if (!isNaN(fbtPrice) && !isNaN(fbtOldPrice)) {
                if (onSale) {
                    var content = priceRangeFormat;
                    content = content.replace("{0}", "$" + fbtPrice.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, "$&,"));
                    content = content.replace("{1}", "$" + fbtOldPrice.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, "$&,"));
                    $("#fbt-price-product").html(content);
                    if ($(".limited-offer-fbt")) {
                        $(".limited-offer-fbt").show();
                    }
                    else {
                        $('<p class="sale-price  m-0 limited-offer-fbt">' + defaulLimitedOfferText  + '</p>').parent().insertBefore($('#fbt-price-product'));

                    }
                }
                else{
                    $("#fbt-price-product").html("$" + fbtOldPrice.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, "$&,"));
                    $(".limited-offer-fbt").show();
                }
            }
        }
    }


    jQuery(document).ajaxComplete(function (event, xhr, options) {
        if (options['url'].indexOf("CustomProductDetails_AttributeChange") > -1 && options['url'].indexOf("product_details_fbt") > -1) {
            updateFbtPrice();
        }
    });
    setTimeout(updateFbtPrice, 400);
    $(".fbt-addtocart").click(function () {
        var isFormValid = true;
        $(".cls-frqbought select,.cls-frqbought input").each(function (index, element) {

            var elementselected = false;

            if ($(element).prop('nodeName') == "INPUT" && $(element).attr('type') == "radio") {

                if ($("input[name='" + $(element).attr("name") + "']:checked").length > 0) {
                    elementselected = true;

                }
                else{
               
                }

            }
            else if ($(element).prop('nodeName') == "INPUT" && ($(element).attr('type') == "text" || $(element).attr('type') == "number")) {

                if ($(element).val() != "") {
                    elementselected = true;

                }

            }
            else if ($(element).val() != "" && $(element).val() != "0") {
                elementselected = true;
            }
            else if ($(element).prop("name").indexOf("EnteredQuantity")>0) {
                elementselected = true;
            }
        
            if (!elementselected) {
                isFormValid = false;

                var top = $(element).parent().offset().top;

                $('html, body').animate({
                    scrollTop: top
                }, 2000);
                return false;
            }
        });
        if (isFormValid) {
            
            /// Write code to pass data to gtm
            processFbtProductInfo();

            AjaxCart.addproducttocart_details(fbtUrl, '#product-details-fbt');
        }
    });

</script>