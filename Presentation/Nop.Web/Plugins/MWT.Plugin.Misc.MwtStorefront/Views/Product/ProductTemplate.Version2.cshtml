        <div class="row">
            <div class="col-12 detail-section">
                @{
                    ViewData["DisplaySpecificationAttributeDimension"] = !Model.DisplayDimensionOfVariant;
                }

                @if (_workContext.IsMobileDevice())
                {
                    <div id="productdetail-accordion" class="accordion">

                        <div class="card-header" data-bs-toggle="collapse" href="#collapse-desc">
                            <span class="card-title">
                                @T("Product.Desc.Tab.heading")
                            </span>
                        </div>
                        <div id="collapse-desc" class="card-body description-tab show" style="">

                            <div class="description-content @(Model.FullDescription.Length > 500 ? "hide-content" : "")">
                                @Html.Raw(Model.FullDescription)
                                <div class="product-notes">
                                    @Html.Raw(Model.Notes)
                                </div>
                            </div>
                            @if (Model.FullDescription.Length > 500)
                            {
                                <span data-attr-less="@T("Product.show.Less")" data-attr-more="@T("Product.show.More")" class="showmore">@T("Product.Show.More") </span>
                            }
                        </div>

                        @if (Model.DisplayDimensionOfVariant)
                        {
                            @await Html.PartialAsync("_ProductVariantDimension", Model)
                        }
                        @await Html.PartialAsync("_ProductSpecifications", Model.ProductSpecificationModel)



                        @if (Model.IsThanksGivingProduct)
                        {
                            <div class="card-header collapsed" data-bs-toggle="collapse" href="#collapse-thanksgiving">
                                <span class="card-title">
                                    @T("Product.Guaranteed.Delivery.Tab.heading")
                                </span>
                            </div>
                            <div id="collapse-thanksgiving" class="card-body collapse" style="">
                                @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "guaranteed-delivery-by-thanksgiving-2024" })
                            </div>
                        }
                    </div>
                }
                else
                {
                    string descriptionTabName = System.Text.RegularExpressions.Regex.Replace(T("Product.Desc.Tab.heading").ToString().Trim().ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
                    string dimensionTabName = System.Text.RegularExpressions.Regex.Replace(T("product.specification.attr.dimension").ToString().Trim().ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
                    string thanksGiving = System.Text.RegularExpressions.Regex.Replace(T("Product.Guaranteed.Delivery.Tab.heading").ToString().Trim().ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
                    <ul class="nav nav-tabs" id="infotab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-@descriptionTabName" data-bs-toggle="tab"
                                    data-bs-target="#@descriptionTabName" type="button" role="tab">
                                @T("Product.Desc.Tab.heading")
                            </button>
                        </li>

                        @if (Model.DisplayDimensionOfVariant)
                        {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-@dimensionTabName" data-bs-toggle="tab"
                                        data-bs-target="#@dimensionTabName" type="button" role="tab">
                                    @T("product.specification.attr.dimension")
                                </button>
                            </li>
                        }

                        @await Html.PartialAsync("_ProductSpecifications.Tabs", Model.ProductSpecificationModel)
                        @if (Model.IsThanksGivingProduct)
                        {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-@thanksGiving" data-bs-toggle="tab"
                                        data-bs-target="#@thanksGiving" type="button" role="tab">
                                    @T("Product.Guaranteed.Delivery.Tab.heading")
                                </button>
                            </li>
                        }
                    </ul>
                    <div class="tab-content border border-top-0 p-3" id="infotabContent">
                        <div class="tab-pane fade show active" id="@descriptionTabName" role="tabpanel" aria-labelledby="@T("Product.Desc.Tab.heading") tab" tabindex="0">
                            @Html.Raw(Model.FullDescription)
                            <div class="product-notes">
                                @Html.Raw(Model.Notes)
                            </div>
                        </div>
                        @if (Model.DisplayDimensionOfVariant)
                        {
                            <div class="tab-pane fade" id="@dimensionTabName" role="tabpanel" aria-labelledby="@T("product.specification.attr.dimension") tab" tabindex="0">
                                @await Html.PartialAsync("_ProductVariantDimension", Model)
                            </div>
                        }
                        @await Html.PartialAsync("_ProductSpecifications", Model.ProductSpecificationModel)
                        @if (Model.IsThanksGivingProduct)
                        {
                            <div class="tab-pane fade" id="@thanksGiving" role="tabpanel" aria-labelledby="@T("Product.Guaranteed.Delivery.Tab.heading") tab" tabindex="0">
                                @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "guaranteed-delivery-by-thanksgiving-2024" })
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    
        @if (_workContext.IsMobileDevice())
        {
            <script asp-location="Footer">
                // Convert .showmore click handler
                $('.description-tab .showmore').on('click', function () {
                    const $description = $('.description-content');
                    $description.toggleClass('hide-content');

                    if ($description.hasClass('hide-content')) {

                        $description[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
                        $(this).text($(this).data('attr-more'));
                    } else {
                        $(this).text($(this).data('attr-less'));
                    }
                });


            </script>
        }
