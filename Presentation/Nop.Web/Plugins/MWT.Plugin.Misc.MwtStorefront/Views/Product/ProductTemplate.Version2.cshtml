@model CustomProductDetailsModel
@using Nop.Core.Domain.Seo;
@using Nop.Core
@inject Nop.Core.IWebHelper webHelper
@inject SeoSettings seoSettings
@inject IThemeContext themeContext
@inject Nop.Services.Catalog.ISpecificationAttributeService _specificationAttributeService
@inject Nop.Services.Configuration.ISettingService _settingService
@inject IThemeContext themeContext
@inject ICustomWorkContext _workContext
@inject ICustomCustomerService _customerService
@{
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    bool isAttributePreselected = true;
    if (Model.ProductAttributes != null)
        foreach (var attribute in Model.ProductAttributes)
        {
            if (attribute.Values != null && !attribute.Values.Where(a => a.IsPreSelected).Any())
            {
                isAttributePreselected = false;
                break;
            }
        }
    bool collectionListingDisplayVertically = Model.CollectionListingDisplayVertically;
    if (!collectionListingDisplayVertically)
    {
        collectionListingDisplayVertically = await _settingService.GetSettingByKeyAsync<bool>("Collection.Listing.Display.Vertically");
    }

    var productTag = await _settingService.GetSettingByKeyAsync<string>("ThanksGiving.ProductTag.Name");
    bool isAdmin = await _customerService.IsAdminAsync(await _workContext.GetCurrentCustomerAsync(), true);
    string name = Model.VariantId > 0 && !string.IsNullOrEmpty(Model.VariantTitle) ? Model.VariantTitle : Model.Name;
}
<script>
     var customizeSizeText = '@Html.Raw(T("Product.Size.Customize.Text").Value.Replace("'", "\\'"))';
    var shadeAsShow = '@Html.Raw(T("Product.selected.shades").Value.Replace("'", "\\'"))';
    var priceRangeFormat = '@Html.Raw(T("Price.Range.Product.Format").Value.Replace("'", "\\'"))';
     var priceRangeWithoutOfferFormat = '@Html.Raw(T("Price.Range.Product.Without.Offer.Format").Value.Replace("'", "\\'"))';
    var limitedOfferText = '@Model.ProductPrice.OfferText.Replace("'", "\\'"))';
    var defaulLimitedOfferText = '@CommonHelper.GetProductOfferText(Model.Id,Model.ProductPrice.OfferText,Model.ProductPrice.OfferPlaceHolder,Model.ProductPrice.DiscountAmount,Model.ProductPrice.DiscountPercentage,Model.ProductPrice.SaleEndDate,true).Replace("'", "\\'")';
    var conversionValue = @Model.ConversionValue;
    var dimensionIndex = @(await _settingService.GetSettingByKeyAsync<int>("product.Dimension.Image.Index"));
    dimensionIndex = dimensionIndex === 0 ? 3 : dimensionIndex;
    var variantLabel= '@T("Products.VariantId").Value.Replace("'", "\\'")';
</script>

@{ decimal price = 0;
    if (!string.IsNullOrEmpty(Model.ProductPrice.MembershipPrice))
    {
        price = Model.ProductPrice.MembershipPriceValue;
    }
    else
    {
        price = Model.ProductPrice.PriceValue;
    } }
@{ bool hasDimensions = false;
    foreach (var attribute in Model.ProductAttributes)
    {
        var textPrompt = attribute.Name;
        if (T("Product.Attr.Size").Text == textPrompt && attribute.Values.Count == 1)
        {
            hasDimensions = true;
        }
    }
    var reviewPageSize = await _settingService.GetSettingByKeyAsync<int>("product.reviews.pagesize");

    Layout = "_ColumnsOne";
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/jcarousel.responsive.css");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Themes/{themeName}/Content/js/magiczoomplus.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Themes/{themeName}/Content/js/product-gtm.js");
    NopHtml.AppendCssFileParts($"~/Themes/{themeName}/Content/css/magiczoomplus.css");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Themes/{themeName}/Content/js/jquery.jcarousel.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Themes/{themeName}/Content/js/jcarousel.responsive.js");
    //title
    NopHtml.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : name);
    //meta
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    //page class
    NopHtml.AppendPageCssClassParts("html-product-details-page");

    //canonical URL
    if (seoSettings.CanonicalUrlsEnabled)
    {
        var productUrl = Url.RouteUrl("Product", new { id = Model.Id, SeName = Model.SeName }, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant();
        Html.AddCanonicalUrlParts(productUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }

    //open graph META tags
    if (seoSettings.OpenGraphMetaTags)
    {
        NopHtml.AddHeadCustomParts("<meta property=\"og:type\" content=\"product\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:title\" content=\"" + Html.Encode(name) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:description\" content=\"" + Html.Encode(Nop.Core.Html.HtmlHelper.StripTags(Model.MetaDescription)) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:image\" content=\"" + Model.DefaultPictureModel.ImageUrl + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:image:url\" content=\"" + Model.DefaultPictureModel.ImageUrl + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:url\" content=\"" + webHelper.GetThisPageUrl(false) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"og:site_name\" content=\"" + Html.Encode(Model.CurrentStoreName) + "\" />");
    }

    //Twitter META tags
    if (seoSettings.TwitterMetaTags)
    {
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:card\" content=\"summary\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:site\" content=\"" + Html.Encode(Model.CurrentStoreName) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:title\" content=\"" + Html.Encode(name) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:description\" content=\"" + Html.Encode(Nop.Core.Html.HtmlHelper.StripTags(Model.MetaDescription)) + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:image\" content=\"" + Model.DefaultPictureModel.ImageUrl + "\" />");
        NopHtml.AddHeadCustomParts("<meta property=\"twitter:url\" content=\"" + webHelper.GetThisPageUrl(false) + "\" />");
    } }
<!--product breadcrumb-->
@section Breadcrumb
    {
    <div class="row mx-0">
        @await Html.PartialAsync("_ProductBreadcrumb", Model.Breadcrumb)
    </div>
}
@await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ProductDetailsAfterBreadcrumb, additionalData = Model })
<div class="page product-details-page version2">
    <div class="page-body">


        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.DefaultVariantId)
        @Html.Hidden("MainCategoryId", Model.MainCategoryId)
        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ProductDetailsTop, additionalData = Model })
        <form asp-route="Product" asp-route-sename="@Model.SeName" method="post" id="product-details-form" class="main-addtocart">
