@inject Nop.Core.IStoreContext _storeContext;

<script asp-location="Footer">
    $(document).ready(function () {

        $('div#productdetail-accordion .card-body a.sizing-guide').on('click', function (e) {
            e.preventDefault();
            const pdfUrl = $(this).attr('href');
            $('#pdfModalLabel').text('Furniture Sizing Guide');
            $('#pdfViewer').attr('src', `https://docs.google.com/gview?url=@((await _storeContext.GetCurrentStoreAsync()).Url)${pdfUrl}&embedded=true`);
            const modal = new bootstrap.Modal(document.getElementById('pdfModal'));
            modal.show();
        });

        $('#pdfModal').on('hidden.bs.modal', function () {
            $('#pdfViewer').attr('src', '');
        });
    });

</script>

<div class="modal fade" id="pdfModal" tabindex="-1" aria-labelledby="pdfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfModalLabel">Furniture Sizing Guide</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="height: 85vh;">
                <iframe id="pdfViewer" src="" width="100%" height="100%" style="border-top:15px solid #313131;"></iframe>
            </div>
        </div>
    </div>
</div>