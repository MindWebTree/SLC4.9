<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.web>
		<customErrors mode="Off" />
	</system.web>
	<system.webServer>
		<security>
			<requestFiltering allowDoubleEscaping="true">
				<alwaysAllowedUrls>
				</alwaysAllowedUrls>
			</requestFiltering>
		</security>
		<rewrite>
			<rules>

				<rule name="shoppingcart">
					<match url="shoppingcartitems" />
					<action type="Redirect" redirectType="Permanent" url="cart" />
				</rule>
				<rule name="account-signin">
					<match url="account/signin" />
					<action type="Redirect" redirectType="Permanent" url="register" />
				</rule>
				<rule name="account">
					<match url="account" />
					<action type="Redirect" redirectType="Permanent" url="customer/info" />
				</rule>
				<rule name="URL1">
					<match url="product/8516/mauka-reclaimed-wood-canoe-bookcase-with-door(.*)" ignoreCase="true" />
