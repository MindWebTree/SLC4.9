		<modules>
			<!-- Remove WebDAV module so that we can make DELETE requests -->
			<remove name="WebDAVModule" />
		</modules>
		<handlers>
			<!-- Remove WebDAV module so that we can make DELETE requests -->
			<remove name="WebDAV" />
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
		</handlers>
		<!-- When deploying on Azure, make sure that "dotnet" is installed and the path to it is registered in the PATH environment variable or specify the full path to it -->
	<aspNetCore requestTimeout="23:00:00" processPath=".\Nop.Web.exe" arguments="" forwardWindowsAuthToken="false" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" startupTimeLimit="3600" hostingModel="InProcess">
</aspNetCore>
		<httpProtocol>
			<customHeaders>
				<remove name="X-Powered-By" />
				<!-- Protects against XSS injections. ref.: https://www.veracode.com/blog/2014/03/guidelines-for-setting-security-headers/ -->
				<add name="X-XSS-Protection" value="1; mode=block" />
				<!-- Protects against Clickjacking attacks. ref.: http://stackoverflow.com/a/22105445/1233379 -->
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<!-- Protects against MIME-type confusion attack. ref.: https://www.veracode.com/blog/2014/03/guidelines-for-setting-security-headers/ -->
				<add name="X-Content-Type-Options" value="nosniff" />
				<!-- Protects against Clickjacking attacks. ref.: https://www.owasp.org/index.php/HTTP_Strict_Transport_Security_Cheat_Sheet -->
				<add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
				<!-- CSP modern XSS directive-based defence, used since 2014. ref.: http://content-security-policy.com/ -->
				<add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://sierralivingconcepts.com https://load.sgtm.sierralivingconcepts.com https://stapecdn.com https://cdn.jsdelivr.net https://code.jquery.com https://www.googletagmanager.com https://www.google.com https://www.google-analytics.com https://*.clarity.ms https://server2.123stat.com https://static.cloudflareinsights.com https://cdn-cookieyes.com https://ct.pinterest.com https://s.pinimg.com https://bat.bing.com https://connect.facebook.net https://*.zohopublic.com https://*.zohocdn.com https://salesiq.zoho.com https://cdn.botpress.cloud https://www.gstatic.com https://maps.googleapis.com https://images.dmca.com https://seal.digicert.com https://*.paypal.com https://*.paypalobjects.com https://*.venmo.com https://js.authorize.net https://jstest.authorize.net https://accept.authorize.net https://test.authorize.net https://*.affirm.com https://assets.secure.checkout.visa.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://code.jquery.com https://*.zohocdn.com https://accept.authorize.net https://*.paypal.com https://*.paypalobjects.com; img-src 'self' data: https://sierralivingconcepts.com https://s3.amazonaws.com https://sierraimages.s3.amazonaws.com https://sierraimages.s3.us-east-1.amazonaws.com https://code.jquery.com https://shareasale.com https://www.shareasale.com https://images.dmca.com https://seal.digicert.com https://cdn-icons-png.flaticon.com https://googleads.g.doubleclick.net https://www.google.com https://www.googletagmanager.com https://www.facebook.com https://bat.bing.com https://maps.gstatic.com https://*.zohopublic.com https://*.affirm.com https://*.paypal.com https://*.paypalobjects.com; font-src 'self' data: https://fonts.gstatic.com https://*.zohocdn.com; media-src 'self' https://sierraimages.s3.us-east-1.amazonaws.com https://static.zohocdn.com; connect-src 'self' https://sierralivingconcepts.com https://load.sgtm.sierralivingconcepts.com https://www.google-analytics.com https://analytics.google.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://*.clarity.ms https://cdn-cookieyes.com https://log.cookieyes.com https://directory.cookieyes.com https://ct.pinterest.com https://webchat.botpress.cloud https://*.zohopublic.com wss://vts.zohopublic.com https://app.ardalio.com https://m6-211026f8a25b42c08fc190458268b30e.ecs.us-east-2.on.aws https://maps.googleapis.com https://*.paypal.com https://accept.authorize.net https://test.authorize.net https://*.affirm.com; frame-src 'self' https://www.google.com https://ct.pinterest.com https://*.paypal.com https://*.zohopublic.com https://js.authorize.net https://jstest.authorize.net https://accept.authorize.net https://test.authorize.net https://cdn1.affirm.com; object-src 'none'; base-uri 'self'; form-action 'self' https://accept.authorize.net https://test.authorize.net;" />
				<!-- Prevents from leaking referrer data over insecure connections. ref.: https://scotthelme.co.uk/a-new-security-header-referrer-policy/ -->
				<add name="Referrer-Policy" value="same-origin" />
				<!-- Permissions-Policy is a new header that allows a site to control which features and APIs can be used in the browser. ref.: https://w3c.github.io/webappsec-permissions-policy/ -->
				<add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=*, usb=()" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>


	<location path="Plugins/Payments.AuthorizeNetHosted/content/Communicator.html">
		<system.webServer>
			<httpProtocol>
				<customHeaders>
					<remove name="Content-Security-Policy" />
					<remove name="Permissions-Policy" />
					<remove name="X-Frame-Options" />
					<add name="Content-Security-Policy"
						 value="default-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.authorize.net; frame-ancestors 'self' https://*.authorize.net https://test.authorize.net https://accept.authorize.net;" />
					<add name="Permissions-Policy" value="payment=*" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>
</configuration>
