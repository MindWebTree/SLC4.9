@model IList<MegaMenuCategoryModel>

@foreach (var subCategory in Model)
{

    if (subCategory.SubCategories.Count > 0)
    {
<li class="has-sublist">
    <a href="@Url.RouteUrl("Category", new { SeName = subCategory.CategoryModel.SeName })" title="@subCategory.CategoryModel.Name" class="with-subcategories"><span>@subCategory.CategoryModel.Name</span></a>
    <div class="plus-button">
        <svg focusable="false" viewBox="2 2 24 24" class="pl-BaseIcon BaseIcon pl-BaseIcon--scalable DepartmentMenuCard-icon" aria-hidden="true" data-hb-id="pl-icon"><path d="M21.46 14.19a.5.5 0 000-.38.36.36 0 00-.11-.16l-6-6a.49.49 0 00-.7.7l5.14 5.15H7a.5.5 0 000 1h12.79l-5.14 5.15a.48.48 0 000 .7.48.48 0 00.7 0l6-6a.36.36 0 00.11-.16z"></path></svg>
    </div>             <div class="sublist-wrap">
        <div class="navigation-wrapper">
            <div class="close-menu">
                <span>@T("MWT.Themes.Common.CloseMenu")</span>
            </div>
            <div class="back-button">
                <span>@T("MWT.MegaMenu.ResponsiveBackButton")</span>
            </div>
        </div>
        <ul class="sublist">
            @await Component.InvokeAsync("MegaMenuListSubCategories", new { subCategories = subCategory.SubCategories })

            @if (subCategory.ShouldShowViewAllLink)
            {
                <li>
                            <a class="view-all" href="@Url.RouteUrl("Category", new { SeName = subCategory.CategoryModel.SeName })" title="@T("MWT.MegaMenu.ViewAllCategories")">
                        <span>@T("MWT.MegaMenu.ViewAllCategories")</span>
                    </a>
                </li>
            }
        </ul>
    </div>
</li>
    }
    else
    {
        <li>
            <a class="lastLevelCategory" href="@Url.RouteUrl("Category", new {SeName = subCategory.CategoryModel.SeName})" title="@subCategory.CategoryModel.Name"><span>@subCategory.CategoryModel.Name</span></a>
        </li>
    }
}