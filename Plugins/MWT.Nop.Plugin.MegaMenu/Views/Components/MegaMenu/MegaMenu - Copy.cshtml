@inject Nop.Core.IWorkContext _workContext;
@inject Nop.Core.IStoreContext _store;
@inject Nop.Services.Customers.ICustomerService  _customerService;
@inject Nop.Core.IWebHelper _webHelper;
@using Microsoft.Extensions.Primitives;

@model MegaMenuWidgetModel

@{
    var store = await _store.GetCurrentStoreAsync();
    bool isAuthenticated = false;
    var customer = await _workContext.GetCurrentCustomerAsync();
    isAuthenticated = await _customerService.IsRegisteredAsync(customer);
    NopHtml.AddCssFileParts("~/Plugins/MWT.Nop.Plugin.MegaMenu/Themes/" + Model.Theme + "/Content/MegaMenuDesktop.css");

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/MWT.Nop.Plugin.MegaMenu/Scripts/MegaMenu.min.js");
}

@foreach (var menu in Model.MegaMenus)
{


    @*@if (_workContext.IsMobileDevice())
        {*@

<nav class="navbar navbar-expand-lg navbar-light" id="sidebar-menu">

    <div id="mobilenavbarContent" class="collapse navbar-collapse m-menu">
        <ul class="m-top-links">
            @if (!isAuthenticated)
            {
                var returnUrl = Context.Request.Query.TryGetValue("returnUrl", out var url) && !StringValues.IsNullOrEmpty(url) ? url.ToString() : _webHelper.GetRawUrl(Context.Request);
                <li>
                    <a href="@Url.RouteUrl("Login", new { returnUrl })">
                        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.5 8.4375C9.8291 8.4375 11.7188 6.54785 11.7188 4.21875C11.7188 1.88965 9.8291 0 7.5 0C5.1709 0 3.28125 1.88965 3.28125 4.21875C3.28125 6.54785 5.1709 8.4375 7.5 8.4375ZM11.25 9.375H9.63574C8.98535 9.67383 8.26172 9.84375 7.5 9.84375C6.73828 9.84375 6.01758 9.67383 5.36426 9.375H3.75C1.67871 9.375 0 11.0537 0 13.125V13.5938C0 14.3701 0.629883 15 1.40625 15H13.5938C14.3701 15 15 14.3701 15 13.5938V13.125C15 11.0537 13.3213 9.375 11.25 9.375Z" fill="#808080"></path>
                        </svg>
                        @T("MainNavigation.Signin")
                    </a>
                </li>
            }
            else
            {
                <li>
                    <a href="@Url.RouteUrl("CustomerInfo")">
                        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.5 8.4375C9.8291 8.4375 11.7188 6.54785 11.7188 4.21875C11.7188 1.88965 9.8291 0 7.5 0C5.1709 0 3.28125 1.88965 3.28125 4.21875C3.28125 6.54785 5.1709 8.4375 7.5 8.4375ZM11.25 9.375H9.63574C8.98535 9.67383 8.26172 9.84375 7.5 9.84375C6.73828 9.84375 6.01758 9.67383 5.36426 9.375H3.75C1.67871 9.375 0 11.0537 0 13.125V13.5938C0 14.3701 0.629883 15 1.40625 15H13.5938C14.3701 15 15 14.3701 15 13.5938V13.125C15 11.0537 13.3213 9.375 11.25 9.375Z" fill="#808080"></path>
                        </svg>
                        @T("Account.MyAccount")
                    </a>
                </li>
                <li>
                    <a href="@Url.RouteUrl("Logout")">
                        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.5 8.4375C9.8291 8.4375 11.7188 6.54785 11.7188 4.21875C11.7188 1.88965 9.8291 0 7.5 0C5.1709 0 3.28125 1.88965 3.28125 4.21875C3.28125 6.54785 5.1709 8.4375 7.5 8.4375ZM11.25 9.375H9.63574C8.98535 9.67383 8.26172 9.84375 7.5 9.84375C6.73828 9.84375 6.01758 9.67383 5.36426 9.375H3.75C1.67871 9.375 0 11.0537 0 13.125V13.5938C0 14.3701 0.629883 15 1.40625 15H13.5938C14.3701 15 15 14.3701 15 13.5938V13.125C15 11.0537 13.3213 9.375 11.25 9.375Z" fill="#808080"></path>
                        </svg>
                        @T("Account.Logout")
                    </a>
                </li>
            }
            @if (isAuthenticated)
            {
                <li>
                    <a href="@Url.RouteUrl("CustomerOrders")">
                        <svg width="17" height="14" viewBox="0 0 17 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16.575 9.35H16.15V6.47859C16.15 6.14125 16.0145 5.81719 15.7755 5.57812L13.1219 2.92453C12.8828 2.68547 12.5588 2.55 12.2214 2.55H11.05V1.275C11.05 0.571094 10.4789 0 9.775 0H1.275C0.571094 0 0 0.571094 0 1.275V9.775C0 10.4789 0.571094 11.05 1.275 11.05H1.7C1.7 12.4578 2.84219 13.6 4.25 13.6C5.65781 13.6 6.8 12.4578 6.8 11.05H10.2C10.2 12.4578 11.3422 13.6 12.75 13.6C14.1578 13.6 15.3 12.4578 15.3 11.05H16.575C16.8088 11.05 17 10.8588 17 10.625V9.775C17 9.54125 16.8088 9.35 16.575 9.35ZM4.25 12.325C3.54609 12.325 2.975 11.7539 2.975 11.05C2.975 10.3461 3.54609 9.775 4.25 9.775C4.95391 9.775 5.525 10.3461 5.525 11.05C5.525 11.7539 4.95391 12.325 4.25 12.325ZM12.75 12.325C12.0461 12.325 11.475 11.7539 11.475 11.05C11.475 10.3461 12.0461 9.775 12.75 9.775C13.4539 9.775 14.025 10.3461 14.025 11.05C14.025 11.7539 13.4539 12.325 12.75 12.325ZM14.875 6.8H11.05V3.825H12.2214L14.875 6.47859V6.8Z" fill="#808080"></path>
                        </svg>
                        @T("MainNavigation.Order")
                    </a>
                </li>
            }
            <li>
                <a href="tel:@store.CompanyPhoneNumber">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M14.5722 10.5995L11.2909 9.19325C11.1507 9.13351 10.995 9.12093 10.847 9.15738C10.6991 9.19384 10.567 9.27738 10.4706 9.3954L9.01744 11.1708C6.73686 10.0956 4.90151 8.26021 3.82624 5.97962L5.60166 4.52647C5.71993 4.43028 5.80363 4.29818 5.84011 4.15016C5.87659 4.00215 5.86384 3.84627 5.80381 3.70615L4.39754 0.424839C4.33165 0.273785 4.21512 0.150453 4.06804 0.0761122C3.92097 0.00177107 3.75256 -0.0189204 3.59186 0.0176058L0.544931 0.720743C0.389998 0.75652 0.251766 0.843756 0.152796 0.968213C0.0538267 1.09267 -3.56904e-05 1.247 1.77431e-08 1.40601C1.77431e-08 8.92079 6.09093 15 13.594 15C13.753 15.0001 13.9074 14.9463 14.032 14.8473C14.1565 14.7483 14.2438 14.61 14.2795 14.4551L14.9827 11.4081C15.019 11.2467 14.9978 11.0776 14.9229 10.93C14.848 10.7824 14.724 10.6655 14.5722 10.5995Z" fill="#808080"></path>
                    </svg>
                    @store.CompanyPhoneNumber
                </a>
            </li>
        </ul>

        @*// categories*@
        @{ var items = menu.Items.Where(m => !(m.CssClass == null ? "" : m.CssClass).Contains("ismobileBottomTopicLink")).ToList();
        }
        @if (items.Count > 0)
        {
            <div class="m-category ">
                <div id="accordion" class="accordion menu-accordion">
                    <div class="card mb-0">


                        @foreach (var item in items)
                        {
                            var menuItemHtml = await Component.InvokeAsync("MegaMenuMenuItem", new { menuItem = item, modelId = item.Id, level = 0 });
                            @menuItemHtml
                        }

                    </div>
                </div>
            </div>
        }

        @*// end*@

        @*// topics*@
        @{ var mobileTopicItems = menu.Items.Where(m => (m.CssClass == null ? "" : m.CssClass).Contains("ismobileBottomTopicLink")).ToList();


        }
        @*<ul class="m-top-links m-bottom-links">
                @foreach (var topic in mobileTopicItems)
                {
                    <li>
                        <a href="@(Plugin.PredefinedPageTypes.Contains(topic.Type) ? Url.RouteUrl(topic.Type.ToString()) : topic.Url)"
                           class="cat-@(topic.Id) @topic.CssClass ffff" title="@topic.Title" @if (topic.OpenInNewWindow) { <text> target="_blank" </text> }>
                            @topic.Title
                        </a>
                    </li>
                }
            </ul>*@
        @if (mobileTopicItems.Count > 0)
        {
            <div class="m-category border-0">
                <div id="accordion" class="accordion menu-accordion">
                    <div class="card mb-0">
                        @foreach (var item in mobileTopicItems)
                        {
                            var menuItemHtml = await Component.InvokeAsync("MegaMenuMenuItem", new { menuItem = item, modelId = item.Id, level = 0 });
                            @menuItemHtml
                        }

                    </div>
                </div>
            </div>
        }

        @*// end*@
    </div>

    <script asp-location="Footer">
        $(window).on('load', function () {
            if ($(window).width() >= 991) {
                $('.navbar .dropdown').hover(function () {
                    $(this).find('.dropdown-menu').first().stop(true, true).delay(100).slideDown();
                }, function () {
                    $(this).find('.dropdown-menu').first().stop(true, true).delay(100).slideUp()
                });
            }
            //})
        });

    </script>
    <script asp-location="Footer">
        function openNav() {
            document.getElementById("mySidenav").style.width = "100%";
        }
        function closeNav() {
            document.getElementById("mySidenav").style.width = "0";
        }

        $(".toggle").click(function () {
            $(".header").addClass("header-overlay");
        });
        $(".closebtn").click(function () {
            setTimeout(function () {
                $(".header").removeClass("header-overlay");
            }, 500);
        });
    </script>



    <div id="navbarContent" class="collapse navbar-collapse d-none d-lg-block">
        <ul class="navbar-nav mx-auto nav-menu">
            @{ var desktopitems = menu.Items.Where(m => !(m.CssClass == null ? "" : m.CssClass).Contains("ismobileBottomTopicLink")).ToList();
            }
            @foreach (var item in desktopitems)
            {
                var menuItemHtml = await Component.InvokeAsync("MegaMenuMenuItem", new { menuItem = item, modelId = item.Id, level = 0 });
                @menuItemHtml
            }
        </ul>
    </div>
</nav>

    }

