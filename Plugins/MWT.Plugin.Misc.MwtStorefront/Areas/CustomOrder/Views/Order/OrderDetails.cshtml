            <script asp-location="Footer">
                $('#product_search').keypress(function (e) {
                    var key = e.which;
                    if (key == 13)  // the enter key code
                    {
                        e.preventDefault();
                        productsection.searchProducts($("#product_search").val());
                    }
                });
                $(".productssearch_btn").click(function () {
                    productsection.searchProducts($("#product_search").val());
                });
                $("body").on("change", "input[name=\"option\"]", function (e) {
                    if ($(this).prop("checked")) {
                        var selectedValue = $(this).val();
                        var productId = $(this).attr("data-productid");

                        if (selectedValue.toLowerCase() == "custom") {

                            $("div[data-custom-productId=\"" + productId + "\"]").show();
                        }
                        else {
                            $("div[data-custom-productId=\"" + productId + "\"]").hide();
                        }

                        $(this).parent().parent().parent().parent().find("input[type=\"checkbox\"]").each(function (index, item) {
                            if ($(item).val() != selectedValue) {
                                $(item).prop('checked', false).trigger("change");
                            }
                        });
                    }
                })
                $("body").on("click", ".itemedit", function (e) {
                    var id = $(this).attr("data-id");
                    console.log("tr[id='tr-" + id + "']");
                    console.log($("tr[id='tr-" + id + "']"));
                    $(this).hide();
                    $("tr[id='tr-" + id + "']").find(".itemupdate").show();
                    $("tr[id='tr-" + id + "']").find(".itemUpdateCancel").show();
                    $("tr[id='tr-" + id + "']").find("input").removeClass("disabled");
                    $("tr[id='tr-" + id + "']").find("input").removeAttr("disabled");
                });
                $("body").on("click", ".itemUpdateCancel", function (e) {
                    var id = $(this).attr("data-id");
                    $("tr[id='tr-" + id + "']").find(".itemupdate").hide();
                    $("tr[id='tr-" + id + "']").find(".itemedit").show()
                    $("tr[id='tr-" + id + "']").find(".itemUpdateCancel").hide();
                    $("tr[id='tr-" + id + "']").find("input").addClass("disabled");
                    $("tr[id='tr-" + id + "']").find("input").addAttr("disabled");
                    $("tr[id='tr-" + id + "']").find("input[name='quantity']").
                        val($("tr[id='tr-" + id + "']").find("input[name='quantity']").attr("data-qty"));
                    $("tr[id='tr-" + id + "']").find("input[name='discount']").
                        val($("tr[id='tr-" + id + "']").find("input[name='discount']").attr("data-discount"));

                });

                $("body").on("click", ".itemupdate", function (e) {
                    var products = [];
                    var id = $(this).attr("data-id");
                    var qty = $("tr[id='tr-" + id + "']").find("input[name='quantity']").val();
                    var discountType = "Fixed";
                    var adjustmentText = $("tr[id='tr-" + id + "']").find("input[name='discount']").val();
                    if (adjustmentText.indexOf("%") > 0) {
                        discountType = "Percentage";
                    }
                    var adj = parseFloat(adjustmentText.replace("%", "").replace(",", ""));
                    adj = isNaN(adj) ? 0 : adj;

                    if ((adj < -100) && discountType == "Percentage") {
                        $("tr[id='tr-" + id + "']").find("input[name='discount']").focus();
                        return;
                    }

                    products.push({
                        Id: id,
                        Quantity: qty, DiscountAmount: (discountType == "Fixed" ? adj : 0),
                        DiscountPercentage: (discountType == "Percentage" ? adj : 0), ChargeType: (adj > 0 ? "Add" : "Subtract"), DiscountType: discountType
                    })
                    productsection.itemUpdate(products)
                });
                $("body").on("click", ".add-item-note", function (e) {

                    var id = $(this).attr("data-id");
                    var notes = $("tr[id='tr-" + id + "']").find(".itemnotes").html();
                    $("#add_ItemNoteModel").find("textarea[name='itemNotes']").val(notes);
                    $("#add_ItemNoteModel").find(".applybtn").attr("data-id", id);
                    $("#add_ItemNoteModel").modal('show')
                });
                $("body").on("click", "#add_ItemNoteModel .applybtn", function (e) {
                    var products = [];
                    var obj = this;
                    if ($('.custom-file-input-1').val() == '') {
                        products.push({
                            Id: $(this).attr("data-id"),
                            Notes: $("#add_ItemNoteModel").find("textarea[name='itemNotes']").val()
                        });
                        productsection.itemNotesUpdate(products)
                    }
                    else {
                        var _file = $('.custom-file-input-1').get(0).files[0];
                        var file = _file.file;
                        var reader = new FileReader();
                        reader.readAsDataURL(_file);
                        reader.onloadend = function () {
                            documentbaseFile = reader.result;
                            var ext = "." + $('.custom-file-input-1').val().split('\\').pop().split(".").pop();
                            products.push({
                                Id: $(obj).attr("data-id"),
                                Notes: $("#add_ItemNoteModel").find("textarea[name='itemNotes']").val(),
                                ext: ext,
                                base64: documentbaseFile
                            });
                            $(".custom-file-input-1").val('');
                            $(".selectedfile").html('');
                            productsection.itemNotesUpdate(products)
                        }
                    }

                    $("#add_ItemNoteModel").modal('hide');

                });

            </script>
            @*----------------- end----------------------------------*@


