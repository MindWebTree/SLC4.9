            $("body").on("click", ".btnWgsapply", function () {
                var discount = $("#customorder-orderSummary_Wgs-model").find("input[name='wgs_amount']").val();
                discount = parseFloat(discount);
                if (isNaN(discount)) {
                    $("#customorder-orderSummary_Wgs-model").find("input[name='wgs_amount']").focus();
                    return;
