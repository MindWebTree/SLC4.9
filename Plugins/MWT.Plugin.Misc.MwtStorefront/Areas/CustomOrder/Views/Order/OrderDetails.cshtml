            function sendInvoice(email) {
                $("#invoice_email").val(email);
                $("#customorder-invoice-model").modal('show')
            }
            $("body").on("click", ".btnsendinvoice", function (e) {

                if (!ValidateEmail($("#invoice_email").val())) {
                    $("#invoice_email").focus();
                    return;
                }
                $("#customorder-invoice-model").modal('hide')
                var formdata = new URLSearchParams();
