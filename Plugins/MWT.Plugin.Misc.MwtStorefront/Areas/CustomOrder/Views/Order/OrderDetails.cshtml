                formdata.append(`SpecialInstructionsfromBuyer`, $("#SpecialInstructionsfromBuyer").val());
                formdata.append(`orderTypeUpdate`, "Notes");
                orderSummarySection.orderUpdate(formdata);
            });


            $("body").on("click", ".btnSubtotalDiscount", function () {

                $("#customorder-orderSummary_Discount-model").find("textarea[name='subtotaladjustmentNotes']").val($("#SubTotalAdjNotes").html());
                $("#customorder-orderSummary_Discount-model").find("input[name='discount_amount']").val($(".orderDiscountInfo").attr("data-discount"));
                $("#customorder-orderSummary_Discount-model").find("#subtotal_discount_type").val($(".orderDiscountInfo").attr("data-discount-Type"));
                $('#customorder-orderSummary_Discount-model').modal('show')
            })
            $("body").on("click", ".btnSubTotalapply", function () {
                var discount = $("#customorder-orderSummary_Discount-model").find("input[name='discount_amount']").val();
                discount = parseFloat(discount);
                if (isNaN(discount)) {
                    $("#customorder-orderSummary_Discount-model").find("input[name='discount_amount']").focus();
                    return;
                }
                if (!$("#customorder-orderSummary_Discount-model").find("#subtotal_discount_type").val()) {
                    $("#customorder-orderSummary_Discount-model").find("#subtotal_discount_type").focus();
                    return;
                }
                if ($("#customorder-orderSummary_Discount-model").find("#subtotal_discount_type").val() == "Percentage" && discount > 100) {
                    $("#customorder-orderSummary_Discount-model").find("input[name='discount_amount']").focus();
                    return;
                }

                var formdata = new URLSearchParams();
                formdata.append(`Id`, parseInt($("#orderId").val()));
                formdata.append(`SubTotalDiscountType`, $("#customorder-orderSummary_Discount-model").find("#subtotal_discount_type").val());
                formdata.append(`SubTotalDiscount`, discount);
                formdata.append(`SubTotalAdjustmentNotes`, $("#customorder-orderSummary_Discount-model").find("textarea[name='subtotaladjustmentNotes']").val());
                formdata.append(`orderTypeUpdate`, "Discount");
                orderSummarySection.orderUpdate(formdata);
            });

            //wgs
