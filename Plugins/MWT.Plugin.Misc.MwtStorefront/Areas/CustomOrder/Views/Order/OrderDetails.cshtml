                if (!isMethodExist) {
                    swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        html: paymentMethodNotExist.replace("{0}", cashPaymentMethodName)
                    })

                }
                else {
                    paymentModuleSection.processPayment(".cashondelivery");
                }
            });


            $("body").on("click", ".creditCardAction", function (e) {
                var isMethodExist = false;
                $.each($('input[name="paymentmethod"]'), function (index, element) {
                    console.log($(element).attr("data-paymethodname"));
                    if ($(element).attr("data-paymethodname").toLowerCase().indexOf(creditPaymentMethodName) >= 0) {
                        $(element).prop("checked", true).trigger('change');
                        isMethodExist = true;
                        return false;
                    }
                });
                if (!isMethodExist) {

                    swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        html: paymentMethodNotExist.replace("{0}", creditPaymentMethodName)
                    })
                }
                else {
                    paymentModuleSection.processPayment(".creditCardAction");
                }
            });


            $("body").on("change", "#ApplyTax", function () {

                var formdata = new URLSearchParams();
                formdata.append(`Id`, parseInt($("#orderId").val()));
                formdata.append(`ApplyTax`, $(this).is(':checked'));
                formdata.append(`orderTypeUpdate`, "TaxUpdate");
                orderSummarySection.orderUpdate(formdata);
            })

        </script>
        @***********************end*****@
    </div>
</form>

