                $("#customorder-orderSummary_Wgs-model").find(".defaultwgscharges").html($(".wgscharges").attr("data-normal-wgs").replace("$", "").replace(",", ""));
                $("#customorder-orderSummary_Wgs-model").find("input[name='complementryWgsFree']").prop('checked',
