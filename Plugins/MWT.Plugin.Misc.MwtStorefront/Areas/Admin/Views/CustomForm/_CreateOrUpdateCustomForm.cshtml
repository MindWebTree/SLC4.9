@model  CustomFormModel


<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

@if (ViewBag.RefreshPage == true)
{
    <script>
        try { window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click(); }
        catch (e) { }
        window.close();
    </script>
}

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
               @await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.ProductTagDetailsTop, additionalData = Model })
                <div class="card card-default margin-bottom">
                    <div class="card-header">
                    <i class="fas fa-info"></i>     @T("admin.catalog.customform.info")
                    </div>
                    <div class="card-body">
                        <section class="content">
                            <div class="container-fluid">
                                <div class="form-horizontal">
                                    <div class="cards-group">
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="FormName" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="FormName" asp-required="true" />
                                                <span asp-validation-for="FormName"></span>
                                                @if (Model.Id > 0)
                                                {
                                                    <div style="background: antiquewhite;padding: 10px;">

                                                        <b>Short Code</b>
                                                        <br />
                                                        <text>[%Custom_Form name = "@Model.FormName"%]</text>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="FormHtml" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="FormHtml" asp-required="true" asp-template="RichEditor" />
                                                <span asp-validation-for="FormHtml"></span>
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="Published" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="Published" />
                                                <span asp-validation-for="Published"></span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="RenderActions" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="RenderActions" />
                                                <span asp-validation-for="RenderActions"></span>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

                <div class="card card-default margin-bottom">
                    <div class="card-header">
                       <i class="fas fa-info"></i>@T("admin.catalog.customform.thankyou.heading")
                    </div>
                    <div class="card-body">
                        <section class="content">
                            <div class="container-fluid">
                                <div class="form-horizontal">
                                    <div class="cards-group">

                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="UseHtml" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="UseHtml" />
                                                <span asp-validation-for="UseHtml"></span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="ShowInPopup" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="ShowInPopup" />
                                                <span asp-validation-for="ShowInPopup"></span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="ThankYouPageLink" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="ThankYouPageLink" />
                                                <span asp-validation-for="ThankYouPageLink"></span>
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="ThankYouHtml" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="ThankYouHtml" asp-template="RichEditor" />
                                                <span asp-validation-for="ThankYouHtml"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

                <div class="card card-default margin-bottom">
                    <div class="card-header">
                        <i class="fas fa-cog"></i>   @T("admin.catalog.customform.Notification.heading")
                    </div>
                    <div class="card-body">
                        <section class="content">
                            <div class="container-fluid">
                                <div class="form-horizontal">
                                    <div class="cards-group">
                                     
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="BccEmailAddresses" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="BccEmailAddresses" />
                                                <span asp-validation-for="BccEmailAddresses"></span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="Subject" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="Subject" />
                                                <span asp-validation-for="Subject"></span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="Body" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="Body" asp-template="RichEditor" />
                                                <span asp-validation-for="Body"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

                <div class="card card-default margin-bottom">
                    <div class="card-header">
                        <i class="fas fa-cog"></i> @T("admin.catalog.customform.Customer.Notification.heading")
                    </div>
                    <div class="card-body">
                        <section class="content">
                            <div class="container-fluid">
                                <div class="form-horizontal">
                                       <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="SendCustomerNotification" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="SendCustomerNotification" />
                                                <span asp-validation-for="SendCustomerNotification"></span>
                                            </div>
                                        </div>
                                    <div class="cards-group">
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="CustomerNotificationSubject" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="CustomerNotificationSubject" />
                                                <span asp-validation-for="CustomerNotificationSubject"></span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-sm-3">
                                                <nop-label asp-for="CustomerNotificationEmailBody" />
                                            </div>
                                            <div class="col-sm-9">
                                                <nop-editor asp-for="CustomerNotificationEmailBody" asp-template="RichEditor" />
                                                <span asp-validation-for="CustomerNotificationEmailBody"></span>
                                            </div>
                                        </div>
                                       
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>


                @await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.ProductTagDetailsBottom, additionalData = Model })
            </div>
        </div>
    </div>
</section>