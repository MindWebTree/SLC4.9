@using Nop.Web.Framework.Models.DataTables
@using Nop.Web.Framework.Models

@model TagSlugMappingSearchModel
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Tag URL Slugs (First Segment)";
}
<div class="content-header clearfix" bis_skin_checked="1">
    <h1 class="pull-left">Tag URL Slugs</h1>
    <div class="float-right" bis_skin_checked="1">
        <a href="@Url.Action("CreateTagSlug")" class="btn btn-primary">
            <i class="fa fa-plus-square"></i> Add New Tag Slug
        </a>


    </div>
</div>


<div class="card card-default" bis_skin_checked="1">
    <div class="card-body" bis_skin_checked="1">

        <div class="panel panel-default">
        
            <div class="panel-body">
                @await Html.PartialAsync("Table", new DataTablesModel
           {
               Name = "tagslug-grid",
               UrlRead = new DataUrl("TagSlugList", "TagAdmin", null),
               UrlDelete = new DataUrl("DeleteTagSlug", "TagAdmin", null),
               SearchButtonId = "search-tagslug",
               Length = Model.PageSize,
               LengthMenu = Model.AvailablePageSizes,
               Filters = new List<FilterParameter>(),
               ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(TagSlugMappingModel.Slug))
                        {
                            Title = "Slug",
                            Render = new RenderCustom("renderSlugBadge")
                        },
                        new ColumnProperty(nameof(TagSlugMappingModel.Label))
                        {
                            Title = "Label"
                        },
                        new ColumnProperty(nameof(TagSlugMappingModel.TagId))
                        {
                            Title = "Tag ID"
                        },
                        new ColumnProperty(nameof(TagSlugMappingModel.SortOrder))
                        {
                            Title = "Sort Order"
                        },
                        new ColumnProperty(nameof(TagSlugMappingModel.IsActive))
                        {
                            Title  = "Active",
                            Render = new RenderBoolean()
                        },

            new ColumnProperty(nameof(TagSlugMappingModel.Id))
                         {
                           Title = T("Admin.Common.Edit").Text,
                           Width = "100",
                           ClassName =  NopColumnClassDefaults.Button,
                           Render = new RenderButtonEdit(new DataUrl("EditTagSlug", "TagAdmin"))
                }, new ColumnProperty(nameof(TagSlugMappingModel.Id))
                        {
                            Title = T("Admin.Common.Delete").Text,
                            ClassName = NopColumnClassDefaults.Button,
                            Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                            Width = "100"
                        }
                    }
           })
            </div>
        </div>
    </div>
</div>


<script>
    function renderSlugBadge(data) {
        return '<code>/' + data + '</code>';
    }
</script>
