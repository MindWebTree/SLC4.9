@model CategoryPermissionSearchModel

<form asp-controller="Security" asp-action="CategoryPermissionList" id="categorypermission-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Catalog.Products.CategoryPermission.Hint")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Permissions">@T("Admin.Catalog.CategoryPermission.BackToList")</a>
            </small>
        </h1>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">

                            @await Html.PartialAsync("Table", new DataTablesModel
                       {
                           Name = "CategoryPermission-grid",
                           UrlRead = new DataUrl("CategoryPermissionList", "Security", null),
                           UrlDelete = new DataUrl("CategoryPermissionDelete", "Security", null),
                           Length = Model.PageSize,
                           LengthMenu = Model.AvailablePageSizes,
                           ColumnCollection = new List<ColumnProperty>
                                    {
                                new ColumnProperty(nameof(CategoryPermissionModel.Id))
                                        {
                                            Title = T("Admin.Catalog.Products.CategoryPermission.Fields.Id").Text,
                                            Width = "150",
                                            ClassName = NopColumnClassDefaults.CenterAll
                                        },
                                        new ColumnProperty(nameof(CategoryPermissionModel.UserEmail))
                                        {
                                            Title = T("Admin.Catalog.Products.CategoryPermission.Fields.UserEmail").Text,
                                            Width = "150",
                                            ClassName = NopColumnClassDefaults.CenterAll
                                        },
                                            new ColumnProperty(nameof(CategoryPermissionModel.CategoryName))
                                        {
                                            Title = T("Admin.Catalog.Products.CategoryPermission.Fields.CategoryName").Text,
                                            Width = "200",
                                            ClassName = NopColumnClassDefaults.CenterAll
                                        },
                                        new ColumnProperty(nameof(CategoryPermissionModel.Id))
                                        {
                                            Title = T("Admin.Common.Delete").Text,
                                            Width = "100",
                                            Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                            ClassName = NopColumnClassDefaults.Button
                                        }
                                    }
                       })
                        </div>
                        <div class="card-footer">
                            <button type="submit" id="btnAddNewCategoryPermission"
                                    onclick="javascript:OpenWindow('@(Url.Action("CategoryPermissionAddPopup", "Security", new {btnId = "btnRefreshCategoryPermissions", formId = "categorypermission-form" }))', 800, 800, true); return false;"
                                    class="btn btn-primary">
                                @T("Admin.Catalog.CategoryPermission.AddNew")
                            </button>
                            <button type="submit" id="btnRefreshCategoryPermissions" style="display: none"></button>
                            <script>
                                $(document).ready(function () {
                                    $('#btnRefreshCategoryPermissions').click(function () {
                                        //refresh grid
                                        updateTable('#CategoryPermission-grid');

                                        //return false to don't reload a page
                                        return false;
                                    });
                                });
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</form>

