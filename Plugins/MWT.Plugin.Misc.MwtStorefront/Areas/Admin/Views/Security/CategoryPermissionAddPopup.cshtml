@model AddCategoryToCategoryPermissionModel

@{
    Layout = "_AdminPopupLayout";

    //page title
    ViewBag.PageTitle = T("Admin.Catalog.CategoryPermission.Categories.AddNew").Text;
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
        catch (e){}
        window.close();
    </script>
}
else
{
    <form asp-controller="Security" asp-action="CategoryPermissionAddPopup"
          asp-route-btnId="@Context.Request.Query["btnId"]"
          asp-route-formId="@Context.Request.Query["formId"]">
        <div class="card-body">
            <p>
                @T("Admin.Catalog.CategoryPermission.Hint")
            </p>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="SelectedCategoryId" />
                </div>
                <div class="col-md-9">
                    <nop-select asp-for="SelectedCategoryId" asp-items="Model.AvailableCategories" asp-multiple="false" />
                    <script>
                    $(document).ready(function () {
                        var ddl = $('#@Html.IdFor(model => model.SelectedCategoryId)').data("kendoDropDownList");

                        ddl.setOptions({
                            filter: "contains"
                        });

                        @if (Model.AvailableCategories.Count == 0)
                        {
                            <text>
                                ddl.enable(false);
                                ddl.input.attr("placeholder", '@T("Admin.Catalog.Products.Fields.CategoryPermission.NoCustomersAvailable")');
                            </text>
                        }
                    });
                    </script>

                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="SelectedCustomerId" />
                </div>
                <div class="col-md-9">
                    <nop-select asp-for="SelectedCustomerId" asp-items="Model.AvailableCustomerIds" asp-multiple="false" />
                    <script>
                    $(document).ready(function () {
                        var ddl = $('#@Html.IdFor(model => model.SelectedCustomerId)').data("kendoDropDownList");

                        ddl.setOptions({
                            filter: "contains"
                        });

                        @if (Model.AvailableCategories.Count == 0)
                        {
                            <text>
                                ddl.enable(false);
                                ddl.input.attr("placeholder", '@T("Admin.Catalog.Products.Fields.CategoryPermission.NoCustomersAvailable")');
                            </text>
                        }
                    });
                    </script>
                </div>
            </div>

        </div>
        <div class="card-footer">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>

    </form>
}