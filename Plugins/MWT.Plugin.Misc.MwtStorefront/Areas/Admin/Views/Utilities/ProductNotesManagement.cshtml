@model Nop.Web.Areas.Admin.Models.Customization.Utilities.ProductNotesManagementModel
@using Nop.Web.Framework.Models.AdminAreaTour

@{
    //page title
    ViewBag.PageTitle = T("Admin.Utilities.Bulk.Notes").Text;

    //active menu item (system name)
    Html.SetActiveMenuItemSystemName("BulkNotes");
}
@{

    //resources for product tags input
    Html.AppendCssFileParts("~/lib_npm/jquery-tageditor/jquery.tag-editor.css");
    Html.AppendScriptParts("~/lib_npm/jquery-tageditor/jquery.tag-editor.min.js");

}

<form asp-controller="Utilities" asp-action="ProductNotesManagement" method="post" id="product-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
        @T("Admin.Utilities.Notes.Heading")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>


        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="EntityType" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="EntityType" asp-items="Model.EntityTypes" />
                        <span asp-validation-for="EntityType"></span>
                    </div>
                </div>

                <div class="form-group row productSection">
                    <div class="col-md-3">
                        <nop-label asp-for="ProductIds" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ProductIds" />
                        <span asp-validation-for="ProductIds"></span>
                    </div>
                </div>

                <div class="form-group row categorySection">
                    <div class="col-md-3">
                        <nop-label asp-for="CategoryIds" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="CategoryIds" />
                        <span asp-validation-for="CategoryIds"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Notes" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Notes" asp-template="RichEditor" />
                        <span asp-validation-for="Notes"></span>
                    </div>
                </div>
            </div>
        </div>
    </section>

</form>

<script>
    var selectEntityType = $('#@Html.IdFor(model => model.EntityType)');
    console.log(selectEntityType);
    $(document).ready(function () {
        mangeSections($(selectEntityType).val());
    });

    $(selectEntityType).change(function () {
        mangeSections($(this).val());
    })
    function mangeSections(value) {
        if (value == "Product") {
            $(".productSection").show();
            $(".categorySection").hide();
        }
        else if (value == "Category") {

            $(".categorySection").show();
            $(".productSection").hide();
        }
        else {
            $(".productSection").hide();
            $(".categorySection").hide();
        }
    }
            
</script>