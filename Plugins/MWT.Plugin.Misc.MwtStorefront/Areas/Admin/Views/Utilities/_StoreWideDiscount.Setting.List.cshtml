@model StoreWideDiscountModel 


    <div class="card card-secondary card-outline" data-card-name="product-info" data-hideattribute="ProductPage.HideInfoBlock" id="product-info" bis_skin_checked="1">
        <div class="card-header with-border clearfix" bis_skin_checked="1">
            <div class="card-title" bis_skin_checked="1">
                <i class="fas fa-info"></i>
                @T("admin.Utilities.Marketing.StoreWideDiscount.Settings")
            </div><div class="card-tools float-right">
                <button class="btn btn-tool" data-card-widget="collapse" type="button">
                    <i class="fa-minus toggle-icon fa"></i>
                </button>
            </div>
        </div>

        <div class="card-body">
            @if (Model.Id > 0)
            {
                @await Html.PartialAsync("Table", new DataTablesModel
           {

               Name = "storeWideDiscount-table",
               UrlRead = new DataUrl("StoreWideDiscountSettingList", "Utilities", new RouteValueDictionary { [nameof(StoreWideDiscountSettingSearchModel.StoreWideDiscountId)] = Model.Id }),
               UrlDelete = new DataUrl("StoreWideDiscountSettingDelete", "Utilities", null),
               Length = Model.StoreWideDiscountSettingSearchModel.PageSize,
               LengthMenu = Model.StoreWideDiscountSettingSearchModel.AvailablePageSizes,
               Filters = new List<FilterParameter>
               {
               },

               ColumnCollection = new List<ColumnProperty>
    {
    new ColumnProperty(nameof(StoreWideDiscountSettingModel.Id))
    {
    Title = T("Admin.Utilities.Marketing.Offer.Field.Id").Text,
    Width = "120",
    },
    new ColumnProperty(nameof(StoreWideDiscountSettingModel.InfoText))
    {
    Title = T("Admin.Utilities.Marketing.Offer.Field.InfoText").Text,
    Width = "220",
    },
    new ColumnProperty(nameof(StoreWideDiscountSettingModel.ProductIds))
    {
    Title = T("Admin.Utilities.Marketing.Offer.Field.ProductIds").Text,
    Width = "220",
    },
    new ColumnProperty(nameof(StoreWideDiscountSettingModel.CategoryIds))
    {
    Title = T("Admin.Utilities.Marketing.Offer.Field.CategoryIds").Text,
    Width = "320",
    },
    new ColumnProperty(nameof(StoreWideDiscountSettingModel.Discount))
    {
    Title = T("Admin.Utilities.Marketing.Offer.Field.Discount").Text,
    Width = "120",
    },
    new ColumnProperty(nameof(StoreWideDiscountSettingModel.Id))
    {
    Title = T("Admin.Common.Edit").Text,
    Width = "100",
    ClassName =  NopColumnClassDefaults.Button,
    Render = new RenderCustom("renderColumnEdit")
    },
    new ColumnProperty(nameof(StoreWideDiscountSettingModel.Id))
    {
    Title = T("Admin.Common.Delete").Text,
    Width = "120",
    ClassName =  NopColumnClassDefaults.Button,
    Render = new RenderButtonRemove("Delete")
    },
    }
           }
         )
            }
            else
            {
                <div class="card-body">
                    @T("Admin.Utilities.Marketing.Offer.SaveBeforeEdit")
                </div>
            }

            <div class="card-footer">
                <button type="submit" id="btnAddNewProduct"
                        onclick="javascript:OpenWindow('@(Url.Action("StoreWideDiscountSettingCreateUpdate", "Utilities", new { storewidediscountid = Model.Id, btnId = "btnRefreshProducts", formId = "storewidediscount-form" }))', 800, 800, true); return false;"
                        class="btn btn-primary">
                    @T("Admin.Common.AddNew")
                </button>
                <button type="submit" id="btnRefreshProducts" style="display: none"></button>
                <script>
                                        $(document).ready(function () {

                                            $('#btnRefreshProducts').click(function () {
                                                //refresh grid
                                                updateTable('#storeWideDiscount-table');

                                                //return false to don't reload a page
                                                return false;
                                            });
                                        });

                                        function renderColumnEdit(data, type, row, meta) {
                                            var editUrl = '@Url.Action("StoreWideDiscountSettingCreateUpdate", "Utilities",new { storewidediscountid= Model.Id , settingid=0 })';
                                            var fullUrl = editUrl + data + '\?&btnId=btnRefreshProducts&formId=storewidediscount-form';
                                            return '<button onclick="javascript:OpenWindow(\'' + fullUrl + '\', 800, 800, true); return false;" class="btn btn-default"><i class="fas fa-pencil-alt"></i>@T("Admin.Common.Edit").Text</button>';
                                        }


                </script>

            </div>
        </div>
    </div>


 

