@model ProductModel
@using Nop.Web.Framework.Models.DataTables
@using MWT.Nop.Plugin.Misc.ProductBundle.Models.Variant
@using Microsoft.AspNetCore.Routing
@using Nop.Web.Areas.Admin.Models.Catalog
@using Nop.Web.Framework.Infrastructure 

@await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.ProductDetailsProductAttributesInfoTop, additionalData = Model })

<div class="card-body">
    <p>@T("Admin.Catalog.Products.Variant.Hint")</p>
    @if (Model.Id > 0)
    {
        <div class="card card-default">
            <div class="card-body">
                @await Html.PartialAsync("Table", new DataTablesModel
           {
               Name = "Variantbundle-grid",
               UrlRead = new DataUrl("VariantList", "ProductBundle", new RouteValueDictionary { [nameof(Model.RelatedProductSearchModel.ProductId)] = Model.RelatedProductSearchModel.ProductId }),
               UrlUpdate = new DataUrl("VariantUpdate", "Product", null),
               Length = Model.RelatedProductSearchModel.PageSize,
               LengthMenu = Model.RelatedProductSearchModel.AvailablePageSizes,
               ColumnCollection = new List<ColumnProperty>
            {
                              new ColumnProperty(nameof(VariantBundleModel.VariantId))
                                {
                                    Title = T("Admin.Catalog.Products.Variant.Fields.Product.VariantId").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.CenterAll
                                },
                               new ColumnProperty(nameof(VariantBundleModel.Title))
                                {
                                    Title = T("Admin.Catalog.Products.Variant.Fields.Product.Title").Text,
                                    Width = "150",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Editable = true
                                },
                                new ColumnProperty(nameof(VariantBundleModel.Attributes))
                                {
                                    Title = T("Admin.Catalog.Products.Variant.Fields.Product.Attributes").Text,
                                    Width = "150",
                                    ClassName = NopColumnClassDefaults.CenterAll
                                },
                                new ColumnProperty(nameof(VariantBundleModel.CreatedOn))
            {
            Title = T("Admin.Catalog.Products.Variant.Fields.Product.CreatedOn").Text,
            Width = "150",
            ClassName = NopColumnClassDefaults.CenterAll,
            Editable = false,
            EditType = EditType.Checkbox
            },
                          new ColumnProperty(nameof(VariantBundleModel.IsValidBundle))
                            {
                                Title = "Bundle Valid",
                                Width = "120",
                                ClassName = NopColumnClassDefaults.CenterAll,
                                Render = new RenderBoolean()
                            },
                                new ColumnProperty(nameof(VariantBundleModel.VariantId))
                                {
                                    Title = "Bundle",
                                    Width = "200",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderCustom("renderConfigureBundleButton")
                                }

                            }
           })
            </div>
            <div class="card-footer">
                <button type="submit" id="btnRefreshRelatedSearchProducts" style="display: none"></button>
            </div>
        </div> }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                @T("Admin.Catalog.Products.RelatedSearch.SaveBeforeEdit")
            </div>
        </div>}
</div>

@await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.ProductDetailsProductAttributesInfoBottom, additionalData = Model })

<script> 
    function renderConfigureBundleButton(data, type, row, meta) {
        var url = '@Url.Content("~/Admin/ProductBundle/Manage/")' + data;

        // Construct the Log URL dynamically using the row data
        var logUrl = '@Url.Content("~/Admin/ProductBundle/Log")?productId=' + row.ProductId + '&variantId=' + data;

   
        if (row.HasBundleForProduct) {
            return '<div class="text-center">' +
                   '<span class="badge bg-green mb-1" style="font-size: 14px; padding: 5px 10px;">Active</span>' +
                   '<div class="margin-t-5">' +
                '<a href="' + url + '" class="btn btn-sm btn-primary" style="margin-right: 5px;"><i class="fas fa-pencil-alt"></i> Edit</a>' +
                   '<a href="' + logUrl + '" class="btn btn-sm btn-info" style="margin-right: 5px;" target="_blank"><i class="fas fa-history"></i> Log</a>' +
                   '<button type="button" onclick="disableBundle(' + data + ')" class="btn btn-sm btn-danger"><i class="fas fa-ban"></i> Disable</button>' +
                   '</div>' +
                   '</div>';
        } else {
            return '<div class="text-center">' +
                '<a href="' + url + '" class="btn btn-default mt-1" style="margin-right: 5px;">' +
                   '<i class="fas fa-cogs"></i> Configure Bundle' +
                   '</a>' +
                   '<a href="' + logUrl + '" class="btn btn-info mt-1" target="_blank"><i class="fas fa-history"></i> Log</a>' +
                   '</div>';
        }
    }

    function disableBundle(variantId) {
        if (confirm('@T("Admin.Common.AreYouSure")')) {
            var postData = {
                variantId: variantId // Controller still expects mappingId parameter name
            };

            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@(Url.Action("DisableBundle", "ProductBundle"))",
                data: postData,
                success: function (data) {
                    // Refreshes the Variant-grid specifically
                    updateTable('#Variantbundle-grid');
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert('Failed to disable the bundle.');
                }
            });
        }
    }  

    
</script>