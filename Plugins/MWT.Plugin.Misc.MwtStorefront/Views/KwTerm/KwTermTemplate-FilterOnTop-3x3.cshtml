@model KwTermModel
@using Nop.Core.Domain.Common
@using Nop.Core.Domain.Seo
@inject Nop.Core.IWebHelper webHelper
@inject SeoSettings seoSettings
@inject CommonSettings commonSettings
@inject Nop.Core.IWorkContext _workcontext
@{
    Layout = "_kwTermTemplate";

    //title
    Html.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    //meta
    Html.AddMetaDescriptionParts(Model.MetaDescription);
    Html.AddMetaKeywordParts(Model.MetaKeywords);
    //page class



    Html.AppendPageCssClassParts("html-category-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var categoryUrl = Url.RouteUrl("KwTerm", new { SeName = Model.SeName }, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant();
        Html.AddCanonicalUrlParts(categoryUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }

    var breadcrumbDelimiter = commonSettings.BreadcrumbDelimiter;

    #region filter display
    var hidefilter = false;
    var displayFilters = false;
    if (!_workcontext.IsMobileDevice())
    {
        if (Model.CatalogProductsModel.SpecificationFilter.Attributes.Count == 0)
            hidefilter = true;

        if (Model.CatalogProductsModel.SpecificationFilter.Attributes.Where(m => m.Values.Where(m => m.Selected).Count() > 0).Any())
            displayFilters = true;
    }

    ViewBag.hidefilter = hidefilter.ToString();
    ViewBag.displayFilters = displayFilters.ToString();
    ViewBag.EnableInfiniteScroll = Model.EnableInfiniteScroll.ToString();
    #endregion
}
<script>
var pageSize='@Model.CatalogProductsModel.PageSize';
</script>
@*category breadcrumb*@
@section Breadcrumb
    {
    @if (Model.DisplayCategoryBreadcrumb)
    {
<nav aria-label="breadcrumb">
    <ol class="breadcrumb" itemscope itemtype="http://schema.org/BreadcrumbList">
        @{
            int position = 1;
        }
        <li class="breadcrumb-item">
            <span itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                <a href="@Url.RouteUrl("Homepage")" itemprop="item">
                    <span  itemprop="name">@T("Categories.Breadcrumb.Top")</span>

                </a>
                <meta itemprop="position" content="@position" />
            </span>
        </li>



        @{position++;}

        @foreach (var cat in Model.KwTermBreadcrumb)
        {
            var isLastCategory = cat.Id == Model.Id;
            <li itemprop="itemListElement" class="breadcrumb-item active" itemscope itemtype="http://schema.org/ListItem">
                @if (isLastCategory)
                {
                    <strong class="current-item" itemprop="name">@cat.Name</strong>
                    <span itemprop="item" itemscope itemtype="http://schema.org/Thing"
                          id="@Url.RouteUrl("Category", new { id = cat.Id, SeName = cat.SeName })">
                    </span>
                }
                else
                {
                    <a href="@Url.RouteUrl("Category", new { id = cat.Id, SeName = cat.SeName })" title="@cat.Name" itemprop="item">
                        <span itemprop="name">@cat.Name</span>
                    </a>
                }
                <meta itemprop="position" content="@position" />
                @{position++;}
            </li>

                    }

    </ol>
</nav>
        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.CategoryDetailsAfterBreadcrumb, additionalData = Model })
                    }
}



<div class="page category-page">

    @section Heading{
        <div class="version1 categorypage-heading-section">
            <h1 class="page-heading">@(Model.Name)</h1>
           
        </div>
    }



    <div class="page-body">










      


        @section CatalogSelector {
            @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.CategoryDetailsAfterFeaturedProducts, additionalData = Model })
            @await Html.PartialAsync("_CatalogSelectors", Model.CatalogProductsModel)
        }
        @if (_workcontext.IsMobileDevice())
        {
            @section SelectedtFilters {
                @await Html.PartialAsync("_SelectedtFilters", Model.CatalogProductsModel)
            }
        }


        @{ var catalogProductsViewData = new ViewDataDictionary(ViewData);

            catalogProductsViewData["fetchUrl"] = Html.Raw(Url.Action("GetCustomKwTermProducts", "KwTerm", new { kwTermid = Model.Id }));
            catalogProductsViewData["entityId"] = Model.Id;
        }
        @await Html.PartialAsync("_CatalogProducts-FilterOnTop-3x3", Model.CatalogProductsModel, catalogProductsViewData)

        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.CategoryDetailsBeforeFeaturedProducts, additionalData = Model })








        @await Component.InvokeAsync("BestSellerByCategoryBlock", new { categoryId = Model.Id })




        @*description*@
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class=" shop-by-category about-buffet">
              
                <div class="category-description" @if (Model.Description.Length > 500) { <text> style="height:250px;overflow:hidden" </text> }>
                    @Html.Raw(Model.Description)
                </div>
                @if (Model.Description.Length > 500)
                {
                    <div class="w-100 text-right">
                        <a href="#" id="lessmore" data-more-text="@T("Button.More")" data-less-text="@T("Button.Less")">@T("Button.More")&nbsp;<i class="fas fa-angle-down"></i></a>
                    </div>
                }
            </div>
        }


        @section categoryBottom {
            @*//Related Search*@

            @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.CategoryDetailsBottom, additionalData = Model })
            @await Component.InvokeAsync("RecommendationProductsBlock", new { categoryId = Model.Id })

            @*recently  products*@
            @await Component.InvokeAsync("Custom_RecentlyViewedProductsBlock")
        }



    </div>
</div>
