@model ProductOverviewModel
@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax
@inject CatalogSettings catalogSettings
@inject IWorkContext _workContext
@{ 
    string offerText = CommonHelper.GetProductOfferText(Model.Id, Model.ProductPrice.OfferText, Model.ProductPrice.OfferPlaceHolder, Model.ProductPrice.DiscountAmount, Model.ProductPrice.DiscountPercentage, Model.ProductPrice.SaleEndDate, false);
    var addtowishlistlink = Url.RouteUrl("AddProductToCart-Catalog", new
    {
        productId = Model.Id,
        shoppingCartTypeId = (int)ShoppingCartType.Wishlist,
        quantity = 1,
        iswishlist = true
    }); }
<div data-productid="@Model.Id" data-isSimilarProduct="@Model.IsSimilarProduct">
    <div class="cat-img">
        @*Tags*@
        <div class="Tags">
            @if (Model.Tags != null)
            {
                foreach (var tag in Model.Tags)
                {
<div class="@tag.Name">@tag.Name</div>break;
}
}
        </div>

        <a href="@Url.RouteUrl("Product", new {id=Model.Id, SeName = Model.SeName })" title="@Model.DefaultPictureModel.Title">
            <img alt="@Model.DefaultPictureModel.AlternateText" src="/images/pixel.png" Width="415" height="415" 
                 data-src="@Model.DefaultPictureModel.ImageUrl"
                 default-pic="@Model.DefaultPictureModel.ImageUrl" alt-pic="@(Model.AlternatePictureModel==null?"":Model.AlternatePictureModel.ImageUrl)"
                 title="@Model.DefaultPictureModel.Title" class="lazy" style="width:100%;height:auto;" />
        </a>
        <div class="wishlist-icon" data-toggle="tooltip" data-placement="top" title="Add to Wishlist" data-wishlistid="@Model.Id" onclick="AjaxCart.addproducttocart_catalog('@addtowishlistlink');return false;">
            <i class="far fa-heart" alt="Add to Wishlist"></i>
        </div>
    </div>
    @*<div class="shade d-flex">
        <img src="images/Black.jpg" alt="image">
        <img src="images/Dark-Natural.jpg" alt="image">
        <img src="images/Espresso.jpg" alt="image">
        <img src="images/Mahogany.jpg" alt="image">
        <img src="images/Natural.jpg" alt="image">
        </div>*@

    @if (Model.Attribute != null)
    {
@if (Model.Attribute.Count > 0)
{
<div class="shade d-flex shadesSection">
    @{ var shadeAttributes = _workContext.IsMobileDevice() ? (Model.Attribute.Count > 4 ? Model.Attribute.Take(4) : Model.Attribute) : Model.Attribute;

        foreach (var attr in shadeAttributes)
        {
            if (string.IsNullOrEmpty(attr.PictureUrl))
            {
                <a href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">
                    <img src="/images/shades/Squareimage/@(attr.Name).jpg" data-id="@Model.Id" alt="@attr.Name"  height="44" width="44">
                </a>
            }
            else
            {
                <img src="/images/shades/Squareimage/@(attr.Name).jpg" data-id="@Model.Id" pic-url="@(attr.PictureUrl==""?Model.DefaultPictureModel.ImageUrl:attr.PictureUrl)" alt="@attr.Name"  height="44" width="44">
            }
        }
        if (_workContext.IsMobileDevice() && Model.Attribute.Count > 4)
        {
            <a class="more-stain-btn" href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">
                +more
            </a> } }
</div>}}
    <h3>
        <a href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">@Model.Name</a>
    </h3>
    @*Size Shade aggregation*@

    @if (!string.IsNullOrEmpty(Model.SizeShadeMessage))
    {
        <h4 class="size-shade-aggregation">
            @{
                var attrs = Model.SizeShadeMessage.Split('|', StringSplitOptions.RemoveEmptyEntries);
                foreach (var attr in attrs)
                {
                    <a href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">
                        @attr
                    </a>
                }
            }
        </h4>
    }

    @if (Model.ProductPrice.IsVariantProduct)
    {


@if (!string.IsNullOrEmpty(Model.ProductPrice.MinMembershipPrice))
{
<h4 class="price actual-price">
    @T("Label.RegularPrice")
    @T("Price.Range",
         !string.IsNullOrEmpty(Model.ProductPrice.MinOldPrice) ? Model.ProductPrice.MinOldPrice : Model.ProductPrice.MinPrice,
         !string.IsNullOrEmpty(Model.ProductPrice.MaxOldPrice) ? Model.ProductPrice.MaxOldPrice : Model.ProductPrice.MaxPrice)
</h4>
                    <h5 class="price old-price">
                        @T("Label.MembershipPrice")
                        @T("Price.Range", Model.ProductPrice.MinMembershipPrice, Model.ProductPrice.MaxMembershipPrice)
                    </h5> }
                else
                {
@if (Model.ProductPrice.MinOldPriceValue > 0 && Model.ProductPrice.MinPriceValue > 0 && Model.ProductPrice.MinOldPriceValue != Model.ProductPrice.MinPriceValue)
{
    if (!string.IsNullOrEmpty(Model.ProductPrice.OfferText))
    {
<p class="sale-price  m-0">@Html.Raw(offerText)</p> }

<h4 class="price actual-price sale-price">
    @T("Price.Range.With.Saleprice",
        !string.IsNullOrEmpty(Model.ProductPrice.MinPrice) ? Model.ProductPrice.MinPrice : Model.ProductPrice.MinOldPrice,
        !string.IsNullOrEmpty(Model.ProductPrice.MaxPrice) ? Model.ProductPrice.MaxPrice : Model.ProductPrice.MaxOldPrice,
        !string.IsNullOrEmpty(Model.ProductPrice.MinOldPrice) ? Model.ProductPrice.MinOldPrice : Model.ProductPrice.MinPrice,
        !string.IsNullOrEmpty(Model.ProductPrice.MaxOldPrice) ? Model.ProductPrice.MaxOldPrice : Model.ProductPrice.MaxPrice
        )
</h4> }
else
{
if (!string.IsNullOrEmpty(Model.ProductPrice.OfferText))
{
<p class="sale-price  m-0">@Html.Raw(offerText)</p> }
<h4 class="price actual-price">
    @T("Price.Range",
        !string.IsNullOrEmpty(Model.ProductPrice.MinOldPrice) ? Model.ProductPrice.MinOldPrice : Model.ProductPrice.MinPrice,
        !string.IsNullOrEmpty(Model.ProductPrice.MaxOldPrice) ? Model.ProductPrice.MaxOldPrice : Model.ProductPrice.MaxPrice)
</h4>}} }
else
{
@if (!string.IsNullOrEmpty(Model.ProductPrice.MembershipPrice))
{
<h4 class="price actual-price">@T("Label.RegularPrice")@(!string.IsNullOrEmpty(Model.ProductPrice.OldPrice) ? Model.ProductPrice.OldPrice : Model.ProductPrice.Price)</h4>
                    <h5 class="price old-price">@T("Label.MembershipPrice")@Model.ProductPrice.MembershipPrice</h5> }
                else
                {
@if (Model.ProductPrice.OldPriceValue > 0 && Model.ProductPrice.PriceValue > 0 && Model.ProductPrice.OldPrice != Model.ProductPrice.Price)
{
    if (!string.IsNullOrEmpty(Model.ProductPrice.OfferText))
    {
<p class="sale-price  m-0">@Html.Raw(offerText)</p> }
<h4 class="price actual-price">
    <p class="sale-price">@Model.ProductPrice.Price<span class="suggested-price">@Model.ProductPrice.OldPrice</span></p>
</h4> }
else
{
if (!string.IsNullOrEmpty(Model.ProductPrice.OfferText))
{
<p class="sale-price  m-0">@Html.Raw(offerText)</p> }
<h4 class="price actual-price">
    @(
                        !string.IsNullOrEmpty(Model.ProductPrice.OldPrice) ? Model.ProductPrice.OldPrice : Model.ProductPrice.Price
                        )
</h4>}}}


</div>



<script asp-location="Footer">
         $(".category.product-card.out-of-stock a").click(function (e) {
             e.preventDefault();
            })
    function AddEmailToList(productId) {
        var validRegex = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$/;
        if (!$("#user-subscription-email-"+productId).val().match(validRegex)) {
            $("#user-subscription-email-" + productId).focus();
            return;
        }

        var _formdata = new URLSearchParams();
        _formdata.append('ProductId', productId);
        _formdata.append('email', $('#user-subscription-email-' +productId).val());

        var tokenInput = $('input[name=__RequestVerificationToken]');
        if (tokenInput.length) {
            _formdata.append('__RequestVerificationToken', tokenInput.val());
        }
        $(".dispaly-Status-" + productId +" .Success").hide();
        $(".dispaly-Status-" + productId +" .Error").hide();

        $.ajax({
            url: '@(Url.ActionLink("BackInStockSubscription", "Product"))',
            type: 'POST',
            data: _formdata,
            async: true,
            processData: false,  // Important! Don't process the data
            contentType: false,
            success: function (data) {
			    $("#user-subscription-email-" + productId).val("");
                $(".dispaly-Status-" + productId + " .Success").show().html(data);
                $(".dispaly-Status-" + productId + " .Error").hide();
            },
            error: function (xhr) {
                console.log(xhr);
                $(".dispaly-Status-" + productId +" .Success").hide();
                $(".dispaly-Status-" + productId + " .Error").show().html(xhr.responseText);

            }
        });
    }
</script>