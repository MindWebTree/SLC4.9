@model SpecificationFilterModel
@using System.Linq;

@{
    int noOfFiltersToShow = 5;
}


<script>
    var filterAttr = '@string.Join( ",",Model.Attributes.Select(m=>m.Name.ToLower().Trim()).ToArray())';

</script>
<div class="horizontalfilter_section d-md-flex align-items-center w-100">
    @await Html.PartialAsync("_AjaxFilterSpecsBoxHorizontal", Model)
</div>

<div class="modal fade left" id="filterModal" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="popupfilterheading">
                    <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                    <h4 class="modal-title">@T("Txt.Category.AllFilters")</h4>
                </div>
                <div class="buttons">
                    <button type="button" class="btncancel">@T("Button.cancel")</button>
                    <button type="button" class="btnapply">@T("Button.Apply")</button>
                </div>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_AjaxFilterSpecsBoxPopup", Model)
            </div>
        </div>
    </div>
</div>


<script asp-location="Footer">
    //$(document).ready(function () {
    //    var $optionPopupEls = $('[popup-data-option-id]');
    //    $optionPopupEls.on('change', function () {
    //        var optionId = $(this).attr("popup-data-option-id");
