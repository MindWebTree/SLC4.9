                                    </svg>
                                </div>
                                <div class="multiple_attachment_image">
                                    <div class="preview-item new">
                                        <input name="attachment[]" class="form-control-file" multiple accept="@uploadTypes_Expression" type="file" />
                                    </div>
                                </div>
                                <div class="add-image-icon desable">
                                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M0.75 7.5H6V12.75C6 12.9489 6.07902 13.1397 6.21967 13.2803C6.36032 13.421 6.55109 13.5 6.75 13.5C6.94891 13.5 7.13968 13.421 7.28033 13.2803C7.42098 13.1397 7.5 12.9489 7.5 12.75V7.5H12.75C12.9489 7.5 13.1397 7.42098 13.2803 7.28033C13.421 7.13968 13.5 6.94891 13.5 6.75C13.5 6.55109 13.421 6.36032 13.2803 6.21967C13.1397 6.07902 12.9489 6 12.75 6H7.5V0.75C7.5 0.551088 7.42098 0.360322 7.28033 0.21967C7.13968 0.0790178 6.94891 0 6.75 0C6.55109 0 6.36032 0.0790178 6.21967 0.21967C6.07902 0.360322 6 0.551088 6 0.75V6H0.75C0.551088 6 0.360322 6.07902 0.21967 6.21967C0.0790178 6.36032 0 6.55109 0 6.75C0 6.94891 0.0790178 7.13968 0.21967 7.28033C0.360322 7.42098 0.551088 7.5 0.75 7.5Z" fill="#BDBDBD" />
                                    </svg>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="col-12 ">
                        <div class="form-group">
                            <label>@T("Customizationform.label.message")</label>
                            <nop-textarea asp-for="@Model.Message" placeholder="Add Your Special Notes Here " />
                            <span asp-validation-for="@Model.Message"></span>
                        </div>
                    </div>
                    <div class="col-12 ">
                        <div class="customize-form-consent-section">
                            <input id="consent1" class="custom-control-input" name="consent1" type="checkbox" /> <label class="custom-control-label consent-label gdprconsent" for="consent1">By checking this box, I consent to receive SMS messages from <strong>Sierra Living Concepts</strong> regarding customizations at the phone number provided. Message frequency may vary. Data rates may apply. Text <strong>HELP</strong> to <a href="tel:5109964499">510-996-4499</a> for assistance. Reply <strong>STOP</strong> to opt out.</label>
                        </div>
                    </div>
                    </div>
                    <div class="customize-submit-btn-captcha">
                        @if (Model.DisplayCaptcha)
                        {
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-12 col-sm-8 offset-md-4 offset-lg-4 offset-xl-4">
                                        <nop-captcha class="g-recaptcha" />
                                    </div>
                                </div>
                            </div>
                        }
                        <button type="submit" name="addtocartbutton" class="btn btn-secondary" id="btnsubmitcustomizationform">
                            <span> @T("forum.submit")</span>
                            <svg width="20" height="20" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff" class="d-none" style=" width: 20px;">
                                <g fill="none" fill-rule="evenodd">
                                    <g transform="translate(1 1)" stroke-width="2">
                                        <circle stroke-opacity=".5" cx="18" cy="18" r="18" />
                                        <path d="M36 18c0-9.94-8.06-18-18-18">
                                            <animateTransform attributeName="transform"
                                                              type="rotate"
                                                              from="0 18 18"
                                                              to="360 18 18"
                                                              dur="1s"
                                                              repeatCount="indefinite" />
                                        </path>
                                    </g>
                                </g>
                            </svg>
                        </button>
                    </div>
                    <div class="alert alert-danger d-none" role="alert">
                    </div>
</form>
        </div>
    </div>


    <script type="text/javascript">
    $(document).ready(function () {
        const btnId = '#btnsubmitcustomizationform';
        const form = $("#CustomizationForm");

            $('#CustomizationForm').on('submit', function (e) {
            e.preventDefault();
            $.validator.unobtrusive.parse(form);
            form.validate();

            if (!form.valid()) return;
            if ($("#consent1").length > 0) {
                if (!$("#consent1").prop("checked")) {
                    $(".customize-form-consent-section").addClass("invalid");
                    $("#consent1").focus();
                    return;
                }
                else {

                    $(".customize-form-consent-section").removeClass("invalid");
                }
            }
            // Clear previous validation errors
            clearValidationErrors();

            // Custom Validations
            if (!validateInputs()) return;

            $(btnId).prop("disabled", true).find("span").addClass("d-none");
            $(btnId).find("svg").removeClass("d-none");
            $(".customization-form-body .alert-danger").html("").addClass("d-none");

            const formData = new FormData(form[0]);

            $.ajax({
                url: form.attr("action"),
                type: 'POST',
                data: formData,
                async: true,
                cache: false,
                contentType: false,
                processData: false,
                success: function (data) {
                    handleSuccess(data);
                },
                error: function (xhr) {
                    handleError(xhr);
                }
            });
        });

        function clearValidationErrors() {
            const fields = ['Phone'];
            fields.forEach(field => {
                $(`#CustomizationForm #${field}`).removeClass("input-validation-error");
                $(`#CustomizationForm span[data-valmsg-for='${field}']`).html('');
            });
        }

        function validateInputs() {
            const phone = $("#CustomizationForm #Phone").val().trim();

            if (phone && !validatePhoneNumber(phone)) {
                showValidationError('Phone', '@T("Account.Fields.Phone.NotValid")');
                return false;
            }
            return true;
        }

        function showValidationError(field, message) {
            $(`#CustomizationForm #${field}`).addClass("input-validation-error");
            $(`#CustomizationForm span[data-valmsg-for='${field}']`).addClass("field-validation-error").html(`<span>${message}</span>`);
        }

        function handleSuccess(data) {
            if (data.Success) {
                // Your Google Ads tracking logic here
                $(".customization-form-body").html(data.content);
            } else {
               
                $(".customization-form-body .alert-danger").removeClass("d-none").html(data.content);
            }
            resetButtonState();
        }

        function handleError(xhr) {
           
            $(".customization-form-body .alert-danger").removeClass("d-none").html(xhr);
            resetButtonState();
        }

        function resetButtonState() {
            $(btnId).prop("disabled", false).find("span").removeClass("d-none");
            $(btnId).find("svg").addClass("d-none");
        }

        function validatePhoneNumber(phoneNumber) {
            const regex = /^[0-9]{3}-[0-9]{3}-[0-9]{4}$/;
            return regex.test(phoneNumber);
        }

        // Phone Input Masking
        $("body").on("keyup paste", "#CustomizationForm #Phone", function () {
            const input = this.value.replace(/[^0-9\(\)\s\-]/g, "");
            let newval = "";

            const numbers = input.replace(/\D/g, '');
            for (let i = 0; i < numbers.length; i++) {
                if (i === 0) newval = numbers[i];
                else if (i === 3 || i === 6) newval += "-" + numbers[i];
                else newval += numbers[i];
            }
            $(this).val(newval.substring(0, 12));
        });
    });
    </script>

