@model Nop.Web.Models.Customizations.Custom.CustomizationFormModel;
@inject Nop.Services.Configuration.ISettingService _settingService
@{
    string uploadTypes_Expression = await _settingService.GetSettingByKeyAsync<string>("Customizationform.Supported.UploadTypes.Expression");
}
<div class="modal-content desktop-customize-form">
    <button type="button" class="close dialog-close-btn border" data-bs-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
    <div class="modal-header">
        <div class="modal-header-text">
            <h2>@T("Customizationform.Version2.heading")</h2>
            <p>@T("Customizationform.Version2.Description")</p>
        </div>

    </div>
    <div class="modal-body d-flex  customizationformBody">
