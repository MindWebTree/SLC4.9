                <input type="hidden" asp-for="@Model.Dimensions" />
                <input type="hidden" asp-for="@Model.ProductName" />
                <input type="hidden" id="DefaultPicture" name="DefaultPicture" value="@Model.DefaultPictureModel.ImageUrl">
                <div class="row">

                    <div class="col-12 form-group checkasterisk">
                        <label>@T("Customizationform.label.Name")</label>
                        <nop-editor asp-for="@Model.FullName" />
                        <span asp-validation-for="@Model.FullName"></span>
                    </div>
                    <div class="col-6 form-group checkasterisk">
                        <nop-label asp-for="@Model.Email" />*
                        <nop-editor asp-for="@Model.Email" />
                        <span asp-validation-for="@Model.Email"></span>
                    </div>
                    <div class="col-6 form-group">
                        <div>
                            <label>@T("Customizationform.label.mobile")</label>
                            <nop-editor asp-for="@Model.Phone" id="Phone" />
                            <span asp-validation-for="@Model.Phone"></span>
                        </div>
                    </div>
                    <div class="col-12 ">
                        <div class="attachment">
                            <label>@T("customizationform.fields.attachment")</label>
                            <label class="image-attachment-error">@T("customizationform.Image.Validity.Error")</label>
                            <div class="image-upload">
