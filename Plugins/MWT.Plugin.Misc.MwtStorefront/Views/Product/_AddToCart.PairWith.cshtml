@model List<CustomProductDetailsModel>
@using Nop.Core.Domain.Orders
@inject Nop.Services.Directory.ICurrencyService _currencyService;
@inject ICustomWorkContext _workContext;
@{
    var addtoCartFormId = ViewData["addtocartform"].ToString();
    string refFormId = addtoCartFormId.Replace("#", "").Replace("-", "_").Split('?')[0];
    string productIds = "";
    foreach (var product in Model)
    {
        productIds += "-" + product.Id;
    }
}
<!-- Removed As Per Karan Sir <div class="add-to-cart">
    <button type="button" id="add-to-cart-button-pairwith-@Model.FirstOrDefault().Id" class="button-2 btn btn-primary add-to-cart-button btn btn-secondary pairwith-addtocart" data-productid="@Model.FirstOrDefault().Id">@T("ShoppingCart.AddToCart")</button>
</div>--->


<script asp-location="Footer">
    var pairWithUrl = '@Url.RouteUrl("CustomAddProductToCart-Collections", new {formId=refFormId,isFbt=false, productIds = productIds, shoppingCartTypeId = (int) ShoppingCartType.ShoppingCart})';

    $(".pairwith-addtocart").click(function () {

        var isFormValid = true;
        $("#product-details-pairwith .variants select,#product-details-pairwith .variants input").each(function (index, element) {

            var elementselected = false;

            if ($(element).prop('nodeName') == "INPUT" && $(element).attr('type') == "radio") {

                if ($("input[name='" + $(element).attr("name") + "']:checked").length > 0) {
                    elementselected = true;

                }

            }
            else if ($(element).prop('nodeName') == "INPUT" && ($(element).attr('type') == "text" || $(element).attr('type') == "number")) {

                if ($(element).val() != "") {
                    elementselected = true;

                }

            }
            else if ($(element).val() != "" && $(element).val() != "0") {
                elementselected = true;
            }

            if (!elementselected) {
                isFormValid = false;

                var top = $(element).parent().offset().top;

                $('html, body').animate({
                    scrollTop: top
                }, 2000);
                return false;
            }
        });
        if (isFormValid) {
          processPairWithProductInfo();
            AjaxCart.addproducttocart_details(pairWithUrl, '#product-details-pairwith');
        }
    });

</script>