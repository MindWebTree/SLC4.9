                                </svg>
                                View in 3D
                            </div>
                        }
                        <img alt="@Model.DefaultPictureModel.AlternateText" height="840" width="840" src="@Model.DefaultPictureModel.ImageUrl"
                             title="@Model.DefaultPictureModel.Title"
                             id="main-product-img-@Model.Id" />
                        <div class="overlay-text">
                            @T("Product.Dimension.Overlay.Text")
                        </div>

                    </a>
                }

                else

                {
                    <img class="lazy" alt="@Model.DefaultPictureModel.AlternateText" height="840" width="840" src="/images/pixel.png" data-src="@Model.DefaultPictureModel.ImageUrl" title="@Model.DefaultPictureModel.Title" id="main-product-img-@Model.Id" />
                }
            </div>


            @await Html.PartialAsync("_socialShare", Model)

            @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ProductDetailsAfterPictures, additionalData = Model })
        </div>
    </div>
</div>



@if (Model.DefaultPictureZoomEnabled)

{
    <script asp-location="Footer">
        document.addEventListener("DOMContentLoaded", function () {
            MagicZoom.start('product-magiczoom');
        });
    </script>
}
@if (!string.IsNullOrEmpty(Model.ARImageUrl))

{
    <div id="ifArImageContainer">

        <div class="ifArImage">
            @if (!string.IsNullOrEmpty(Model.ARHeading))

            {
                <div class="ar-content" style="display:none;">@Html.Raw(Model.ARHeading)</div>
            }
            <iframe id="ifArImage" style="width: 100%; height: 100%; border: none;" src="" allowfullscreen></iframe>

            <a id="fullscreenCloseBtn">
                <img src="~/images/icons/close-line-icon.png" style="width:16px;" alt="@Model.DefaultPictureModel.Title">
            </a>
        </div>

    </div>
}
