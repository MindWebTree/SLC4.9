@model ProductDetailsModel
@inject Nop.Services.Configuration.ISettingService _settingService;



<div class="gallery desktop">
    <div class="row">
        @if (Model.PictureModels.Count > 1)

        {


            <div class="col-2">
                <div class="vertical_layout product-sub-images jcarousel">
                    <ul>
                        @{
                            var imgCount = 0;

                            foreach (var picture in Model.PictureModels)

                            {

                                @if (!string.IsNullOrEmpty(Model.VideoUrl) && (imgCount + 1) == Model.VideoThumnailDisplayOrder)
                                {
                                    <li>
                                        <a class="thumb-Video" data-zoom-id="product-video-magiczoom" href="@picture.FullSizeImageUrl"
                                           data-image="@picture.ImageUrl" alt="@picture.AlternateText" title="@picture.Title">
                                            <img data-index="@imgCount" class="lazy" width="100" height="100" src="/images/pixel.png" data-src="@Model.PictureModels[0].ThumbImageUrl"
                                                 alt="@picture.AlternateText" title="@picture.Title" data-video="@Model.VideoUrl" />
                                            <!-- Add a play icon overlay for video thumbnails -->
                                            <div class="video-play-overlay">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                                                    <path d="M8 5v14l11-7z" />
                                                </svg>
                                            </div>
                                        </a>
                                    </li>
                                    imgCount++;

                                }
                                <li>
                                    <a class="thumb-item @(imgCount==0?" img-selected":"") @(picture.IsDimensionImage?"dimension-image":"")" data-zoom-id="product-magiczoom" href="@picture.FullSizeImageUrl"
                                       data-image="@picture.ImageUrl" alt="@picture.AlternateText" title="@picture.Title">
                                        <img data-index="@imgCount" class="lazy" width="100" height="100" src="/images/pixel.png" data-src="@picture.ThumbImageUrl"
                                             alt="@picture.AlternateText" title="@picture.Title" data-defaultsize="@picture.ImageUrl" data-fullsize="@picture.FullSizeImageUrl" />
                                    </a>

                                </li>
                                imgCount++;

                            }
                        }
                    </ul>
                    <a href="#" class="jcarousel-control-prev">
                        <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M11.0092 12.9844C10.7413 12.9848 10.4837 12.8781 10.2948 12.6883L0.22686 2.61565C-0.110617 2.1743 -0.0269527 1.54305 0.4144 1.20558C0.775379 0.929674 1.27595 0.929674 1.63693 1.20558L11.0092 10.5544L20.3674 1.19148C20.8087 0.854002 21.44 0.937665 21.7774 1.37902C22.0534 1.74 22.0534 2.24057 21.7774 2.60155L11.7236 12.6883C11.5347 12.8781 11.2771 12.9848 11.0092 12.9844Z" fill="#4A4A4A" />
                        </svg>
                    </a>
                    <a href="#" class="jcarousel-control-next">
                        <svg width="22" height="13" viewBox="0 0 22 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M11.0092 12.9844C10.7413 12.9848 10.4837 12.8781 10.2948 12.6883L0.22686 2.61565C-0.110617 2.1743 -0.0269527 1.54305 0.4144 1.20558C0.775379 0.929674 1.27595 0.929674 1.63693 1.20558L11.0092 10.5544L20.3674 1.19148C20.8087 0.854002 21.44 0.937665 21.7774 1.37902C22.0534 1.74 22.0534 2.24057 21.7774 2.60155L11.7236 12.6883C11.5347 12.8781 11.2771 12.9848 11.0092 12.9844Z" fill="#4A4A4A" />
                        </svg>
                    </a>
                </div>
                <script asp-location="Footer">

                    $(document).ready(function () {
                        $('.product-sub-images.jcarousel').each(function () {
                            var $carousel = $(this);
                            $carousel.jcarousel({
                                vertical: true,
                                wrap: 'none'
                            });

                            var $prevBtn = $carousel.find('.jcarousel-control-prev');
                            var $nextBtn = $carousel.find('.jcarousel-control-next');

                            function updateButtonVisibility(totalItems, currentIndex) {
                                if (currentIndex > 0) {
                                    $prevBtn.show();
                                } else {
                                    $prevBtn.hide();
                                }


                                if (currentIndex < (totalItems - 6)) {
                                    $nextBtn.show();
                                } else {
                                    $nextBtn.hide();
                                }
                            }


                            $carousel.on('jcarousel:reload jcarousel:scrollend', function () {
                                var totalItems = $carousel.find('li').length;
                                var currentIndex = $carousel.jcarousel('items').index($carousel.jcarousel('visible').first());
                                lazyloadimages();
                                updateButtonVisibility(totalItems, currentIndex);
                            });
                            var totalItems = $carousel.find('li').length;
                            var currentIndex = $carousel.jcarousel('items').index($carousel.jcarousel('visible').first());
                            updateButtonVisibility(totalItems, currentIndex);
                        });

                        $(document).on('click', '.thumb-Video, .thumb-item', function (e) {
                            $("#product-magiczoom .overlay-text").removeClass("show");
                            e.preventDefault();
                            e.stopPropagation();

                            var $clicked = $(this);
                            // var isVideo = $clicked.hasClass('thumb-Video');

                            var videoUrl = $clicked.find('img').data('video');
                            var isVideo = (typeof videoUrl !== 'undefined' && videoUrl !== '');

                            // Clear all selections
                            $('.thumb-item, .thumb-Video').removeClass('img-selected mz-thumb-selected');

                            // Step 2: Add selection to clicked element with small delay
                            setTimeout(function () {
                                $clicked.addClass('img-selected mz-thumb-selected');
                            }, 10);

                            var mainImageContainer = $('#product-magiczoom');

                            if (isVideo) {
                                var videoUrl = $clicked.find('img').data('video');
                                if (videoUrl) {
                                    // stop MagicZoom and clear previous content inside anchor
                                    if (typeof MagicZoom !== 'undefined') { try { MagicZoom.stop('product-magiczoom'); } catch (e) { } }
                                    // Remove previous media containers (video/iframe) for safety
                                    mainImageContainer.find('video, iframe, .auto-video-container').remove();

                                    // Decide embed type
                                    var isDirectFile = /\.(mp4|webm|ogg)(\?|#|$)/i.test(videoUrl);
                                    var html;

                                    if (isDirectFile) {
                                        // Native HTML5 video (best control/compatibility requires muted+playsinline)
                                        html = `
                            <div class="auto-video-container" style="position:relative;width:100%;height:100%;">
                              <video
                                class="auto-video-iframe"
                                src="${videoUrl}"
                                autoplay
                                muted
                                playsinline
                                loop
                                controls
                                preload="metadata"
                                style="width:100%;height:100%;object-fit:cover;">
                              </video>
                            </div>
                          `;
                                    } else {
                                        // Third-party embed (e.g., YouTube/Vimeo) in iframe
                                        var autoSrc = videoUrl + (videoUrl.indexOf('?') > -1 ? '&' : '?') + 'autoplay=1&mute=1';
                                        html = `
                            <div class="auto-video-container" style="position:relative;width:100%;height:100%;">
                              <iframe
                                src="${autoSrc}"
                                class="auto-video-iframe"
                                frameborder="0"
                                allow="autoplay; fullscreen"
                                allowfullscreen
                                style="width:100%;height:100%;border:0;">
                              </iframe>
                            </div>
                          `;
                                    }

                                    // Inject media into the existing anchor
                                    mainImageContainer.html(html);
                                }
                            }
                            else {
                                if ($clicked.find('img').attr("src").indexOf("dimension") > 0) {
                                    $("#product-magiczoom .overlay-text").addClass("show");
                                }

                                if (mainImageContainer.find('video, iframe, .auto-video-container').length > 0) {
                                    // Handle regular image thumbnail
                                    var imageUrl = $clicked.data('image');
                                    var fullSizeUrl = $clicked.attr('href');
                                    var altText = $clicked.attr('alt') || '@Model.DefaultPictureModel.AlternateText';
                                    var title = $clicked.attr('title') || '@Model.DefaultPictureModel.Title';

                                    if (imageUrl) {
                                        // Stop existing zoom
                                        if (typeof MagicZoom !== 'undefined') {
                                            MagicZoom.stop('product-magiczoom');
                                        }

                                        // Restore image in main container with proper zoom link
                                        var imageHtml = '<a href="' + fullSizeUrl + '" title="' + title + '" id="product-magiczoom" class="main-product-image">' +
                                            '<img alt="' + altText + '" height="840" width="840" src="' + imageUrl + '" title="' + title + '" id="main-product-img-@Model.Id" />' +
                                            '</a>';

                                        mainImageContainer.parent().html(imageHtml);

                                        // Re-enable zoom for images
                                        setTimeout(function () {
                                            if (typeof MagicZoom !== 'undefined') {
                                                MagicZoom.start('product-magiczoom');
                                            }
                                        }, 50);
                                    }
                                }
                            }
                        });

                    });


                    var styledAdded = false;
                    var thumbImageClicked = false;
                    function arImageDisplay() {

                        if (!$('.ifArImage').hasClass('ifArImage-visible')) {
                            var $img = $('.mz-figure');
                            var arImageUrl = "@Model.ARImageUrl";
                            if (!styledAdded) {
                                $("#ifArImage").attr("src", arImageUrl);
                                if ($(".ar-content").length > 0) {
                                    $(".ar-content").show();
                                }
                            }
                            var imgWidth = $img.width();
                            var imgHeight = $img.height();
                            if (!styledAdded) {
                                styledAdded = true;
                                $('.ifArImage').css({
                                    'max-width': imgWidth + 'px',
                                    'height': imgHeight + 'px'
                                });
                            }



                        }

                        $('.ifArImage').addClass("ifArImage-visible");
                        $("a.thumb-item").removeClass("mz-thumb-selected");
                        $(".thumb360-container a").addClass("mz-thumb-selected");
                    }

                    $(document).ready(function () {
                        $('.product-sub-images img').on('click', function () {

                            $(".thumb-item").removeClass("img-selected");
                            $(".thumb-item").removeClass("mz-thumb-selected");
                            $(this).parent().addClass("mz-thumb-selected");
                            $(this).parent().addClass("img-selected");
                        });
                    });

                    $("#openFullscreen").click(function (event) {
                        var $img = $('.mz-figure');
                        var arImageUrl = "@Model.ARImageUrl";
                        if (!styledAdded) {
                            $("#ifArImage").attr("src", arImageUrl);
                            if ($(".ar-content").length > 0) {
                                $(".ar-content").show();
                            }
                        }
                        var imgWidth = $img.width();
                        var imgHeight = $img.height();
                        if (!styledAdded) {
                            styledAdded = true;
                            $('.ifArImage').css({
                                'max-width': imgWidth + 'px',
                                'height': imgHeight + 'px'
                            });
                        }
                        $('.ifArImage').addClass("ifArImage-visible");
                        event.preventDefault();
                        $("#ifArImageContainer").addClass("fullscreen-iframe");
                        $("body").addClass("zoom360");
                        $("#fullscreenCloseBtn").show();
                        $("#openFullscreen").hide();
                    });
                    $("#fullscreenCloseBtn").click(function (event) {
                        event.preventDefault();
                        $('.ifArImage').removeClass("ifArImage-visible");
                        $("#ifArImageContainer").removeClass("fullscreen-iframe");
                        $("body").removeClass("zoom360");
                        $("#fullscreenCloseBtn").hide();
                        $("#openFullscreen").show();
                    });



                </script>

            </div>
        }

        <div class="@(Model.PictureModels.Count > 1?"col-10":"col-12")">
            @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.ProductDetailsBeforePictures, additionalData = Model })
            <div class="picture">
                @*Tags*@


                @if (Model.DefaultPictureZoomEnabled)

                {

                    <a href="@Model.DefaultPictureModel.FullSizeImageUrl" title="@Model.DefaultPictureModel.Title" id="product-magiczoom" class="main-product-image">
                        @if (!string.IsNullOrEmpty(Model.ARImageUrl))

                        {
                            <div id="openFullscreen">

                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M11.9994 22.7508C11.9394 22.7508 11.8794 22.7408 11.8294 22.7308C11.7694 22.7208 11.7094 22.6908 11.6494 22.6608L9.43938 21.5608C9.06938 21.3708 8.91937 20.9208 9.09937 20.5508C9.28937 20.1808 9.73938 20.0308 10.1094 20.2108L11.2494 20.7808V19.2208C11.2494 18.8108 11.5894 18.4708 11.9994 18.4708C12.4094 18.4708 12.7494 18.8108 12.7494 19.2208V20.7808L13.8894 20.2108C14.2594 20.0308 14.7094 20.1808 14.8994 20.5508C15.0894 20.9208 14.9394 21.3708 14.5594 21.5608L12.3494 22.6608C12.2894 22.6908 12.2294 22.7108 12.1694 22.7308C12.1094 22.7408 12.0594 22.7508 11.9994 22.7508ZM18.6694 19.4208C18.3994 19.4208 18.1294 19.2708 17.9994 19.0108C17.8094 18.6408 17.9594 18.1908 18.3394 18.0008L20.1494 17.1008V14.7908C20.1494 14.3808 20.4894 14.0408 20.8994 14.0408C21.3094 14.0408 21.6494 14.3808 21.6494 14.7908V17.5708C21.6494 17.8508 21.4894 18.1108 21.2394 18.2408L19.0194 19.3508C18.8894 19.3908 18.7794 19.4208 18.6694 19.4208ZM5.32938 19.4208C5.21938 19.4208 5.09937 19.3908 4.99937 19.3408L2.77937 18.2308C2.52937 18.1008 2.36938 17.8408 2.36938 17.5608V14.7808C2.36938 14.3708 2.70938 14.0308 3.11938 14.0308C3.52938 14.0308 3.86938 14.3708 3.86938 14.7808V17.0908L5.67937 17.9908C6.04937 18.1808 6.19937 18.6308 6.01937 19.0008C5.86937 19.2608 5.60938 19.4208 5.32938 19.4208ZM11.9994 14.4208C11.5894 14.4208 11.2494 14.0808 11.2494 13.6708V11.3608L9.43938 10.4608C9.06938 10.2708 8.91937 9.82077 9.09937 9.45077C9.28937 9.08077 9.73938 8.93077 10.1094 9.11077L11.9994 10.0508L13.8894 9.11077C14.2594 8.93077 14.7094 9.07077 14.8994 9.45077C15.0894 9.83077 14.9394 10.2708 14.5594 10.4608L12.7494 11.3608V13.6708C12.7494 14.0808 12.4094 14.4208 11.9994 14.4208ZM20.8894 9.97078C20.4794 9.97078 20.1394 9.63077 20.1394 9.22077V7.66078L18.9994 8.23077C18.6294 8.42077 18.1794 8.27077 17.9894 7.89077C17.7994 7.52077 17.9494 7.07078 18.3294 6.88078L19.2094 6.44078L18.3294 6.00077C17.9594 5.81077 17.8094 5.36078 17.9894 4.99078C18.1794 4.62078 18.629