@model CustomProductOverviewModel
@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax
@inject CatalogSettings catalogSettings
@inject MWT.Nop.Core.Infrastructure.ICustomWorkContext _workContext
@{
    var addtowishlistlink = Url.RouteUrl("AddProductToCart-Catalog", new
    {
        productId = Model.Id,
        shoppingCartTypeId = (int)ShoppingCartType.Wishlist,
        quantity = 1,
        iswishlist = true
    });
}
<div class="category product-card out-of-stock">
    <div data-productid="@Model.Id" data-isSimilarProduct="@Model.IsSimilarProduct">
        <div class="cat-img out-of-stock-blur">
            @*Tags*@
            <div class="Tags">
                @if (Model.Tags != null)
                {
                    foreach (var tag in Model.Tags)
                    {
                        <div class="@tag.Name">@tag.Name</div>
                        break;
                    }
                }
            </div>

            <a href="@Url.RouteUrl("Product", new {id=Model.Id, SeName = Model.SeName })" aria-label="@Model.DefaultPictureModel.Title">
                <div class="image-container out-of-stock" ">
                    <img alt="" src="/images/pixel.png"
                         data-src="@Model.DefaultPictureModel.ImageUrl"
                         default-pic="@Model.DefaultPictureModel.ImageUrl" alt-pic="@(Model.AlternatePictureModel==null?"":Model.AlternatePictureModel.ImageUrl)"
                          class="lazy" width="100%" />

                    <div class="sold-out-text">@T("Label.SoldOut")</div>
                </div>
            </a>
            <div class="wishlist-icon" role="button" tabindex="0" data-toggle="tooltip" data-placement="top" title="Add to Wishlist" data-wishlistid="@Model.Id" onclick="AjaxCart.addproducttocart_catalog('@addtowishlistlink');return false;">
                <i class="far fa-heart" alt="Add to Wishlist"></i>
            </div>
        </div>
        <div class="@(Model.Inventory <= 0 ? "out-of-stock-blur" : "")">


        @if (Model.Attribute != null)
        {
            @if (Model.Attribute.Count > 0)
            {
                    <div class="shade d-flex shadesSection">
                    @{
                        var shadeAttributes = _workContext.IsMobileDevice() ? (Model.Attribute.Count > 4 ? Model.Attribute.Take(4) : Model.Attribute) : Model.Attribute;

                        foreach (var attr in shadeAttributes)
                        {
                            if (string.IsNullOrEmpty(attr.PictureUrl))
                            {
                                    <a href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">
                                        <img src="/images/shades/Squareimage/@(attr.Name).jpg" data-id="@Model.Id"
                                             alt="Available in @attr.Name Shade">
                                    </a>
                            }
                            else
                            {
                                    <img src="/images/shades/Squareimage/@(attr.Name).jpg"
                                     tabindex="0" role="button" 
                                     data-id="@Model.Id"
                                    pic-url="@(attr.PictureUrl==""?Model.DefaultPictureModel.ImageUrl:attr.PictureUrl)"
                                         alt="Available in @attr.Name Shade">
                            }
                        }
                        if (_workContext.IsMobileDevice() && Model.Attribute.Count > 4)
                        {
                                <a href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">
                                    +
                                </a>
                        }
                    }
                    </div>
            }           }
            <h3>
                <a href="@Url.RouteUrl("Product", new {id=Model.Id,SeName = Model.SeName})">@Model.Name</a>
            </h3>
        @if (!string.IsNullOrEmpty(Model.SizeShadeMessage))
        {
                <h4 class="size-shade-aggregation">

                @{
                    var attrs = Model.SizeShadeMessage.Split('|', StringSplitOptions.RemoveEmptyEntries);
                    foreach (var attr in attrs)
                    {
                            <span> @attr</span>
                    }
                }

                </h4>
        } @*end*@

            @await Html.PartialAsync("_ListingPrice", Model)
        </div>

        <span class="label-notify-me p-1 m-1">Notify Me When Available</span>
        <div class="out-of-stock-message">
            <div class="notify-me row-cols-12">
                <input type="text" autocomplete="off" id="user-subscription-email-@Model.Id" aria-label="Enter Your Email" placeholder="Enter Your Email Address" class="notify-me-input col-11" />
                <br />
                <button class="notify-me-button col-11" onclick="AddEmailToList(@Model.Id)">@T("backinstocksubscriptions.notifyme")</button>
                <p class="stock-subscription-section dispaly-Status-@Model.Id">
                    <span class="Success" style="display: none; color:green;">@T("Common.Success.Message")</span>
                    <span class="Error" style="display: none; color: red;">@T("Common.Error.Message")</span>
                </p>
            </div>
        </div>

    </div>
</div>



