@model OnePageCheckoutModel
@using Nop.Core
@using Nop.Services.Customers
@using Nop.Core.Domain.Seo
@inject IWebHelper webHelper
@inject IWorkContext workContext
@inject ICustomerService _customerService
@inject Nop.Services.Localization.ILocalizationService  _localizationService
@inject Nop.Core.Domain.Customers.CustomerSettings _customerSettings
@inject SeoSettings seoSettings
@{ Layout = "_ColumnsOne_Checkout";

    //scripts

    Html.AddScriptParts(ResourceLocation.Head, "~/js/customizations/public.custom.accordion.js?version=2");
    Html.AddScriptParts(ResourceLocation.Head, "~/js/customizations/public.Custom.onepagecheckout.js?version=126");

    var storeLocation = webHelper.GetStoreLocation();

    //title
    Html.AddTitleParts(T("PageTitle.Checkout").Text);
    //page class
    Html.AppendPageCssClassParts("html-checkout-page");
    if (seoSettings.CanonicalUrlsEnabled)
    {
        Html.AddCanonicalUrlParts(Url.RouteUrl("CheckoutOnePage", null, webHelper.GetCurrentRequestProtocol()).ToLowerInvariant(), false);
    } }
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCxJavVrIvirKKh4iwR-hxhC5gfQjFmcDI&libraries=places&v=weekly" defer></script>
<script>

    var phoneNumberValidationRule = '@_customerSettings.PhoneNumberValidationRule';
    var phoneValidationError='@await _localizationService.GetResourceAsync("Account.Fields.Phone.NotValid")';
    var emailValidationError='@await _localizationService.GetResourceAsync("Common.WrongEmail")';
</script>
@{ //step numbers
    var userDetaisStepNumber = 1;
    var shippingAddressStepNumber = 2;
    var shippingMethodStepNumber = 3;
    var paymentMethodStepNumber = 4;
    var confirmOrderStepNumber = 5;
    if (!Model.ShippingRequired)
    {
        paymentMethodStepNumber = paymentMethodStepNumber - 1;
        confirmOrderStepNumber = confirmOrderStepNumber - 1;
    } }
<div class="page  checkout-pages">
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.OpcContentBefore })
    <div class="row d-flex justify-content-center">
        <div class="progress-bar-wrapper">
            <ul class="checkout-steps" id="checkout-steps">
                <li>
                    <a href="@Url.RouteUrl("ShoppingCart")">

                        @T("opc.Breadcrumb.Cart")
                    </a>
                </li>
                <li id="opc-customerinfo" class="step-title allow">
                    <span class="bullet"></span>

                    <h4>@T("opc.Breadcrumb.ShippingAddress") </h4>
                </li>
                <li id="opc-shipping_method" class="step-title @(Model.StepActive=="#opc-shipping_method" || Model.StepActive=="#opc-payment_method"?"allow":"")">
                    <span class="bullet"></span>
                    @*<span class="completed"><img src="/images/tick.svg" /></span>
                        <span class="processing"><img src="/images/checkout-processing.svg" /></span>*@
                    <h4>@T("opc.Breadcrumb.deliveryoptions")</h4>
                </li>
                <li id="opc-payment_method" class="step-title @( Model.StepActive=="#opc-payment_method"?"allow":"")" ">
                    <span class="bullet"></span>
                    @*<span class="completed"><img src="/images/tick.svg" /></span>
                        <span class="processing"><img src="/images/checkout-processing.svg" /></span>*@
                    <h4>@T("opc.Breadcrumb.Payment")</h4>
                </li>
            </ul>
        </div>
    </div>
    <div class="row sections">
        <div class="col-6">
            @* step1*@
            <div id="checkout-step-customerinfo" class="step a-item" data-section-id="opc-customerinfo" style="display: none;">

                <form id="co-customerinfo-form">
                    <div id="checkout-customerinfo-load">
                        @await Html.PartialAsync("OpccustomerInfo", Model.AddressModel)
                    </div>

                </form>
                <button name="save" type="button" class="checkoutdesktopbtn customerinfobtn button-1 button-2 btn btn-primary new-address-next-step-button" onclick="customerInfo.save(true)">@T("Common.Continue")</button>
                <script asp-location="Footer">
                    customerInfo.init('#co-customerinfo-form', '@(storeLocation)checkout/OpcSaveCustomerInfo/',
        @((await _customerService.IsGuestAsync(await workContext.GetCurrentCustomerAsync())).ToString().ToLowerInvariant()));
                </script>

            </div>

            @* step1 end*@


            @*Step 2*@
            <script>
                         Shipping.init('#co-shipping-form', '@(storeLocation)checkout/OpcCustomSaveShipping/','@(storeLocation)checkout/GetTaxByZipCode/');
            </script>
            @*step2 end*@

            @*Step3*@

            <div id="checkout-step-shipping-method" class="step a-item" data-section-id="opc-shipping_method" style="display: none;">

                <form id="co-shipping-method-form" action="">
                    <div id="checkout-shipping-method-load">
                        @if (Model.StepActive == "#opc-shipping_method" || Model.StepActive == "#opc-payment_method")
                        {
                            ViewData["ShippingAddress"] = Model.AddressModel;
            @await Html.PartialAsync("OpcShippingMethods", Model.CheckoutShippingMethodModel) } @*shipping methods content will be loaded here*@
                    </div>
                    <script asp-location="Footer">
                        var localized_data = {
                            NotAvailableMethodsError: "@T("ShippingMethod.NotAvailableMethodsError")",
                            SpecifyMethodError: "@T("ShippingMethod.SpecifyMethodError")"
                        };
                        ShippingMethod.init('#co-shipping-method-form', '@(storeLocation)checkout/OpcCustomSaveShippingMethod/', localized_data);
                    </script>
                    <button type="button" class="checkoutdesktopbtn btn btn-primary button-1 new-address-next-step-button" onclick="ShippingMethod.save()">@T("Common.Continue")</button>
                </form>
            </div>

            @*step 3 end*@

            @*Step4*@
            <div id="checkout-step-payment-method" class="step a-item" data-section-id="opc-payment_method" style="display: none;">

                <form action="" id="co-payment-method-form">
                    <div id="checkout-payment-method-load">
                        @if (Model.StepActive == "#opc-payment_method")
                        {
                           @await Html.PartialAsync("OpcPaymentMethods", Model.CheckoutPaymentMethodModel)}
                    </div>
                </form>
                <script asp-location="Footer">
                    var localized_data = {
                        NotAvailableMethodsError: "@T("PaymentMethod.NotAvailableMethodsError")",
                        SpecifyMethodError: "@T("PaymentMethod.SpecifyMethodError")"
                    };
                    PaymentMethod.init('#co-payment-method-form', '@(storeLocation)checkout/OpcCustomSavePaymentInfo/', localized_data,
                        '@(storeLocation)checkout/OpcCustomLoadBillingAddres/',
                        '@(storeLocation)checkout/OpcCustomSaveBilling/', '#co-billing-form', '@Url.RouteUrl("CheckoutCompleted")');
                </script>
                <div class="term-conditions">
                    <label class="custom-control-label" style="    margin: 20px 0 0px;">
                        @T("Checkout.TermsOfService.IAccept")
                    </label>
                </div>
                <button name="save" type="button" class="checkoutdesktopbtn customerinfobtn button-1 button-2 btn btn-primary payment-info-next-step-button" onclick="PaymentMethod.save()">@T("checkout.placeyourorder")</button>

            </div>


            <div id="checkout-step-billing" class="step a-item" data-section-id="opc-billing" data-parent-section-id="opc-payment-method" style="display:none;">
                <div class="row">
                    <div class="backpage">
                        <a onclick="PaymentMethod.backtoparent(this); return false;" data-anchor-section-id="checkout-step-billing" data-anchor-parent-section-id="checkout-step-payment-method">
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="11" height="11" viewBox="0 0 256 256" xml:space="preserve">

<g transform="translate(128 128) scale(0.72 0.72)" style="">
                            <g style="stroke: none; stroke-width: 0; stroke-dasharray: none; stroke-linecap: butt; stroke-linejoin: miter; stroke-miterlimit: 10; fill: none; fill-rule: nonzero; opacity: 1;" transform="translate(-175.05 -175.05000000000004) scale(3.89 3.89)">
                            <path d="M 65.75 90 c 0.896 0 1.792 -0.342 2.475 -1.025 c 1.367 -1.366 1.367 -3.583 0 -4.949 L 29.2 45 L 68.225 5.975 c 1.367 -1.367 1.367 -3.583 0 -4.95 c -1.367 -1.366 -3.583 -1.366 -4.95 0 l -41.5 41.5 c -1.367 1.366 -1.367 3.583 0 4.949 l 41.5 41.5 C 63.958 89.658 64.854 90 65.75 90 z" style="stroke: none; stroke-width: 1; stroke-dasharray: none; stroke-linecap: butt; stroke-linejoin: miter; stroke-miterlimit: 10; fill: rgb(0,0,0); fill-rule: nonzero; opacity: 1;" transform=" matrix(1 0 0 1 0 0) " stroke-linecap="round" />
</g>
</g>
</svg>@T("OPC.BACKToPayment")
</a>
</div>
</div>

<form action="" id="co-billing-form">
    <div id="checkout-billing-load">
        @*billing address content will be loaded here*@
    </div>
</form>
<button type="button" class="checkoutdesktopbtn checkoutdesktopbillingbtn btn btn-primary button-1 new-address-next-step-button" onclick="PaymentMethod.save_Billing()">@T("Common.Continue")</button>
</div>
@*step4 end*@


</div>
<div class="col-6">
    <div class="order-summary-section">
        @await Component.InvokeAsync("CheckoutOrderSummary", new { isEditable = false, isConfirmationPage = (Model.StepActive == "#opc-payment_method" ? true : false) })
    </div>
</div>
</div>

@await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.OpcContentAfter })
<script asp-location="Footer">


        Accordion.init('checkout-steps', '.step-title', '@T("Common.Continue")', '@T("checkout.placeyourorder")', true);
        Accordion.openSection('@Model.StepActive', true);
        Checkout.init('@(storeLocation)cart/', '@T("Common.Continue")', '@T("checkout.placeyourorder")');
        //$('input', 'form').blur(function () {
        //   $(this).valid();
        //});
        $(document).on('blur', 'form input,form textarea,form select', function () {
            $(this).valid();
        });
        $(document).on('focusout', 'form input,form textarea,form select', function () {
            $(this).valid();
        });

    $(document).ready(function () {

        $('body').on('click', ".shipping-section-price-info", function () {
 
            $(this).find('input[type="radio"]').prop('checked', true).trigger("change");
        });
            $('.checkoutprocessingModel').show();

            setTimeout(function () {

                $('.checkoutprocessingModel').hide();
            }, 1000);

        });
        $(document).on('click', '.checkoutmobilebtn', function () {
            $(".checkout-pages .a-item").each(function (index) {
                if ($(this).is(":visible")) {
                    $(this).find("button").click();
                }
            });
        });
    $(document).on('click', '#toggle-summary-view .title-items', function () {
            $(".order-summary-wrapper .block-content").toggleClass("active");
            $(".order-summary-wrapper").toggleClass("active");
            $(this).find(".down-arrow").toggleClass("active");
         /*   $(".order-summary-wrapper .block-title .total-price").toggleClass("hidelement");*/
        });
        $(document).on('click', '.checkout-pages .close-icon', function () {
            $(this).parent().hide();
        });


</script>
</div>

<div class="modal fade" id="paymenterror-modal" tabindex="-1" aria-labelledby="paymenterrormodal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered max-width-900">
        <div class="modal-content">

            <div class="modal-body p-5 d-flex flex-column justify-content-center align-items-center">
                <div class="text-center">

                    <svg fill="#000" width="50px" viewBox="0 0 24.00 24.00" xmlns="http://www.w3.org/2000/svg" data-name="Layer 1" stroke="#000000" stroke-width="0.00024000000000000003"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M8.36,15.33a1,1,0,0,0-.13,1.4,1,1,0,0,0,1.41.13,3.76,3.76,0,0,1,4.72,0,1,1,0,0,0,.64.23,1,1,0,0,0,.64-1.76A5.81,5.81,0,0,0,8.36,15.33Zm.85-4.79a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41,3.08,3.08,0,0,0-4.24,0,1,1,0,1,0,1.41,1.41A1,1,0,0,1,9.21,10.54ZM12,2A10,10,0,1,0,22,12,10,10,0,0,0,12,2Zm0,18a8,8,0,1,1,8-8A8,8,0,0,1,12,20ZM17.62,9.13a3.08,3.08,0,0,0-4.24,0,1,1,0,0,0,1.41,1.41,1,1,0,0,1,1.42,0,1,1,0,0,0,1.41,0A1,1,0,0,0,17.62,9.13Z"></path></g></svg>
                </div>

                <h2 class="text-center fw-normal payment_failed fw-bold mt-4">@T("Payment.Decline.Heading")</h2>
            
 <div class="text-center fw-semibold p-font mt-4 errormessage" data-message="@T("Common.Payment.Error.Message.Default")">@T("Common.Payment.Error.Message.Default")</div>
                <button type="button" class="btn btn-primary pay_now mt-4 p-2 pay-now-btn" data-bs-dismiss="modal">@T("Payment.Decline.Popup.Button")</button>

                <h4 class="having-trouble-font-size mt-4">

                    @T("Common.Payment.Error.Call.Action")

                </h4>


            </div>

        </div>
    </div>
</div>

<div class="checkoutprocessingModel">
    <div class="modal-dialog modal-dialog-centered" style="display:none">
        <div class="modal-content">
            <div class="modal-body p-5">
                <h1 class="text-center fw-bold order_processing">@T("Order.Processing.Heading")</h1>
                <h3 class="text-center fw-normal font-size mt-3">@T("Order.Processing.SubHeading")</h3>
                <svg width="60" height="60" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg" stroke="#000" class="mt-5">
                    <g fill="none" fill-rule="evenodd">
                        <g transform="translate(1 1)" stroke-width="2">
                            <circle stroke-opacity=".5" cx="18" cy="18" r="18"></circle>
                            <path d="M36 18c0-9.94-8.06-18-18-18">
                                <animateTransform attributeName="transform" type="rotate" from="0 18 18" to="360 18 18" dur="1s" repeatCount="indefinite"></animateTransform>
                        </g>
                    </g>
                </svg>
            </div>
        </div>
    </div>
    <svg width="60" height="60" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg" stroke="#fff" class="loading">
        <g fill="none" fill-rule="evenodd">
            <g transform="translate(1 1)" stroke-width="2">
                <circle stroke-opacity=".5" cx="18" cy="18" r="18"></circle>
                <path d="M36 18c0-9.94-8.06-18-18-18">
                    <animateTransform attributeName="transform" type="rotate" from="0 18 18" to="360 18 18" dur="1s" repeatCount="indefinite"></animateTransform>
            </g>
        </g>
    </svg>
</div>

@*Loading Model*@
