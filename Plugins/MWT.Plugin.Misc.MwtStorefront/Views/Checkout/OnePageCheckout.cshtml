@if (TempData["Affirm.Error"] != null)
{
<div class="modal fade" id="paymentErrorModel">
    <div class="modal-dialog modal-dialog-centered paymentErrorModel">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-center w-100" id="exampleModalLabel">Error</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.Raw(TempData["Affirm.Error"])
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Return to the Merchant</button>
            </div>
        </div>
    </div>
</div>

                <script asp-location="Footer">

                    document.addEventListener("DOMContentLoaded", function () {
                        setTimeout(function () {
                            const merchantModal = new bootstrap.Modal(document.getElementById("paymentErrorModel"));
                            merchantModal.show();
                        }, 1000); // Delay of 1 second
                    });

                </script>}