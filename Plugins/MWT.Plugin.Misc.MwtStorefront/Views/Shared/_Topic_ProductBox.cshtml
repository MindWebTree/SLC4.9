@model CustomProductOverviewModel
@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax
@inject CatalogSettings catalogSettings
@inject ICustomWorkContext workContext
@inject ICustomSpecificationAttributeService _specificationAttributeService

<div data-productid="@Model.Id" data-main-catid="@await _specificationAttributeService.GetMainCategoryOfProduct(Model.Id)">
    @{
        var utm = ViewData["Utm"] as string;
        var target = ViewData["target"] as string;
    }


        @*Tags*@
        <div class="Tags">

            @if (Model.Tags != null)
            {
                foreach (var tag in Model.Tags)
                {
                    <div class="@tag.Name">@tag.Name</div>
                    break;
                }
            }
        </div>
    <a target="@target" href="@Url.RouteUrl("Product", new { id = Model.Id, SeName = Model.SeName, utm_source = utm })" aria-label="@Model.DefaultPictureModel.Title">
        <img alt="" style="width:100%; height:auto;" width="415" height="415" src="/images/pixel.png" data-src="@Model.DefaultPictureModel.ImageUrl" title="@Model.DefaultPictureModel.Title" class="lazy" />
    </a>
    @*@if (ViewBag.Type == null)
        {*@
    <h3 class="product-title">
        <a target="@target" href="@Url.RouteUrl("Product", new { id = Model.Id, SeName = Model.SeName, utm_source = utm })">@Model.Name</a>
    </h3>

    @Html.Partial("_ListingPrice", Model)




</div>



