@using MWT.Plugin.Misc.MwtStorefront.Components
@using Nop.Web.Components
@using Nop.Web.Framework.Infrastructure
 

@inject MWT.Nop.Core.Infrastructure.ICustomWorkContext _customWorkContext ;

@await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.HeaderBefore })

<!-- Seema : 13-01-2022: Added new container and modify the location of search box-->
<div class="container">
    <div class="header-lower logo-section">
        <div class="row align-items-center mx-0">
            @if (!_customWorkContext.IsMobileDevice())
            {
                <div class="col-2 d-none d-lg-block desktop-device">
                    @await Component.InvokeAsync(typeof(MWT.Plugin.Misc.MwtStorefront.Components.SearchBoxViewComponent))
                </div>
            }

            <!-- Seema Mobile Menu Hamburger Icon -->
            <div class="col-1 col-sm-1 col-md-1 d-lg-none d-xl-none px-0">
                <div class="mobile-menu-icon navbar-toggler">
                    <button type="button" data-bs-toggle="collapse" data-bs-target="#mobilenavbarContent" aria-controls="navbars" aria-expanded="false" aria-label="navigations" class="navbar-toggler"> <span class="navbar-toggler-icon"></span> </button>
                </div>
            </div>



            <div class="col-1 col-sm-1 col-md-1 d-lg-none d-xl-none px-0 mobile-search-icon">
                <a href="#"
    role="button"
    tabindex="0"
    aria-label="Search" class="search-trigger-icon">
                    <svg width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg" class="open">
                        <path d="M19.7266 17.2913L15.832 13.3971C15.6562 13.2214 15.418 13.1237 15.168 13.1237H14.5312C15.6094 11.7449 16.25 10.0107 16.25 8.12421C16.25 3.63636 12.6133 0 8.125 0C3.63672 0 0 3.63636 0 8.12421C0 12.6121 3.63672 16.2484 8.125 16.2484C10.0117 16.2484 11.7461 15.6079 13.125 14.5298V15.1665C13.125 15.4165 13.2227 15.6547 13.3984 15.8305L17.293 19.7246C17.6602 20.0918 18.2539 20.0918 18.6172 19.7246L19.7227 18.6193C20.0898 18.2521 20.0898 17.6584 19.7266 17.2913ZM8.125 13.1237C5.36328 13.1237 3.125 10.8896 3.125 8.12421C3.125 5.36276 5.35937 3.12469 8.125 3.12469C10.8867 3.12469 13.125 5.35885 13.125 8.12421C13.125 10.8857 10.8906 13.1237 8.125 13.1237Z" fill="#444444" fill-opacity="1"></path>
                    </svg>

                  
                </a>
            </div>

            <!--- end -->

            <div class="logo col-8 col-sm-8 col-md-8">
                <div class="header-logo"> 
                    @await Component.InvokeAsync(typeof(LogoViewComponent))
                </div>
            </div>

            <div class="col-1 col-sm-1 col-md-1 d-lg-none d-xl-none px-0 mobile-wishlist-icon">
                <a href="/wishlist" id="mobile-wishlist" aria-label="wishlist">

                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M17.3666 3.84168C16.941 3.41585 16.4356 3.07805 15.8794 2.84758C15.3232 2.61711 14.727 2.49849 14.1249 2.49849C13.5229 2.49849 12.9267 2.61711 12.3705 2.84758C11.8143 3.07805 11.3089 3.41585 10.8833 3.84168L9.99994 4.72501L9.1166 3.84168C8.25686 2.98193 7.0908 2.49894 5.87494 2.49894C4.65908 2.49894 3.49301 2.98193 2.63327 3.84168C1.77353 4.70142 1.29053 5.86748 1.29053 7.08334C1.29053 8.2992 1.77353 9.46527 2.63327 10.325L3.5166 11.2083L9.99994 17.6917L16.4833 11.2083L17.3666 10.325C17.7924 9.89938 18.1302 9.39402 18.3607 8.83781C18.5912 8.28159 18.7098 7.68542 18.7098 7.08334C18.7098 6.48127 18.5912 5.8851 18.3607 5.32888C18.1302 4.77267 17.7924 4.26731 17.3666 3.84168V3.84168Z" stroke="#444444" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>

                </a>
            </div>

            <div class="col-md-1 col-sm-1 col-1 col-lg-2 align-items-end d-flex justify-content-end header-right-links">
                @await Component.InvokeAsync(typeof(HeaderLinksViewComponent))

            </div>
        </div>


        <div class="mobile-call-chat">
            <a href="tel: 1-866-864-8488" class="mobile-call-btn">
                <svg width="40" height="auto" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">

                    <path d="M37.2866 30.6656L31.8179 28.3218C31.5843 28.2223 31.3246 28.2013 31.078 28.262C30.8315 28.3228 30.6113 28.462 30.4507 28.6587L28.0288 31.6177C24.2279 29.8256 21.169 26.7668 19.377 22.9659L22.3359 20.544C22.533 20.3837 22.6726 20.1635 22.7333 19.9168C22.7941 19.6701 22.7729 19.4103 22.6729 19.1768L20.3291 13.7081C20.2193 13.4563 20.0251 13.2508 19.78 13.1269C19.5348 13.003 19.2542 12.9685 18.9863 13.0293L13.9082 14.2012C13.65 14.2608 13.4196 14.4062 13.2547 14.6137C13.0897 14.8211 12.9999 15.0783 13 15.3433C13 27.8677 23.1514 37.9996 35.6562 37.9996C35.9213 37.9997 36.1787 37.91 36.3862 37.7451C36.5937 37.5801 36.7392 37.3497 36.7988 37.0914L37.9707 32.0132C38.0312 31.7441 37.996 31.4623 37.8711 31.2163C37.7463 30.9704 37.5396 30.7756 37.2866 30.6656Z" fill="#444444" style="
                color: #444;
            "></path>
                </svg> 1-866-864-8488
            </a>
            <a href="#" id="chatdiv" aria-label="chat">
                <svg width="40" height="auto" viewBox="0 0 50 50" fill="#808080" xmlns="http://www.w3.org/2000/svg">

                    <path d="M34.875 13H16.125C14.4014 13 13 14.4014 13 16.125V30.1875C13 31.9111 14.4014 33.3125 16.125 33.3125H20.8125V37.4141C20.8125 37.8926 21.3594 38.1709 21.7451 37.8877L27.8438 33.3125H34.875C36.5986 33.3125 38 31.9111 38 30.1875V16.125C38 14.4014 36.5986 13 34.875 13Z" fill="#444444"></path>
                </svg> Chat With Us
            </a>
        </div>




        <!-- Seema : 14-01-2022: created and call new topic foe sub header menu-->
        @await Component.InvokeAsync("Custom_TopicBlock", new { systemName = "Subheader.menu" })
    </div>
</div>


