@model CustomProductOverviewModel
@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax
@inject CatalogSettings catalogSettings
@inject IWorkContext workContext
@inject ICustomSpecificationAttributeService _specificationAttributeService

@{
    string offerText = CustomCommonHelper.GetProductOfferText(Model.Id, Model.ProductPrice.OfferText, Model.ProductPrice.OfferPlaceHolder, Model.ProductPrice.DiscountAmount, Model.ProductPrice.DiscountPercentage, Model.ProductPrice.SaleEndDate, false);

}
<div data-productid="@Model.Id" data-main-catid="@await _specificationAttributeService.GetMainCategoryOfProduct(Model.Id)">
    <a href="@Url.RouteUrl("Product", new {id=Model.Id, SeName = Model.SeName })" title="@Model.DefaultPictureModel.Title">
        @*Tags*@
        <div class="Tags">

            @if (Model.Tags != null)
            {
                foreach (var tag in Model.Tags)
                {
<div class="@tag.Name">@tag.Name</div>                    break;
                }
            }
        </div>
        <img alt="@Model.DefaultPictureModel.AlternateText" style="width:100%; height:auto;" width="415" height="415" src="@Model.DefaultPictureModel.ImageUrl"
		title="@Model.DefaultPictureModel.Title" class="" />
    </a>
