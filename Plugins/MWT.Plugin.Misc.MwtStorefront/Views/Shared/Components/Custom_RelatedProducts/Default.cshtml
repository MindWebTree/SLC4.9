

@model IList<CustomProductOverviewModel>
@if (Model.Count > 0)
{
    <div aria-labelledby="people-viewed-section-heading" role="region" class="shop-by-category new-this-week people-viewed-section">
        <h2 id="people-viewed-section-heading" >@T("Products.PeopleViewed")</h2>
        <div class="people-viewed">
            @foreach (var item in Model)
            {
                @await Html.PartialAsync("_home_ProductBox", item)
            }
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('.people-viewed').slick({
                dots: true,
                infinite: false,
                speed: 300,
                slidesToShow: 4,
                slidesToScroll: 1,
                variableWidth: false,
                centerMode: false,
                centerPadding: '0',

                prevArrow: '<button class="slide-arrow prev-arrow" aria-label="arrow"><i class="fas fa-chevron-left"></i></button>',
                nextArrow: '<button class="slide-arrow next-arrow" aria-label="arrow"><i class="fas fa-chevron-right"></i></button>',
                responsive: [
                    {
                        breakpoint: 1199,
                        settings: {
                            centerMode: false,
                            centerPadding: '40px',
                            slidesToShow: 3
                        }
                    },
                    {
                        breakpoint: 767,
                        settings: {
                            centerMode: false,
                            centerPadding: '40px',
                            dots: false,
                            slidesToShow: 2
                        }
                    },
                    {
                        breakpoint: 480,
                        settings: {
                            centerMode: false,
                            centerPadding: '40px',
                            dots: false,
                            slidesToShow: 1
                        }
                    }
                ]
            });
                   $('.people-viewed').on('init reInit setPosition breakpoint', function () {
                $(this).find('.prev-arrow').attr('aria-label', 'Previous');
                $(this).find('.next-arrow').attr('aria-label', 'Next');
            });
        });
    </script>
}

