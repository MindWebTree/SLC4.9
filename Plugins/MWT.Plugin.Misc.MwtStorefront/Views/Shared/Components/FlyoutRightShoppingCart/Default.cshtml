    var settingValue = await _settingServce.GetSettingByKeyAsync<string>("MarketingSettings.ShowBuymoreSavemoreBanner");
    bool showBuymoreSavemoreBanner = false;
    bool.TryParse(settingValue, out showBuymoreSavemoreBanner);
    bool disableConversion = await _settingService.GetSettingByKeyAsync<bool>("Disable.Addtocart.Desktop.Conversion");
    bool disableMobileConversion = await _settingService.GetSettingByKeyAsync<bool>("Disable.Addtocart.Mobile.Conversion");
    string queryStringKey = await _settingService.GetSettingByKeyAsync<string>("Disable.Addtocart.Conversion,QueryString");
