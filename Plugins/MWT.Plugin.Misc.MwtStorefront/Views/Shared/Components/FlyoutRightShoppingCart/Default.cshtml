<script type="text/javascript">
    function validateAndUpdateQuantity(cartId, obj, event, url) {
        const quantity = parseInt($(`#itemquantity${cartId}`).val());
     
        if (isNaN(quantity) || quantity <= 0) {
            return false;
        }
        AjaxCart.updateCartQuantity(url, quantity);
        return false;
    }
    function deleteItem(cartId, obj, event, url) {
        event.preventDefault();
        $(obj).find(".deleteItem").hide();
        $(obj).find(".minicart-processing").show();
        AjaxCart.deleteCartItem(url, '#product-details-form');
        return false;
    }


    document.addEventListener("DOMContentLoaded", function () {
        addSlickSlider();
        $("#cartpopupmodel").on("hidden.bs.modal", function () {
            $(".add-to-cart-button").removeClass("active");
        });
        $('body').on('show.bs.modal', '#cartpopupmodel', function () {
            if ($(".complete-images").hasClass("slick-slider")) {
                addSlickSlider(true);
            }
            else {
                addSlickSlider(false);
            }
        });
    });
    function addSlickSlider(isSlickAdded) {
        console.log(isSlickAdded);
        console.log($(".complete-images")[0]);
        if ($(".complete-images")[0]) {
            if (!isSlickAdded) {

                $('.complete-images').slick({
                    dots: false,
                    arrows: true,
                    infinite: true,
                    speed: 300,
                    slidesToShow: 3,
                    slidesToScroll: 1,
                    variableWidth: false,
                    centerMode: false,
                    centerPadding: '0',
                    prevArrow: '<button class="slide-arrow prev-arrow"><img src="/images/uploaded/f-arrow.svg" alt="Previous" /></button>',
                    nextArrow: '<button class="slide-arrow next-arrow"><img src="/images/uploaded/f-arrow.svg" alt="next" /></button>',
                    responsive: [
                        {
                            breakpoint: 991,
                            settings: {
                                centerMode: false,
                                centerPadding: '40px',
                                slidesToShow: 3
                            }
                        },
                        {
                            breakpoint: 767,
                            settings: {
                                centerMode: false,
                                centerPadding: '40px',
                                dots: false,
                                slidesToShow: 2
                            }
                        },
                        {
                            breakpoint: 480,
                            settings: {
                                centerMode: false,
                                centerPadding: '40px',
                                dots: false,
                                slidesToShow: 2
                            }
                        }
                    ]
                });
                lazyloadimages();
                setTimeout(function () { $('.complete-images').resize(); }, 200);
            }
            else {
                setTimeout(function () { $('.complete-images').resize(); lazyloadimages(); }, 200);
            }
        }
		else{
		 lazyloadimages();
		}
    }
</script>