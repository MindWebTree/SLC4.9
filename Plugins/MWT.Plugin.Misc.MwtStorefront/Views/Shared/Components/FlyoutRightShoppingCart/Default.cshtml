<script>
    function isMobile() {
        const regex = /Mobi|Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i;
        return regex.test(navigator.userAgent);
    }

    function isQueryStringExist(queryStringKey) {

        return window.location.search.match(queryStringKey);
    }

    if ('@Model.Heading.ToLower()' == '.item.add') {
        //
        var allowConversion = true;
        var device = "";
        var referrer = ""
        var userAgent = "";
        var opr = "";
        var queryStringKey = '@queryStringKey';
        if ('@disableConversion' == 'True' || '@disableMobileConversion' == 'True') {
            try {

                device = isMobile() ? "Mobile" : "Desktop";
                referrer = document.referrer == null ? "" : document.referrer;
                if (referrer == "") {
                    referrer = localStorage.getItem("Last-Visit-Url");
                    referrer = referrer == null ? "" : referrer;
                }
                userAgent = (navigator.userAgent == null ? "" : navigator.userAgent).indexOf("Chrome") > -1 ? "Chrome" : "Other";
                opr = (navigator.appVersion == null ? "" : navigator.appVersion).indexOf("Windows") > -1 ? "Windows" : "Other";



                if (device == "Desktop" && '@disableConversion' == 'True' && (queryStringKey == "" ||
                    isQueryStringExist(queryStringKey))) {
                    if (opr == "Windows" && userAgent == "Chrome" && referrer.indexOf(window.location.host) < 0) {
                        allowConversion = false;
                    }
                }
                else if (device == "Mobile" && '@disableMobileConversion' == 'True' && (queryStringKey == "" ||
                    isQueryStringExist(queryStringKey))) {
                    if (referrer.indexOf(window.location.host) < 0) {
                        allowConversion = false;
                    }
                }


            }
            catch (err) {
                console.log(err);

            }
        }


        if (typeof gtag_addtocart_withoutvalue_report_conversion === "function" && typeof gtag_addtocart_report_conversion === "function" && allowConversion) {

            gtag_addtocart_withoutvalue_report_conversion();
            if (@Model.Items.Count > 0) {
             
                gtag_addtocart_report_conversion('@(Decimal.Parse(Model.Items.FirstOrDefault()?.UnitPrice ?? "0".Replace("\"", ""), NumberStyles.Currency))' * (conversionValue/100), ' ');
            }
        }

    }
</script>

