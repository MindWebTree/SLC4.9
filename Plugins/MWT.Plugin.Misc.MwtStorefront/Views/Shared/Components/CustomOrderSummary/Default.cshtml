@model ShoppingCartModel
@using Nop.Core
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax
@using Nop.Services.Forums
@using Nop.Services.Security
@using Nop.Services.Seo
@using Nop.Services.Topics
@using Nop.Web.Framework.Mvc.Routing
@inject IWebHelper webHelper
@inject IForumService _forumService
@inject IWorkContext workContext
@inject OrderSettings orderSettings
@inject IForumService _forumService
@inject ICustomerExtendedService _customerService
@inject Nop.Services.Configuration.ISettingService _settingService
@inject Nop.Services.Catalog.IPriceFormatter _priceFormatter
@inject Nop.Core.IStoreContext _storeContext
@inject Nop.Core.IWorkContext _workcontext
@inject ICustomWorkContext _customWorkcontext
@inject INopUrlHelper _nopurlHelper;
@{
    bool isMemberShipEnabled = false;
    decimal memberShipFeeValue = 0;
    string memberShipFee = "";
    try
    {
        isMemberShipEnabled = await _settingService.GetSettingByKeyAsync<bool>("ismembershipenabled");
    }
    catch { }

    try
    {
        memberShipFeeValue = await _settingService.GetSettingByKeyAsync<decimal>("MemberShip.Fee");
    }
    catch { }
    memberShipFee = await _priceFormatter.FormatPriceAsync(memberShipFeeValue);
    var customer = await workContext.GetCurrentCustomerAsync();
    bool IsMemberShipAddedInCart = false;
    if (isMemberShipEnabled)
        IsMemberShipAddedInCart = await _customerService.IsMemberShipAddedInCart(customer);

    bool isAuthenticated = false;

    isAuthenticated = await _customerService.IsRegisteredAsync(customer);
    var store = await _storeContext.GetCurrentStoreAsync();

    var returnUrl = Context.Request.Query.TryGetValue("returnUrl", out var url) && !StringValues.IsNullOrEmpty(url.ToString().Trim())
        ? url.ToString()
        : webHelper.GetRawUrl(Context.Request);
}

<div class="order-summary-content">
    @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.OrderSummaryContentBefore })
    @await Html.PartialAsync("_OrderReviewData", Model.OrderReviewData)
    @if (Model.Items.Count > 0)
    {

        if (Model.Warnings.Count > 0)
        {
            <div class="message-error">
                <ul>
                    @foreach (var warning in Model.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }
     @*we add enctype = "multipart/form-data" because "File upload" attribute control type requires it*@
        <form asp-route="ShoppingCart" method="post" enctype="multipart/form-data" id="shopping-cart-form">

            @*Membership Section*@
            @if (isMemberShipEnabled)
            {
                if (!await _customerService.IsCustomerPurchasedMembership(customer))
                {
                    <div class="membershipSection">
                        <div class="row">
                            <div class="col-12">
                                <p class="membershipHeading">@T("Membership.Section.Heading")</p>
                                <p class="membershipdetails">@T((IsMemberShipAddedInCart ? "Membership.Section.Joining.Details" : "Membership.Section.Join.Details"), memberShipFee, Model.MemberShipDiscount.Replace("-", ""))</p>
                                @if (IsMemberShipAddedInCart)
                                {
                                    <button type="submit" name="removemembership" value="@T("Membership.Section.Button.Remove")" class="membership-remove">
                                        @T("Membership.Section.Button.Remove")
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" name="addmembership" value="@T("Membership.Section.Button.Add")" class="membership-remove">
                                        @T("Membership.Section.Button.Add")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="membershipSection">
                        <div class="row">
                            <div class="col-12">
                                <p class="membershipHeading">@T("Membership.Section.Heading")</p>
                                <p class="membershipdetails">@T("Membership.Section.Joined.Details", memberShipFee, Model.MemberShipDiscount.Replace("-", ""))</p>
                            </div>
                        </div>
                    </div>
                }
            }
     @*Membership Section End*@




            <div class="row mt-3">
                <div class="col-12 col-sm-12 col-lg-8">

                    @if (!_customWorkcontext.IsMobileDevice())
                    {
                        <div class="cartitems-heading">
                            <div class="row">
                                <div class="col-6">
                                    @T("ShoppingCart.Your.Cart", Model.Items.Count)
                                </div>
                                <div class="col-6">
                                    @if (!isAuthenticated)
                                    {
                                        @Html.Raw(T("ShoppingCart.Signin.CreateAccount"))
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="table-wrapper panel panel-default">

                            <table class="cart table-wrapper table table-responsive" role="presentation">
                                <colgroup>

                                    <col />
                                    @if (Model.ShowVendorName)
                                    {
                                        <col width="1" />
                                    }
                                    <col width="1" />
                                    <col width="1" />
                                    <col width="1" />

                                </colgroup>
                                <thead>
                                    <tr class="cart-header-row">


                                        <th class="product">
                                            @T("ShoppingCart.Product(s)")
                                        </th>
                                        @if (Model.ShowVendorName)
                                        {
                                            <th class="vendor">
                                                @T("ShoppingCart.VendorName")
                                            </th>
                                        }
                                        <th class="quantity">
                                            @T("ShoppingCart.Quantity")
                                        </th>
                                        <th class="unit-price">
                                            @T("ShoppingCart.UnitPrice")
                                        </th>

                                        <th class="end subtotal">
                                            @T("ShoppingCart.ItemTotal")
                                        </th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr class="cart-item-row">

                                            <td class="product">
                                                <div class="shoppping-cart-left-image">
                                                    <a target="_blank" href="@Url.RouteUrl("Product", new {id=item.ProductId,SeName = item.ProductSeName})"><img alt="@item.Picture.AlternateText" src="@item.Picture.ImageUrl" title="@item.Picture.Title" /></a>

                                                </div>
                                                <div class="shoppping-cart-right-image">
                                                    <a target="_blank" href="@Url.RouteUrl("Product", new {id=item.ProductId,SeName = item.ProductSeName})" class="product-name">@item.ProductName</a>

                                                    @if (!string.IsNullOrEmpty(item.AttributeInfo))
                                                    {
                                                        <div class="attributes">

                                                            @{
                                                                string[] attrs = item.AttributeInfo.Split(new string[] { "<br />" }, StringSplitOptions.None);
                                                                foreach (var attr in attrs)
                                                                {
                                                                    string[] _attrParts = attr.Split(':');
                                                                    <strong>@_attrParts[0]:</strong>
                                                                    @Html.Raw(System.Net.WebUtility.HtmlDecode(string.Join(':', _attrParts.Skip(1))))


                                                                    <br>
                                                                }
                                                            }
                                                        </div>
                                                    }




                                                    @if (!string.IsNullOrEmpty(item.Sku))
                                                    {
                                                        <div class="attributes">
                                                            <strong>  @T("shoppingcart.sku")</strong>  @Html.Raw(item.Sku)
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.RecurringInfo))
                                                    {
                                                        <div class="recurring-info">
                                                            @Html.Raw(item.RecurringInfo)
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.RentalInfo))
                                                    {
                                                        <div class="rental-info">
                                                            @Html.Raw(item.RentalInfo)
                                                        </div>
                                                    }








                                                    @if (item.Warnings.Count > 0)
                                                    {
                                                        <div class="message-error">
                                                            <ul>
                                                                @foreach (var warning in item.Warnings)
                                                                {
                                                                    <li>@Html.Raw(warning)</li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="row">
                                                    <div class="col-12">
                                                        <div id="prd-instruction-@item.Id">
                                                            <div class="card-body p-0">

                                                                <textarea aria-label="@T("shoppingcart.specialinstructions.PlaceHolder")" class="form-control desktop ItemNotes " cols="2" name="itemspecialinstructions@(item.Id)"
                                                              type="text" id="itemspecialinstructions@(item.Id)"
                                                              placeholder="@T("shoppingcart.specialinstructions.PlaceHolder")" rows="2" style="resize:vertical;">@(string.IsNullOrEmpty(item.SpecialInstructions) ? "" : item.SpecialInstructions)</textarea>



                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            @if (Model.ShowVendorName)
                                            {
                                                <td class="vendor">
                                                    <label class="td-title">@T("ShoppingCart.VendorName"):</label>
                                                    <span class="vendor-name">@item.VendorName</span>
                                                </td>
                                            }
                                            <td class="quantity nobr">
                                                <label class="td-title" for="itemquantity@(item.Id)">@T("ShoppingCart.Quantity"):</label>
                                                @if (Model.IsEditable)
                                                {



                                                    <button class="quantity-btn desc" type="button">−</button>
                                                    <input type="text" id="itemquantity@(item.Id)" class="qty-input" name="itemquantity@(item.Id)" aria-label="@T("ShoppingCart.Quantity")" value="@(item.Quantity)">
                                                    <button class="quantity-btn inc" type="button">+</button>
                                                }
                                                else
                                                {
                                                    <span class="product-quantity">@item.Quantity</span>
                                                }
                                                @if (item.DisableRemoval)
                                                {
                                                    <text>&nbsp;</text>
                                                }
                                                else
                                                {

                                                    <a href="@Url.Action("SaveForLater","ShoppingCart",new {cartId=item.Id})" class="ShpSaveForLater"><i class="far fa-heart"></i> @T("shoppingcart.saveforlater") </a>
                                                    <input type="checkbox" name="removefromcart" id="removefromcart@(item.Id)" value="@(item.Id)" aria-label="@T("ShoppingCart.Remove")" />
                                                    <button name="customupdatecart" class="remove-btn" onclick="$('#removefromcart@(item.Id)').attr('checked', true);">
                                                        <i class="far fa-trash-alt"></i>
                                                        @T("admin.common.remove")
                                                    </button>
                                                }
                                            </td>
                                            <td class="unit-price nobr">
                                                <label class="td-title">@T("ShoppingCart.UnitPrice"):</label>
                                                <span class="product-unit-price">@item.UnitPrice</span>
                                            </td>

                                            <td class="subtotal nobr end">
                                                <label class="td-title">@T("ShoppingCart.ItemTotal"):</label>
                                                <span class="product-subtotal">@item.SubTotal</span>

                                                @if (!string.IsNullOrEmpty(item.MemberShipDiscount))
                                                {

                                                    <div class="discount">
                                                        @item.MemberShipDiscount
