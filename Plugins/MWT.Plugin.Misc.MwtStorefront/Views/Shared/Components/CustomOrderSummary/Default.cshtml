                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(item.BuyMoreSaveMoreDiscount))
                                                {
                                                    <div class="discount">
                                                        @Html.Raw(!string.IsNullOrEmpty(item.BuyMoreSaveMoreDiscount) ? item.BuyMoreSaveMoreDiscount : await _priceFormatter.FormatPriceAsync(0))
