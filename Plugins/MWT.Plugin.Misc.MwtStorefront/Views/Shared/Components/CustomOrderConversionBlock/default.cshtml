@model Nop.Web.Models.Customizations.CustomOrder.CustomOrderConversionModel
@inject Nop.Services.Catalog.IProductService _productService
@inject Nop.Services.Customizations.Phone_Order.ICustomOrderService     _customorderService
@{
    var customOrder = await _customorderService.GetByOrderNumber(Model.order.Id);
    if (customOrder.ParentOrderID == 0)
    {

        var products = new List<dynamic>();
        var line_items = new List<dynamic>();
        var index = 0;
        int productId = 0;
        int variantId = 0;

        foreach (var item in Model.Items)
        {
            productId = 0;
            variantId = 0;
            var _prd = await _productService.GetProductBySkuAsync(item.Sku ?? String.Empty);
            if (_prd != null)
            {
                productId = _prd.Id;
                if (!string.IsNullOrEmpty(item.AttributesDescription))
                {
                    variantId = await _productService.GetVariantIdFromAttributeDescription(productId, item.AttributesDescription);
                }
                if (variantId == 0)
                {
                    variantId = (await _productService.GetPublishedProductVariants(productId)).FirstOrDefault()?.VariantId ?? 0;
                }
            }

            var product = new
            {
                product_id = productId,
                item_id = productId + "-" + variantId + "--",
                index = index,
                item_name = item.Name,
                price = decimal.TryParse(item.Total.Replace("$", "").Replace(",", ""), out decimal Price) ? Price : 0,
                quantity = item.Quantity,
                item_variant = variantId
            };
            line_items.Add(new { product_id = productId + "-" + variantId + "--" });
            products.Add(product);
            index++;
        }

        var orderDetails = new
        {

            transaction_id = Model.order.Id,
            affiliation = "Sierra Living Concepts",
            brand = "sierralivingconcepts",
            item_category = " ",
            type = "Sales",
            value = Model.order.OrderTotal,
            shipping = Model.order.OrderShippingExclTax,
            tax = Model.order.OrderTax,
            payment_type = Model.order.PaymentMethodSystemName,
            currency = Model.order.CustomerCurrencyCode,
            items = products,
            send_to = "G-KZS8HKJ18D"
        };

    <script>
        alert("a");
        document.addEventListener("DOMContentLoaded", function () {
            var phoneNumber = '@(Model.ShippingAddress?.PhoneNumber ?? "")';
            phoneNumber = phoneNumber.replace(/ /g, "").replace(/-/g, "");
            var country = '@(Model.ShippingAddress?.CountryName ?? "")';
            var countryCode = country == "" ? "" : "+1";
            phoneNumber = countryCode + phoneNumber;

            //   if (gtag) {



        @*gtag('set', 'user_data', {
