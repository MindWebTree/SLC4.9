            });*@

                // end


                window.dataLayer.push({
                    'event': 'purchase',
                    'ecommerce': {
                        'transaction_id': '@Model.order.Id',
                        'affiliation': 'Sierra Living Concepts',
                        'value': @orderDetails.value,
                        'tax': @Model.order.OrderTax,
                        'shipping': @Model.order.OrderShippingExclTax,
                        'currency': '@Model.order.CustomerCurrencyCode',
                        'payment_type': '@Model.order.PaymentMethodSystemName',
                        'items': @Html.Raw(Json.Serialize(products)),
                        'line_items': @(Html.Raw(Json.Serialize(line_items))),
                        'order_quantity': @(Model.Items.Sum(i => i.Quantity)),
                        'content_ids': productIds,
                    }, 'user_data': {
                        'email': '@Model.order.CustomerEmail',
                        "phone_number": phoneNumber,
                        'address': {
                            "first_name": '@Model.ShippingAddress?.FirstName',
                            "last_name": '@Model.ShippingAddress?.LastName',
                            "street": '@Model.ShippingAddress?.Address1',
