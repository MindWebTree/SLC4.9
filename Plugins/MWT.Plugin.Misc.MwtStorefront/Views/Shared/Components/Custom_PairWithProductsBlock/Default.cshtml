@model List<CustomProductDetailsModel>

<div class="variants">
    <h2>@T("products.group.pairwith.heading")</h2>
    @foreach (var variant in Model)
    {
        <div class="row mx-0">
            <div class="product-details collection-product-variant" data-productid="@variant.Id">
                <div class="custom-left">
                    @if (!string.IsNullOrWhiteSpace(variant.DefaultPictureModel.ImageUrl))
                    {
                        <div class="variant-picture">
                            <a href="@(Url.RouteUrl("Product", new { id=variant.Id, SeName=variant.SeName }))" title="@variant.DefaultPictureModel.Title">
                                <img alt="@variant.DefaultPictureModel.AlternateText" src="@variant.DefaultPictureModel.ImageUrl"
                             title="@variant.DefaultPictureModel.Title" id="main-product-img-@variant.Id" />
                            </a>
                        </div>
                    }
                  
                </div>
                <div class="variant-overview custom-right">
                    @if (!string.IsNullOrWhiteSpace(variant.Name))
                    {
                        <div class="variant-name">
                            <a href="@(Url.RouteUrl("Product", new { id=variant.Id, SeName=variant.SeName }))" title="@variant.DefaultPictureModel.Title">

                                <h2>  @variant.Name</h2>
                            </a>
                        </div>
                    }


                    @if (!string.IsNullOrEmpty(variant.Sku))
                    {
                        <h3 class="sku-pair">
                            @T("Products.Sku") # @variant.Sku
                        </h3>
                    }
                    @await Html.PartialAsync("_DownloadSample", variant)

                    <!--price & add to cart-->
                    @{
                        var dataDictPrice = new ViewDataDictionary(ViewData);
                        dataDictPrice.TemplateInfo.HtmlFieldPrefix = $"price_{variant.Id}";
                        @await Html.PartialAsync("_ProductPrice", variant.ProductPrice, dataDictPrice)
                    }
                    <!--price breaks-->
                    @await Html.PartialAsync("_ProductTierPrices", variant.TierPrices)
                    <!--attributes-->
                    @{
                        if (ViewData["addtocartform"] == null || ViewData["addtocartform"] == "")
                        {
                            ViewData.Add("addtocartform", "#product-details-pairwith");
                        }
                        else
                        {
                            ViewData["addtocartform"] = "#product-details-pairwith";
                        }
                        ViewData["showSelectedAttributeInFront"] = true;
                        var dataDictAttributes = new ViewDataDictionary(ViewData);
                        dataDictAttributes.TemplateInfo.HtmlFieldPrefix = $"attributes_{variant.Id}";
                        @await Html.PartialAsync("_Collection_ProductAttributes", variant, dataDictAttributes)
                        ViewData["showSelectedAttributeInFront"] = null;
                    }


                </div>

                <div class="variant-description description">
                    <div class="product-more-details-link">
                        <a href="@(Url.RouteUrl("Product", new { id=variant.Id,sename=variant.SeName}))">@T("common.moredetails")</a>
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3.33203 8H12.6654" stroke="black" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M8 3.33203L12.6667 7.9987L8 12.6654" stroke="black" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <!--gift card-->
                    @{
                        var dataDictGiftCard = new ViewDataDictionary(ViewData);
                        dataDictGiftCard.TemplateInfo.HtmlFieldPrefix = $"giftcard_{variant.Id}";
                        @await Html.PartialAsync("_GiftCardInfo", variant.GiftCard, dataDictGiftCard)
                    }
                    <!--rental info-->
                    @{
                        var dataDictRental = new ViewDataDictionary(ViewData);
                        dataDictRental.TemplateInfo.HtmlFieldPrefix = $"rental_{variant.Id}";
                        @await Html.PartialAsync("_RentalInfo", variant, dataDictRental)
                    }

                    @{

                        var dataDictAddToCart = new ViewDataDictionary(ViewData);

                        dataDictAddToCart.TemplateInfo.HtmlFieldPrefix = $"addtocart_{variant.Id}";
                        dataDictAddToCart.Add("variantId", variant.DefaultVariantId);
                        @await Html.PartialAsync("_AddToCart", variant.AddToCart, dataDictAddToCart)
                    }
                    @Html.Raw(T("product.coupon.text"))
                    <!--wishlist-->

                </div>

            </div>
        </div>
    }
    @*<div class="row pairs-row-cart">
        <div class="add-to-cart">
            @await Html.PartialAsync("_AddToCart.PairWith", Model)

        </div>
    </div>*@
<script>
    function updatePairWithProductAttributeAvailability(productId) {


        var attributeContainers = $(`#product-details-pairwith div[data-productid="${productId}"] .attributes tr .pairwith_attribute_value_wrapper`);
       
                var currentSelections = {};
        var validCombinationsList = [];

        if (window.productImages && window.productImages[productId]) {
            validCombinationsList = window.productImages[productId];
        }
                attributeContainers.each(function () {
                    var valId = null;
                    var $checkedInput = $(this).find('input[type="radio"]:checked, input[type="checkbox"]:checked');
                    if ($checkedInput.length > 0) {
                        valId = parseInt($checkedInput.val());
                    } else {
                        var $select = $(this).find('select');
                        if ($select.length > 0 && parseInt($select.val()) > 0) valId = parseInt($select.val());
                    }
                    if (valId && !isNaN(valId)) {
                        currentSelections[$(this).attr('id')] = valId;
                    }
                });


                var globalAllowedIds = new Set();
                validCombinationsList.forEach(function (combo) {
                    combo.forEach(function (id) { globalAllowedIds.add(id); });
                });

                // 2. UI Update Loop
                attributeContainers.each(function (index) {
                    var $container = $(this);
                    var $parentRow = $container.closest('tr');
                    var currentContainerId = $container.attr('id');

                    var otherSelectedIds = [];
                    attributeContainers.each(function (i) {
                        if (i < index) {
                            var val = currentSelections[$(this).attr('id')];
                            if (val) otherSelectedIds.push(val);
                        }
                    });

                    var allowedIds = new Set();
                    if (index === 0) {
                        allowedIds = globalAllowedIds;
                    } else {
                        validCombinationsList.forEach(function (combo) {
                            if (otherSelectedIds.every(function (id) { return combo.includes(id); })) {
                                combo.forEach(function (id) { allowedIds.add(id); });
                            }
                        });
                    }

                    var visibleValuesCount = 0;

                    // A. Swatches (FIXED)
                    $container.find('li[data-attr-value]').each(function () {
                        var valId = parseInt($(this).attr('data-attr-value'));
                        var $input = $(this).find('input');

                        var originalName = $input.attr('data-original-name') || $input.attr('name');
                        if (!$input.attr('data-original-name') && originalName) {
                            $input.attr('data-original-name', originalName);
                        }

                        $(this).show(); // always visible

                        if (allowedIds.has(valId)) {
                            $(this).removeClass('unavailable-swatch');
                            $input.prop('disabled', false);
                            if (originalName) $input.attr('name', originalName);
                            visibleValuesCount++; // ✅ ONLY valid
                        } else {
                            $input.prop('checked', false)
                                .removeAttr('checked')
                                .prop('disabled', true)
                                .removeAttr('name');

                            $(this).addClass('unavailable-swatch');
                            $(this).removeClass('selected-value img-selected mz-thumb-selected');
                        }


                    });

                    $container.find('li[data-attr-value]').each(function () {
                        var $checked = $container.find('input:checked:not(:disabled)');

                        if ($checked.length === 0) {
                            var $firstValid = $container.find('input:not(:disabled)').first();

                            if ($firstValid.length > 0) {
                                $firstValid.prop('checked', true).trigger('click');
                                $container.find('li').removeClass('selected-value');
                               $firstValid.closest('li').addClass('selected-value');
                            }
                        }
                    });


                    var $select = $container.find('select');
                    if ($select.length > 0) {
                        var originalSelectName = $select.attr('data-original-name') || $select.attr('name');
                        if (!$select.attr('data-original-name') && originalSelectName) {
                            $select.attr('data-original-name', originalSelectName);
                        }

                        var $customItemsContainer = $select.siblings('.select-items');

                        $select.find('option').each(function () {
                            var valId = parseInt($(this).attr('data-attr-value') || $(this).val());
                            if (!valId || valId === 0) return;

                            var optionText = $.trim($(this).text());
                            var $customDiv = $customItemsContainer.find('div').filter(function () {
                                return $.trim($(this).text()) === optionText;
                            });

                            if (allowedIds.has(valId)) {
                                $(this).prop('disabled', false);
                                if ($customDiv.length) {
                                    $customDiv.removeClass('unavailable-swatch');
                                }
                                visibleValuesCount++;
                            } else {
                                if ($(this).is(':selected')) {
                                    $select.val('0');
                                }

                                $(this).prop('disabled', true);
                                if ($customDiv.length) {
                                    $customDiv.addClass('unavailable-swatch');
                                    $customDiv.removeClass('same-as-selected');
                                }
                            }
                        });


                        if (visibleValuesCount === 0) { //--
                            $select.removeAttr('name');
                        } else {
                            $select.attr('name', originalSelectName);

                            if ($select.val() === "0" || $select.val() === null) {

                                var $firstValidOpt = $select.find('option').filter(function () {
                                    return !$(this).prop('disabled') && $(this).val() !== "0";
                                }).first();

                                if ($firstValidOpt.length > 0) {
                                    $select.val($firstValidOpt.val()).trigger('change');

                                    var $customSelected = $select.siblings('.select-selected');
                                    if ($customSelected.length > 0) {
                                        $customSelected.html($firstValidOpt.text());
                                        //var $customDiv = $customItemsContainer.find('div').filter(function () {
                                        //    return $.trim($(this).text()) === "Queen"
                                        //});
                                        //alert($customDiv.length);
                                        //if ($customDiv.length > 0) {
                                        //    $customDiv.addClass('same-as-selected');
                                        //}
                                    }
                                }
                            }
                        }
                    }

                    $parentRow[0].style.removeProperty('display');
                });
      }
</script>
</div>