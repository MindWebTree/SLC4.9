@model IList<CustomCategoryModel>
@if (Model.Count > 0)
{
    <section class="category-showcase" aria-labelledby="feature-categories" >
        <h2 id="feature-categories" class="category-showcase__title">@T("Heading.Category")</h2>
        <div  class="category-showcase__slider">
            @foreach (var item in Model)
            {
                <div class="category-card">
                    <a class="category-card__link"
                       href="@Url.RouteUrl("Category", new { id = item.Id, SeName = item.SeName })"
                    >
                        <div class="category-card__image-wrapper">
                            <img class="category-card__image lazy"
                                 alt=""
                                 src="/images/pixel.png"
                                 data-src="@item.PictureModel.ImageUrl">
                        </div>
                        <div class="category-card__content">
                            <h3 class="category-card__name">@item.Name</h3>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}


<script>
document.addEventListener("DOMContentLoaded", function () {
    var $slider = $('.category-showcase__slider');

    $slider.slick({
        dots: false,
        infinite: false,
        speed: 800,
        cssEase: 'ease-out',
        useTransform: true,
        useCSS: true,
        slidesToShow: 4,
        slidesToScroll: 2,
        variableWidth: false,
        centerMode: false,
        centerPadding: '0',
        responsive: [
            {
                breakpoint: 1600,
                settings: {
                    centerMode: false,
                    centerPadding: '40px',
                    slidesToScroll: 2,
                    slidesToShow: 3
                }
            },
            {
                breakpoint: 991,
                settings: {
                    centerMode: false,
                    centerPadding: '40px',
                    slidesToScroll: 2,
                    slidesToShow: 2
                }
            },
            {
                breakpoint: 767,
                settings: {
                    centerMode: false,
                    centerPadding: '40px',
                    dots: true,
                    slidesToScroll: 2,
                    slidesToShow: 2,
                    rows: 2
                }
            },
            {
                breakpoint: 480,
                settings: {
                    centerMode: false,
                    slidesToScroll: 2,
                    centerPadding: '40px',
                    dots: true,
                    slidesToShow: 2,
                    rows: 2
                }
            }
        ]
    });
    $('.category-showcase__slider').on('init reInit setPosition breakpoint', function () {
        $(this).find('.slick-prev').attr('aria-label', 'Previous Category');
        $(this).find('.slick-next').attr('aria-label', 'Next Category');
    });
    let isScrolling = false;

$slider.on('wheel', function(e) {
    let deltaX = e.originalEvent.deltaX;
    let deltaY = e.originalEvent.deltaY;

    // 👉 Ignore if vertical scroll is dominant
    if (Math.abs(deltaY) > Math.abs(deltaX)) {
        return;
    }

    e.preventDefault();

    if (isScrolling) return;
    isScrolling = true;

    if (deltaX > 10) {
        $slider.slick('slickNext');
    } else if (deltaX < -10) {
        $slider.slick('slickPrev');
    }

    setTimeout(function() {
        isScrolling = false;
    }, 50);
});
});
</script>

