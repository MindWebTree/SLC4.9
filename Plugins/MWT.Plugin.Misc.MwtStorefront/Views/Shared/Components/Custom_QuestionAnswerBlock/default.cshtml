@model List<QuestionAnswerModel>

@if (Model.Count > 0)



{

    <div class="shop-by-questionanswer">
        <h2 class="mb-3">@T("Heading.QuestionAnswer")</h2>

        <div class="accordion" id="faqAccordion">
            @{
                int i = 0;
            }

            @foreach (var qa in Model)
           {
             <div class="accordion-item faq-box">
                    <h2 class="accordion-header" id="heading-@qa.Id">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapse-@qa.Id"
                                aria-expanded="false"
                                aria-controls="collapse-@qa.Id">
                            @qa.Name
                        </button>
                    </h2>

                    <div id="collapse-@qa.Id"
                         class="accordion-collapse collapse"
                         aria-labelledby="heading-@qa.Id"
                         data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            @Html.Raw(qa.Description)
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>
}

