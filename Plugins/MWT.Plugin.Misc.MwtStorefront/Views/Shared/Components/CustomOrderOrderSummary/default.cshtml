@model Nop.Web.Areas.CustomOrder.Models.Orders.CustomOrderSummaryModel
@inject Nop.Services.Catalog.IPriceFormatter _priceFormatter
@inject Nop.Services.Payments.IPaymentPluginManager _paymentPluginManager
@inject Nop.Services.Customers.ICustomerService _customerService;
@inject Nop.Core.IStoreContext _storeContext
@inject Nop.Core.IWorkContext _workContext
@using Nop.Core.Domain.Customization.PhoneOrder
@{ var storeId = (await _storeContext.GetCurrentStoreAsync()).Id;
                var defautPrice = await _priceFormatter.FormatPriceAsync(0);
                bool isPaid = Model.OrderStatus == OrderStatus.Paid.ToString() && Model.FullPaid ? true : false; }
<div class="row custom-order-payment-shopping">
    <div class="col-sm-12"><h3>Shopping Cart</h3></div>
    @* Cart Items*@
    <div class="col-8">
        @await Component.InvokeAsync("CustomOrderItems", new { orderId = Model.Id })
    </div>
    <div class="col-4">

        <div id="order-summary-wrapper" class="customorder-summary">

            <h2>Order Summary</h2>
            <div class="block-content">
                <table>
                    <tbody>
                        <tr><td>Subtotal:</td><td>@Model.SubTotal</td></tr>
                        <tr style="border-bottom:1px dashed #cacaca">
                            <td>Subtotal Adjustment:</td>
                            <td class="red">
                                @(!string.IsNullOrEmpty(Model.SubTotalDiscountDetails?.TotalAdjustment) ? (Model.SubTotalDiscountDetails?.ChargeType == ChargeType.Subtract.ToString() ?
                                    "-" : "") + Model.SubTotalDiscountDetails.TotalAdjustment : defautPrice
                                    )
                            </td>
                        </tr>
                        @if (Model.ParentOrderID == 0)
                        {
            <tr>
                <td>@T("order.shipping.CurbSide"):</td>
                <td>
                    @(string.IsNullOrEmpty(Model.Shipping) ? "Free" : @Model.Shipping)
                </td>
            </tr>}

                        @if (!string.IsNullOrEmpty(Model.ShippingDiscountDetails?.TotalAdjustment))
                        {
            <tr style="border-bottom:1px dashed #cacaca">
                <td>Shipping Adjustment:</td>
                <td class="red">
                    @(
                                        !string.IsNullOrEmpty(Model.ShippingDiscountDetails?.TotalAdjustment) ? (Model.ShippingDiscountDetails?.ChargeType == ChargeType.Subtract.ToString() ?
                                "-" : "") + Model.ShippingDiscountDetails.TotalAdjustment : defautPrice
                                )
                </td>
            </tr>} @if (Model.ParentOrderID == 0)
                        {
            <tr style="border-bottom:1px dashed #cacaca"><td>WGS Service:</td><td>@(string.IsNullOrEmpty(Model.Wgs) ? defautPrice : Model.Wgs)</td></tr>}
            @if (Model.CustomDutyPercentage > 0)
            {
<tr style="border-bottom:1px dashed #cacaca">
    <td>
        Custom Duty(@Model.CustomDutyPercentage%)
    </td>

    <td>
        @(string.IsNullOrEmpty(Model.CustomDuty) ? defautPrice : Model.CustomDuty)
    </td>
</tr>}
            @if (!Model.TaxInfo.Where(t => t.TaxType != Nop.Services.Tax.TaxType.Tax && t.TaxRate > 0).Any() && Model.ParentOrderID == 0)
            {
<tr style="border-bottom:1px dashed #cacaca"><td>Sales Tax:</td><td>@(string.IsNullOrEmpty(Model.Tax) ? defautPrice : Model.Tax)</td></tr> }
            else if (Model.ParentOrderID == 0)
            {
<tr style="border-bottom:1px dashed #cacaca">

    <td colspan="2" class="text" style="text-align:left;">
        <label>@T("ShoppingCart.Totals.DisplayTax.Info")</label>
    </td>
</tr>
                @foreach (var tax in Model.TaxInfo.Where(t => t.TaxRate > 0))
                {
<tr style="border-bottom:1px dashed #cacaca">

    <td style="padding: 0 0 0 10px;">
        <label style="text-transform: uppercase;">@T("Canada.Tax.Label", tax.TaxType.ToString(), tax.TaxRate.ToString("F2"))</label>

    </td>
    <td class="cart-total-right a-right">
        <span class="">@await _priceFormatter.FormatPriceAsync(tax.Amount, true, false)</span>
    </td>
</tr>}}
            @if (!isPaid)
            {
@if (Model.OrderType == OrderTypes.CustomOrder.ToString() && !string.IsNullOrEmpty(Model.InitialPayment))
{
<tr>
    <td>
        <span>
            @(
                                                Model.OrderStatus == OrderStatus.Paid.ToString() && !Model.FullPaid ? "Paid Amount" : "Initial Payment"
                                                )
        </span>
    </td>

    <td class="border-0 text-center align-middle ordersummary-customorder-InitialPayment"> <span>@Model.InitialPayment</span></td>
</tr>
                    <tr>
                        <td>
                            <span>
                                Pending Payment:
                            </span>
                        </td>

                        <td class="border-0 text-center align-middle ordersummary-customorder-InitialPayment"> <span>@Model.PendingPayment</span></td>
                    </tr>
                                        <tr><td><span>Payable Amount:	</span></td><td><span>@Model.PayableAmount</span></td></tr> }
                                                        else
                                                        {
                                        <tr><td><span>Payable Amount:	</span></td><td><span>@Model.PayableAmount</span></td></tr>} }
            else
            {
<tr>
    <td>
        <span>Paid Amount</span>
    </td>

    <td>
        <span>
            @Model.OrderTotal
        </span>
    </td>
</tr>}


        </tbody>
    </table>
</div>


</div>
</div>
</div>
@* added check by Nikhil if order is expired than will not show the payemnet section*@
@if (!isPaid && Model.IsOrderExpired != true)
{@*    <div class="row  custom-order-payment-address custom-order-pay">
        <div class="col-sm-12"><h3>Pay now</h3></div>
        <div class="col-sm-6 col-12">

            <strong class="text-dark">Select the mode of Payment. All the transactions are safe and secure</strong><br>
            @if (Model.PaymentMethods.Where(m => m.Name.ToLower().Contains("authorize")).Any())
            {
                <a href="#"><img src="images/checkout-paypal.png"></a>
            }
            @if (Model.PaymentMethods.Where(m => m.Name.ToLower().Contains("paypal")).Any())
            {
                <a href="#"><img src="images/credit_payment.png"></a>
            }
        </div>
    </div>*@

                <form id="paymentform">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <div class="row  custom-order-payment-address custom-order-pay">
                        <div class="col-sm-12"><h3>Pay now</h3></div>
                        <div class="col-sm-6 col-12">
                            @for (var i = 0; i < Model.PaymentMethods.Count; i++)
                            {
                                var paymentMethod = Model.PaymentMethods[i];
                                var paymentMethodName = paymentMethod.Name;
                                if (!isPaid)
                                {
            @if (Model.OrderType == OrderTypes.CustomOrder.ToString() && !string.IsNullOrEmpty(Model.InitialPayment)
         && Model.OrderStatus != OrderStatus.Paid.ToString() && (paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("paypal") >= 0
         || paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("affirm") >= 0)
         )
            {
                continue;
            }
            else if(Model.ParentOrderID>0  && paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("affirm") >= 0)
            {
                continue;
            }
                                }

                                if (paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("paypal") >= 0 || paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("authorize") >= 0 || paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("affirm") >= 0)
                                {
                                    if (!string.IsNullOrEmpty(paymentMethod.Fee))
                                    {
                                        paymentMethodName = @T("Checkout.SelectPaymentMethod.MethodAndFee", paymentMethodName, paymentMethod.Fee).Text;
                                    }


            <div>
                @if (paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("authorize") >= 0)
                {
<a class="paymentmethod" paymethodname="@paymentMethodName"><img src="images/credit_payment.png"></a> }
                        else if (paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("paypal") >= 0)
                        {
<a class="paymentmethod" paymethodname="@paymentMethodName"><img src="images/checkout-paypal.png"></a> }
                        else if (paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("affirm") >= 0)
                        {
<a class="paymentmethod" paymethodname="@paymentMethodName"><img src="images/affirm.jpg"></a>}


                <div class="checkout-payment-methods hidelement @(paymentMethod.Selected ? "active" : "")">
                    <input type="radio" id="paymentmethod_@(i)" name="paymentmethod" data-paymethodname="@paymentMethodName"
                           value="@(paymentMethod.PaymentMethodSystemName)" class="radio" checked="@paymentMethod.Selected" />
                    <label for="paymentmethod_@(i)" class="d-flex width w-100">
                        <span class="ml-0">     @paymentMethodName</span>
                        @if (!string.IsNullOrEmpty(paymentMethod.LogoUrl))
                        {
<span>
    <img src="@paymentMethod.LogoUrl" alt="@paymentMethodName" />
</span>}
                    </label>
                </div>

                @{ var paymentMethodInst = await _paymentPluginManager
                                            .LoadPluginBySystemNameAsync(paymentMethod.PaymentMethodSystemName,
                                            Model.Customer, storeId); }


                <div class="paymentinfo " style="display:none;" data-paymentinfo="@paymentMethodName">

                    @{ string viewName =
paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("paypal") >= 0 ? "CustomPayPalCommercePaymentInfo" : (paymentMethod.PaymentMethodSystemName.ToLower().IndexOf("affirm") >= 0 ? "AffirmCustomOrderPaymentInfo" :
((Nop.Services.Payments.IPaymentMethod)paymentMethodInst).GetPublicViewComponentName()); }


                    @await Html.PartialAsync("OpcPaymentInfo", new Nop.Web.Models.Checkout.CheckoutPaymentInfoModel
                    {
                        PaymentViewComponentName = viewName
             ,
                        DisplayOrderTotals = true,
                        AdditionaData = Model
                    })
                </div>

            </div>                    }


                            }

                        </div>
                    </div>
                </form>
                                <div class="text-center place-order-pay-custom">
                                    <button type="button" id="btnplaceOrder" class="btn btn-primary">Place your order <span class="load loading"></span></button>
                                </div>
                                                <script asp-location="Footer">
                                                    $(".paymentmethod").click(function () {
                                                        var paymethodname = $(this).attr("paymethodname");
                                                     
                                                        $("input[data-paymethodname='" + paymethodname + "']").prop("checked", true).trigger('change');


                                                    });

                                                    $("input[name='paymentmethod']").change(function () {

                                                        var paymethodname = $(this).attr("data-paymethodname");
                                                        $(".paymentinfo").hide();

                                                        $("div[data-paymentinfo='" + paymethodname + "']").show();
                                                    })

                                                    $("body").on("click", "#btnplaceOrder", function (e) {
                                                        if ($('#paymentform input[type=radio]:checked').length) {

                                                            if ($('#paymentform input[type=radio]:checked').val().toLowerCase().indexOf("affirm") > 0) {
                                                                submitAffirmHostedCheckout();
                                                                return;
                                                            }
                                                        }
                                                        $("#btnplaceOrder").attr("disabled", true);
                                                        $("#btnplaceOrder").addClass("activeLoading");
                                                        var formData = $("#paymentform").serialize();
                                                       
                                                        var paymentProcessUrl = '/CheckoutCustomOrder/ProcessPayment/';
                                                        $.ajax({
                                                            cache: false,
                                                            url: paymentProcessUrl,
                                                            type: "Post",
                                                            data: formData,
                                                            success: function (data) {
                                                                $("#btnplaceOrder").removeAttr("disabled");
                                                                $("#btnplaceOrder").removeClass("activeLoading");
                                                                if (data.response.statuscode == 200) {
                                                                    if (data.response.notificationMessage && data.response.notificationMessage != null) {
                                                                        swal.fire(
                                                                            {
                                                                                icon: 'success',
                                                                                html: data.response.notificationMessage
                                                                            })
                                                                            .then(function () {
                                                                                window.location = window.location.href;
                                                                            });
                                                                    }

                                                                }
                                                                else {
                                                                    if (data.response.notificationMessage && data.response.notificationMessage != null) {

                                                                        swal.fire(
                                                                            {
                                                                                title: 'Oops...',
                                                                                icon: 'error',
                                                                                html: data.response.notificationMessage
                                                                            })
                                                                    }
                                                                    else if (data.response.message && data.response.message != null) {
                                                                        swal.fire(
                                                                            {
                                                                                title: 'Oops...',
                                                                                icon: 'error',
                                                                                html: data.response.message
                                                                            })

                                                                    }
                                                                }
                                                            },
                                                            error: function (data) {
                                                                $("#btnplaceOrder").removeAttr("disabled");
                                                                $("#btnplaceOrder").removeClass("activeLoading");
                                                                swal.fire(
                                                                    {
                                                                        title: 'Oops...',
                                                                        icon: 'error',
                                                                        html: data
                                                                    })
                                                            }
                                                        })
                                                    });
                                                </script>
                                                                <style>
                                                                    .payment-info .message-error.validation-summary-errors {
                                                                        display: none;
                                                                    }

                                                                    .payment-info .info {
                                                                        float: left;
																		padding: 20px 0 10px 27px;
                                                                    }
                                                                </style> }
                                                                            else
                                                                            {
                                                                                if (Model.IsOrderExpired)
                                                                                {
                                                                <div>
                                                                      @T("admin.CheckoutCustomOrder.Isexpired")
                                                                </div>}
                                                                            }
