@using MWT.Plugin.Misc.MwtStorefront.Models.ShoppingCart
@model MiniShoppingCartExtendedModel.ShoppingCartItemModel
@using Nop.Core.Domain.Orders
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering;
<div class="product-add-to-cart-setting">
    <div class="d-flex product-add-to-cart">
        <div class="img-add-to-cart">
            <a href="@Url.RouteUrl("Product", new { id = Model.ProductId, SeName = Model.ProductSeName })" aria-label="@Model.Picture.Title">
                <img alt="" src="/images/pixel.png" data-src="@Model.Picture.ImageUrl" class="lazy"   />
            </a>
        </div>
        <div class="deatail-add-to-cart">
            <h4>
                <a href="@Url.RouteUrl("Product", new { id = Model.ProductId, SeName = Model.ProductSeName })" title="@Model.Picture.Title">
                    @Model.ProductName
                </a>
            </h4>


            @Html.Raw("<br />")
            @Html.Raw("<br />")
            @Html.Raw("<br />")
            <div class="d-flex align-items-center">
                <div class="quantity nobr">
                    @if (Model.AllowedQuantities?.Count > 0)
                    {
                        <div class="quantity-container">
                            <label for="itemquantity@(Model.Id)" class="quantity-label">
                                Quantity
                            </label>
                            <span class="quantity-background"></span>
                            <div class="quantity-box">
                                <select name="Model.uantity@(Model.Id)"
                                        id="Model.uantity@(Model.Id)"
                                        class="qty-dropdown form-control"
                                        data-url="@Url.RouteUrl("CartItem-Update", new { productId = Model.ProductId, shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart })"
                                        onchange="validateAndUpdateQuantity(this)">
                                    @foreach (var qty in Model.AllowedQuantities)
                                    {
                                        <option value="@qty.Value" selected="@qty.Selected">@qty.Value</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        var quantityOptions = Enumerable.Range(1, 10).Select(i => new SelectListItem { Value = i.ToString(), Text = i.ToString(), Selected = (i == Model.Quantity) }).ToList();
                        <div class="quantity-container">
                            <label for="itemquantity@(Model.Id)" class="quantity-label">
                                Quantity
                            </label>
                            <span class="quantity-background"></span>
                            <div class="quantity-box">
                                <select name="Model.uantity@(Model.Id)"
                                        id="Model.uantity@(Model.Id)"
                                        class="qty-dropdown form-control"
                                        data-url="@Url.RouteUrl("CartItem-Update", new { shoppingCartId = Model.Id, shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart })"
                                        onchange="validateAndUpdateQuantity(this)">
                                    @foreach (var qty in quantityOptions)
                                    {
                                        <option value="@qty.Value" selected="@qty.Selected">@qty.Value</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>
                <div class="delete-button-desktop">
                    <a href="#" aria-label="Remove @Model.ProductName from cart" onclick="deleteItem('@Model.Id',this,event,'@Url.RouteUrl("CartItem-Delete", new { shoppingCartRecId = Model.Id, shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart })')">

                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="deleteItem">
                            <path d="M7.32109 22.3984H16.7611C17.8411 22.3984 18.6811 21.5184 18.6811 20.4784V7.47844H19.5211C19.7611 7.47844 19.9211 7.31844 19.9211 7.07844V6.15844C19.9211 5.31844 19.2411 4.67844 18.4411 4.67844H15.0411V3.63844C15.0411 2.95844 14.4811 2.39844 13.8011 2.39844H10.2411C9.56109 2.39844 9.00109 2.95844 9.00109 3.63844V4.67844H5.60109C4.76109 4.67844 4.12109 5.35844 4.12109 6.15844V7.07844C4.12109 7.31844 4.28109 7.47844 4.52109 7.47844H5.36109V20.4784C5.36109 21.5184 6.24109 22.3984 7.32109 22.3984ZM17.8811 20.4784C17.8811 21.1184 17.3611 21.5984 16.7611 21.5984H7.32109C6.68109 21.5984 6.20109 21.0784 6.20109 20.4784V7.47844H17.9211V20.4784H17.8811ZM9.80109 3.63844C9.80109 3.39844 10.0011 3.19844 10.2411 3.19844H13.8011C14.0411 3.19844 14.2411 3.39844 14.2411 3.63844V4.67844H9.84109V3.63844H9.80109ZM4.92109 6.15844C4.92109 5.75844 5.24109 5.47844 5.60109 5.47844H18.4011C18.8011 5.47844 19.0811 5.79844 19.0811 6.15844V6.67844H4.92109V6.15844Z" fill="black" />
                            <path d="M15.1605 19.6794C15.4005 19.6794 15.5605 19.5194 15.5605 19.2794V9.75938C15.5605 9.51937 15.4005 9.35938 15.1605 9.35938C14.9205 9.35938 14.7605 9.51937 14.7605 9.75938V19.2794C14.7605 19.5194 14.9605 19.6794 15.1605 19.6794ZM12.0405 19.6794C12.2805 19.6794 12.4405 19.5194 12.4405 19.2794V9.75938C12.4405 9.51937 12.2805 9.35938 12.0405 9.35938C11.8005 9.35938 11.6405 9.51937 11.6405 9.75938V19.2794C11.6405 19.5194 11.8005 19.6794 12.0405 19.6794ZM8.88047 19.6794C9.12047 19.6794 9.28047 19.5194 9.28047 19.2794V9.75938C9.28047 9.51937 9.12047 9.35938 8.88047 9.35938C8.64047 9.35938 8.48047 9.51937 8.48047 9.75938V19.2794C8.48047 19.5194 8.64047 19.6794 8.88047 19.6794Z" fill="black" />
                        </svg>
                        <svg aria-hidden="true" width="14" height="15" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg" stroke="#4D585A" class="minicart-processing" style="display: none; width: 15px;">
                            <g fill="none" fill-rule="evenodd">
                                <g transform="translate(1 1)" stroke-width="2">
                                    <circle stroke-opacity=".5" cx="18" cy="18" r="18"></circle>
                                    <path d="M36 18c0-9.94-8.06-18-18-18">
                                        <animateTransform attributeName="transform" type="rotate" from="0 18 18" to="360 18 18" dur="1s" repeatCount="indefinite"></animateTransform>
                                    </path>
                                </g>
                            </g>
                        </svg>
                    </a>
                </div>
                <h4 class="shoppingcart-unitprice">@Model.UnitPrice</h4>
            </div>

        </div>
    </div>
    <div class="delete-button-mobile"><a href="#" onclick="deleteItem('@Model.Id',this,event,'@Url.RouteUrl("CartItem-Delete", new {shoppingCartRecId = Model.Id, shoppingCartTypeId = (int) ShoppingCartType.ShoppingCart})')">Delete</a></div>


    @if (Model.PictureModels.Count > 0)
    {
        <div class="selection-preview">
            <p>@T("cart.popup.Selection.Preview.Heading")</p>
            <div class="selection-preview-wrapper">
                <button class="sp-chevron sp-prev sp-hidden" aria-label="Scroll left">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="selection-preview-image">
                    @foreach (var picture in Model.PictureModels)
                    {
                        <img class="lazy" src="/images/pixel.png" data-src="@picture.ImageUrl"
                             alt="@picture.AlternateText" title="@picture.Title" />
                    }
                </div>
                <button class="sp-chevron sp-next sp-hidden" aria-label="Scroll right">
                   <i class="fas fa-chevron-right "></i>
                </button>
            
        </div>
    </div>
    }
<div class="selection-info">
    <ul>
            @if (!string.IsNullOrEmpty(Model.AttributeInfo))
            {

                string[] attrs = Model.AttributeInfo.Split(new string[] { "<br />" }, StringSplitOptions.None);
                foreach (var attr in attrs)
                {

                <li>@Html.Raw(attr)</li>

                }

            }

    </ul>
</div>

</div>


