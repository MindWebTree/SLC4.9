@model CustomOrderLoginInfo

@{
    string customerId = Context.Request.Query["customerid"];
}

<h2 class="page-heading text-center pt-5">@T(Model.ParentOrderId>0? "customorder.WGS.Payment.Heading" : "customorder.Payment.Heading")</h2>
<form asp-action="index" asp-controller="CheckoutCustomOrder" asp-route-OrderId="@Model.OrderId" asp-route-customerid="@customerId" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="message-error alert alert-danger"></div>
    <div class="form-custom-order-login mb-3">
        <h4>
            @if (Model.ParentOrderId > 0)
            {
                @T("customorder.WGS.Payment.Subheading", Model.ParentOrderId)
            }
            else
            {
                @T("customorder.Payment.Subheading", Model.OrderId)
            }
           
        </h4>
         <input class="address-id" asp-for="OrderId" type="hidden" />
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="EmailAddress"></label>
                <input asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress"></span>
            </div>
            <div class="form-group col-md-12">
                <label asp-for="ZipCode"></label>
                <nop-editor class="form-control" asp-for="ZipCode" />
                <span asp-validation-for="ZipCode"></span>

            </div>
        </div>

        <button type="submit" class="btn btn-primary">SUBMIT</button>
    </div>
</form>