@{
    Layout = "_AdminPopupLayout";
} 
@model MWT.Nop.Plugin.Widgets.Catalog.Models.MWTEntityBannerModel
@{
    NopHtml.AddCssFileParts("~/Plugins/MWT.Nop.Plugin.Widgets.Catalog/Content/css/style.css");
}
<form asp-controller="MWTWidgetsCatalog" asp-action="EditBannerPopup"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Common.Edit")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
        </div>
    </div>
    <section class="content">
        <div class="content">
            <div class="form-horizontal">
                @await Html.PartialAsync("~/Plugins/MWT.Nop.Plugin.Widgets.Catalog/Views/_CreateOrUpdateCatalogWidgetRecord.cshtml", Model)

            </div>
        </div>
    </section>
</form>